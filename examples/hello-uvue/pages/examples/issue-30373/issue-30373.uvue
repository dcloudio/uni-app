<script setup vapor lang="ts">
  function forceGarbage(): string {
    const list: string[] = []
    for (let i = 0; i < 40000; i++) {
      list.push('issue-30373-garbage-' + i)
    }
    return 'gc-' + list.length
  }
</script>

<template>
  <view class="page">
    <text class="title">#30373 插槽中 v-for 渲染</text>
    <text class="desc">静态 v-for 放在组件插槽中，内容应该稳定显示。</text>

    <issue-30373-shell>
      <issue-30373-item
        v-for="i in 5"
        :key="'default-' + i"
        :text-id="'issue-30373-default-' + i"
        :label="'default-' + i"
      />

      <template #footer>
        <issue-30373-item
          v-for="i in 5"
          :key="'footer-' + i"
          :text-id="'issue-30373-footer-' + i"
          :label="'footer-' + i"
        />
      </template>

      <template #scoped="{ suffix }">
        <issue-30373-item
          v-for="i in 5"
          :key="'scoped-' + i"
          :text-id="'issue-30373-scoped-' + i"
          :label="'' + suffix + '-' + i"
        />
      </template>
    </issue-30373-shell>
    <text id="issue-30373-gc" class="gc-text">{{ forceGarbage() }}</text>
  </view>
</template>

<style>
  .page {
    flex: 1;
    padding: 12px;
  }

  .title {
    color: #111111;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 8px;
  }

  .desc {
    color: #666666;
