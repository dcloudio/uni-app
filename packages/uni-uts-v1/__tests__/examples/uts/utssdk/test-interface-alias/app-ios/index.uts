import { ChannelManager, PushChannelManager, NestedPushChannelManager, CycleA } from '../interface.uts';
import { JSExport } from 'JavaScriptCore';

type PlatformManager = NestedPushChannelManager;

export function getChannelManager(): ChannelManager { throw new Error('stub'); }
export function getPushChannelManager(): PushChannelManager { throw new Error('stub'); }
export function getNestedPushChannelManager(): NestedPushChannelManager { throw new Error('stub'); }
export function getPlatformManager(): PlatformManager { throw new Error('stub'); }
export function getNullableManager(): PushChannelManager | null { return null; }
export const getManager = (): PushChannelManager => { throw new Error('stub'); };
export function getCyclicManager(): CycleA { throw new Error('stub'); }

export class ManagerFactory {
  getManager(): PlatformManager { throw new Error('stub'); }
}

export interface ExportedManager extends JSExport {
  getValue(): string;
}
export interface ChildExportedManager extends ExportedManager {
  getChildValue(): string;
}
export type ExportedManagerAlias = ExportedManager;
export type NestedExportedManagerAlias = ExportedManagerAlias;
export type ChildExportedManagerAlias = ChildExportedManager;

export function getExportedManager(): ExportedManager { throw new Error('stub'); }
export function getExportedManagerAlias(): ExportedManagerAlias { throw new Error('stub'); }
export function getNestedExportedManagerAlias(): NestedExportedManagerAlias { throw new Error('stub'); }
export function getChildExportedManagerAlias(): ChildExportedManagerAlias { throw new Error('stub'); }
