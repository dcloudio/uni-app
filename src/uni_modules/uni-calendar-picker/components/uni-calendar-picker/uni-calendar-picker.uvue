<template>
	<view style="position: relative;">
		<!-- 触发区，默认插槽可替换 -->
		<view class="cp-trigger" :class="props.disabled ? 'cp-trigger--disabled' : ''" ref="anchorRef" @click="onTriggerClick"
			<!-- #ifdef WEB -->
			:tabindex="props.disabled ? '-1' : '0'"
			@keydown="onTriggerKeydown"
			<!-- #endif -->
		>
			<slot :start="committedStart" :end="committedEnd" :text="displayText">
				<view class="uni-field-default" :class="[props.inputClass, props.disabled ? 'cp-trigger-disabled' : '']">
					<text flatten class="uni-result-text"
						:class="hasDisplayValue ? (props.disabled ? 'cp-trigger-value-disabled' : 'cp-trigger-value') : 'cp-trigger-placeholder'">{{ displayText }}</text>
					<text class="uni-down-arrow-iconfont" :class="props.arrowClass">{{'\uE601'}}</text>
					<!-- <view class="uni-arrow-wrap" flatten>
						<view class="uni-arrow" flatten></view>
					</view> -->
				</view>
			</slot>
		</view>

		<!-- 遮罩，宽屏下无过渡动画 -->
		<view v-if="isOpened" class="cp-mask" :class="[props.maskClass, active ? 'cp-mask-active' : '']"
			@click="close" />

		<!-- 弹层 -->
		<view v-if="isOpened" class="cp-popup"
			:class="[props.popClass, active ? 'cp-popup-active' : '', dragTransitionOff ? 'cp-popup-dragging' : '']"
			:style="popupStyle">
			<view class="cp-header" @touchstart="onHeaderTouchStart" @touchmove="onHeaderTouchMove"
				@touchend="onTouchEnd" @touchcancel="onTouchEnd">
				<view class="cp-close" :class="[props.cancelClass, props.confirm ? 'cp-close-cancel' : '']" @click="close"
					<!-- #ifdef WEB -->
					tabindex="0"
					@keydown="onCloseKeydown"
					<!-- #endif -->
				>
					<template v-if="props.confirm">
						<text flatten class="cp-cancel-text">{{ cancelText }}</text>
					</template>
					<template v-else>
						<view class="cp-close-line" flatten></view>
						<view class="cp-close-line cp-close-line-rotate" flatten></view>
					</template>
				</view>
				<view class="cp-title-wrap" :class="props.confirm ? 'cp-title-wrap-confirm' : ''">
					<slot name="title">
						<text flatten class="cp-title">{{ props.title }}</text>
					</slot>
				</view>
				<view v-if="props.confirm" class="cp-confirm-action" @click="onConfirmClick"
					<!-- #ifdef WEB -->
					tabindex="0"
					@keydown="onConfirmKeydown"
					<!-- #endif -->
				>
					<text flatten class="cp-confirm-text">{{ confirmText }}</text>
				</view>
			</view>

			<view class="cp-body" @touchstart="onBodyTouchStart" @touchmove="onBodyTouchMove"
				@touchend="onTouchEnd" @touchcancel="onTouchEnd">
				<scroll-view class="cp-scroll" :show-scrollbar="false" @scroll="onBodyScroll">
					<view :class="[props.range ? 'cp-calendars-range' : 'cp-calendars-single', isWideLayout ? 'cp-calendars-wide' : '']">
						<!-- 单日选择：一个日历 -->
						<view v-if="!props.range" class="cp-cal cp-cal-single">
							<uni-calendar-view :date="firstMonth" :compact="compactMode" :model-value="selectedDate"
								:min-date="props.minDate" :max-date="props.maxDate" :locale="props.locale"
								:week-start="props.weekStart" :holidays="props.holidays" :day-extras="props.dayExtras"
								:year-month-class="props.yearMonthClass"
								:year-month-arrow-class="props.yearMonthArrowClass" :week-class="props.weekClass"
								:week-item-class="props.weekItemClass" :day-class="props.dayClass"
								:day-selected-class="props.daySelectedClass"
								@update:model-value="onViewModelValueUpdate" />
						</view>

						<!-- 范围选择：两个日历共享同一份区间，各自独立翻月 -->
						<!-- 传入首尾插槽时使用带插槽透传的日历；未传入时使用无插槽版本，避免影响标签文案回退 -->
						<!-- 微信小程序同名插槽只接受第一个，故按当前展示月份把首尾插槽排他地路由到对应日历 -->
						<template v-if="props.range && hasRangeSlots">
							<view class="cp-cal cp-cal-range" :class="isWideLayout ? 'cp-cal-wide' : ''">
								<uni-calendar-view :date="firstMonth" range :compact="compactMode" :range-start="rangeStart"
									:range-end="rangeEnd" :min-date="props.minDate" :max-date="props.maxDate"
									:locale="props.locale" :week-start="props.weekStart" :holidays="props.holidays"
									:day-extras="props.dayExtras" :range-start-label="props.rangeStartLabel"
									:range-end-label="props.rangeEndLabel" :range-class="props.rangeClass"
									:range-label-class="props.rangeLabelClass" :year-month-class="props.yearMonthClass"
									:year-month-arrow-class="props.yearMonthArrowClass" :week-class="props.weekClass"
									:week-item-class="props.weekItemClass" :day-class="props.dayClass"
									:day-selected-class="props.daySelectedClass"
									@update:range-start="onViewRangeStartUpdate"
									@update:range-end="onViewRangeEndUpdate" @range-change="onRangeChange"
									@month-change="onFirstPaneMonthChange">
									<template v-if="hasStartSlot" #range-start="slotProps">
										<slot v-if="!startOwnedBySecond" name="range-start" :date="slotProps.date"
											:start="slotProps.start" :end="slotProps.end" />
										<view v-else class="cp-range-label-filler" flatten></view>
									</template>
									<template v-if="hasEndSlot" #range-end="slotProps">
										<slot v-if="!endOwnedBySecond" name="range-end" :date="slotProps.date"
											:start="slotProps.start" :end="slotProps.end" />
										<view v-else class="cp-range-label-filler" flatten></view>
									</template>
								</uni-calendar-view>
							</view>
							<view class="cp-cal cp-cal-range" :class="isWideLayout ? 'cp-cal-wide cp-cal-wide-second' : ''">
								<uni-calendar-view :date="secondMonth" range :compact="compactMode" :range-start="rangeStart"
									:range-end="rangeEnd" :min-date="props.minDate" :max-date="props.maxDate"
									:locale="props.locale" :week-start="props.weekStart" :holidays="props.holidays"
									:day-extras="props.dayExtras" :range-start-label="props.rangeStartLabel"
									:range-end-label="props.rangeEndLabel" :range-class="props.rangeClass"
									:range-label-class="props.rangeLabelClass" :year-month-class="props.yearMonthClass"
									:year-month-arrow-class="props.yearMonthArrowClass" :week-class="props.weekClass"
									:week-item-class="props.weekItemClass" :day-class="props.dayClass"
									:day-selected-class="props.daySelectedClass"
									@update:range-start="onViewRangeStartUpdate"
									@update:range-end="onViewRangeEndUpdate" @range-change="onRangeChange"
									@month-change="onSecondPaneMonthChange">
									<template v-if="hasStartSlot" #range-start="slotProps">
										<slot v-if="startOwnedBySecond" name="range-start" :date="slotProps.date"
											:start="slotProps.start" :end="slotProps.end" />
										<view v-else class="cp-range-label-filler" flatten></view>
									</template>
									<template v-if="hasEndSlot" #range-end="slotProps">
										<slot v-if="endOwnedBySecond" name="range-end" :date="slotProps.date"
											:start="slotProps.start" :end="slotProps.end" />
										<view v-else class="cp-range-label-filler" flatten></view>
									</template>
								</uni-calendar-view>
							</view>
						</template>
						<template v-if="props.range && !hasRangeSlots">
							<view class="cp-cal cp-cal-range" :class="isWideLayout ? 'cp-cal-wide' : ''">
								<uni-calendar-view :date="firstMonth" range :compact="compactMode" :range-start="rangeStart"
									:range-end="rangeEnd" :min-date="props.minDate" :max-date="props.maxDate"
									:locale="props.locale" :week-start="props.weekStart" :holidays="props.holidays"
									:day-extras="props.dayExtras" :range-start-label="props.rangeStartLabel"
									:range-end-label="props.rangeEndLabel" :range-class="props.rangeClass"
									:range-label-class="props.rangeLabelClass" :year-month-class="props.yearMonthClass"
									:year-month-arrow-class="props.yearMonthArrowClass" :week-class="props.weekClass"
									:week-item-class="props.weekItemClass" :day-class="props.dayClass"
									:day-selected-class="props.daySelectedClass"
									@update:range-start="onViewRangeStartUpdate"
									@update:range-end="onViewRangeEndUpdate" @range-change="onRangeChange" />
							</view>
							<view class="cp-cal cp-cal-range" :class="isWideLayout ? 'cp-cal-wide cp-cal-wide-second' : ''">
								<uni-calendar-view :date="secondMonth" range :compact="compactMode" :range-start="rangeStart"
									:range-end="rangeEnd" :min-date="props.minDate" :max-date="props.maxDate"
									:locale="props.locale" :week-start="props.weekStart" :holidays="props.holidays"
									:day-extras="props.dayExtras" :range-start-label="props.rangeStartLabel"
									:range-end-label="props.rangeEndLabel" :range-class="props.rangeClass"
									:range-label-class="props.rangeLabelClass" :year-month-class="props.yearMonthClass"
									:year-month-arrow-class="props.yearMonthArrowClass" :week-class="props.weekClass"
									:week-item-class="props.weekItemClass" :day-class="props.dayClass"
									:day-selected-class="props.daySelectedClass"
									@update:range-start="onViewRangeStartUpdate"
									@update:range-end="onViewRangeEndUpdate" @range-change="onRangeChange" />
							</view>
						</template>
					</view>
				</scroll-view>
			</view>

			<!-- 确认模式底部预览区 -->
			<view v-if="props.confirm" flatten class="cp-footer":class="props.previewResultClass">
				<text v-if="!props.range" flatten class="cp-preview-text"
					:class="props.previewResultTextClass">{{ selectedDate }}</text>
				<template v-else>
					<text flatten class="cp-preview-text"
						:class="props.previewResultTextClass">{{ rangeStart }}</text>
					<text flatten class="cp-preview-text"
						:class="props.previewResultTextClass">{{ rangeEnd }}</text>
				</template>
			</view>
		</view>
	</view>
</template>

<script setup lang="ts">
/**
 * 日历选择器
 * @description 点击触发区弹出日历弹层，支持单日选择与首尾日期范围选择；手机端（含宽屏与 Pad）统一为底部弹层，Web 宽屏（宽度不小于 700px）为锚定触发区的弹层，支持返回键与下拉关闭
 * @uniPlatform {
 *   "app": {
 *     "android": {"unixVaporVer": "5.35"},
 *     "ios": {"unixVaporVer": "5.35"},
 *     "harmony": {"unixVaporVer": "5.35"}
 *   },
 *   "mp": {
 *     "weixin": {"unixVer": "5.35"},
 *     "alipay": {"unixVer": "5.35"}
 *   },
 *   "web": {"unixVer": "5.35"}
 * }
 */

type CalendarDayExtra = {
	/**
	 * @description 日期，格式 YYYY-MM-DD
	 */
	date : string
	/**
	 * @description 日期数字上方显示的文字
	 */
	top ?: string
	/**
	 * @description 日期数字下方显示的文字
	 */
	bottom ?: string
}

type CalendarRange = {
	/**
	 * @description 范围开始日期，格式 YYYY-MM-DD
	 */
	start : string
	/**
	 * @description 范围结束日期，格式 YYYY-MM-DD
	 */
	end : string
}

type PickerLocaleMessages = {
	/**
	 * @description 确定按钮文字
	 */
	confirm : string
	/**
	 * @description 取消按钮文字
	 */
	cancel : string
}

type Props = {
	/**
	 * @description 是否开启日期范围选择
	 * @default false
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	range ?: boolean
	/**
	 * @description 单选值，格式 YYYY-MM-DD，支持 v-model；range 为 true 时忽略
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	modelValue ?: string
	/**
	 * @description 范围开始日期，格式 YYYY-MM-DD，支持 v-model:range-start
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	rangeStart ?: string
	/**
	 * @description 范围结束日期，格式 YYYY-MM-DD，支持 v-model:range-end
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	rangeEnd ?: string
	/**
	 * @description 未选择日期时的占位文字，组件不提供内置文案
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	placeholder ?: string
	/**
	 * @description 弹层标题文字，组件不提供内置文案
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	title ?: string
	/**
	 * @description 语言标识，透传给日历视图
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	locale ?: string
	/**
	 * @description 一周起始日，透传给日历视图；-1 表示按语言自动适配
	 * @default -1
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	weekStart ?: number
	/**
	 * @description 可选的最小日期，格式 YYYY-MM-DD，透传给日历视图
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	minDate ?: string
	/**
	 * @description 可选的最大日期，格式 YYYY-MM-DD，透传给日历视图
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	maxDate ?: string
	/**
	 * @description 节假日日期列表，格式 YYYY-MM-DD，透传给日历视图
	 * @default []
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	holidays ?: string[]
	/**
	 * @description 日期附加文字列表，透传给日历视图
	 * @default []
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	dayExtras ?: CalendarDayExtra[]
	/**
	 * @description 范围开始日期上方的标签文字，透传给日历视图
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	rangeStartLabel ?: string
	/**
	 * @description 范围结束日期上方的标签文字，透传给日历视图
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	rangeEndLabel ?: string
	/**
	 * @description 是否开启确认模式：弹层底部显示已选日期预览（范围模式分别显示开始与结束日期），左上角变为取消、右上角为确定；点击确定才提交选择并关闭弹层，点取消、遮罩、返回键等关闭方式不会提交选择
	 * @default false
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	confirm ?: boolean
	/**
	 * @description 是否禁用触发区
	 * @default false
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	disabled ?: boolean
	/**
	 * @description 弹层容器的样式类，作用于弹层根节点
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.35"},
	 *     "alipay": {"unixVer": "5.35"}
	 *   },
	 *   "web": {"unixVer": "5.35"}
	 * }
	 */
	popClass ?: string.ClassString
	/**
	 * @description 遮罩层的样式类
	 * @default ""
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVaporVer": "5.35"},
	 *     "ios": {"unixVaporVer": "5.35"},
	 *     "harmony": {"unixVaporVer": "5.35"}
	 *   },
