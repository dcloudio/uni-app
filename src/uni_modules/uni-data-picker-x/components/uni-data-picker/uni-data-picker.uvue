<template>
  <view class="uni-data-tree">
    <view
      class="uni-data-tree-input"
      ref="anchorRef"
      :style="anchorStyle"
      @click="handleInput"
      <!-- #ifdef WEB -->
      :tabindex="readonly ? '-1' : '0'"
      @keydown="onInputKeydown"
      <!-- #endif -->
    >
      <slot :data="dataPicker.selectedPaths" :error="dataPicker.error">
        <view class="input-value" :class="inputClass">
          <text flatten v-if="dataPicker.error!=null" class="error-text" :class="errorClass">{{dataPicker.error!.errMsg}}</text>
          <scroll-view v-if="dataPicker.selectedPaths.length" class="selected-path" direction="horizontal"
            :show-scrollbar="false">
            <view class="selected-list" flatten>
              <template v-for="(item, index) in dataPicker.selectedPaths" :key="index">
                <text flatten class="text-color">{{item[dataPicker.mappingTextName]}}</text>
                <text flatten v-if="index<dataPicker.selectedPaths.length-1" class="input-split-line">{{split}}</text>
              </template>
            </view>
          </scroll-view>
          <text flatten v-else-if="dataPicker.error==null&&!dataPicker.loading" class="placeholder">{{placeholder}}</text>
          <view v-if="!readonly" class="arrow-area">
            <view class="input-arrow" flatten></view>
          </view>
        </view>
      </slot>
      <view v-if="dataPicker.loading && !isOpened" class="selected-loading">
        <slot name="picker-loading" :loading="dataPicker.loading">
          <loading></loading>
        </slot>
      </view>
    </view>
    <!-- 弹层挂到页面根节点，避免祖先 overflow/transform/层叠上下文裁剪或破坏 fixed 与锚点定位 -->
    <!-- #ifdef WEB -->
    <teleport v-if="isOpened" to="body">
    <!-- #endif -->
    <!-- #ifndef WEB -->
    <teleport v-if="isOpened" to="page">
    <!-- #endif -->
    <!-- 宽屏为下拉浮层，不铺设全屏遮罩，避免拦截页面滚动；改由外部点击监听关闭 -->
    <view ref="coverRef" class="uni-data-tree-mask" :class="[maskClassValue, active ? 'uni-data-tree-mask-active' : '']" v-if="isOpened && !isWide" @click="handleClose"></view>
    <view ref="dialogRef" class="uni-data-tree-dialog"
      :class="[popupClass, active ? 'uni-data-tree-dialog-active' : '', dragTransitionOff ? 'uni-data-tree-dialog-drag' : '']"
      :style="dialogStyle" v-if="isOpened"
      <!-- #ifdef WEB -->
      @keydown="onDialogKeydown"
      <!-- #endif -->
    >
      <view class="dialog-caption" @touchstart="onTitleTouchStart" @touchmove="onTitleTouchMove"
        @touchend="onTouchEnd" @touchcancel="onTouchEnd">
        <view class="dialog-title-view" flatten>
          <text class="dialog-title" flatten>{{popupTitle}}</text>
        </view>
        <view class="dialog-close" @click="handleClose"
          <!-- #ifdef WEB -->
          tabindex="0"
          @keydown="onCloseKeydown"
          <!-- #endif -->
        >
          <view class="dialog-close-plus" data-id="close" flatten></view>
          <view class="dialog-close-plus dialog-close-rotate" data-id="close" flatten></view>
        </view>
      </view>
      <view class="dialog-body" @touchstart="onBodyTouchStart" @touchmove="onBodyTouchMove"
        @touchend="onTouchEnd" @touchcancel="onTouchEnd">
        <uni-data-picker-view ref="pickerView" v-bind="props" :in-data-picker="true" style="flex: 1;"
          @change="onpickerviewchange" @nodeclick="onpickerviewnodeclick" />
      </view>
    </view>
    </teleport>
  </view>
</template>

<script setup lang="ts">
  /**
   * DataPicker 级联选择
   * @description 通过本地数据或 datacom 数据的级联选择组件，支持单列和多列级联选择，列数没有限制，如果屏幕显示不全，顶部tab区域会左右滚动。
   * @uniPlatform {
   *   "app": {
   *     "android": {"unixVaporVer": "5.33"},
   *     "ios": {"unixVaporVer": "5.33"},
   *     "harmony": {"unixVaporVer": "5.33"}
   *   },
   *   "mp": {
   *     "weixin": {"unixVer": "5.33"},
   *     "alipay": {"unixVer": "5.33"}
   *   },
   *   "web": {"unixVer": "5.33"}
   * }
   */

  import { dataPickerProps, useDataPicker } from "../uni-data-picker-view/uni-data-picker.ts"

  /**
   * @tutorial https://ext.dcloud.net.cn/plugin?id=uni-data-picker-x
   * @property {String} popup-title 弹出窗口标题
   * @property {String} popup-class 弹出窗口自定义样式类名
   * @property {String} mask-class 遮罩层自定义样式类名
   * @property {String} cover-class 遮罩层自定义样式类名（已废弃，请使用 mask-class）
   * @property {Array} localdata 本地数据，参考
   * @property {Boolean} readonly = [true|false] 是否仅读
   * @property {Boolean} preload = [true|false] 是否预加载数据
   * @value true 开启预加载数据，点击弹出窗口后显示已加载数据
   * @value false 关闭预加载数据，点击弹出窗口后开始加载数据
   * @property {Boolean} step-searh = [true|false] 是否分布查询
   * @value true 启用分布查询，仅查询当前选中节点
   * @value false 关闭分布查询，一次查询出所有数据
   * @property {String|DBFieldString} self-field 分布查询当前字段名称
   * @property {String|DBFieldString} parent-field 分布查询父字段名称
   * @property {String|DBCollectionString} collection 表名
   * @property {String|DBFieldString} field 查询字段，多个字段用 `,` 分割
   * @property {String} orderby 排序字段及正序倒叙设置
   * @property {String|JQLString} where 查询条件
   * @event {Function} nodeclick 点击节点时触发此事件
   * @event {Function} change 选择结束后触发此事件
   * @event {Function} popupopened 弹出的选择窗口打开时触发此事件
   * @event {Function} popupclosed 弹出的选择窗口关闭时触发此事件
   */
  const props = defineProps({
    ...dataPickerProps,
    /**
     * @description 未选择时的占位文字
     * @default ""
     */
    placeholder: {
      type: String,
      default: ''
    },
    /**
     * @description 是否只读，只读时点击输入框仅触发 inputclick
     * @default false
     */
    readonly: {
      type: Boolean,
      default: false
    },
    /**
     * @description 多级已选值之间的分隔符
     * @default "/"
     */
    split: {
      type: String,
      default: '/'
    },
    /**
     * @description 已选文字是否省略
     * @default true
     */
    ellipsis: {
      type: Boolean,
      default: true
    },
    /**
     * @description 输入框容器的 external class
     * @default ""
     */
    inputClass: {
      type: String,
      default: ''
    },
    /**
     * @description 错误提示文字的 external class
     * @default ""
     */
    errorClass: {
      type: String,
      default: ''
    },
    /**
     * @description 弹出窗口标题
     * @default ""
     */
    popupTitle: {
      type: String,
      default: ''
    },
    /**
     * @description 弹出窗口的 external class
     * @default ""
     */
    popupClass: {
      type: String,
      default: ''
    },
    /**
     * @description 遮罩层的 external class
     * @default ""
     */
    maskClass: {
      type: String,
      default: ''
    },
    // 已废弃，请使用 mask-class，保留以兼容旧用法
    /**
     * @description 遮罩层的 external class（已废弃，请使用 maskClass）
     * @default ""
     */
    coverClass: {
      type: String,
      default: ''
    }
  })
  defineOptions({
    externalClasses: ['input-class', 'error-class', 'popup-class', 'mask-class', 'cover-class']
  })

  const dataPicker = useDataPicker(props)

  const maskClassValue = computed(() : string => {
    return props.maskClass || props.coverClass
  })

  const emit = defineEmits<{
    /**
     * @description 弹出选择窗口打开时触发
     */
    popupopened: [],
    /**
     * @description 弹出选择窗口关闭时触发
     */
    popupclosed: [],
    /**
     * @description 点击任意层级节点时触发
     * @param {Object} node 被点击的节点数据
     */
    nodeclick: [node: any],
    /**
     * @description 选择结束后触发
     * @param {Object} event 事件对象；event.detail.value 为已选节点数组
     */
    change: [event: any],
    /**
     * @description 输入值变化时触发
     * @param {Object} event 事件对象
     */
    input: [event: any],
    /**
     * @description 选中值变化时更新绑定值
     * @param {String} value 最后一级节点的值
     */
    'update:modelValue': [value: any],
    /**
     * @description 只读模式下点击输入框时触发
     * @param {Object} event 事件对象
     */
    inputclick: [event: any]
  }>()

  const isOpened = ref(false)
  const active = ref(false)
  // 当前是否处于宽屏下拉浮层模式：打开时确定，窗口尺寸跨阈值时更新
  const isWide = ref(false)
  const pickerView = ref<ComponentPublicInstance | null>(null)
  const coverRef = ref<UniElement | null>(null)
  // 宽屏下拉浮层需要测量触发区位置，这里引用输入框容器
  const anchorRef = ref<UniElement | null>(null)
  const dialogRef = ref<UniElement | null>(null)
  // 优先使用 CSS 锚点定位：滚动位移由浏览器原生处理，无需 JS 逐帧更新，也不会拦截页面滚动
  let webUseAnchorPositioning = false
  // #ifdef WEB
  webUseAnchorPositioning = typeof CSS != 'undefined'
    && CSS.supports('anchor-name', '--uni-data-picker')
    && CSS.supports('position-anchor', '--uni-data-picker')
    && CSS.supports('top', 'anchor(bottom)')
    && CSS.supports('width', 'anchor-size(width)')
  // #endif
  const webAnchorName = '--uni-data-picker-' + String(Math.floor(Math.random() * 1000000000))
  // 锚点仅宽屏下拉浮层且浏览器支持时绑定到触发区
  const anchorStyle = ref('')
  // 宽屏下拉浮层锚定矩形（px），不支持锚点定位时用作回退
  let wideLeft = 0
  let wideTop = 0
  let wideWidth = 0
  let wideReady = false
  // 锚定定位请求序号，用于丢弃过期的异步测量结果
  let positionRequestId = 0
  // 拖拽期间的位移，通过模板 :style 绑定下发，替代 element.style.setProperty（规避部分平台的兼容问题）
  const dialogStyle = ref('')
  // 拖拽期间禁用过渡。必须用 class 开关而不能写内联 transition-duration：
  // App 端同一属性被内联样式设置过后，再清空内联样式不会恢复 class 上的过渡，会导致后续关闭无动画
  const dragTransitionOff = ref(false)

  const POPUP_DURATION = 250
  const DRAG_CLOSE_THRESHOLD = 60
  let startY = 0
  let hasStart = false
  let dragging = false
  let animating = false
  let curOffset = 0
  let lastY = 0
  let lastY2 = 0

  // #ifndef WEB
  onBackPress(() => {
    if (isOpened.value) {
      hide()
      return true
    }
    return false
  })
  // #endif

  function load() {
    if (dataPicker.isLocalData) {
      dataPicker.loadLocalData()
    } else if (dataPicker.isCloudDataList || dataPicker.isCloudDataTree) {
      dataPicker.loadCloudDataPath()
    }
  }

  function resetDrag() {
    startY = 0
    hasStart = false
    dragging = false
    curOffset = 0
    lastY = 0
    lastY2 = 0
  }

  function getTouchY(touch : Touch) : number {
    if (touch.screenY > 0) {
      return touch.screenY
    }
    if (touch.clientY > 0) {
      return touch.clientY
    }
    return touch.pageY
  }

  function applyOffset(offset : number) {
    curOffset = offset
    // 宽屏下拉浮层不做拖拽位移，避免覆盖锚定定位
    if (isWide.value) {
      return
    }
    dialogStyle.value = 'transform: translateY(' + offset.toFixed(2) + 'px);'
  }

  // 清除拖拽期间写入的内联样式，交回 CSS 过渡动画
  function clearDragStyle() {
    dragTransitionOff.value = false
    // 宽屏下拉浮层需要保留锚定定位，只重建定位样式
    if (isWide.value) {
      buildDialogStyle()
      return
    }
    dialogStyle.value = ''
  }

  // 不支持 CSS 锚点定位时的回退：根据触发区矩形计算位置，贴在触发区下方 4px，下方空间不足时翻到上方
  function applyWideRect(rect : DOMRect | null) {
    const windowInfo = uni.getWindowInfo()
    const gap = 4
    const minHeight = 150
    let left = 0
    let width = windowInfo.windowWidth
    let top = 0
    if (rect != null) {
      left = rect.left
      width = rect.width
      top = rect.bottom + gap
      if (top + minHeight > windowInfo.windowHeight && rect.top - gap - minHeight >= gap) {
        top = rect.top - gap - minHeight
      }
    }
    wideLeft = left
    wideWidth = width
    wideTop = top
    wideReady = true
    buildDialogStyle()
  }

  // 宽屏下拉浮层的定位样式：优先使用 CSS 锚点定位（滚动时由浏览器原生跟随，不依赖 JS）
  function buildDialogStyle() {
    // #ifdef WEB
    if (isWide.value) {
      if (webUseAnchorPositioning) {
        dialogStyle.value = 'position: fixed; position-anchor: ' + webAnchorName +
          '; left: anchor(left); top: calc(anchor(bottom) + 4px); width: anchor-size(width); transform: translateY(0);'
        return
      }
      if (wideReady) {
        dialogStyle.value = 'position: fixed; left: ' + wideLeft.toFixed(2) + 'px; top: ' + wideTop.toFixed(2) +
          'px; width: ' + wideWidth.toFixed(2) + 'px; transform: translateY(0);'
        return
      }
    }
    // #endif
    dialogStyle.value = ''
  }

  function openPickerView() {
    if (pickerView.value != null) {
      pickerView.value!.loadData(dataPicker.selectedPaths)
    }
  }

  // 宽屏下拉浮层：直接显示，无过渡动画
  function openPopupNow() {
    buildDialogStyle()
    isOpened.value = true
    nextTick(() => {
      openPickerView()
      active.value = true
      // #ifdef WEB
      startResizeWatch()
      startScrollFollow()
      startWideOutside()
      // #endif
      emit('popupopened')
    })
  }

  // #ifdef WEB
  // 宽屏下拉浮层跟随：锚点定位时滚动位移由浏览器原生处理；回退方案下重新测量坐标
  let wideFollowRafId = 0
  let wideResizeActive = false
  let wideScrollActive = false

  function repositionWide() {
    if (!isOpened.value || !isWide.value) {
      return
    }
    const requestId = positionRequestId + 1
    positionRequestId = requestId
    const element = anchorRef.value
    if (element == null) {
      return
    }
    const rectPromise = element.getBoundingClientRectAsync()
    if (rectPromise == null) {
      return
    }
    rectPromise.then((rect : DOMRect) => {
      if (requestId != positionRequestId || !isOpened.value) {
        return
      }
      applyWideRect(rect)
    })
  }

  // 从宽屏下拉浮层切换为窄屏底部弹层，保持打开，避免窗口缩小时弹层直接消失
  function switchToNarrowSheet() {
    isWide.value = false
    anchorStyle.value = ''
    dialogStyle.value = ''
    stopScrollFollow()
    stopWideOutside()
    if (isOpened.value) {
      active.value = true
    }
  }

  // 从窄屏底部弹层切换为宽屏下拉浮层，保持打开，避免窗口变宽后弹层错位
  function switchToWidePopup() {
    isWide.value = true
    if (webUseAnchorPositioning) {
      anchorStyle.value = 'anchor-name: ' + webAnchorName + ';'
      wideReady = true
      buildDialogStyle()
    } else {
      repositionWide()
    }
    startScrollFollow()
    startWideOutside()
    if (isOpened.value) {
      active.value = true
    }
  }

  function onWideViewportChange() {
    if (!isOpened.value) {
      return
    }
    const wide = isWideScreenPopup()
    if (wide != isWide.value) {
      // 窗口跨过宽/窄屏阈值：在浮层与底部弹层之间切换，保持打开
      if (wide) {
        switchToWidePopup()
      } else {
        switchToNarrowSheet()
      }
      return
    }
    // 形态未变：宽屏回退方案在滚动/尺寸变化后重新测量坐标
    if (wide && !webUseAnchorPositioning) {
      if (wideFollowRafId != 0) {
        return
      }
      wideFollowRafId = requestAnimationFrame(() => {
        wideFollowRafId = 0
        repositionWide()
      })
    }
  }

  // 尺寸监听在打开期间常驻，用于宽/窄屏形态切换
  function startResizeWatch() {
    if (wideResizeActive) {
      return
    }
    wideResizeActive = true
    window.addEventListener('resize', onWideViewportChange)
  }

  function stopResizeWatch() {
    if (!wideResizeActive) {
      return
    }
    wideResizeActive = false
    window.removeEventListener('resize', onWideViewportChange)
  }

  // 回退方案下的滚动跟随（锚点定位可用时由浏览器原生处理，无需监听）
  function startScrollFollow() {
    if (wideScrollActive || webUseAnchorPositioning) {
      return
    }
    wideScrollActive = true
    window.addEventListener('scroll', onWideViewportChange, true)
  }

  function stopScrollFollow() {
    if (!wideScrollActive) {
      return
    }
    wideScrollActive = false
    window.removeEventListener('scroll', onWideViewportChange, true)
    if (wideFollowRafId != 0) {
      cancelAnimationFrame(wideFollowRafId)
      wideFollowRafId = 0
    }
  }

  // 宽屏不铺设遮罩：点击浮层与触发区之外时关闭，不阻止页面滚动
  let wideOutsideActive = false

  function isWebEventInside(event : Event, element : UniElement | null) : boolean {
    return element instanceof Node && event.target instanceof Node && element.contains(event.target)
  }

  function onWideOutsideClick(event : Event) {
    if (!isOpened.value || !isWide.value) {
      return
    }
    if (!isWebEventInside(event, anchorRef.value) && !isWebEventInside(event, dialogRef.value)) {
      hide()
    }
  }

  function startWideOutside() {
    if (wideOutsideActive) {
      return
    }
    wideOutsideActive = true
    document.addEventListener('click', onWideOutsideClick, true)
  }

  function stopWideOutside() {
    if (!wideOutsideActive) {
      return
    }
    wideOutsideActive = false
    document.removeEventListener('click', onWideOutsideClick, true)
  }

  onUnmounted(() => {
    stopResizeWatch()
    stopScrollFollow()
    stopWideOutside()
  })
  // #endif

  // 宽屏打开：优先用 CSS 锚点定位直接展示；回退方案先异步测量，避免弹层错位
  function openWide() {
    if (webUseAnchorPositioning) {
      wideReady = true
      // 等 anchor-name 渲染到触发区后再显示，保证 position-anchor 能解析
      nextTick(() => {
        openPopupNow()
      })
      return
    }
    const requestId = positionRequestId + 1
    positionRequestId = requestId
    const element = anchorRef.value
    if (element != null) {
      const rectPromise = element.getBoundingClientRectAsync()
      if (rectPromise != null) {
        rectPromise.then((rect : DOMRect) => {
          if (requestId != positionRequestId || isOpened.value) {
            return
          }
          applyWideRect(rect)
          openPopupNow()
        })
        return
      }
    }
    applyWideRect(null)
    openPopupNow()
  }

  // 打开：窄屏从底部弹出（纯 CSS 过渡动画），宽屏为下拉浮层
  function show() {
    if (isOpened.value) {
      return
    }
    resetDrag()
    // #ifdef WEB
    if (isWideScreenPopup()) {
      isWide.value = true
      if (webUseAnchorPositioning) {
        anchorStyle.value = 'anchor-name: ' + webAnchorName + ';'
      }
      openWide()
      return
    }
    // #endif
    isWide.value = false
    anchorStyle.value = ''
    // #ifdef WEB
    // 窄屏打开时也监听尺寸，窗口变宽时切换为下拉浮层
    startResizeWatch()
    // #endif
    isOpened.value = true
    nextTick(() => {
      openPickerView()
      animating = true
      // 等首帧渲染完成后再切换 active，触发 CSS 过渡
      setTimeout(() => {
        if (!isOpened.value) {
          animating = false
          return
        }
        active.value = true
        setTimeout(() => {
          animating = false
        }, POPUP_DURATION)
      }, 20)
    })
    emit('popupopened')
  }

  // 关闭：纯 CSS 过渡动画，动画结束后再卸载
  function hide() {
    if (!isOpened.value || !active.value) {
      return
    }
    positionRequestId += 1
    animating = true
    // 先在切换 active 之前清除拖拽期间的过渡禁用状态，保证关闭时用 CSS 的 250ms 过渡
    clearDragStyle()
    active.value = false

    // 宽屏无动画，立即卸载；否则等过渡动画结束
    const delay = isWide.value ? 0 : POPUP_DURATION + 50
    setTimeout(() => {
      animating = false
      resetDrag()
      wideReady = false
      dialogStyle.value = ''
      anchorStyle.value = ''
      // #ifdef WEB
      stopResizeWatch()
      stopScrollFollow()
      stopWideOutside()
      // #endif
      isOpened.value = false
      emit('popupclosed')
    }, delay)
  }

  // 松手未达关闭阈值：清除内联样式，由 CSS 过渡回弹到原位
  function resume() {
    clearDragStyle()
    dragging = false
    curOffset = 0
  }

  function getListScrollTop() : number {
    const inst = pickerView.value
    if (inst == null) {
      return 0
    }
    return inst.getScrollTop()
  }

  // 与 Web 宽屏媒体查询（min-width: 768px）保持一致，宽屏下无过渡动画
  function isWideScreenPopup() : boolean {
    // #ifdef WEB
    return uni.getWindowInfo().windowWidth >= 768
    // #endif
    // #ifndef WEB
    return false
    // #endif
  }

  function onTitleTouchStart(_e : TouchEvent) {
    if (animating) {
      return
    }
    resetDrag()
    dragTransitionOff.value = true
  }

  function onBodyTouchStart(e : TouchEvent) {
    onTitleTouchStart(e)
  }

  // 拖拽处理：allowDrag 为 true（标题栏）时不校验内部滚动位置
  function handleDragMove(touchY : number, allowDrag : boolean) {
    if (animating) {
      return
    }
    lastY2 = lastY
    lastY = touchY
    if (!allowDrag) {
      // 内部列表未滚动到顶部时不接管手势
      if (getListScrollTop() > 0.01 && !dragging) {
        return
      }
    }
    if (!hasStart) {
      startY = touchY
      hasStart = true
    }
    const offset = touchY - startY
    if (offset > 0) {
      dragging = true
      applyOffset(offset)
    } else if (curOffset > 0) {
      let back = startY - touchY
      if (back > curOffset) {
        back = 0
        dragging = false
      }
      applyOffset(back)
    }
  }

  function onTitleTouchMove(e : TouchEvent) {
    if (animating) {
      return
    }
    handleDragMove(getTouchY(e.touches[0]), true)
    // #ifdef WEB
    if (dragging) {
      e.preventDefault()
    }
    // #endif
  }

  function onBodyTouchMove(e : TouchEvent) {
    if (animating) {
      return
    }
    handleDragMove(getTouchY(e.touches[0]), false)
    // #ifdef WEB
    if (dragging) {
      e.preventDefault()
    }
    // #endif
  }

  function onTouchEnd(_e : TouchEvent) {
    if (animating) {
      return
    }
    if (!dragging && curOffset <= 0) {
      clearDragStyle()
      resetDrag()
      return
    }
    // 拖动超过阈值，或快速下滑动量，则关闭
    let shouldClose = curOffset > DRAG_CLOSE_THRESHOLD
    if (!shouldClose) {
      shouldClose = curOffset > 0 && (lastY - lastY2) > 3
    }
    if (shouldClose) {
      hide()
    } else if (curOffset > 0) {
      resume()
    } else {
      clearDragStyle()
      resetDrag()
    }
  }

  function handleInput() {
    if (props.readonly) {
      emit('inputclick')
      return
    }
    // 宽屏下拉浮层：再次点击触发区收起
    if (isWide.value && isOpened.value) {
      hide()
      return
    }
    show()
  }

  function handleClose() {
    hide()
  }

  // #ifdef WEB
  function onInputKeydown(event : KeyboardEvent) {
    const key = event.key as string
    if (isOpened.value && key == 'Escape') {
      event.preventDefault()
      hide()
      return
    }
    if (!isOpened.value && (key == 'Enter' || key == ' ' || key == 'ArrowDown')) {
      event.preventDefault()
      handleInput()
    }
  }

  // 弹窗内的 Esc 关闭；焦点位于列表项时也会冒泡到这里
  function onDialogKeydown(event : KeyboardEvent) {
    if (event.key == 'Escape') {
      event.preventDefault()
      hide()
    }
  }

  function onCloseKeydown(event : KeyboardEvent) {
    const key = event.key as string
    if (key == 'Enter' || key == ' ') {
      event.preventDefault()
      hide()
    }
  }
  // #endif

  const onpickerviewchange = (e : any) => {
    dataPicker.selectedPaths = e.detail.value
    const nodes = e.detail.value as Array<Record<string, any>>
    if (nodes.length > 0) {
      emit('update:modelValue', nodes[nodes.length - 1][dataPicker.mappingValueName])
    }
    emit('change', e)
    hide()
  }

  const onpickerviewnodeclick = (e : any) => {
    emit('nodeclick', e)
  }

  load()
</script>

<style>
  @import url("uni-data-picker.css");
</style>
