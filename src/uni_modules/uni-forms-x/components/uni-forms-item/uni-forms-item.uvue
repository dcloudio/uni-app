		margin-top: 10px;
		background-color: var(--divider-color, #e5e5e5);
	}

	.uni-forms-item--border {
		border-bottom-width: 0.5px;
		border-bottom-style: solid;
		border-bottom-color: var(--divider-color, #e5e5e5);
		padding-top: 10px;
		padding-bottom: 10px;
	}

	.uni-forms-item--error {
		margin-top: 6px;
		margin-bottom: 6px;
		padding-top: 10px;
		padding-right: 8px;
		padding-bottom: 10px;
		padding-left: 8px;
		border-radius: 8px;
		/* 浅色默认浅红底。暗黑模式由主题变量或下面的媒体查询换成深色底，避免白字贴在浅粉底上。 */
		background-color: var(--forms-error-background-color, #fff2f0);
		border-top-width: 1px;
		border-right-width: 1px;
		border-bottom-width: 1px;
		border-left-width: 1px;
		border-top-style: solid;
		border-right-style: solid;
		border-bottom-style: solid;
		border-left-style: solid;
		border-top-color: #ff4d4f;
		border-right-color: #ff4d4f;
		border-bottom-color: #ff4d4f;
		border-left-color: #ff4d4f;
	}

	/* 宿主没提供主题变量时，系统暗色仍使用深色错误底。 */
	@media (prefers-color-scheme: dark) {
		.uni-forms-item--error {
			background-color: var(--forms-error-background-color, #3a1a1c);
		}
	}
</style>
