  /**
   * 开始监听罗盘数据
   * 
   * @tutorial https://doc.dcloud.net.cn/uni-app-x/api/compass.html#startcompass
   * @tutorial_uni_app https://uniapp.dcloud.net.cn/api/system/compass.html#startcompass
   * @tutorial_uni_app_x https://doc.dcloud.net.cn/uni-app-x/api/compass.html#startcompass
   *
   * @uniPlatform {
   * 	"app": {
   * 		"android": {
   * 			"osVer": "5.0",
   * 			"uniVer": "5.08",
   * 			"unixVer": "5.08"
   * 		},
   * 		"ios": {
   * 			"osVer": "12.0",
   * 			"uniVer": "5.08",
   * 			"unixVer": "5.08"
   * 		},
   *    "harmony": {
   *      "osVer": "5.0.0",
   *      "uniVer": "5.08",
   *      "unixVer": "5.08",
