export type Convert2AbsFullPath = (inputPath: string) => string

export interface Uni {
  /**
   * 将文件的项目相对地址转换为 运行期对应的绝对地址
   * @tutorial_uni_app_x https://doc.dcloud.net.cn/uni-app-x/api/convert2-abs-full-path.html
   * @tutorial https://doc.dcloud.net.cn/uni-app-x/api/convert2-abs-full-path.html
   * @uniPlatform {
   *  "app": {
   *    "android": {
   *      "uniVer": "x",
   *      "unixVer": "5.32",
   *      "unixVaporVer": "5.32"
   *    },
   *    "ios": {
   *      "uniVer": "x",
   *      "unixVer": "5.32",
   *      "unixVaporVer": "5.32"
   *    },
   *    "harmony": {
   *      "uniVer": "x",
   *      "unixVer": "5.32",
   *      "unixVaporVer": "5.32"
   *    }
   *  }
   * }
   * @example
    ```typescript
      uni.convert2AbsFullPath('/static/logo.png')
    ```
   */
  convert2AbsFullPath: (inputPath: string) => string
}
