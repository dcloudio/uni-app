const runtime = BluetoothRuntime.shared()

function createFail(api: BluetoothApiName, error: Error): BluetoothFailImpl {
  if (error instanceof BluetoothRuntimeError) {
    const cause = new SourceError(error.message)
    cause.subject = 'HarmonyBluetooth'
    cause.code = error.platformCode
    const result = new BluetoothFailImpl(api, error.uniCode as UniBluetoothErrorCode, cause)
    result.data = { phase: error.phase, platformCode: error.platformCode }
    if (error.authResult != null) {
      result.data!['authResult'] = error.authResult
    }
    if (error.permissionErrorReason != null) {
      result.data!['permissionErrorReason'] = error.permissionErrorReason
    }
    return result
  }
  const cause = new SourceError(error.message)
  cause.subject = 'HarmonyBluetooth'
  // 系统异常已在 Port 中分类；未分类的普通异常按内部 BLE 错误兜底。
  return new BluetoothFailImpl(api, 1509000, cause)
}

function finishOpen(options: OpenBluetoothAdapterOptions, error: Error | null): void {
  try {
    if (error == null) {
      const result: OpenBluetoothAdapterSuccess = { errMsg: 'openBluetoothAdapter:ok' }
      try {
        options.success?.(result)
      } finally {
        options.complete?.(result)
      }
    } else {
      const fail = createFail('openBluetoothAdapter', error)
      try {
        options.fail?.(fail)
      } finally {
        options.complete?.(fail)
      }
    }
  } catch (_) {
    // 业务回调异常不得阻断后续回调或清理。
  }
}

export const openBluetoothAdapter: OpenBluetoothAdapter = function (
  options: OpenBluetoothAdapterOptions
): void {
  try {
    const context = UTSHarmony.getUIAbilityContext()
    runtime.open(context).then(
      (): void => {
        finishOpen(options, null)
      },
      (error: Error): void => {
        finishOpen(options, error)
      }
    )
  } catch (error) {
    finishOpen(options, error as Error)
  }
}

export const closeBluetoothAdapter: CloseBluetoothAdapter = function (
  options: CloseBluetoothAdapterOptions
): void {
  runtime.close().then(
    (): void => {
      const result: CloseBluetoothAdapterSuccess = { errMsg: 'closeBluetoothAdapter:ok' }
      try {
        try {
          options.success?.(result)
        } finally {
          options.complete?.(result)
        }
      } catch (_) {
        // 业务回调异常不得阻断后续回调或清理。
      }
    },
    (error: Error): void => {
      const fail = createFail('closeBluetoothAdapter', error)
      try {
        try {
          options.fail?.(fail)
        } finally {
          options.complete?.(fail)
        }
      } catch (_) {
        // 业务回调异常不得阻断后续回调或清理。
      }
    }
  )
}

export const getBluetoothAdapterState: GetBluetoothAdapterState = function (
  options: GetBluetoothAdapterStateOptions
): void {
  runtime.getAdapterState().then(
    (state: AdapterSnapshot): void => {
      const result: GetBluetoothAdapterStateSuccess = {
        errMsg: 'getBluetoothAdapterState:ok',
        available: state.available,
        discovering: state.discovering
      }
      try {
        try {
          options.success?.(result)
        } finally {
          options.complete?.(result)
        }
      } catch (_) {
        // 业务回调异常不得阻断后续回调或清理。
      }
    },
    (error: Error): void => {
      const fail = createFail('getBluetoothAdapterState', error)
      try {
        try {
          options.fail?.(fail)
        } finally {
          options.complete?.(fail)
        }
      } catch (_) {
        // 业务回调异常不得阻断后续回调或清理。
      }
    }
  )
}

export const onBluetoothAdapterStateChange: OnBluetoothAdapterStateChange = function (
  listener: BluetoothAdapterStateChangeCallback
): number {
  // 保存原函数身份，off(callback) 才能精确移除，不创建包装回调。
  return runtime.addAdapterListener(listener)
}

export const offBluetoothAdapterStateChange: OffBluetoothAdapterStateChange = function (
  listener?: number | BluetoothAdapterStateChangeCallback | null
): void {
  runtime.removeAdapterListener(listener ?? null)
}
function succeed<T>(
  result: T,
  success: ((result: T) => void) | null,
  complete: ((result: T | BluetoothFail) => void) | null
): void {
  try {
    try {
      success?.(result)
    } finally {
      complete?.(result)
    }
  } catch (_) {
    // 业务回调异常不得阻断后续回调或清理。
  }
}

function failed<T>(
  api: BluetoothApiName,
  error: Error,
  fail: ((error: BluetoothFail) => void) | null,
  complete: ((result: T | BluetoothFail) => void) | null
): void {
  const result = createFail(api, error)
  try {
    try {
      fail?.(result)
    } finally {
      complete?.(result)
    }
  } catch (_) {
    // 业务回调异常不得阻断后续回调或清理。
  }
}

function deviceResult(device: DeviceSnapshot): BluetoothDevice {
  const data = new UTSJSONObject()
  device.serviceData.forEach((value: ArrayBuffer, key: string): void => {
    data[key] = value
  })
  return {
    name: device.name,
    deviceId: device.deviceId,
    RSSI: device.RSSI,
    advertisData: device.advertisData,
    advertisServiceUUIDs: device.advertisServiceUUIDs,
    localName: device.localName,
    serviceData: data,
    connectable: device.connectable
  }
}

export const startBluetoothDevicesDiscovery: StartBluetoothDevicesDiscovery = function (
  options: StartBluetoothDevicesDiscoveryOptions
): void {
  runtime
    .startDiscovery(
      options.services ?? [],
      options.allowDuplicatesKey ?? false,
      options.interval ?? 0,
      options.powerLevel ?? 'medium'
    )
    .then(
      (): void => {
        const result: StartBluetoothDevicesDiscoverySuccess = {
          errMsg: 'startBluetoothDevicesDiscovery:ok'
        }
        succeed<StartBluetoothDevicesDiscoverySuccess>(
          result,
          options.success ?? null,
          options.complete ?? null
        )
      },
      (error: Error): void => {
        failed<StartBluetoothDevicesDiscoverySuccess>(
          'startBluetoothDevicesDiscovery',
          error,
          options.fail ?? null,
          options.complete ?? null
        )
      }
    )
}

export const stopBluetoothDevicesDiscovery: StopBluetoothDevicesDiscovery = function (
  options: StopBluetoothDevicesDiscoveryOptions
): void {
  runtime.stopDiscovery().then(
    (): void => {
      const result: StopBluetoothDevicesDiscoverySuccess = {
        errMsg: 'stopBluetoothDevicesDiscovery:ok'
      }
      succeed<StopBluetoothDevicesDiscoverySuccess>(
        result,
        options.success ?? null,
        options.complete ?? null
      )
    },
    (error: Error): void => {
      failed<StopBluetoothDevicesDiscoverySuccess>(
        'stopBluetoothDevicesDiscovery',
        error,
        options.fail ?? null,
        options.complete ?? null
      )
    }
  )
}

export const getBluetoothDevices: GetBluetoothDevices = function (
  options: GetBluetoothDevicesOptions
): void {
  runtime.getDevices().then(
    (devices: DeviceSnapshot[]): void => {
      const result: GetBluetoothDevicesSuccess = {
        errMsg: 'getBluetoothDevices:ok',
        devices: devices.map((device: DeviceSnapshot): BluetoothDevice => deviceResult(device))
      }
      succeed<GetBluetoothDevicesSuccess>(result, options.success ?? null, options.complete ?? null)
    },
    (error: Error): void => {
      failed<GetBluetoothDevicesSuccess>(
        'getBluetoothDevices',
        error,
        options.fail ?? null,
        options.complete ?? null
      )
    }
  )
}

