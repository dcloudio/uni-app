export const getBLEDeviceCharacteristics: GetBLEDeviceCharacteristics = function (
  options: GetBLEDeviceCharacteristicsOptions
): void {
  runtime.getCharacteristics(options.deviceId, options.serviceId).then(
    (characteristics: CharacteristicSnapshot[]): void => {
      const result: GetBLEDeviceCharacteristicsSuccess = {
        errMsg: 'getBLEDeviceCharacteristics:ok',
        characteristics: characteristics.map(
          (characteristic: CharacteristicSnapshot): BLECharacteristic => {
            return {
              uuid: characteristic.uuid,
              properties: {
                read: characteristic.properties.read,
                write: characteristic.properties.write,
                writeNoResponse: characteristic.properties.writeNoResponse,
                writeDefault: characteristic.properties.writeDefault,
                notify: characteristic.properties.notify,
                indicate: characteristic.properties.indicate
              }
            }
          }
        )
      }
      succeed<GetBLEDeviceCharacteristicsSuccess>(
        result,
        options.success ?? null,
        options.complete ?? null
      )
    },
    (error: Error): void => {
      failed<GetBLEDeviceCharacteristicsSuccess>(
        'getBLEDeviceCharacteristics',
        error,
        options.fail ?? null,
        options.complete ?? null
      )
    }
  )
}

