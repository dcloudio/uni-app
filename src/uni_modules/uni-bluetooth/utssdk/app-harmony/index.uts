const deviceCallbacks = new Map<number, BluetoothDeviceFoundCallback>()

export const onBluetoothDeviceFound: OnBluetoothDeviceFound = function (
  listener: BluetoothDeviceFoundCallback
): number {
  const token = runtime.addDeviceListener((event: DeviceFoundEvent): void => {
    const result: BluetoothDeviceFoundResult = {
      devices: event.devices.map((device: DeviceSnapshot): BluetoothDevice => deviceResult(device))
    }
    listener(result)
  })
  deviceCallbacks.set(token, listener)
  return token
}
export const offBluetoothDeviceFound: OffBluetoothDeviceFound = function (
  listener?: number | BluetoothDeviceFoundCallback | null
): void {
  if (listener == null) {
    runtime.removeDeviceListener()
    deviceCallbacks.clear()
  } else if (typeof listener == 'number') {
    runtime.removeDeviceListener(listener)
    deviceCallbacks.delete(listener)
  } else {
    deviceCallbacks.forEach((registered: BluetoothDeviceFoundCallback, token: number): void => {
      if (registered === listener) {
        runtime.removeDeviceListener(token)
        deviceCallbacks.delete(token)
      }
    })
  }
}

export const onBLEMTUChange: OnBLEMTUChange = function (listener: BLEMTUChangeCallback): number {
  return runtime.addMtuListener(listener)
}
export const offBLEMTUChange: OffBLEMTUChange = function (
  listener?: number | BLEMTUChangeCallback | null
): void {
  runtime.removeMtuListener(listener ?? null)
}

