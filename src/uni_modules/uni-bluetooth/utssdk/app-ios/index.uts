export const getBLEDeviceServices : GetBLEDeviceServices = function (options : GetBLEDeviceServicesOptions) : void {
	BluetoothUTSAdapterBridge.shared.getDeviceServices(deviceId = options.deviceId, success = (services : BluetoothUTSServiceSnapshot[]) : void => {
		const result : GetBLEDeviceServicesSuccess = {
			errMsg: 'getBLEDeviceServices:ok',
			services: services.map((service : BluetoothUTSServiceSnapshot) : BLEService => {
