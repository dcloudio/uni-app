		options.fail?.(fail)
		options.complete?.(fail)
	})
}

export const getBLEDeviceRSSI : GetBLEDeviceRSSI = function (options : GetBLEDeviceRSSIOptions) : void {
	BluetoothUTSAdapterBridge.shared.getDeviceRSSI(deviceId = options.deviceId, success = (rssi : Int) : void => {
		const result : GetBLEDeviceRSSISuccess = {
			errMsg: 'getBLEDeviceRSSI:ok',
			RSSI: Number.from(rssi)
		}
		options.success?.(result)
		options.complete?.(result)
	}, failure = (errorCode : Int, state : Int, reason : string) : void => {
		const fail = createIOSBluetoothFail('getBLEDeviceRSSI', Number.from(errorCode) as UniBluetoothErrorCode, Number.from(state), reason)
		options.fail?.(fail)
		options.complete?.(fail)
	})
}

export const getBLEDeviceCharacteristics : GetBLEDeviceCharacteristics = function (options : GetBLEDeviceCharacteristicsOptions) : void {
	BluetoothUTSAdapterBridge.shared.getDeviceCharacteristics(deviceId = options.deviceId, serviceId = options.serviceId, success = (characteristics : BluetoothUTSCharacteristicSnapshot[]) : void => {
		const result : GetBLEDeviceCharacteristicsSuccess = {
			errMsg: 'getBLEDeviceCharacteristics:ok',
			characteristics: characteristics.map((characteristic : BluetoothUTSCharacteristicSnapshot) : BLECharacteristic => {
				return {
					uuid: characteristic.uuid,
					properties: {
						read: characteristic.read,
						write: characteristic.write,
						notify: characteristic.notify,
						indicate: characteristic.indicate,
						writeNoResponse: characteristic.writeNoResponse,
						writeDefault: characteristic.writeDefault
					}
				}
			})
		}
		options.success?.(result)
		options.complete?.(result)
	}, failure = (errorCode : Int, state : Int, reason : string) : void => {
		const fail = createIOSBluetoothFail('getBLEDeviceCharacteristics', Number.from(errorCode) as UniBluetoothErrorCode, Number.from(state), reason)
		options.fail?.(fail)
		options.complete?.(fail)
	})
}

@UTSiOS.keyword("private")
function ensureNativeConnectionListener() : void {
	if (nativeConnectionListenerToken != null) {
		return
	}
	nativeConnectionListenerToken = BluetoothUTSAdapterBridge.shared.addConnectionListener((deviceId : string, state : string) : void => {
		if (state != 'connected' && state != 'disconnected') {
			return
		}
		const result : BLEConnectionStateChangeResult = {
			deviceId: deviceId,
			connected: state == 'connected'
		}
		bleConnectionStateChangeCallbacks.forEach((callback : BLEConnectionStateChangeCallback, _id : number) : void => {
			callback(result)
		})
	})
}

@UTSiOS.keyword("private")
function removeNativeConnectionListener() : void {
	if (nativeConnectionListenerToken == null) {
		return
	}
	BluetoothUTSAdapterBridge.shared.removeConnectionListener(nativeConnectionListenerToken)
	nativeConnectionListenerToken = null
}

@UTSiOS.keyword("private")
function ensureNativeCharacteristicValueListener() : void {
	if (nativeCharacteristicValueListenerToken != null) {
		return
	}
	nativeCharacteristicValueListenerToken = BluetoothUTSAdapterBridge.shared.addCharacteristicValueListener((event : BluetoothUTSCharacteristicValueSnapshot) : void => {
		const result : BLECharacteristicValueChangeResult = {
			deviceId: event.deviceId,
			serviceId: event.serviceId,
			characteristicId: event.characteristicId,
			value: event.value
		}
		bleCharacteristicValueChangeCallbacks.forEach((callback : BLECharacteristicValueChangeCallback, _id : number) : void => {
			callback(result)
		})
	})
}

@UTSiOS.keyword("private")
function removeNativeCharacteristicValueListener() : void {
	if (nativeCharacteristicValueListenerToken == null) {
		return
	}
	BluetoothUTSAdapterBridge.shared.removeCharacteristicValueListener(nativeCharacteristicValueListenerToken)
	nativeCharacteristicValueListenerToken = null
}

export const createBLEConnection : CreateBLEConnection = function (options : CreateBLEConnectionOptions) : void {
	const connectionTimeoutMilliseconds : Int | null = options.timeout == null ? null : options.timeout!.toInt()
	BluetoothUTSAdapterBridge.shared.connect(deviceId = options.deviceId, timeoutMilliseconds = connectionTimeoutMilliseconds, success = () : void => {
		const result : BLEOperationSuccess = {
			errMsg: 'createBLEConnection:ok'
		}
		options.success?.(result)
		options.complete?.(result)
	}, failure = (errorCode : Int, state : Int, reason : string) : void => {
		// 对已连接设备重复连接按幂等成功处理（与微信一致，实测 iOS 亦为成功）。
		if (errorCode == 1509007) {
			const result : BLEOperationSuccess = {
				errMsg: 'createBLEConnection:ok'
			}
			options.success?.(result)
			options.complete?.(result)
			return
		}
		const fail = createIOSBluetoothFail('createBLEConnection', Number.from(errorCode) as UniBluetoothErrorCode, Number.from(state), reason)
		options.fail?.(fail)
		options.complete?.(fail)
	})
}

export const closeBLEConnection : CloseBLEConnection = function (options : CloseBLEConnectionOptions) : void {
	BluetoothUTSAdapterBridge.shared.disconnect(deviceId = options.deviceId, success = () : void => {
		const result : BLEOperationSuccess = {
			errMsg: 'closeBLEConnection:ok'
		}
		options.success?.(result)
		options.complete?.(result)
	}, failure = (errorCode : Int, state : Int, reason : string) : void => {
		const fail = createIOSBluetoothFail('closeBLEConnection', Number.from(errorCode) as UniBluetoothErrorCode, Number.from(state), reason)
		options.fail?.(fail)
		options.complete?.(fail)
	})
}