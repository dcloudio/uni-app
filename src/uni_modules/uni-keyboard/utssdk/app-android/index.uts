import {
	HideKeyboard, HideKeyboardOptions, HideKeyboardSuccess,
	OffKeyboardHeightChange, OnKeyboardHeightChange, OnKeyboardHeightChangeCallback, OnKeyboardHeightChangeCallbackResult,
	OnKeyboardAnimationChange, OnKeyboardAnimationChangeCallback, OnKeyboardAnimationChangeCallbackResult, OffKeyboardAnimationChange
} from "../interface.uts"
import { KeyboardAnimationNative } from "uts.sdk.modules.uniKeyboard"
import InputMethodManager from 'android.view.inputmethod.InputMethodManager';
import ViewTreeObserver from "android.view.ViewTreeObserver";
import View from 'android.view.View';
import ViewParent from 'android.view.ViewParent';
import Activity from 'android.app.Activity';
import Context from 'android.content.Context';
import WebView from 'android.webkit.WebView';
import ViewCompat from 'androidx.core.view.ViewCompat';
import WindowInsetsCompat from 'androidx.core.view.WindowInsetsCompat';
import Build from 'android.os.Build';

let inputManager : InputMethodManager | null = null

let index = 0

let keyBoardChangeListeerMaps : HashMap<number, OnKeyboardHeightChangeCallback> = new HashMap()

var listener : OnKeyBoardChangedListener | null = null

function isWebViewRelatedFocusView(view : View) : boolean {
	if (view instanceof WebView) {
		return true
	}

	let parent : ViewParent | null = view.getParent()
	while (parent != null) {
		if (parent instanceof WebView) {
			return true
		}
		if (!(parent instanceof View)) {
			return false
		}
		parent = (parent as View).getParent()
	}

	return false
}

export const hideKeyboard : HideKeyboard = (options ?: HideKeyboardOptions | null) => {
	var activity : Activity | null = UTSAndroid.getUniActivity()
	if (activity != null) {
		if (inputManager == null) {
			inputManager = activity!.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
		}
		let focusView = activity!.getCurrentFocus()
		if (focusView != null) {
			focusView!.postDelayed(class implements Runnable {
				override run() {
					let shouldClearFocus = !isWebViewRelatedFocusView(focusView!)
					let result = inputManager!.hideSoftInputFromWindow(focusView!.getWindowToken(), 0)
					if (result && shouldClearFocus) {
						focusView!.clearFocus()
					}
				}
			}, 16)
		}
	}
	var success : HideKeyboardSuccess = {}
	options?.success?.(success)
	options?.complete?.(success)
}

export const onKeyboardHeightChange : OnKeyboardHeightChange = function (callback : OnKeyboardHeightChangeCallback) : number {
	if (listener == null) {
		listener = new OnKeyBoardChangedListener(keyBoardChangeListeerMaps)
	}
	index++;
	keyBoardChangeListeerMaps[index] = callback
	listener!.watch()
	return index;
}

export const offKeyboardHeightChange : OffKeyboardHeightChange = function (id : number | null) {
	if (id == null) {
		keyBoardChangeListeerMaps.clear()
		listener?.unwatch()
	} else {
		keyBoardChangeListeerMaps.remove(id)
		if (keyBoardChangeListeerMaps.isEmpty()) {
			listener?.unwatch()
		}
	}
}

let animationCallbacks : Array<OnKeyboardAnimationChangeCallback> = []

let animationListenerRegistered = false

// 动画监听专用的 Activity 生命周期回调（仅注册一次），保证 Activity 重建后能重绑动画监听
let animationLifecycleCallback : KeyboardAnimationLifeCycleCallback | null = null

// 当前页面是否配置了 androidThreeButtonNavigationTranslucent（内容是否可渲染到三键导航栏区域）
let currentPageTranslucent = false

function refreshCurrentPageTranslucent() : void {
	try {
		const pages = getCurrentPages()
		if (pages.length > 0) {
			const style = pages[pages.length - 1].getPageStyle()
			currentPageTranslucent = style['androidThreeButtonNavigationTranslucent'] == true
		} else {
			currentPageTranslucent = false
		}
	} catch (e) {
		currentPageTranslucent = false
	}
}

function dispatchKeyboardAnimation(ime : number, tappable : number, state : string) : void {
	if (state == 'start') {
		refreshCurrentPageTranslucent()
	}
	// 页面内容渲染到三键导航栏下（translucent）时，键盘高度无需再减去导航栏高度
	const subtract = currentPageTranslucent ? 0 : tappable
	const raw = ime - subtract
	const result : OnKeyboardAnimationChangeCallbackResult = {
		height: UTSAndroid.devicePX2px(raw > 0 ? raw : 0),
		state: state as 'start' | 'running' | 'end'
	}
	animationCallbacks.forEach((callback : OnKeyboardAnimationChangeCallback) => {
		callback(result)
	})
}

// API<30 时 compat 需要视图设置 OnApplyWindowInsetsListener 才会派发 insets；统一在这里管理，避免覆盖后不恢复
let insetsListenerView : View | null = null

function ensureInsetsListener() : void {
	if (Build.VERSION.SDK_INT >= 30) {
		return
	}
	const activity = UTSAndroid.getUniActivity()
	if (activity == null) {
		return
	}
	const view = activity!.getWindow().getDecorView()
	if (insetsListenerView === view) {
		return
	}
	ViewCompat.setOnApplyWindowInsetsListener(view, (v : View, insets : WindowInsetsCompat) : WindowInsetsCompat => {
		return insets
	})
	insetsListenerView = view
}

function resetInsetsListener() : void {
	const view = insetsListenerView
	if (view != null) {
		ViewCompat.setOnApplyWindowInsetsListener(view, null)
	}
	insetsListenerView = null
}

function releaseInsetsListenerIfIdle() : void {
	// 动画监听与高度监听都停用时，移除我们添加的 insets 监听
	if (animationListenerRegistered || !keyBoardChangeListeerMaps.isEmpty()) {
		return
	}
	resetInsetsListener()
}

// Activity 重建（旋转、切换导航方式等）后重新绑定动画监听：避免旧 decorView 泄漏，并保证继续生效。
// 由 KeyboardAnimationLifeCycleCallback 的 onResume 触发，即使未注册高度监听也能恢复。
function rebindAnimationListenerIfActive() : void {
	// 只要还有动画监听（不依赖是否已注册高度监听），Activity 重建后就重绑原生动画监听
	if (animationCallbacks.length == 0) {
		return
	}
	ensureInsetsListener()
	const registered = KeyboardAnimationNative.onKeyboardAnimationChangeKotlin((ime : number, tappable : number, state : string) => {
		dispatchKeyboardAnimation(ime, tappable, state)
	})
	animationListenerRegistered = registered
}

// 动画监听专用的 Activity 生命周期回调：即使只注册了 onKeyboardAnimationChange（未注册高度监听），
// Activity 重建（旋转/切换导航方式等）后也能重新绑定原生动画监听，避免动画永久失效。
class KeyboardAnimationLifeCycleCallback extends UniActivityLifeCycleCallback {
	constructor() {
		super();
	}
	override onResume(params : UniActivityParams) {
		rebindAnimationListenerIfActive()
	}
	override onDestroy(params : UniActivityParams) {
		// 释放原生监听对已销毁 Activity decorView 的引用；仍在监听时由下次 resume 重绑
		KeyboardAnimationNative.offKeyboardAnimationChangeKotlin()
		animationListenerRegistered = false
	}
}

function ensureKeyboardAnimationListener() : void {
	// 注册生命周期回调（仅一次），保证 Activity 重建后动画监听可重绑
	if (animationLifecycleCallback == null) {
		animationLifecycleCallback = new KeyboardAnimationLifeCycleCallback()
		UTSAndroid.onActivityCallback(animationLifecycleCallback!)
	}
	if (animationListenerRegistered) {
		return
	}
	refreshCurrentPageTranslucent()
	ensureInsetsListener()
	const registered = KeyboardAnimationNative.onKeyboardAnimationChangeKotlin((ime : number, tappable : number, state : string) => {
		dispatchKeyboardAnimation(ime, tappable, state)
	})
	// 只有原生注册成功才置位；否则保留 false，后续 on 可重新尝试注册，
	// 避免 Activity 尚未就绪时永久卡在「已注册但未生效」状态。
	if (registered) {
		animationListenerRegistered = true
	}
}

export const onKeyboardAnimationChange : OnKeyboardAnimationChange = function (callback : OnKeyboardAnimationChangeCallback) : void {
	animationCallbacks.push(callback)
	ensureKeyboardAnimationListener()
}

export const offKeyboardAnimationChange : OffKeyboardAnimationChange = function (callback ?: OnKeyboardAnimationChangeCallback | null) {
	// 跨 JS 与原生（Kotlin）边界时，同一个 JS 函数每次传入都会生成新的原生对象引用，
	// 无法用 Array.indexOf(callback) 精确匹配已注册的监听。若匹配失败，
	// animationCallbacks 不会清空，原生监听既无法释放（泄漏已销毁 Activity），
	// 又重新进入页面时被 ensureKeyboardAnimationListener 跳过（不再回调）。
	// 因此这里统一注销全部监听，确保原生监听被释放并可重新绑定到新 Activity。
	animationCallbacks = []
	KeyboardAnimationNative.offKeyboardAnimationChangeKotlin()
	animationListenerRegistered = false
	if (animationLifecycleCallback != null) {
		UTSAndroid.offActivityCallback(animationLifecycleCallback!)
		animationLifecycleCallback = null
	}
	releaseInsetsListenerIfIdle()
}

