// 通过监听activity的创建，确保当前页面被遮盖之后，仍然可以触发监听事件
class OnKeyBoardChangedListener extends UniActivityLifeCycleCallback implements ViewTreeObserver.OnGlobalLayoutListener {
	decorView : View | null = null
	activity : Activity | null = null

	// 是否已注册（避免重复调用 onKeyboardHeightChange 导致重复注册与定时器堆积）
	watched = false

	// 记录上一次的键盘高度，防止重复触发相同值
	lastKeyboardHeight = 0

	// 记录上一次原始 ime.bottom：globalLayout 高频触发，原始值未变化时跳过重复计算，避免主线程卡顿（ANR）
	lastImeBottom = -1

	// 生命周期回调是否已注册，避免重复注册
	callbackRegistered = false

	keyBoardChangeListeerMaps : HashMap<number, OnKeyboardHeightChangeCallback>
	constructor(keyBoardChangeListeerMaps : HashMap<number, OnKeyboardHeightChangeCallback>) {
		super();
		this.keyBoardChangeListeerMaps = keyBoardChangeListeerMaps
	}
	watch() {
		if (this.watched) {
			return
		}
		if (!this.callbackRegistered) {
			UTSAndroid.onActivityCallback(this)
			this.callbackRegistered = true
		}
		// 只有视图监听真正绑定成功才置位，避免 Activity 未就绪时永久卡在「已监听」状态而收不到回调
		this.watched = this.watchKeyBoardChanged()
	}

	override onResume(params : UniActivityParams) {
		if (this.activity != UTSAndroid.getUniActivity()) {
			this.watched = this.watchKeyBoardChanged()
		}
	}

	override onDestroy(params : UniActivityParams) {
		if (this.activity == null) {
			return
		}
		this.decorView?.getViewTreeObserver()?.removeOnGlobalLayoutListener(this)
		this.decorView = null
		this.activity = null
		// 重置高度缓存：Activity 重建后即使键盘高度与销毁前相同，也应重新上报，避免监听不到
		this.lastKeyboardHeight = 0
		this.lastImeBottom = -1
		// 释放动画监听与 insets 监听对已销毁 Activity 的 decorView 引用；下次 resume 会重新绑定
		if (animationListenerRegistered) {
			KeyboardAnimationNative.offKeyboardAnimationChangeKotlin()
		}
		resetInsetsListener()
	}

	watchKeyBoardChanged() : boolean {
		const activity = UTSAndroid.getUniActivity()
		if (activity == null) {
			return false
		}
		// 先移除旧的 global layout 监听，避免同一实例被重复添加导致回调多次触发
		this.decorView?.getViewTreeObserver()?.removeOnGlobalLayoutListener(this)
		this.activity = activity
		this.decorView = activity!.getWindow().getDecorView()
		ensureInsetsListener()
		this.decorView!.getViewTreeObserver().addOnGlobalLayoutListener(this)
		return true
	}

	unwatch() {
		if (this.callbackRegistered) {
			UTSAndroid.offActivityCallback(this)
			this.callbackRegistered = false
		}
		this.decorView?.getViewTreeObserver()?.removeOnGlobalLayoutListener(this)
		this.decorView = null
		this.activity = null
		this.watched = false
		// 注销后重置缓存，下次注册时重新计算并上报
		this.lastKeyboardHeight = 0
		this.lastImeBottom = -1
		releaseInsetsListenerIfIdle()
	}

	override onGlobalLayout() {
		var view = this.decorView
		if (view == null) {
			return
		}
		var insets = ViewCompat.getRootWindowInsets(view)
		if (insets == null) {
			return
		}
		let ime = insets!.getInsets(WindowInsetsCompat.Type.ime()).bottom
		// globalLayout 高频触发，原始键盘高度未变化时直接返回，
		// 避免重复调用 getCurrentPages/getPageStyle 造成主线程卡顿（ANR 风险）
		if (ime == this.lastImeBottom) {
			return
		}
		this.lastImeBottom = ime
		refreshCurrentPageTranslucent()
		let tappable = insets!.getInsets(WindowInsetsCompat.Type.tappableElement()).bottom
		let navBar = insets!.getInsets(WindowInsetsCompat.Type.navigationBars()).bottom
		// 与 onKeyboardAnimationChange 使用同一套算法；旧系统(API<30) tappable 静态值不可靠，取 min(tappable, navigationBars)
		let navInset = tappable < navBar ? tappable : navBar
		let subtract = currentPageTranslucent ? 0 : navInset
		let raw = ime - subtract
		let height = UTSAndroid.devicePX2px(raw > 0 ? raw : 0)
		if (this.lastKeyboardHeight == height) {
			return
		}
		this.lastKeyboardHeight = height
		const result : OnKeyboardHeightChangeCallbackResult = {
			height: height
		}
		// 先做快照再回调：回调内若同步调用 offKeyboardHeightChange 修改原 map，
		// 会触发 ConcurrentModificationException 导致崩溃
		let callbacks : Array<OnKeyboardHeightChangeCallback> = []
		this.keyBoardChangeListeerMaps.values.forEach((callback : OnKeyboardHeightChangeCallback) => {
			callbacks.push(callback)
		})
		callbacks.forEach((callback : OnKeyboardHeightChangeCallback) => {
			callback(result)
		})
	}
}
