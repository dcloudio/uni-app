export interface Uni {
    /**
     * 创建并返回一个 IntersectionObserver 对象实例
     *
     * @tutorial https://doc.dcloud.net.cn/uni-app-x/api/create-intersection-observer.html#createintersectionobserver
     * @uniPlatform {
     *  "app": {
     *    "android": {
     *      "uniVer": "√",
     *      "unixVer": "x"
     *    },
     *    "ios": {
     *      "uniVer": "√",
     *      "unixVer": "x"
     *    },
     *    "harmony": {
     *      "uniVer": "4.23",
     *      "unixVer": "x"
     *    }
     *  },
     *  "mp": {
     *    "weixin": {
     *      "uniVer": "√",
     *      "unixVer": "4.41"
     *    },
     *    "alipay": {
     *      "uniVer": "√",
     *      "unixVer": "5.31"
     *    },
     *    "baidu": {
     *      "uniVer": "√",
     *    },
     *    "toutiao": {
     *      "uniVer": "√",
     *    },
     *    "lark": {
     *      "uniVer": "√",
     *    },
     *    "qq": {
     *      "uniVer": "√",
     *    },
     *    "kuaishou": {
     *      "uniVer": "√",
     *    },
     *    "jd": {
     *      "uniVer": "√",
     *    }
     *  },
     *  "web": {
     *    "uniVer": "√",
     *    "unixVer": "4.0"
     *  }
     * }
     */
    createIntersectionObserver(component: any | null, options?: CreateIntersectionObserverOptions | null): IntersectionObserver;
}

export type CreateIntersectionObserver = (component: any | null, options?: CreateIntersectionObserverOptions | null) => IntersectionObserver;

export interface CreateIntersectionObserverOptions {
    /**
     * 所有阈值
     */
    thresholds?: (any[]) | null,
    /**
     * 初始的相交比例
     */
    initialRatio?: number | null,
    /**
     * 是否同时观测多个参照节点（而非一个）
     */
    observeAll?: boolean | null
};

// ---------------------------------------------------------------------------
// 各平台统一使用 ObserveResult / ObserveNodeRect，ObserveCallback 共用同一声明。
// Android 的矩形额外带 width/height，结果额外带节点 id；其它平台保留原有字段。
// ---------------------------------------------------------------------------

// #ifdef APP-ANDROID
/** 相交区域的边界。 */
export type ObserveNodeRect = {
    left: number,
    right: number,
    top: number,
    bottom: number,
    width: number,
    height: number
};


/** 相交回调数据类型。 */
export type ObserveResult = {
    /** 节点 ID，没有设置时为空字符串 */
    id: string,
    /** 相交比例 */
    intersectionRatio: number,
    /** 相交区域的边界 */
    intersectionRect: ObserveNodeRect,
    /** 目标节点布局区域的边界 */
    boundingClientRect: ObserveNodeRect,
    /** 参照区域的边界 */
    relativeRect: ObserveNodeRect,
    /** 相交检测时的时间戳 */
    time: number
};

// #endif

// #ifndef APP-ANDROID
export type ObserveNodeRect = {
    /**
     * left
     */
    left: number,
    /**
     * right
     */
    right: number,
    /**
     * top
     */
    top: number,
    /**
     * bottom
     */
    bottom: number
};
export type ObserveResult = {
    /**
     * 相交比例
     */
    intersectionRatio: number,
    /**
     * 相交区域的边界
     */
    intersectionRect: any,
    /**
     * 目标节点布局区域的边界
     */
    boundingClientRect: ObserveNodeRect,
    /**
     * 参照区域的边界
     */
    relativeRect: ObserveNodeRect,
    /**
     * 相交检测时的时间戳
     */
    time: number
};

// #endif

export type ObserveCallback = (result: ObserveResult) => void;

export interface IntersectionObserver {
    /**
     * 使用选择器指定一个节点，作为参照区域之一
     */
    relativeTo(selector: string, margins?: any): IntersectionObserver;
    /**
     * 指定页面显示区域作为参照区域之一
     */
    relativeToViewport(margins?: any): IntersectionObserver;
    /**
     * 指定目标节点并开始监听相交状态变化情况
		 * @UTSJS.keepAlive
     */
    observe(targetSelector: string, callback: ObserveCallback): void;
    /**
     * 停止监听
     */
    disconnect(): void;
}
