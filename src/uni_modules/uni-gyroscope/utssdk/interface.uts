export type GyroscopeInterval =
  /**
   * 	适用于更新游戏的回调频率，约 20ms/次 左右
   */
	'game' |
	/**
	 * 	适用于更新 UI 的回调频率，在 60ms/次 左右
	 */
	'ui' |
	/**
	 * 		普通的回调频率，在 200ms/次 左右
	 */
	'normal'

export type GyroscopeErrorCode =
	601 |
	602 |
	603 |
	604 |
	701 |
	702 |
	703 |
	704 |
	801 |
	802 |
	803 |
	804 |
	501 |
	502 |
	503 |
	504 |
	901

export interface IGyroscopeError extends IUniError {
	errCode : GyroscopeErrorCode
}

export interface IStartGyroscopeFail extends IGyroscopeError {
}

export interface IStopGyroscopeFail extends IGyroscopeError {
}

export type StartGyroscopeSuccess = {
	errMsg ?: string | null
}

export type StartGyroscopeFail = IStartGyroscopeFail
export type StartGyroscopeSuccessCallback = (res : StartGyroscopeSuccess) => void
export type StartGyroscopeFailCallback = (res : StartGyroscopeFail) => void
export type StartGyroscopeComplete = StartGyroscopeSuccess | StartGyroscopeFail
export type StartGyroscopeCompleteCallback = (res : StartGyroscopeComplete) => void

export type StopGyroscopeSuccess = {
	errMsg ?: string | null
}

export type StopGyroscopeFail = IStopGyroscopeFail
export type StopGyroscopeSuccessCallback = (res : StopGyroscopeSuccess) => void
export type StopGyroscopeFailCallback = (res : StopGyroscopeFail) => void
export type StopGyroscopeComplete = StopGyroscopeSuccess | StopGyroscopeFail
export type StopGyroscopeCompleteCallback = (res : StopGyroscopeComplete) => void

/**
 * 开始监听陀螺仪数据的参数
 */
export type StartGyroscopeOptions = {
  /**
   * 监听陀螺仪数据回调函数的执行频率
   */
	interval ?: GyroscopeInterval | null
	/**
	 * 接口调用成功的回调函数
	 */
	success ?: StartGyroscopeSuccessCallback | null
	/**
	 * 接口调用失败的回调函数
	 */
	fail ?: StartGyroscopeFailCallback | null
	/**
	 * 接口调用结束的回调函数（调用成功、失败都会执行）
	 */
	complete ?: StartGyroscopeCompleteCallback | null
}

/**
 * 停止监听陀螺仪数据的参数
 */
export type StopGyroscopeOptions = {
	/**
	 * 接口调用成功的回调函数
	 */
	success ?: StopGyroscopeSuccessCallback | null
	/**
	 * 接口调用失败的回调函数
	 */
	fail ?: StopGyroscopeFailCallback | null
	/**
	 * 接口调用结束的回调函数（调用成功、失败都会执行）
	 */
	complete ?: StopGyroscopeCompleteCallback | null
}

/**
 * 陀螺仪数据
 */
export type OnGyroscopeChangeCallbackResult = {
	/**
	 * x 轴的角速度
	 */
	x : number
	/**
	 * y 轴的角速度
	 */
	y : number
	/**
	 * z 轴的角速度
	 */
	z : number
}

export type OnGyroscopeChangeCallback = (result : OnGyroscopeChangeCallbackResult) => void

export type StartGyroscope = (options?: StartGyroscopeOptions | null) => void;
export type StopGyroscope = (options?: StopGyroscopeOptions | null) => void;
export type OnGyroscopeChange = (callback: OnGyroscopeChangeCallback) => void;
export type OffGyroscopeChange = (callback: OnGyroscopeChangeCallback | null) => void;

export interface Uni {
 	/**
