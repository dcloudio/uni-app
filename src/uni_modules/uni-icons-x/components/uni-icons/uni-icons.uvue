<template>
	<text :class="iconClass">{{ iconText }}</text>
</template>

<script setup lang="ts">
	// #ifdef APP
	import { uniIconsMap, IconsType } from './icons.ts'
	// #endif
	// #ifdef WEB || MP
	import { uniIconsWebMap, IconsType } from './icons.ts'
	// #endif

	type Props = {
		/**
		 * @description 图标名称，取值范围见 icons.ts 导出的 IconsType，未传入或取值不存在时不显示图标
		 * @default ""
		 * @uniPlatform {
		 *   "app": {
		 *     "android": {"unixVaporVer": "5.21"},
		 *     "ios": {"unixVaporVer": "5.21"},
		 *     "harmony": {"unixVaporVer": "5.21"}
		 *   },
		 *   "mp": {
		 *     "weixin": {"unixVer": "5.36"},
		 *     "alipay": {"unixVer": "5.36"}
		 *   },
		 *   "web": {"unixVer": "5.36"}
		 * }
		 */
		type? : IconsType
	}
	const props = defineProps<Props>()

	const iconText = computed(() : string => {
		const iconType = props.type
		if (iconType == null) return ''
		// #ifdef APP
		return uniIconsMap[iconType]
		// #endif
		// #ifdef WEB || MP
		return uniIconsWebMap[iconType]
		// #endif
	})

	const iconClass = computed(() : string => {
		const iconType = props.type
		if (iconType == null) return ''
		return `uni-icons uni-icon-${iconType}`
	})

</script>

<style>
	@import './uni-icons.css';
	@font-face {
		font-family: UniIconsFontFamily;
		/* #ifdef WEB || MP */
		src: url('./uniicons.woff2') format('woff2');
		/* #endif */
		/* #ifdef APP */
		src: url('./uniicons.ttf');
		/* #endif */
	}
</style>
