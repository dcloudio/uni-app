<template>
	<!-- #ifdef APP -->
	<text style="font-family: UniIconsFontFamily;">{{ type != null ? uniIconsMap[type] : '' }}</text>
	<!-- #endif -->
	<!-- #ifdef WEB || MP -->
	<view style="font-family: UniIconsFontFamily;" :class="type ? 'uni-icon-' + type : ''"></view>
	<!-- #endif -->
</template>

<script setup lang="ts">
	// #ifdef APP
	import { uniIconsMap, IconsType } from './icons.ts'
	// #endif
	// #ifdef WEB || MP
	import { IconsType } from './icons.ts'
	// #endif

	type Props = {
		/**
		 * @description 图标名称，取值范围见 icons.ts 导出的 IconsType，未传入或取值不存在时不显示图标
		 * @default ""
		 * @uniPlatform {
		 *   "app": {
		 *     "android": {"unixVaporVer": "5.21"},
		 *     "ios": {"unixVaporVer": "5.21"},
		 *     "harmony": {"unixVaporVer": "5.21"}
		 *   },
		 *   "mp": {
		 *     "weixin": {"unixVer": "5.07"},
		 *     "alipay": {"unixVer": "5.31"}
		 *   },
		 *   "web": {"unixVer": "5.07"}
		 * }
		 */
		type? : IconsType
	}
	defineProps<Props>()

</script>

<style>
	/* #ifdef WEB || MP */
	@import './uni-icons.css';
	/* #endif */
	@font-face {
		font-family: UniIconsFontFamily;
		/* #ifdef WEB || MP */
		src: url('./uniicons.woff2') format('woff2');
		/* #endif */
		/* #ifdef APP */
		src: url('./uniicons.ttf');
		/* #endif */
	}
</style>
