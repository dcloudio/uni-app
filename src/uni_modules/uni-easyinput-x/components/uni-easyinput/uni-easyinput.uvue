<template>
	<view
		class="uni-easyinput"
		:class="[
			isFocused ? 'uni-easyinput--focused' : '',
			disabled ? 'uni-easyinput--disabled' : '',
			type == 'textarea' ? 'uni-easyinput--textarea' : ''
		]"
	>
		<slot name="left"></slot>

		<textarea
			v-if="type == 'textarea'"
			class="uni-easyinput__field uni-easyinput__textarea"
			:class="[inputClass ?? '', disabled ? 'uni-easyinput__field--disabled' : '']"
			:name="nameValue"
			:value="currentValue"
			:placeholder="placeholderValue"
			:placeholder-class="placeholderClassValue"
			:disabled="disabled == true"
			:maxlength="maxlengthValue"
			:focus="inputFocus"
			:auto-height="autoHeight == true"
			:cursor-spacing="cursorSpacingValue"
			:adjust-position="adjustPosition == true"
			:confirm-type="textareaConfirmType"
			@input="onInput"
			@focus="onFocus"
			@blur="onBlur"
			@confirm="onConfirm"
			@keyboardheightchange="onKeyboardHeightChange"
		></textarea>
		<input
			v-else
			class="uni-easyinput__field uni-easyinput__input"
			:class="[inputClass ?? '', disabled ? 'uni-easyinput__field--disabled' : '']"
			:name="nameValue"
			:value="currentValue"
			:type="inputType"
			:password="type == 'password' && !passwordVisible"
			:placeholder="placeholderValue"
			:placeholder-class="placeholderClassValue"
			:disabled="disabled == true"
			:maxlength="maxlengthValue"
			:focus="inputFocus"
			:confirm-type="inputConfirmType"
			:cursor-spacing="cursorSpacingValue"
			:adjust-position="adjustPosition == true"
			@input="onInput"
			@focus="onFocus"
			@blur="onBlur"
			@confirm="onConfirm"
			@keyboardheightchange="onKeyboardHeightChange"
		/>

		<uni-icons
			v-if="showEyeIcon"
			class="uni-easyinput__icon"
			:class="iconActionClass"
			:type="passwordVisible ? 'eye-slash-filled' : 'eye-filled'"
			@click="onEyes"
		/>
		<uni-icons
			v-if="showClearIcon"
			class="uni-easyinput__icon"
			:class="iconActionClass"
			type="clear"
			@click="onClear"
		/>

		<slot name="right"></slot>
	</view>
</template>

<script setup lang="ts">
	/**
	 * Easyinput 增强输入框
	 * @description 包装原生 input 和 textarea，提供清空、密码显隐、左右插槽和内部样式定制
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "5.07",
	 *       "unixVaporVer": "5.21"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "5.07",
	 *       "unixVaporVer": "5.11"
	 *     },
	 *     "harmony": {
	 *       "uniVer": "x",
	 *       "unixVer": "5.07",
	 *       "unixVaporVer": "5.07"
	 *     }
	 *   },
	 *   "mp": {
	 *     "weixin": {
	 *       "uniVer": "x",
	 *       "unixVer": "5.07"
	 *     },
	 *     "alipay": {
	 *       "uniVer": "x",
	 *       "unixVer": "5.31"
	 *     }
	 *   },
	 *   "web": {
	 *     "uniVer": "x",
	 *     "unixVer": "5.07"
	 *   }
	 * }
	 * @property {String|Number} modelValue 输入内容，支持 v-model；同时传入 value 时优先使用 modelValue，默认值为空字符串
	 * @property {String|Number} value 不使用 v-model 时传入的输入内容；同时传入 modelValue 时不生效，默认值为空字符串
	 * @property {String} name 原生表单控件名称，默认值为空字符串
	 * @property {String} type 输入类型；textarea 渲染多行输入框，password 渲染密码输入框，其余值透传给原生 input，默认值 text
	 * @property {String} placeholder 占位文字，默认值为空字符串
	 * @property {Boolean} disabled 是否禁用，默认值 false
	 * @property {Number} maxlength 最大输入长度，默认值 -1
	 * @property {Boolean} focus 是否聚焦，默认值 false
	 * @property {String} confirmType 键盘右下角按钮类型；单行输入默认 done，多行输入默认 return
	 * @property {Number} cursorSpacing 光标与键盘的距离，单位 px，默认值 0
	 * @property {Boolean} adjustPosition 键盘弹起时是否自动上推页面，默认值 false
	 * @property {Boolean} autoHeight 多行输入框是否自动增高，仅 type 为 textarea 时生效，默认值 false
	 * @property {Boolean} clearable 是否显示清空图标，仅对单行输入框生效，默认值 false
	 * @property {Boolean} passwordIcon 是否显示密码显隐图标，仅 type 为 password 时生效，默认值 false
	 * @property {String} inputClass input 或 textarea 的自定义样式类，默认值为空字符串
	 * @property {String} placeholderClass 占位文字的自定义样式类，默认值为空字符串
	 * @property {String} iconClass 清空和密码显隐图标的自定义样式类，默认值为空字符串
	 * @event {Function} update:modelValue 输入内容更新时触发，参数为当前字符串值
	 * @event {Function} input 输入时触发，参数为当前字符串值
	 * @event {Function} focus 聚焦时触发，参数为原生聚焦事件
	 * @event {Function} blur 失焦时触发，参数为原生失焦事件
	 * @event {Function} confirm 点击键盘完成按钮时触发，参数为当前字符串值
	 * @event {Function} change 失焦或点击键盘完成按钮时触发，同一次聚焦期间相同值只触发一次
	 * @event {Function} clear 点击清空图标时触发
	 * @event {Function} eyes 密码可见状态变化时触发，参数为是否可见
	 * @event {Function} keyboardheightchange 键盘高度变化时触发，参数为原生键盘高度事件
	 */
	import { UniEasyinputProps } from './types.uts'

	defineOptions({
		externalClasses: [
			'input-class',
			'placeholder-class',
			'icon-class'
		]
	})

	const props = defineProps<UniEasyinputProps>()

	const emit = defineEmits<{
		/**
		 * @description 输入内容更新时触发，用于 v-model，参数为当前字符串值
		 */
		'update:modelValue': [value : string],
		/**
		 * @description 输入时触发，参数为当前字符串值
		 */
		input: [value : string],
		/**
		 * @description 聚焦时触发，参数为原生 input 或 textarea 聚焦事件
		 */
		focus: [event : UniInputFocusEvent | UniTextareaFocusEvent],
		/**
		 * @description 失焦时触发，参数为原生 input 或 textarea 失焦事件
		 */
		blur: [event : UniInputBlurEvent | UniTextareaBlurEvent],
		/**
		 * @description 点击键盘完成按钮时触发，参数为当前字符串值
		 */
		confirm: [value : string],
		/**
		 * @description 失焦或点击键盘完成按钮时触发，同一次聚焦期间相同值只触发一次，参数为当前字符串值
		 */
		change: [value : string],
		/**
		 * @description 点击清空图标时触发
		 */
		clear: [],
		/**
		 * @description 密码可见状态变化时触发；点击图标或可见密码因状态变化恢复隐藏时都会触发
		 */
		eyes: [visible : boolean],
		/**
		 * @description 键盘高度变化时触发
		 */
		keyboardheightchange: [event : UniInputKeyboardHeightChangeEvent]
	}>()

	defineSlots<{
		/**
		 * @description 输入区域左侧内容
		 */
		left(props : {}) : any,
		/**
		 * @description 输入区域右侧内容
		 */
		right(props : {}) : any
	}>()

	function normalizeValue(value : string | number | null | undefined) : string {
		return value == null ? '' : value.toString()
	}

	function getPropValue() : string | number | null {
		return props.modelValue !== undefined ? props.modelValue : (props.value ?? null)
	}

	const currentValue = ref<string>(normalizeValue(getPropValue()))
	const inputFocus = ref<boolean>(props.focus == true)
	const isFocused = ref<boolean>(false)
	const passwordVisible = ref<boolean>(false)
	const lastChangeValue = ref<string | null>(null)

	const nameValue = computed((): string => props.name ?? '')
	const placeholderValue = computed((): string => props.placeholder ?? '')
	const maxlengthValue = computed((): number => props.maxlength ?? -1)
	const cursorSpacingValue = computed((): number => props.cursorSpacing ?? 0)
	const inputType = computed((): string => props.type == 'password' ? 'text' : (props.type ?? 'text'))
	const inputConfirmType = computed((): string => props.confirmType ?? 'done')
	const placeholderClassValue = computed((): string.ClassString => {
		return (props.placeholderClass ?? '') as string.ClassString
	})
	const textareaConfirmType = computed((): string => {
		const confirmType = props.confirmType
		return (confirmType == null || confirmType == '' || confirmType == 'done') ? 'return' : confirmType
	})

	const showClearIcon = computed((): boolean => {
		return props.clearable == true && props.type != 'textarea' && props.disabled != true && currentValue.value != ''
	})

	const showEyeIcon = computed((): boolean => {
		return props.type == 'password' && props.passwordIcon == true && props.disabled != true && currentValue.value != ''
	})

	const iconActionClass = computed((): string.ClassString => {
		const className = isFocused.value ? 'uni-easyinput__icon--focused' : ''
		return (className == '' ? (props.iconClass ?? '') : className + ' ' + (props.iconClass ?? '')) as string.ClassString
	})

	function applyInput(value : string) {
		currentValue.value = value
		emit('update:modelValue', value)
		emit('input', value)
	}

	function syncValue(value : string) : string {
		if (value != currentValue.value) {
			applyInput(value)
		}
		return value
	}

	function emitChange(value : string) {
		if (lastChangeValue.value == value) {
			return
		}
		lastChangeValue.value = value
		emit('change', value)
	}

	function onInput(event : UniInputEvent) : string {
		if (props.disabled == true) {
			return currentValue.value
		}
		const value = event.detail.value
		applyInput(value)
		return value
	}

	function onFocus(event : UniInputFocusEvent | UniTextareaFocusEvent) {
		isFocused.value = true
		lastChangeValue.value = null
		emit('focus', event)
	}

	function onBlur(event : UniInputBlurEvent | UniTextareaBlurEvent) {
		isFocused.value = false
		inputFocus.value = false
		const value = syncValue(event.detail.value)
		emit('blur', event)
		emitChange(value)
	}

	function onConfirm(event : UniInputConfirmEvent) {
		if (props.disabled == true) {
			return
		}
		const value = syncValue(event.detail.value)
		emit('confirm', value)
		emitChange(value)
	}

	function onClear() {
		if (props.disabled == true) {
			return
		}
		applyInput('')
		lastChangeValue.value = ''
		emit('clear')
	}

	function onEyes() {
		if (props.disabled == true) {
			return
		}
		passwordVisible.value = !passwordVisible.value
		emit('eyes', passwordVisible.value)
	}

	function onKeyboardHeightChange(event : UniInputKeyboardHeightChangeEvent) {
		emit('keyboardheightchange', event)
	}

	watch(() : string | number | null => getPropValue(), (value : string | number | null) => {
		currentValue.value = normalizeValue(value)
	})

	watch(() : boolean => props.focus == true, (focus : boolean) => {
		inputFocus.value = focus
	})

	watch(() : boolean => showEyeIcon.value, (canShow : boolean) => {
		if (!canShow && passwordVisible.value) {
			passwordVisible.value = false
			emit('eyes', false)
		}
	})

	/**
	 * @description 使内部输入框聚焦；禁用状态下不生效
	 */
	function focusInput() {
		if (props.disabled == true) {
			return
		}
		inputFocus.value = false
		nextTick(() => {
			inputFocus.value = true
		})
	}

	/**
	 * @description 使内部输入框失焦
	 */
	function blurInput() {
		inputFocus.value = false
	}

	defineExpose({
		/**
		 * @description 使内部输入框聚焦；禁用状态下不生效
		 */
		focusInput,
		/**
		 * @description 使内部输入框失焦
		 */
		blurInput
	})
</script>

<style>
	.uni-easyinput {
		width: 100%;
		min-width: 0;
		min-height: 36px;
		flex: 1;
		flex-direction: row;
		align-items: center;
		box-sizing: border-box;
		background-color: var(--list-background-color, #ffffff);
		border-width: 1px;
		border-style: solid;
		border-color: var(--input-border-color, #dcdfe6);
		border-radius: 5px;
		transition-property: border-color;
		transition-duration: 0.2s;
	}

	.uni-easyinput--focused {
		border-color: #2979ff;
	}

	.uni-easyinput--disabled {
		background-color: var(--active-background-color, #f7f6f6);
	}

	.uni-easyinput--textarea {
		align-items: flex-start;
	}

	.uni-easyinput__field {
		position: relative;
		flex: 1;
		min-width: 0;
		width: auto;
		color: var(--text-color, #333333);
		background-color: transparent;
		font-size: 14px;
		box-sizing: border-box;
	}

	.uni-easyinput__field--disabled {
		color: var(--active-color, #d5d5d5);
	}

	.uni-easyinput__input {
		height: 34px;
		padding: 0 10px;
	}

	.uni-easyinput__textarea {
		height: 80px;
		min-height: 80px;
		margin: 6px 0;
		padding: 0 10px;
		line-height: 21px;
	}

	.uni-easyinput__icon {
		padding: 6px 5px;
		color: var(--arrow-color, #c0c4cc);
		background-color: transparent;
		font-size: 22px;
	}

	.uni-easyinput__icon--focused {
		color: #2979ff;
	}
</style>
