	 *   },
	 *   "web": {
	 *     "unixVer": "5.26"
	 *   }
	 * }
	 */
	'update:modelValue': [date: string]
	/**
	 * @description 点击选择日期时触发
	 * @param date 选中的日期，格式 YYYY-MM-DD
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVer": "5.26", "unixVaporVer": "5.26"},
	 *     "ios": {"unixVer": "5.26", "unixVaporVer": "5.26"},
	 *     "harmony": {"unixVer": "5.26", "unixVaporVer": "5.26"}
	 *   },
	 *   "mp": {
	 *     "weixin": {"unixVer": "5.26"},
	 *     "alipay": {"unixVer": "5.31"}
	 *   },
	 *   "web": {
	 *     "unixVer": "5.26"
	 *   }
	 * }
	 */
	change: [date: string]
	/**
	 * @description 当前显示月份变化时触发（切换箭头、滑动、选择月份、方法跳转）
	 * @param year 当前年份
	 * @param month 当前月份，1-12
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVer": "5.26", "unixVaporVer": "5.26"},
	 *     "ios": {"unixVer": "5.26", "unixVaporVer": "5.26"},
	 *     "harmony": {"unixVer": "5.26", "unixVaporVer": "5.26"}
	 *   },
	 *   "mp": {
