<template>
	<!-- 年月标题与左右切换箭头 -->
	<view style="flex-direction: row" class="year-month-row">
		<text class="year-month-arrow" :class="props.yearMonthArrowClass" @click="prevMonth">‹</text>
		<picker class="year-month-picker" mode="date" :value="pickerValue" fields="month" @change="onPickerChange">
			<text class="year-month-text" :class="props.yearMonthClass">{{ yearMonthText }}</text>
		</picker>
		<text class="year-month-arrow" :class="props.yearMonthArrowClass" @click="nextMonth">›</text>
	</view>

	<!-- 星期标题 -->
	<view class="week-row" :class="props.weekClass" flatten>
		<text v-for="(item, index) in weekdayLabels" :key="index" flatten class="week-item"
			:class="props.weekItemClass">{{ item }}</text>
	</view>

	<!-- 日历主体，使用 swiper 承载前后月份，flatten 拍平日期文本提升渲染性能 -->
	<swiper class="calendar-swiper" auto-height :circular="true" :current="swiperCurrent" :style="swiperStyle" @change="onSwiperChange">
		<swiper-item v-for="(item, index) in swiperItems" :key="item.key" class="calendar-swiper-item">
			<view class="calendar-grid" :class="index == 0 ? 'calendar-grid-measure' : ''" @click="onCalendarClick">
				<!-- 无自定义文字时保持单 text 拍平渲染，避免额外节点 -->
				<template v-if="hasDayExtras">
					<view v-for="(day, dayIndex) in item.days" :key="dayIndex" flatten class="day-cell" :class="[
						props.dayWrapClass,
						day.isSelected ? 'day-selected' : '',
						day.isSelected ? 'day-selected-wrap' : '',
						day.isSelected ? props.daySelectedClass : ''
					]">
						<text flatten class="day-extra-text" :class="[
							props.dayTopClass,
							day.isDisabled ? 'day-extra-disabled' : '',
							day.isSelected ? 'day-selected-text' : ''
						]">{{ day.topText }}</text>
						<text flatten class="day-text day-text-inner" :class="[
							props.dayClass,
							day.day == 0 ? 'day-empty' : '',
							day.isToday ? 'day-today' : '',
							day.isToday ? props.todayClass : '',
							day.isWeekend || day.isHoliday ? 'day-holiday' : '',
							day.isDisabled ? 'day-disabled' : '',
							day.isSelected ? 'day-selected-text' : ''
						]">{{ day.day > 0 ? day.day : '' }}</text>
						<text flatten class="day-extra-text" :class="[
							props.dayBottomClass,
							day.isDisabled ? 'day-extra-disabled' : '',
							day.isSelected ? 'day-selected-text' : ''
						]">{{ day.bottomText }}</text>
					</view>
				</template>
				<template v-else>
					<text flatten v-for="(day, dayIndex) in item.days" :key="dayIndex" class="day-text" :class="[
						props.dayClass,
						day.day == 0 ? 'day-empty' : '',
						day.isToday ? 'day-today' : '',
						day.isToday ? props.todayClass : '',
						day.isWeekend || day.isHoliday ? 'day-holiday' : '',
						day.isDisabled ? 'day-disabled' : '',
						day.isSelected ? 'day-selected' : '',
						day.isSelected ? 'day-selected-normal' : '',
						day.isSelected ? props.daySelectedClass : ''
					]">{{ day.day > 0 ? day.day : '' }}</text>
				</template>
			</view>
		</swiper-item>
	</swiper>
</template>

