})

const emit = defineEmits<{
	/**
	 * @description 选中日期变化时触发，用于 v-model 双向绑定
	 * @param date 选中的日期，格式 YYYY-MM-DD
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {"unixVer": "5.26", "unixVaporVer": "5.26"},
	 *     "ios": {"unixVer": "5.26", "unixVaporVer": "5.26"},
	 *     "harmony": {"unixVer": "5.26", "unixVaporVer": "5.26"}
