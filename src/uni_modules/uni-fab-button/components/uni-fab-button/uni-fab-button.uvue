<template>
	<view
		style="align-items: center; justify-content: center;"
		class="fab"
		:class="plusClass.length > 0 ? 'fab-custom-plus' : ''"
		@click="handleClick"
		<!-- #ifdef WEB -->
		:tabindex="'0'"
		@keydown="onKeydown"
		<!-- #endif -->
	>
		<!-- #ifdef WEB || MP -->
		<!-- 保留自定义样式的承载节点，竖线由伪元素绘制 -->
		<view v-if="plusClass.length > 0" class="plus" :class="plusClass" style="position: absolute;"></view>
		<!-- #endif -->
		<!-- #ifdef APP -->
		<view flatten class="plus" :class="plusClass" style="position: absolute;"></view>
		<view flatten class="plus" :class="plusClass" style="position: absolute;transform: rotate(90deg);"></view>
		<!-- #endif -->
	</view>
</template>
<script lang="ts" setup>
  /**
   * 悬浮加号按钮
   * @description 悬浮加号按钮组件
   * @uniPlatform {
   *   "app": {
   *     "android": {"unixVaporVer": "5.21"},
   *     "ios": {"unixVaporVer": "5.11"},
   *     "harmony": {"unixVaporVer": "5.07"}
   *   },
   *   "mp": {
   *     "weixin": {"unixVer": "5.07"},
   *     "alipay": {"unixVer": "5.31"}
   *   },
   *   "web": {"unixVer": "5.07"}
   * }
   */
	defineOptions({
		externalClasses: ['plus-class']
	})
	const props = defineProps({
		/**
		 * @description 加号图标的自定义样式类，用于调整加号颜色、尺寸等样式
		 * @default ""
		 * @uniPlatform {
		 *   "app": {
		 *     "android": {"unixVaporVer": "5.21"},
		 *     "ios": {"unixVaporVer": "5.11"},
		 *     "harmony": {"unixVaporVer": "5.07"}
		 *   },
		 *   "mp": {
		 *     "weixin": {"unixVer": "5.07"},
		 *     "alipay": {"unixVer": "5.31"}
		 *   },
		 *   "web": {"unixVer": "5.07"}
		 * }
		 */
		plusClass: { type: String, default: "" }
	})
	const emit = defineEmits<{
		/**
		 * @description 点击事件，参数为事件对象，类型为 UniPointerEvent
		 * @uniPlatform {
		 *   "app": {
		 *     "android": {"unixVaporVer": "5.21"},
		 *     "ios": {"unixVaporVer": "5.11"},
		 *     "harmony": {"unixVaporVer": "5.07"}
		 *   },
		 *   "mp": {
		 *     "weixin": {"unixVer": "5.07"},
		 *     "alipay": {"unixVer": "5.31"}
		 *   },
		 *   "web": {"unixVer": "5.07"}
		 * }
		 */
		click: [event: UniPointerEvent]
	}>()

	const handleClick = (event: UniPointerEvent) => {
		emit('click', event)
	}

	// #ifdef WEB
	const onKeydown = (event : KeyboardEvent) : void => {
		const key = event.key as string
		if (key == 'Enter' || key == ' ') {
			event.preventDefault()
			const target = event.currentTarget as HTMLElement
			target.click()
		}
	}
	// #endif
</script>
<style>
	.fab {
		position: relative;
		width: 44px;
		height: 44px;
		background-color: #007AFF;
		border-radius: 50%;
		box-shadow: 0 1px 5px 2px rgba(0, 0, 0, .3);
		/* #ifdef WEB */
		cursor: pointer;
		outline: none;
		/* #endif */
	}

	/* #ifdef WEB */
	.fab:hover {
		background-color: #1a85ff;
	}

	.fab:focus-visible {
		outline: 2px solid #2979ff;
		outline-offset: 2px;
	}
	/* #endif */

	.plus {
		background-color: white;
		border-radius: 2px; 	/* 给加号边缘一点圆角 */
		width: 40%;
		height: 2px;
	}

	/* #ifdef WEB || MP */
	.plus {
		/* 竖线旋转后超出横线尺寸，需覆盖uni-view默认的裁剪样式 */
		overflow: visible;
	}

	.fab::before,
	.fab::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 40%;
		height: 2px;
		background-color: white;
		border-radius: 2px;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.fab::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.fab-custom-plus::before,
	.fab-custom-plus::after {
		content: none;
	}

	.plus::after {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		background-color: inherit;
		border-radius: inherit;
		transform: rotate(90deg);
		pointer-events: none;
	}
	/* #endif */
</style>
