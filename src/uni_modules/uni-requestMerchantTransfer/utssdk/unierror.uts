export type RequestMerchantTransferErrorCode = 9301102 | 9301103 | 9301104 | 9301105 | 9301106 | 9301107 | 9301108 | 9301109 | 9301110

export type RequestMerchantTransferError = {
	errCode : RequestMerchantTransferErrorCode
	errMsg : string
}

export const REQUEST_MERCHANT_TRANSFER_MCH_ID_REQUIRED : RequestMerchantTransferError = {
	errCode: 9301102,
	errMsg: 'requestMerchantTransfer:fail mchId is required'
}

