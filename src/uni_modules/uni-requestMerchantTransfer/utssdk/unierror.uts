}

export const REQUEST_MERCHANT_TRANSFER_WECHAT_VERSION_LOW : RequestMerchantTransferError = {
	errCode: 9301106,
	errMsg: 'requestMerchantTransfer:fail wechat version is too low'
}

export const REQUEST_MERCHANT_TRANSFER_CANCEL : RequestMerchantTransferError = {
	errCode: 9301107,
	errMsg: 'requestMerchantTransfer:fail cancel'
}

