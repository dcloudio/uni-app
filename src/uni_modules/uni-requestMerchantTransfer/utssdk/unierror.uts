	errCode: 9301104,
	errMsg: 'requestMerchantTransfer:fail appId is required'
}

export const REQUEST_MERCHANT_TRANSFER_WECHAT_NOT_INSTALLED : RequestMerchantTransferError = {
	errCode: 9301105,
