import {
    API_EXIT
} from '../protocol.uts'
import {
    Exit,
    ExitOptions,
    ExitSuccess
} from '../interface.uts'

export const exit: Exit = defineAsyncApi<ExitOptions, ExitSuccess>(
    API_EXIT,
    function (options: ExitOptions, exec: ApiExecutor<ExitSuccess>) {
        UTSHarmony.exit()
        exec.resolve({ errMsg: 'exit:ok' } as ExitSuccess)
    }
) as Exit
export {
    Exit,
    ExitCompleteCallback,
    ExitErrorCode,
    ExitFail,
    ExitFailCallback,
    ExitOptions,
    ExitSuccess,
    ExitSuccessCallback,
    IExitError
} from '../interface.uts';
