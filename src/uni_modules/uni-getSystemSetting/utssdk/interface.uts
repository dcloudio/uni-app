  /**
   * 蓝牙的报错信息
   *
   * @uniPlatform
   * {
   * 	"app": {
   * 		"android": {
   * 			"uniVer": "√",
   * 			"unixVer": "3.9+"
   * 		},
   * 		"ios": {
   * 			"uniVer": "√",
   * 			"unixVer": "4.11"
   * 		},
  *    "harmony": {
  *      "uniVer": "4.25",
  *      "unixVer": "4.61",
  *      "unixVaporVer": "5.0"
  *    }
   * 	},
   *  "mp": {
   *    "weixin": {
   *        "uniVer": "x",
   *        "unixVer": "4.41"
   *    },
   *    "alipay": {
   *        "uniVer": "√",
   *        "unixVer": "5.31"
   *    },
   *    "baidu": {
   *        "uniVer": "x",
   *    },
   *    "toutiao": {
   *        "uniVer": "x",
   *    },
   *    "lark": {
   *        "uniVer": "√",
   *    },
   *    "qq": {
   *        "uniVer": "x",
   *    },
   *    "kuaishou": {
   *        "uniVer": "x",
   *    },
   *    "jd": {
   *        "uniVer": "x",
   *    }
   *  }
   * }
   */
  bluetoothError?: string | null,
  /**
   * 位置是否开启
   *
   * @uniPlatform
   * {
   * 	"app": {
   * 		"android": {
   * 			"uniVer": "√",
   * 			"unixVer": "3.9+"
   * 		},
   * 		"ios": {
   * 			"uniVer": "√",
   * 			"unixVer": "4.11"
   * 		},
  *    "harmony": {
  *      "uniVer": "4.25",
