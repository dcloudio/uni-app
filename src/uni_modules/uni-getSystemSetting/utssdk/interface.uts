

export type GetSystemSettingResult = {
  /**
   * 蓝牙是否开启
   *
   * @uniPlatform
   * {
   * 	"app": {
   * 		"android": {
   * 			"uniVer": "√",
   * 			"unixVer": "3.9+"
   * 		},
   * 		"ios": {
   * 			"uniVer": "√",
   * 			"unixVer": "4.11"
   * 		},
  *    "harmony": {
  *      "uniVer": "4.25",
  *      "unixVer": "4.61",
  *      "unixVaporVer": "5.0"
  *    }
   * 	},
   *  "mp": {
   *    "weixin": {
   *        "uniVer": "√",
   *        "unixVer": "4.41"
   *    },
   *    "alipay": {
   *        "uniVer": "√",
   *        "unixVer": "5.31"
   *    },
   *    "baidu": {
   *        "uniVer": "√",
