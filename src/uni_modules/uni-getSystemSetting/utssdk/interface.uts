  /**
   * wifi的报错信息
   *
   * @uniPlatform
   * {
   * 	"app": {
   * 		"android": {
   * 			"uniVer": "√",
   * 			"unixVer": "3.9+"
   * 		},
   * 		"ios": {
   * 			"uniVer": "x",
   * 			"unixVer": "x"
   * 		},
  *    "harmony": {
  *      "uniVer": "4.25",
  *      "unixVer": "4.61",
  *      "unixVaporVer": "5.0"
  *    }
   * 	},
   *  "mp": {
   *    "weixin": {
