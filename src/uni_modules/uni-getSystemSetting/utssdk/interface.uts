  *      "unixVaporVer": "5.0"
  *    }
   * 	},
   *  "mp": {
   *    "weixin": {
   *        "uniVer": "√",
   *        "unixVer": "4.41"
   *    },
   *    "alipay": {
   *        "uniVer": "√",
   *        "unixVer": "5.31"
   *    },
   *    "baidu": {
   *        "uniVer": "√",
   *    },
   *    "toutiao": {
   *        "uniVer": "√",
   *    },
   *    "lark": {
   *        "uniVer": "√",
   *    },
   *    "qq": {
   *        "uniVer": "√",
   *    },
   *    "kuaishou": {
   *        "uniVer": "√",
   *    },
   *    "jd": {
   *        "uniVer": "√",
   *    }
   *  }
