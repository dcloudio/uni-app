// #ifdef APP-IOS || APP-HARMONY || (APP-ANDROID && !VUE3-VAPOR)
export interface WebviewContext {
	/**
	 * 前进到 web-view 组件网页加载历史的下一页，如果不存在下一页则没有任何效果
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "3.9.0",
   	 *       "unixVaporVer": "x"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.11"
	 *     },
	 *    "harmony": {
	 *      "uniVer": "4.61",
	 *      "unixVer": "4.61",
	 *      "unixVaporVer": "5.0"
	 *    }
	 *   }
	 * }
	 */
	forward() : void
	/**
	 * 后退到 web-view 组件网页加载历史的上一页，如果不存在上一页则没有任何效果
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "3.9.0",
   	 *       "unixVaporVer": "x"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.11"
	 *     },
	 *    "harmony": {
	 *      "uniVer": "4.61",
	 *      "unixVer": "4.61",
	 *      "unixVaporVer": "5.0"
	 *    }
	 *   }
	 * }
	 */
	back() : void
	/**
	 * 重新加载 web-view 组件当前页面
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "3.9.0",
     *       "unixVaporVer": "x"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.11"
	 *     },
	 *    "harmony": {
	 *      "uniVer": "4.61",
	 *      "unixVer": "4.61",
	 *      "unixVaporVer": "5.0"
	 *    }
	 *   }
	 * }
	 */
	reload() : void
	/**
	 * 停止加载 web-view 组件当前网页，该方法不能阻止已经加载的 html 文档，但是能够阻止未完成的图片及延迟加载的资源
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "3.9.0",
     *       "unixVaporVer": "x"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.11"
	 *     },
	 *    "harmony": {
	 *      "uniVer": "4.61",
	 *      "unixVer": "4.61",
	 *      "unixVaporVer": "5.0"
	 *    }
	 *   }
	 * }
	 */
	stop() : void
	/**
	 * 在网页中执行指定的js脚本，在 uvue 页面中可通过此方法向 web-view 组件加载的页面发送数据
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "3.9.0",
     *       "unixVaporVer": "x"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.11"
	 *     },
	 *    "harmony": {
	 *      "uniVer": "4.61",
	 *      "unixVer": "4.61",
	 *      "unixVaporVer": "5.0"
	 *    }
	 *   }
	 * }
	 */
	evalJS(js : string) : void
	/**
	 * 获取webview内容高度
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.63",
     *       "unixVaporVer": "x"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.63"
	 *     },
	 *    "harmony": {
	 *      "uniVer": "4.63",
	 *      "unixVer": "4.63",
	 *      "unixVaporVer": "5.0"
	 *    }
	 *   }
	 * }
	 */
	getContentHeight() : number
	/**
	 * 在 web-view 组件中加载页面内容
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.71",
     *       "unixVaporVer": "x"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.71"
	 *     },
	 *    "harmony": {
	 *      "uniVer": "4.71",
	 *      "unixVer": "4.63",
	 *      "unixVaporVer": "5.0"
	 *    }
	 *   }
	 * }
	 */
	loadData(options : UniWebViewContextLoadDataOptions) : void
}
// #endif

