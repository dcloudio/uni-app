<template>
  <view class="uni-form">
    <slot></slot>
  </view>
</template>

<script lang="ts" setup>
  import { FORM_KEY } from '../common.ts'
  import { UniFormElement } from './global.ts'
  import { FormField, FormContext } from '../types.ts'

  type UniFormSubmitEventDetail = {
    value : UTSJSONObject
  }

  type UniFormResetEventDetail = {
  }

  defineOptions({
    name: 'form',
    // @ts-ignore
    rootElement: {
      class: UniFormElement
    }
  })

  interface FormProps {
    /**
     * 是否禁用
     * @uniPlatform {
       "app": {
         "ios": {
           "unixVaporVer": "5.11"
         },
         "android": {
           "unixVaporVer": "5.21"
         },
        "harmony": {
           "unixVaporVer": "5.0"
         }
       }
     }
     */
    disabled?: boolean
  }

  const props = withDefaults(defineProps<FormProps>(), {
    disabled: false
  })

  class UniFormSubmitEvent extends UniCustomEvent<UniFormSubmitEventDetail> {
    constructor(value : UTSJSONObject) {
      super('submit', {
        detail: { value } as UniFormSubmitEventDetail
      } as UniCustomEventOptions<UniFormSubmitEventDetail>)
    }
  }

  class UniFormResetEvent extends UniCustomEvent<UniFormResetEventDetail> {
    constructor() {
      super('reset', {
        detail: {} as UniFormResetEventDetail
      } as UniCustomEventOptions<UniFormResetEventDetail>)
    }
  }

  const emit = defineEmits<{
    submit : UniFormSubmitEvent
    reset : UniFormResetEvent
  }>()

  // Keep fields by name
  const fields = new Map<string, FormField>()

  function registerField(field : FormField) {
    if (!field.name) {
      return
    }
    fields.set(field.name, field)
  }

  function unregisterField(name : string) {
    if (!name) {
      return
    }
    fields.delete(name)
  }

  function submit(event?: UniPointerEvent) {
    if (props.disabled) {
      return
    }

    const data = {}
    fields.forEach((field, name) => {
      data[name] = field.getValue()
    })
    emit('submit', new UniFormSubmitEvent(data))
  }

  function reset(event?: UniPointerEvent) {
    if (props.disabled) {
      return
    }

    fields.forEach((field) => {
      field.reset && field.reset()
    })
    emit('reset', new UniFormResetEvent())
  }

  const ctx : FormContext = { registerField, unregisterField, submit, reset }
  provide(FORM_KEY, ctx)

  defineExpose({ submit, reset })
</script>

<style>
  .uni-form {
    flex-direction: column;
  }
</style>
