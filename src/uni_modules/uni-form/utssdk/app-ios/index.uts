function findInputElementImpl(element: UniNativeViewElement): UniInputElementImpl | null {
	let currentElement = element.parentElement
	while (currentElement != null) {
		if (UTSiOS.instanceof(currentElement, UniInputElementImpl.self)) {
			return currentElement as UniInputElementImpl
		}
		currentElement = currentElement.parentElement
	}
	return null
}

function findTextareaElementImpl(element: UniNativeViewElement): UniTextareaElementImpl | null {
	let currentElement = element.parentElement
	while (currentElement != null) {
		if (UTSiOS.instanceof(currentElement, UniTextareaElementImpl.self)) {
			return currentElement as UniTextareaElementImpl
		}
		currentElement = currentElement.parentElement
	}
	return null
}

class UniInputFontUtil {
	static applyInputFont(target: UniInputView | null, fontSize: number, fontWeight: string, fontStyle: string, fontFamily: string) {
		if (target == null) return
		target!.font = this.buildFont(fontSize, fontWeight, fontStyle, fontFamily)
	}

	static applyTextareaFont(target: UniTextareaView | null, fontSize: number, fontWeight: string, fontStyle: string, fontFamily: string) {
		if (target == null) return
		target!.font = this.buildFont(fontSize, fontWeight, fontStyle, fontFamily)
	}

	static buildFont(fontSize: number, fontWeight: string, fontStyle: string, fontFamily: string): UIFont {
		const size = CGFloat(fontSize)
		const familyCandidates = this.buildFontFamilyCandidates(fontFamily)
		for (let i = 0; i < familyCandidates.length; i++) {
			const font = this.buildCustomFont(familyCandidates[i], size, fontWeight, fontStyle)
			if (font != null) {
				return font!
			}
		}
		return this.buildSystemFont(size, fontWeight, fontStyle)
	}

	static parseFontSize(value: string, viewportWidth?: number): number | null {
		if (value == null) {
			return null
		}
		const normalizedValue = value.trim()
		if (normalizedValue == '') {
			return null
		}
		let parsedValue = normalizedValue
		if (parsedValue.endsWith('px')) {
			parsedValue = parsedValue.substring(0, parsedValue.length - 2)
		} else if (parsedValue.endsWith('rpx')) {
			const rpxValue = parseFloat(parsedValue.substring(0, parsedValue.length - 3))
			if (isNaN(rpxValue) || rpxValue <= 0) {
				return null
			}
			const baseWidth = viewportWidth != null && viewportWidth > 0
				? viewportWidth
				: NSNumber(value = Double(UIScreen.main.bounds.size.width))
			return rpxValue * baseWidth / 750
		}
		const size = parseFloat(parsedValue)
		if (isNaN(size) || size <= 0) {
			return null
		}
		return size
	}

	static normalizeFontWeight(value: string): string {
		if (value == null) {
			return 'normal'
		}
		const normalizedValue = value.trim().toLowerCase()
		return normalizedValue == '' ? 'normal' : normalizedValue
	}

	static normalizeFontStyle(value: string): string {
		if (value == null) {
			return 'normal'
		}
		return value.trim().toLowerCase() == 'italic' ? 'italic' : 'normal'
	}

	static normalizeFontFamily(value: string): string {
		if (value == null) {
			return ''
		}
		return value.trim()
	}

	private static buildCustomFont(family: string, size: CGFloat, fontWeight: string, fontStyle: string): UIFont | null {
		return UTSiOS.getFontFamily(family, size, fontWeight, fontStyle)
	}

	private static buildSystemFont(size: CGFloat, fontWeight: string, fontStyle: string): UIFont {
		if (fontStyle == 'italic') {
			if (this.isBoldFontWeight(fontWeight)) {
				const boldItalicFont = UIFont(name = 'Helvetica-BoldOblique', size = size)
				if (boldItalicFont != null) {
					return boldItalicFont!
				}
			}
			return UIFont.italicSystemFont(ofSize = size)
		}
		switch (fontWeight) {
			case '100':
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.ultraLight)
			case '200':
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.thin)
			case '300':
			case 'lighter':
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.light)
			case '500':
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.medium)
			case '600':
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.semibold)
			case '700':
			case 'bold':
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.bold)
			case '800':
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.heavy)
			case '900':
			case 'bolder':
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.black)
			default:
				return UIFont.systemFont(ofSize = size, weight = UIFont.Weight.regular)
		}
	}

	private static isBoldFontWeight(value: string): boolean {
		return value == 'bold' || value == 'bolder' || value == '600' || value == '700' || value == '800' || value == '900'
	}

	private static buildFontFamilyCandidates(value: string): string[] {
		const candidates: string[] = []
		if (value == null || value.trim() == '') {
			return candidates
		}
		const families = value.split(',')
		for (let i = 0; i < families.length; i++) {
			const family = this.trimFontFamilyToken(families[i].trim())
			if (family != '' && candidates.indexOf(family) < 0) {
				candidates.push(family)
			}
		}
		return candidates
	}

	private static trimFontFamilyToken(value: string): string {
		if (value.length >= 2) {
			const firstChar = value.charAt(0)
			const lastChar = value.charAt(value.length - 1)
			if ((firstChar == '\'' && lastChar == '\'') || (firstChar == '"' && lastChar == '"')) {
				return value.substring(1, value.length - 1).trim()
			}
		}
		return value
	}
}

export class NativeInputView implements UITextFieldDelegate {

	element : UniNativeViewElement;
	textField : UniInputView | null = null;
	private state: UniEditSharedState
	private keyboardController: UniEditKeyboardController
	private elementImpl: UniInputElementImpl | null = null

	constructor(element : UniNativeViewElement) {
		// 接收组件传递过来的UniNativeViewElement
		this.element = element;
		this.state = new UniEditSharedState()
		this.keyboardController = new UniEditKeyboardController(element, this.state, (elementHeight: number): number => {
			return Math.max(0, elementHeight)
		})
		super.init()
		this.bindView();
		this.bindElementImpl()
	}

	// element 绑定原生view
	bindView() {
		// 初始化原生 textField
		this.textField = new UniInputView()
		const textField = this.textField!
		this.keyboardController.setCursorBottomOffsetResolver((elementHeight: number): number => {
			const cursorBottomOffset = NSNumber(value = Double(textField.caretBottomOffset()))
			if (cursorBottomOffset > 0) {
				return cursorBottomOffset
			}
			return Math.max(0, elementHeight)
		})
		this.textField!.textColor = UIColor.black;
		UniInputFontUtil.applyInputFont(this.textField, this.state.fontSize, this.state.fontWeight, this.state.fontStyle, this.state.fontFamily)
		// 设置delegate对象
		this.textField!.delegate = this;
		// UniNativeViewElement 绑定原生 view
		this.element.bindIOSView(this.textField!);
		// 监听通知
		this.addObserver()
	}

	destroy() {
		// 移除通知监听
	    NotificationCenter.default.removeObserver(this, name= UITextField.textDidChangeNotification, object= this.textField)
		NotificationCenter.default.removeObserver(this, name= UIResponder.keyboardWillShowNotification, object= null)
		NotificationCenter.default.removeObserver(this, name= UIResponder.keyboardWillHideNotification, object= null)
		NotificationCenter.default.removeObserver(this, name= UIResponder.keyboardWillChangeFrameNotification, object= null)
		this.elementImpl?.setNativeInputView(null)
		this.elementImpl = null
		this.keyboardController.destroy()
		// 释放 UTS 实例对象，避免内存泄露
		UTSiOS.destroyInstance(this)
		
	}   
	
	// 监听通知
	addObserver() {
		if (this.textField == null) { return }
		NotificationCenter.default.addObserver(this, selector= #selector(textFieldDidChange), name= UITextField.textDidChangeNotification, object= this.textField)
		NotificationCenter.default.addObserver(this, selector= #selector(keyboardWillShow), name= UIResponder.keyboardWillShowNotification, object= null)
		NotificationCenter.default.addObserver(this, selector= #selector(keyboardWillHide), name= UIResponder.keyboardWillHideNotification, object= null)
		NotificationCenter.default.addObserver(this, selector= #selector(keyboardFrameWillChange), name= UIResponder.keyboardWillChangeFrameNotification, object= null)
	}

	private bindElementImpl() {
		const elementImpl = findInputElementImpl(this.element)
		if (elementImpl == null) {
			return
		}
		this.elementImpl = elementImpl
		this.elementImpl.setNativeInputView(this)
	}

	private normalizeByMaxLength(value: string): string {
		if (this.state.maxLength >= 0 && value.count > this.state.maxLength) {
			return String(value.prefix(this.state.maxLength.intValue))
		}
		return value
	}
	
	// 处理输入变动通知
	@objc textFieldDidChange(notification: NSNotification) {
		if (this.textField == null) {
			return;
		}
		let range = this.textField!.markedTextRange
		let beginning = this.textField!.beginningOfDocument
		let selectedRange = this.textField!.selectedTextRange
		let selectionStart = selectedRange?.start
		let cursor = this.textField!.offset(from = beginning, to = selectionStart ?? beginning)
		let cursorValue = NSNumber(value = cursor)
		this.state.cursor = cursorValue
		if (range != null) {
			let newText = this.textField!.text(in = range!)
				if (newText != null && newText!.count > 0) {
					dispatchNativeViewEvent(this.element, 'input', {
						'value': this.textField!.text ?? '',
						'cursor': cursorValue,
						'composing': true
					} as UTSJSONObject)
				return
			}      
		}
		let textValue: string = this.textField!.text ?? ""
		const normalizedValue = this.normalizeByMaxLength(textValue)
		if (normalizedValue != textValue) {
			textValue = normalizedValue
			this.textField!.text = textValue
		}
		this.elementImpl?.updateValueFromNative(textValue)
		// 发送 inputEvent
		dispatchNativeViewEvent(this.element, 'input', {
			'value': textValue,
			'cursor': cursorValue,
			'composing': false
		} as UTSJSONObject)
	}
	
	// UITextFieldDelegate 相关
	textFieldDidBeginEditing(textField: UITextField) {
	    this.state.beginEditValue = textField.text ?? ""
		this.keyboardController.beginEditing()
		this.state.isFocusing = true
		this.dispatchFocus()
		this.applySelectionRange()
	}
	
	textFieldDidEndEditing(textField: UITextField) {
		const cursor = this.getCursorPosition()
		if (this.state.beginEditValue != textField.text) {
			dispatchNativeViewEvent(this.element, 'change', {
				'value': this.textField!.text ?? ''
			} as UTSJSONObject)
		}
		dispatchNativeViewEvent(this.element, 'blur', {
			'value': this.textField!.text ?? '',
			'cursor': cursor
		} as UTSJSONObject)
		this.keyboardController.scheduleDismissReset()
		this.state.isFocusing = false
		this.state.beginEditValue = '';
	}

	textFieldShouldReturn(textField: UITextField): boolean {
		dispatchNativeViewEvent(this.element, 'confirm', {
			'value': this.textField!.text ?? ''
		} as UTSJSONObject)
		if (!this.state.confirmHold) {
			textField.resignFirstResponder()
		}
		return true
	}

	@objc keyboardWillShow(notification: NSNotification) {
		this.keyboardController.handleKeyboardWillShow(notification, this.textField != null && this.textField!.isFirstResponder)
	}

	@objc keyboardWillHide(notification: NSNotification) {
		this.keyboardController.handleKeyboardWillHide(notification)
	}

	@objc keyboardFrameWillChange(notification: NSNotification) {
		this.keyboardController.handleKeyboardFrameWillChange(notification, (keyboardHeight: number, duration: number) => {
			dispatchKeyboardHeightChangeEvent(this.element, keyboardHeight, duration)
		})
	}
	
	// input 初始内容
	updateValue(value: string) {
		if (this.textField == null) return
		const normalizedValue = this.normalizeByMaxLength(value)
		this.textField!.text = normalizedValue
		this.elementImpl?.updateValueFromNative(normalizedValue)
		if (this.textField!.isFirstResponder) {
			this.applySelectionRange()
		}
	}
	
	// 更新input 是否禁用
	updateDisabled(value: boolean) {
		if (this.textField == null) return
		this.textField!.isEnabled = !value
		this.elementImpl?.updateDisabledFromNative(value)
	}
	
	// 更新input 的类型
	updateType(value: string) {
		if (this.textField == null) return
		this.elementImpl?.updateTypeFromNative(value)
		const suppressKeyboard = value == 'none'
		this.textField!.setKeyboardSuppressed(suppressKeyboard)
		if (suppressKeyboard) {
			this.textField!.keyboardType = UIKeyboardType.default
			return
		}
		
		// 根据类型设置键盘类型
		switch (value) {
			case "number":
				this.textField!.keyboardType = UIKeyboardType.numberPad
				break
			case "digit":
				this.textField!.keyboardType = UIKeyboardType.decimalPad
				break
			case "tel":
				this.textField!.keyboardType = UIKeyboardType.phonePad
				break
			case "email":
				this.textField!.keyboardType = UIKeyboardType.emailAddress
				break
			case "search":
				this.textField!.keyboardType = UIKeyboardType.webSearch
				break
			case "url":
				this.textField!.keyboardType = UIKeyboardType.URL
				break
			default:
				this.textField!.keyboardType = UIKeyboardType.default
		}
	}
	
	// 更新input 是否是密码类型
	updatePassword(value: boolean) {
		if (this.textField == null) return
		this.textField!.isSecureTextEntry = value
	}
	
	// 更新input 最大输入长度，0和正数为合法值，非法值的时候不限制最大长度
	updateMaxLength(value: number) {
		this.state.maxLength = value
		if (this.textField != null) {
			const textValue = this.textField!.text ?? ''
			const normalizedValue = this.normalizeByMaxLength(textValue)
			if (normalizedValue != textValue) {
				this.updateValue(normalizedValue)
			}
		}
	}
	
	// 更新input 光标与键盘的距离，单位 px 。实际生效值会受可视区域高度限制
	updateCursorSpacing(value: number) {
		this.state.cursorSpacing = Math.max(0, value)
		this.keyboardController.refreshPosition()
	}
	
	// 更新input 光标颜色
	updateCursorColor(value: string) {
		if (this.textField == null || value == "") return
		
		// 解析颜色字符串并设置 tintColor
		// 支持 #RRGGBB 格式
		this.textField!.tintColor = UTSiOS.colorWithString(value)
	}
	
	// 更新input 自动获取焦点，与focus属性对比，此属性只会首次生效。
	updateAutoFocus(value: boolean) {
		this.elementImpl?.updateAutofocusFromNative(value)
		if (value && this.textField != null) {
			this.textField!.becomeFirstResponder()
		}
	}
	
	// 更新input 获取焦点
	updateFocus(value: boolean) {
		if (this.textField == null) return
		
		if (value) {
			this.textField!.becomeFirstResponder()
		} else {
			this.textField!.resignFirstResponder()
		}
	}
	
	// 更新input 键盘右下角按钮的文字，仅在 type为text 时生效。
	updateConfirmType(value: string) {
		if (this.textField == null) return  
		
		// 设置键盘返回键类型
		switch (value) {
			case "send":
				this.textField!.returnKeyType = UIReturnKeyType.send
				break
			case "search":
				this.textField!.returnKeyType = UIReturnKeyType.search
				break
			case "next":
				this.textField!.returnKeyType = UIReturnKeyType.next
				break
			case "go":
				this.textField!.returnKeyType = UIReturnKeyType.go
				break
			case "done":
				this.textField!.returnKeyType = UIReturnKeyType.done
				break
			default:
				this.textField!.returnKeyType = UIReturnKeyType.default
		}
	}
	
	// 更新input 点击键盘右下角按钮时是否保持键盘不收起
	updateConfirmHold(value: boolean) {
		this.state.confirmHold = value
	}
	
	// 更新input focus时的光标位置
	updateCursor(value: number) {
		if (this.textField == null) return
		this.state.cursor = value
		if (this.textField!.isFirstResponder) {
			this.applySelectionRange()
		}
	}
	
	// 更新input 光标起始位置，自动聚集时有效，需与selection-end搭配使用
	updateSelectionStart(value: number) {
		this.state.selectionStart = value
		this.applySelectionRange()
	}
	
	// 更新input 光标结束位置，自动聚集时有效，需与selection-start搭配使用
	updateSelectionEnd(value: number) {
		this.state.selectionEnd = value
		this.applySelectionRange()
	}
	
	// 更新input 键盘弹起时，是否自动上推页面
	updateAdjustPosition(value: boolean) {
		this.state.adjustPosition = value
		if (!value) {
			this.keyboardController.resetPosition()
			return
		}
		this.keyboardController.refreshPosition()
	}
	
	// 更新input focus时，点击页面的时候不收起键盘
	updateHoldKeyboard(value: boolean) {
		this.state.holdKeyboard = value
		if (this.textField != null) {
			this.textField!.holdKeyboardEnabled = value
		}
	}

	handlePageTouchEndFocus() {
		if (this.textField == null) return
		if (!this.state.holdKeyboard && this.textField!.isFirstResponder) {
			this.textField!.resignFirstResponder()
		}
	}

	updateFontSize(value: string) {
		const size = UniInputFontUtil.parseFontSize(value, this.element.uniPage.pageBody.width) ?? UNI_INPUT_DEFAULT_FONT_SIZE
		this.state.fontSize = size
		this.applyFont()
	}

	updateColor(value: string) {
		if (this.textField == null || value == null || value == '') return
		this.textField!.textColor = UTSiOS.colorWithString(value)
	}

	updateLineHeight(value?: string) {
		// UITextField 单行输入框不直接支持 line-height，这里先保留空实现
	}

	updateLetterSpacing(value: string) {
		// 当前 iOS input 插件先保留空实现，避免缺失方法导致运行时崩溃
	}

	updateFontWeight(value: string) {
		this.state.fontWeight = UniInputFontUtil.normalizeFontWeight(value)
		this.applyFont()
	}

	updateFontStyle(value: string) {
		this.state.fontStyle = UniInputFontUtil.normalizeFontStyle(value)
		this.applyFont()
	}

	updateFontFamily(value: string) {
		this.state.fontFamily = UniInputFontUtil.normalizeFontFamily(value)
		this.applyFont()
	}

	updateTextAlign(value: string) {
		if (this.textField == null) return
		switch (value) {
			case 'right':
				this.textField!.textAlignment = NSTextAlignment.right
				break
			case 'center':
				this.textField!.textAlignment = NSTextAlignment.center
				break
			default:
				this.textField!.textAlignment = NSTextAlignment.left
		}
	}

	applySelectionRange() {
		if (this.textField == null) return
		if (this.state.selectionStart >= 0 && this.state.selectionEnd >= 0) {
			this.textField!.setSelectionRange(start = this.state.selectionStart.intValue, end = this.state.selectionEnd.intValue)
			return
		}
		const textLength = (this.textField!.text ?? '').count
		let cursor = textLength
		if (this.state.cursor >= 0) {
			cursor = this.state.cursor.intValue
			if (cursor > textLength) {
				cursor = textLength
			}
		}
		this.textField!.setSelectionRange(start = cursor, end = cursor)
	}

	private dispatchFocus() {
		dispatchNativeViewEvent(this.element, 'focus', {
			'value': this.textField?.text ?? '',
			'height': this.state.keyboardHeight
		} as UTSJSONObject)
	}

	private getCursorPosition(): number {
		if (this.textField == null) {
			return this.state.cursor
		}
		const beginning = this.textField!.beginningOfDocument
		const selectedRange = this.textField!.selectedTextRange
		const selectionStart = selectedRange?.start
		this.state.cursor = NSNumber(value = this.textField!.offset(from = beginning, to = selectionStart ?? beginning))
		return this.state.cursor
	}

	private applyFont() {
		UniInputFontUtil.applyInputFont(this.textField, this.state.fontSize, this.state.fontWeight, this.state.fontStyle, this.state.fontFamily)
	}
}

export class NativeTextareaView implements UITextViewDelegate {
	element : UniNativeViewElement;
	textView : UniTextareaView | null = null;
	private state: UniEditSharedState
	textColor: UIColor = UIColor.black
	textAlign: NSTextAlignment = NSTextAlignment.left
	lineHeight: number = 0
	letterSpacing: number = 0
	autoHeight: boolean = false
	requestedAutoHeight: boolean = false
	explicitHeight: number = 150
	hasExplicitHeight: boolean = false
	minHeight: number = -1
	hasExplicitMinHeight: boolean = false
	maxHeightLimit: number = -1
	hasExplicitMaxHeight: boolean = false
	defaultHeight: number = 150
	private keyboardController: UniEditKeyboardController
	private elementImpl: UniTextareaElementImpl | null = null

	constructor(element : UniNativeViewElement) {
		this.element = element;
		this.state = new UniEditSharedState()
		this.keyboardController = new UniEditKeyboardController(element, this.state, (elementHeight: number): number => {
			return Math.max(0, elementHeight)
		})
		super.init()
		this.bindView();
		this.bindElementImpl()
	}

	bindView() {
		
		this.textView = new UniTextareaView()
		const textView = this.textView!
		this.keyboardController.setCursorBottomOffsetResolver((elementHeight: number): number => {
			const cursorBottomOffset = NSNumber(value = Double(textView.caretBottomOffset()))
			if (cursorBottomOffset > 0) {
				return cursorBottomOffset
			}
			return Math.max(0, elementHeight)
		})
		this.textView!.delegate = this;
		this.textView!.textColor = UIColor.black
		this.textView!.backgroundColor = UIColor.clear
		this.textView!.textContainerInset = UIEdgeInsets.zero
		this.textView!.textContainer.lineFragmentPadding = 0
		this.textView!.clipsToBounds = true
		this.textView!.isScrollEnabled = true
		this.element.bindIOSView(this.textView!);
		this.applyTextStyles(true)
		this.updateTextareaHeight()
		this.addObserver()
	}

	destroy() {
		NotificationCenter.default.removeObserver(this, name= UIResponder.keyboardWillShowNotification, object= null)
		NotificationCenter.default.removeObserver(this, name= UIResponder.keyboardWillHideNotification, object= null)
		NotificationCenter.default.removeObserver(this, name= UIResponder.keyboardWillChangeFrameNotification, object= null)
		this.elementImpl?.setNativeTextareaView(null)
		this.elementImpl = null
		this.keyboardController.destroy()
		UTSiOS.destroyInstance(this)
	}

	private bindElementImpl() {
		const elementImpl = findTextareaElementImpl(this.element)
		if (elementImpl == null) {
			return
		}
		this.elementImpl = elementImpl
		this.elementImpl.setNativeTextareaView(this)
	}

	addObserver() {
		NotificationCenter.default.addObserver(this, selector= #selector(keyboardWillShow), name= UIResponder.keyboardWillShowNotification, object= null)
		NotificationCenter.default.addObserver(this, selector= #selector(keyboardWillHide), name= UIResponder.keyboardWillHideNotification, object= null)
		NotificationCenter.default.addObserver(this, selector= #selector(keyboardFrameWillChange), name= UIResponder.keyboardWillChangeFrameNotification, object= null)
	}

	textViewDidBeginEditing(textView: UITextView) {
		this.state.beginEditValue = textView.text ?? ""
		this.keyboardController.beginEditing()
		this.state.isFocusing = true
		this.dispatchFocus()
		this.applySelectionRange()
	}

	textViewDidChange(textView: UITextView) {
		let textValue = textView.text ?? ''
		const markedTextRange = textView.markedTextRange
		const cursor = this.getCursorPosition()
		if (markedTextRange != null) {
			const markedText = textView.text(in = markedTextRange!)
				if (markedText != null && markedText!.count > 0) {
					dispatchNativeViewEvent(this.element, 'input', {
						'value': textValue,
						'cursor': cursor,
						'composing': true
					} as UTSJSONObject)
				this.updateTextareaHeight()
				return
			}
		}

		const normalizedValue = this.normalizeByMaxLength(textValue)
		if (normalizedValue != textValue) {
			textValue = normalizedValue
			this.textView!.text = textValue
		}
		this.elementImpl?.updateValueFromNative(textValue)

		if (textValue.endsWith('\n') && this.textView!.returnKeyType != UIReturnKeyType.default) {
			textValue = textValue.substring(0, textValue.length - 1)
			this.textView!.text = textValue
			this.applyTextStyles()
			dispatchNativeViewEvent(this.element, 'confirm', {
				'value': textValue
			} as UTSJSONObject)
			if (!this.state.confirmHold) {
				this.textView!.resignFirstResponder()
			}
		}

		this.applyTextStyles()
		dispatchNativeViewEvent(this.element, 'input', {
			'value': this.textView!.text ?? '',
			'cursor': cursor,
			'composing': false
		} as UTSJSONObject)
		this.updateTextareaHeight()
		this.dispatchLineChange()
	}

	textViewDidEndEditing(textView: UITextView) {
		const cursor = this.getCursorPosition()
		if (this.state.beginEditValue != (textView.text ?? '')) {
			dispatchNativeViewEvent(this.element, 'change', {
				'value': this.textView!.text ?? ''
			} as UTSJSONObject)
		}
		dispatchNativeViewEvent(this.element, 'blur', {
			'value': this.textView!.text ?? '',
			'cursor': cursor
		} as UTSJSONObject)
		this.keyboardController.scheduleDismissReset()
		this.state.isFocusing = false
		this.state.beginEditValue = ''
	}

	@objc keyboardWillShow(notification: NSNotification) {
		this.keyboardController.handleKeyboardWillShow(notification, this.textView != null && this.textView!.isFirstResponder)
	}

	@objc keyboardWillHide(notification: NSNotification) {
		this.keyboardController.handleKeyboardWillHide(notification)
	}

	@objc keyboardFrameWillChange(notification: NSNotification) {
		this.keyboardController.handleKeyboardFrameWillChange(notification, (keyboardHeight: number, duration: number) => {
			dispatchKeyboardHeightChangeEvent(this.element, keyboardHeight, duration)
		})
	}

	private normalizeByMaxLength(value: string): string {
		if (this.state.maxLength >= 0 && value.count > this.state.maxLength) {
			return String(value.prefix(this.state.maxLength.intValue))
		}
		return value
	}

	updateValue(value: string) {
		if (this.textView == null) return
		const normalizedValue = this.normalizeByMaxLength(value)
		this.textView!.text = normalizedValue
		this.elementImpl?.updateValueFromNative(normalizedValue)
		this.applyTextStyles()
		this.updateTextareaHeight()
		this.dispatchLineChange()
		if (this.textView!.isFirstResponder) {
			this.applySelectionRange()
		}
	}

	updateDisabled(value: boolean) {
		if (this.textView == null) return
		this.textView!.isEditable = !value
		this.textView!.isSelectable = !value
		this.elementImpl?.updateDisabledFromNative(value)
	}

	updateMaxLength(value: number) {
		this.state.maxLength = value
		if (this.textView != null && this.state.maxLength >= 0) {
			const textValue = this.textView!.text ?? ''
			const normalizedValue = this.normalizeByMaxLength(textValue)
			if (normalizedValue != textValue) {
				this.updateValue(normalizedValue)
			}
		}
	}

	updateCursorSpacing(value: number) {
		this.state.cursorSpacing = Math.max(0, value)
		this.keyboardController.refreshPosition()
	}

	updateCursorColor(value: string) {
		if (this.textView == null || value == '') return
		this.textView!.tintColor = UTSiOS.colorWithString(value)
	}

	updateAutoFocus(value: boolean) {
		this.elementImpl?.updateAutofocusFromNative(value)
		if (value && this.textView != null) {
			this.textView!.becomeFirstResponder()
		}
	}

	updateFocus(value: boolean) {
		if (this.textView == null) return
		if (value) {
			this.textView!.becomeFirstResponder()
		} else {
			this.textView!.resignFirstResponder()
		}
	}

	updateConfirmType(value: string) {
		if (this.textView == null) return
		switch (value) {
			case "send":
				this.textView!.returnKeyType = UIReturnKeyType.send
				break
			case "search":
				this.textView!.returnKeyType = UIReturnKeyType.search
				break
			case "next":
				this.textView!.returnKeyType = UIReturnKeyType.next
				break
			case "go":
				this.textView!.returnKeyType = UIReturnKeyType.go
				break
			case "done":
				this.textView!.returnKeyType = UIReturnKeyType.done
				break
			default:
				this.textView!.returnKeyType = UIReturnKeyType.default
		}
	}

	updateConfirmHold(value: boolean) {
		this.state.confirmHold = value
	}

	updateAutoHeight(value: boolean) {
		this.requestedAutoHeight = value
		this.refreshAutoHeightBehavior()
	}

	updateCursor(value: number) {
		if (this.textView == null) return
		this.state.cursor = value
		if (this.textView!.isFirstResponder) {
			this.applySelectionRange()
		}
	}

	updateSelectionStart(value: number) {
		this.state.selectionStart = value
		this.applySelectionRange()
	}

	updateSelectionEnd(value: number) {
		this.state.selectionEnd = value
		this.applySelectionRange()
	}

	updateAdjustPosition(value: boolean) {
		this.state.adjustPosition = value
		if (!value) {
			this.keyboardController.resetPosition()
			return
		}
		this.keyboardController.refreshPosition()
	}

	updateHoldKeyboard(value: boolean) {
		this.state.holdKeyboard = value
		if (this.textView != null) {
			this.textView!.holdKeyboardEnabled = value
		}
	}

	updateFontSize(value: string) {
		const size = UniInputFontUtil.parseFontSize(value, this.element.uniPage.pageBody.width) ?? UNI_INPUT_DEFAULT_FONT_SIZE
		this.state.fontSize = size
		this.applyTextStyles(true)
		this.updateTextareaHeight()
		this.dispatchLineChange()
	}

	updateColor(value: string) {
		if (value == null || value == '') return
		this.textColor = UTSiOS.colorWithString(value)
		this.applyTextStyles()
	}

	updateLineHeight(value?: string) {
		if (value == null || value == '') {
			this.lineHeight = 0
			this.applyTextStyles()
			this.updateTextareaHeight()
			this.dispatchLineChange()
			return
		}
		const numericValue = parseFloat(value)
		if (value.endsWith('px')) {
			if (!isNaN(numericValue)) {
				this.lineHeight = numericValue
			}
		} else if (value.endsWith('em') || !isNaN(numericValue)) {
			if (!isNaN(numericValue)) {
				this.lineHeight = numericValue * this.state.fontSize
			}
		}
		this.applyTextStyles()
		this.updateTextareaHeight()
		this.dispatchLineChange()
	}

	updateLetterSpacing(value: string) {
		if (value == null || value == '') {
			this.letterSpacing = 0
			this.applyTextStyles()
			return
		}
		const parsed = parseFloat(value)
		if (!isNaN(parsed)) {
			this.letterSpacing = parsed
			this.applyTextStyles()
		}
	}

	updateFontWeight(value: string) {
		this.state.fontWeight = UniInputFontUtil.normalizeFontWeight(value)
		this.applyTextStyles(true)
		this.updateTextareaHeight()
		this.dispatchLineChange()
	}

	updateFontStyle(value: string) {
		this.state.fontStyle = UniInputFontUtil.normalizeFontStyle(value)
		this.applyTextStyles(true)
		this.updateTextareaHeight()
		this.dispatchLineChange()
	}

	updateFontFamily(value: string) {
		this.state.fontFamily = UniInputFontUtil.normalizeFontFamily(value)
		this.applyTextStyles(true)
		this.updateTextareaHeight()
		this.dispatchLineChange()
	}

	updateTextAlign(value: string) {
		switch (value) {
			case 'right':
				this.textAlign = NSTextAlignment.right
				break
			case 'center':
				this.textAlign = NSTextAlignment.center
				break
			default:
				this.textAlign = NSTextAlignment.left
		}
		this.applyTextStyles()
	}

	updatePadding(paddingTop?: string, paddingRight?: string, paddingBottom?: string, paddingLeft?: string) {
		if (this.textView == null) return
		const inset = this.resolvePaddingInset(paddingTop, paddingRight, paddingBottom, paddingLeft)
		const currentInset = this.textView!.textContainerInset
		if (
			currentInset.top == inset.top &&
			currentInset.left == inset.left &&
			currentInset.bottom == inset.bottom &&
			currentInset.right == inset.right
		) {
			return
		}

		this.textView!.textContainerInset = inset
		this.updateTextareaHeight()
		this.dispatchLineChange()
		if (this.state.isFocusing && this.state.adjustPosition) {
			this.keyboardController.refreshPosition()
		}
	}

	updateHeight(value: string) {
		const height = parsePixelStyleValue(value)
		this.hasExplicitHeight = height != null
		if (height == null) {
			this.explicitHeight = this.defaultHeight
		} else if (height! <= 0) {
			this.explicitHeight = this.defaultHeight
		} else {
			this.explicitHeight = height!
		}
		this.refreshAutoHeightBehavior()
	}

	updateMinHeight(value: string) {
		const height = parsePixelStyleValue(value)
		this.hasExplicitMinHeight = height != null
		this.minHeight = height == null ? -1 : height
		this.refreshAutoHeightBehavior()
	}

	updateMaxHeight(value: string) {
		const height = parsePixelStyleValue(value)
		this.hasExplicitMaxHeight = height != null
		this.maxHeightLimit = height == null ? -1 : height
		this.refreshAutoHeightBehavior()
	}

	handlePageTouchEndFocus() {
		if (this.textView == null) return
		if (!this.state.holdKeyboard && this.textView!.isFirstResponder) {
			this.textView!.resignFirstResponder()
		}
	}

	private applySelectionRange() {
		if (this.textView == null) return
		if (this.state.selectionStart >= 0 && this.state.selectionEnd >= 0) {
			this.textView!.setSelectionRange(start = this.state.selectionStart.intValue, end = this.state.selectionEnd.intValue)
			return
		}
		const textLength = (this.textView!.text ?? '').count
		let cursor = textLength
		if (this.state.cursor >= 0) {
			cursor = this.state.cursor.intValue
			if (cursor > textLength) {
				cursor = textLength
			}
		}
		this.textView!.setSelectionRange(start = cursor, end = cursor)
	}

	private applyTextStyles(resolveFont: boolean = false) {
		if (this.textView == null) return
		if (resolveFont) {
			UniInputFontUtil.applyTextareaFont(this.textView, this.state.fontSize, this.state.fontWeight, this.state.fontStyle, this.state.fontFamily)
		}
		this.textView!.styledTextColor = this.textColor
		this.textView!.lineHeightValue = this.lineHeight > 0 ? CGFloat(this.lineHeight) : null
		this.textView!.letterSpacingValue = this.letterSpacing != 0 ? CGFloat(this.letterSpacing) : null
		this.textView!.textAlignment = this.textAlign
		this.textView!.applyTextStyle()
	}

	private updateTextareaHeight() {
		if (this.textView == null) return
		if (this.requestedAutoHeight && this.shouldUseFlexAutoHeightFallback()) {
			this.element.style.setProperty('height', '100%')
			return
		}
		const contentHeight = this.autoHeight
			? NSNumber(value = Double(this.textView!.calculatedContentHeight()))
			: -1
		const height = this.resolveTextareaHeight()
		this.element.style.setProperty('height', `${height}px`)
		if (this.textView != null) {
			this.textView!.isScrollEnabled = this.autoHeight ? contentHeight > height : true
		}
	}

	private isWrapperFlexGrow1(): boolean {
		const wrapperEl = this.element.parentElement?.parentElement
		if (wrapperEl == null) return false
		let flexGrow = wrapperEl.style.getPropertyValue('flex-grow')
		if (flexGrow == '') {
			flexGrow = wrapperEl.style.getPropertyValue('flexGrow')
		}
		const normalizedFlexGrow = parseFloat(flexGrow)
		const wrapperParentHeight = wrapperEl.parentElement?.style.getPropertyValue('height')
		return !isNaN(normalizedFlexGrow) && normalizedFlexGrow == 1 && wrapperParentHeight != 'auto'
	}

	private hasExplicitHeightConstraint(): boolean {
		return this.hasExplicitHeight || this.hasExplicitMinHeight || this.hasExplicitMaxHeight
	}

	private shouldUseFlexAutoHeightFallback(): boolean {
		return this.isWrapperFlexGrow1() && !this.hasExplicitHeightConstraint()
	}

	private shouldDisableAutoHeight(): boolean {
		return this.shouldUseFlexAutoHeightFallback()
	}

	private refreshAutoHeightBehavior() {
		this.autoHeight = this.requestedAutoHeight && !this.shouldDisableAutoHeight()
		if (this.textView != null) {
			this.textView!.isScrollEnabled = !this.autoHeight
		}
		this.updateTextareaHeight()
	}

	private resolvePaddingInset(paddingTop?: string, paddingRight?: string, paddingBottom?: string, paddingLeft?: string): UIEdgeInsets {
		let top = 0
		let right = 0
		let bottom = 0
		let left = 0

		const topValue = normalizePaddingStyleValue(paddingTop)
		if (topValue != null) {
			top = topValue
		}
		const rightValue = normalizePaddingStyleValue(paddingRight)
		if (rightValue != null) {
			right = rightValue
		}
		const bottomValue = normalizePaddingStyleValue(paddingBottom)
		if (bottomValue != null) {
			bottom = bottomValue
		}
		const leftValue = normalizePaddingStyleValue(paddingLeft)
		if (leftValue != null) {
			left = leftValue
		}

		return UIEdgeInsets(
			top = CGFloat(top),
			left = CGFloat(left),
			bottom = CGFloat(bottom),
			right = CGFloat(right)
		)
	}

	private resolveTextareaHeight(): number {
		let height = this.explicitHeight
		if (this.autoHeight) {
			height = NSNumber(value = Double(this.textView!.calculatedContentHeight()))
		}
		if (height <= 0) {
			height = this.defaultHeight
		}
		if (this.minHeight >= 0 && height < this.minHeight) {
			height = this.minHeight
		}
		if (this.maxHeightLimit >= 0 && height > this.maxHeightLimit) {
			height = this.maxHeightLimit
		}
		return height
	}

	private dispatchLineChange() {
		if (this.textView == null) return
		const contentHeight = NSNumber(value = Double(this.textView!.calculatedContentHeight()))
		const detail = {
			'lineCount': this.textView!.currentLineCount(),
			'height': contentHeight
		} as UTSJSONObject
		dispatchNativeViewEvent(this.element, 'linechange', detail)
	}

	private dispatchFocus() {
		dispatchNativeViewEvent(this.element, 'focus', {
			'value': this.textView?.text ?? '',
			'height': this.state.keyboardHeight
		} as UTSJSONObject)
	}

	private getCursorPosition(): number {
		if (this.textView == null) {
			return this.state.cursor
		}
		const beginning = this.textView!.beginningOfDocument
		const selectedRange = this.textView!.selectedTextRange
		const selectionStart = selectedRange?.start
		this.state.cursor = NSNumber(value = this.textView!.offset(from = beginning, to = selectionStart ?? beginning))
		return this.state.cursor
	}
}
