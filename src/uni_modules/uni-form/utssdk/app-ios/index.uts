import { UIReturnKeyType, UIKeyboardType, UITextField, UITextFieldDelegate, UITextView, UITextViewDelegate, UIResponder, UIScreen, UIScrollView, UIView } from 'UIKit';
import { NotificationCenter, NSNotification, NSNumber, NSValue } from 'Foundation';
import { CGPoint, CGFloat } from 'CoreFoundation';
import { JSExport } from 'JavaScriptCore';

function toBoolean(value: any): boolean {
	if (typeof value == 'boolean') {
		return value
	}
	if (typeof value == 'string') {
		return value == 'true'
	}
	if (typeof value == 'number') {
		return value != 0
	}
	return value != null
}

function parsePixelStyleValue(value?: string): number | null {
	if (value == null) {
		return null
	}
	const normalizedValue = value.trim()
	if (normalizedValue == '') {
		return null
	}
	if (normalizedValue.endsWith('px')) {
		const pixelValue = parseFloat(normalizedValue)
		return isNaN(pixelValue) ? null : pixelValue
	}
	const numberValue = parseFloat(normalizedValue)
	return isNaN(numberValue) ? null : numberValue
}

function normalizePaddingStyleValue(value?: string): number | null {
	const pixelValue = parsePixelStyleValue(value)
	if (pixelValue == null) {
		return null
	}
	return Math.max(0, pixelValue)
}

function normalizeElementStringValue(value: any): string {
	if (value == null) {
		return ''
	}
	if (typeof value == 'string') {
		return value as string
	}
	if (typeof value == 'number') {
		return `${value as number}`
	}
	if (typeof value == 'boolean') {
		return (value as boolean) ? 'true' : 'false'
	}
	return ''
}

function dispatchNativeViewEvent(element: UniNativeViewElement, type: string, detail: UTSJSONObject) {
	const event = new UniNativeViewEvent(type, detail)
	element.dispatchEvent(event)
}

function dispatchKeyboardHeightChangeEvent(element: UniNativeViewElement, height: number, duration: number) {
	dispatchNativeViewEvent(element, 'keyboardheightchange', {
		'height': height,
		'duration': duration
	} as UTSJSONObject)
}

class UniAdjustPositionParentSnapshot {
	index: number = -1
	y: number = 0
	height: number = 0
	scrollTop: number = 0
	scrollLeft: number = 0
	scrollHeight: number = 0
}

class UniAdjustPositionParentPlan {
	index: number = -1
	scrollTop: number = 0
}

class UniAdjustPositionPlan {
	shouldAdjust: boolean = false
	parentPlans: UniAdjustPositionParentPlan[] = []
	rootTranslateY: number = 0
}

class UniNativeScrollParentPlan {
	index: number = -1
	originOffsetX: CGFloat = 0.0
	originOffsetY: CGFloat = 0.0
	offsetY: CGFloat = 0.0
}

class UniNativeScrollPlan {
	parentPlans: UniNativeScrollParentPlan[] = []
	remainingDistance: CGFloat = 0.0
}

type UniCursorBottomOffsetResolver = (elementHeight: number) => number

function createAdjustPositionPlan(
	windowHeight: number,
	keyboardHeight: number,
	elementY: number,
	targetBottomOffset: number,
	cursorSpacing: number,
	parents: UniAdjustPositionParentSnapshot[],
	allowRootTranslate: boolean
): UniAdjustPositionPlan {
	const plan = new UniAdjustPositionPlan()
	const targetBottomY = elementY + targetBottomOffset
	let needMoreScrollDistance = keyboardHeight + cursorSpacing - (windowHeight - targetBottomY)
	if (needMoreScrollDistance <= 0) {
		return plan
	}

	plan.shouldAdjust = true

	if (parents.length > 0) {
		const lastParent = parents[parents.length - 1]
		if (windowHeight - lastParent.y - targetBottomOffset >= keyboardHeight) {
			for (let i = 0; i < parents.length; i++) {
				const parent = parents[i]
				const canMoreScrollDistance = parent.scrollHeight - parent.scrollTop - parent.height
				if (canMoreScrollDistance > 0) {
					let shouldScrollDistance = canMoreScrollDistance
					if (canMoreScrollDistance > needMoreScrollDistance) {
						shouldScrollDistance = needMoreScrollDistance
					}
					const parentPlan = new UniAdjustPositionParentPlan()
					parentPlan.index = parent.index
					parentPlan.scrollTop = parent.scrollTop + shouldScrollDistance
					plan.parentPlans.push(parentPlan)
					needMoreScrollDistance = Math.max(0, needMoreScrollDistance - shouldScrollDistance)
					if (needMoreScrollDistance <= 0) {
						break
					}
				}
			}
		}
	}

	const changedScrollParents = plan.parentPlans.length > 0
	const hasScrollParents = parents.length > 0
	if (needMoreScrollDistance > 0 && allowRootTranslate) {
		if (!hasScrollParents || !changedScrollParents) {
			plan.rootTranslateY = needMoreScrollDistance
		}
	}

	return plan
}

function isScrollAbleTagName(tagName: string): boolean {
	const normalizedTagName = tagName.toUpperCase()
	return normalizedTagName == 'SCROLL-VIEW'
		|| normalizedTagName == 'SCROLLVIEW'
		|| normalizedTagName.indexOf('SCROLL-VIEW') >= 0
		|| normalizedTagName.indexOf('SCROLLVIEW') >= 0
		|| normalizedTagName == 'LIST-VIEW'
		|| normalizedTagName == 'LISTVIEW'
		|| normalizedTagName.indexOf('LIST-VIEW') >= 0
		|| normalizedTagName.indexOf('LISTVIEW') >= 0
		|| normalizedTagName == 'WEB-VIEW'
		|| normalizedTagName == 'WEBVIEW'
		|| normalizedTagName.indexOf('WEB-VIEW') >= 0
		|| normalizedTagName.indexOf('WEBVIEW') >= 0
}

class UniInputAdjustPositionHelper {
	private static activeHelper: UniInputAdjustPositionHelper | null = null
	private static sessionPageRootElement: UniElement | null = null
	private static sessionPageRootOriginTransform: string = ''
	private static pendingSessionResetTimer: number | null = null
	private element: UniNativeViewElement
	private resolveCursorBottomOffset: UniCursorBottomOffsetResolver = (elementHeight: number): number => {
		return Math.max(0, elementHeight)
	}
	private scrollAbleParents: UniElement[] = []
	private nativeScrollParents: UIScrollView[] = []
	private pageRootElement: UniElement | null = null
	private hasCollectedScrollAbleParents: boolean = false
	private hasCollectedNativeScrollParents: boolean = false
	private resetPosition: () => void = () => {}
	private hasLocalAdjustment: boolean = false
	private pendingAdjustTimer: number | null = null
	private editingParentSnapshots: UniAdjustPositionParentSnapshot[] = []

	private static readonly REVEAL_RETRY_DELAY = 24
	private static readonly MAX_REVEAL_RETRY_COUNT = 12

	constructor(element: UniNativeViewElement, resolveCursorBottomOffset: UniCursorBottomOffsetResolver) {
		this.element = element
		this.resolveCursorBottomOffset = resolveCursorBottomOffset
	}

	setCursorBottomOffsetResolver(resolveCursorBottomOffset: UniCursorBottomOffsetResolver) {
		this.resolveCursorBottomOffset = resolveCursorBottomOffset
	}

	prepareForEditing() {
		this.cancelPendingSessionReset()
		this.collectScrollAbleParents()
		this.collectNativeScrollParents()
		this.captureSessionPageRootIfNeeded()
		this.captureEditingParentSnapshots()
	}

	private prepareForKeyboardAdjust() {
		this.cancelPendingSessionReset()
		this.collectScrollAbleParents()
		this.collectNativeScrollParents()
		this.captureSessionPageRootIfNeeded()
	}

	cancelPendingSessionReset() {
		const timer = UniInputAdjustPositionHelper.pendingSessionResetTimer
		if (timer != null) {
			clearTimeout(timer!)
			UniInputAdjustPositionHelper.pendingSessionResetTimer = null
		}
	}

	scheduleSessionReset(delaySeconds: number) {
		this.cancelPendingSessionReset()
		const delayMs = Math.max(0, Math.ceil(delaySeconds * 1000) + 16)
		UniInputAdjustPositionHelper.pendingSessionResetTimer = setTimeout(() => {
			UniInputAdjustPositionHelper.pendingSessionResetTimer = null
			this.resetSessionPosition()
		}, delayMs)
	}

	adjustForKeyboardHeight(keyboardHeight: number, cursorSpacing: number) {
		this.prepareForKeyboardAdjust()
		if (UniInputAdjustPositionHelper.activeHelper != null && UniInputAdjustPositionHelper.activeHelper !== this) {
			UniInputAdjustPositionHelper.activeHelper!.clearPendingAdjustTimer()
			UniInputAdjustPositionHelper.activeHelper!.clearLocalResetPosition()
		}
		this.restoreSessionPageRootTransform()
		UniInputAdjustPositionHelper.activeHelper = this
		this.clearPendingAdjustTimer()
		this.applyAdjustForKeyboardHeight(keyboardHeight, cursorSpacing, true, 0)
	}

	private applyAdjustForKeyboardHeight(keyboardHeight: number, cursorSpacing: number, resetBeforeApply: boolean, retryCount: number) {
		if (resetBeforeApply) {
			this.resetElementPosition()
		}
		if (keyboardHeight <= 0) {
			return
		}

		const windowHeight = this.element.uniPage.pageBody.height
		const boundingClientRect = this.element.getBoundingClientRect()
		const resolvedCursorBottomOffset = this.resolveCursorBottomOffset(boundingClientRect.height)
		const maxCursorBottomOffset = Math.max(0, boundingClientRect.height)
		const cursorBottomOffset = maxCursorBottomOffset > 0
			? Math.min(Math.max(0, resolvedCursorBottomOffset), maxCursorBottomOffset)
			: Math.max(0, resolvedCursorBottomOffset)
		const cursorBottomY = boundingClientRect.y + cursorBottomOffset
		const maxSafeSpacing = Math.max(0, windowHeight - keyboardHeight - cursorBottomOffset)
		// Clamp only by the available viewport above the keyboard. In scrollable pages,
		// limiting by the input's current bottom gap makes large cursor-spacing values
		// appear to move only a little even though more scroll distance is available.
		const effectiveCursorSpacing = Math.min(Math.max(0, cursorSpacing), maxSafeSpacing)
		const visibleBottom = windowHeight - keyboardHeight - effectiveCursorSpacing
		const elementBottom = boundingClientRect.y + boundingClientRect.height
		// Only move the whole page when the focused field already overlaps the viewport.
		// Off-screen list items should be brought in by their scroll container instead of
		// applying a large root translate that can push the whole page away.
		const allowRootTranslate = boundingClientRect.height > 0 && boundingClientRect.y < windowHeight && elementBottom > 0
		const parentSnapshots: UniAdjustPositionParentSnapshot[] = []
		for (let i = 0; i < this.scrollAbleParents.length; i++) {
			const parentElement = this.scrollAbleParents[i]
			const parentRect = parentElement.getBoundingClientRect()
			const snapshot = new UniAdjustPositionParentSnapshot()
			snapshot.index = i
			snapshot.y = parentRect.y
			snapshot.height = parentRect.height
			snapshot.scrollTop = parentElement.scrollTop
			snapshot.scrollLeft = parentElement.scrollLeft
			snapshot.scrollHeight = parentElement.scrollHeight
			parentSnapshots.push(snapshot)
		}

		const plan = createAdjustPositionPlan(
			windowHeight,
			keyboardHeight,
			boundingClientRect.y,
			cursorBottomOffset,
			effectiveCursorSpacing,
			parentSnapshots,
			allowRootTranslate
		)
		if (!plan.shouldAdjust) {
			return
		}

		const previousResetPosition = resetBeforeApply ? (() => {}) : this.resetPosition
		const baselineParentSnapshots = (!this.hasLocalAdjustment && this.editingParentSnapshots.length == parentSnapshots.length)
			? this.editingParentSnapshots
			: parentSnapshots
		const nativeScrollPlan = plan.rootTranslateY > 0
			? this.createNativeScrollPlan(plan.rootTranslateY)
			: new UniNativeScrollPlan()
		let rootFallbackTranslateY = plan.rootTranslateY
		if (rootFallbackTranslateY > 0 && this.nativeScrollParents.length > 0) {
			// When the page UIScrollView cannot satisfy a large cursor-spacing, only
			// translate enough to keep the focused field visible above the keyboard.
			const minimalRootPlan = createAdjustPositionPlan(
				windowHeight,
				keyboardHeight,
				boundingClientRect.y,
				cursorBottomOffset,
				0,
				[],
				allowRootTranslate
			)
			if (minimalRootPlan.rootTranslateY < rootFallbackTranslateY) {
				rootFallbackTranslateY = minimalRootPlan.rootTranslateY
			}
		}
		const rootFallbackTranslateYValue = CGFloat(rootFallbackTranslateY)
		const rootTranslateY: CGFloat = nativeScrollPlan.parentPlans.length > 0
			? (nativeScrollPlan.remainingDistance < rootFallbackTranslateYValue ? nativeScrollPlan.remainingDistance : rootFallbackTranslateYValue)
			: rootFallbackTranslateYValue

		for (let i = 0; i < plan.parentPlans.length; i++) {
			const parentPlan = plan.parentPlans[i]
			const parentElement = this.scrollAbleParents[parentPlan.index]
			parentElement.scrollTo(parentElement.scrollLeft, parentPlan.scrollTop)
		}
		for (let i = 0; i < nativeScrollPlan.parentPlans.length; i++) {
			const parentPlan = nativeScrollPlan.parentPlans[i]
			const scrollView = this.nativeScrollParents[parentPlan.index]
			scrollView.setContentOffset(CGPoint(x = scrollView.contentOffset.x, y = parentPlan.offsetY), animated = false)
		}

		if (rootTranslateY > 0) {
			const pageRootElement = this.getPageRootElement()
			const pageRootOriginTransform = UniInputAdjustPositionHelper.sessionPageRootOriginTransform
			pageRootElement?.style.setProperty('transform', `translateY(-${rootTranslateY}px)`)
			this.resetPosition = () => {
				for (let i = 0; i < plan.parentPlans.length; i++) {
					const parentPlan = plan.parentPlans[i]
					const parentElement = this.scrollAbleParents[parentPlan.index]
					const parentSnapshot = baselineParentSnapshots[parentPlan.index]
					parentElement.scrollTo(parentSnapshot.scrollLeft, parentSnapshot.scrollTop)
				}
				for (let i = 0; i < nativeScrollPlan.parentPlans.length; i++) {
					const parentPlan = nativeScrollPlan.parentPlans[i]
					const scrollView = this.nativeScrollParents[parentPlan.index]
					this.restoreNativeScrollParentIfUnchanged(scrollView, parentPlan)
				}
				this.getPageRootElement()?.style.setProperty('transform', pageRootOriginTransform)
				previousResetPosition()
			}
		} else {
			this.resetPosition = () => {
				for (let i = 0; i < plan.parentPlans.length; i++) {
					const parentPlan = plan.parentPlans[i]
					const parentElement = this.scrollAbleParents[parentPlan.index]
					const parentSnapshot = baselineParentSnapshots[parentPlan.index]
					parentElement.scrollTo(parentSnapshot.scrollLeft, parentSnapshot.scrollTop)
				}
				for (let i = 0; i < nativeScrollPlan.parentPlans.length; i++) {
					const parentPlan = nativeScrollPlan.parentPlans[i]
					const scrollView = this.nativeScrollParents[parentPlan.index]
					this.restoreNativeScrollParentIfUnchanged(scrollView, parentPlan)
				}
				previousResetPosition()
			}
		}
		this.hasLocalAdjustment = true
		const changedScrollParents = plan.parentPlans.length > 0
		const changedNativeScrollParents = nativeScrollPlan.parentPlans.length > 0
		const needsMoreReveal = boundingClientRect.y >= windowHeight || cursorBottomY > visibleBottom
		const shouldRetryAfterScroll = changedScrollParents || changedNativeScrollParents || (!allowRootTranslate && needsMoreReveal)
		if (shouldRetryAfterScroll && retryCount < UniInputAdjustPositionHelper.MAX_REVEAL_RETRY_COUNT) {
			this.pendingAdjustTimer = setTimeout(() => {
				this.pendingAdjustTimer = null
				this.applyAdjustForKeyboardHeight(keyboardHeight, cursorSpacing, false, retryCount + 1)
			}, UniInputAdjustPositionHelper.REVEAL_RETRY_DELAY)
		}
	}

	resetElementPosition() {
		this.clearPendingAdjustTimer()
		this.runResetPosition(false)
	}

	resetSessionPosition() {
		this.cancelPendingSessionReset()
		this.clearPendingAdjustTimer()
		this.runResetPosition(true)
		this.editingParentSnapshots.length = 0
		this.clearSharedSessionState(true)
	}

	destroy() {
		this.cancelPendingSessionReset()
		this.clearPendingAdjustTimer()
		this.resetElementPosition()
		const pageRootElement = this.getPageRootElement()
		if (UniInputAdjustPositionHelper.activeHelper === this || UniInputAdjustPositionHelper.sessionPageRootElement === pageRootElement) {
			this.clearSharedSessionState(true)
		}
		this.scrollAbleParents.length = 0
		this.nativeScrollParents.length = 0
		this.pageRootElement = null
		this.hasCollectedScrollAbleParents = false
		this.hasCollectedNativeScrollParents = false
	}

	private clearPendingAdjustTimer() {
		const timer = this.pendingAdjustTimer
		if (timer != null) {
			clearTimeout(timer!)
			this.pendingAdjustTimer = null
		}
	}

	private clearLocalResetPosition() {
		this.resetPosition = () => {}
		this.hasLocalAdjustment = false
	}

	private runResetPosition(clearActiveHelper: boolean) {
		this.resetPosition()
		this.clearLocalResetPosition()
		if (clearActiveHelper && UniInputAdjustPositionHelper.activeHelper === this) {
			UniInputAdjustPositionHelper.activeHelper = null
		}
	}

	private captureSessionPageRootIfNeeded() {
		const pageRootElement = this.getPageRootElement()
		if (UniInputAdjustPositionHelper.sessionPageRootElement != null && UniInputAdjustPositionHelper.sessionPageRootElement !== pageRootElement) {
			this.clearSharedSessionState(true)
		}
		if (UniInputAdjustPositionHelper.sessionPageRootElement != null) {
			return
		}
		UniInputAdjustPositionHelper.sessionPageRootElement = pageRootElement
		UniInputAdjustPositionHelper.sessionPageRootOriginTransform = pageRootElement?.style.getPropertyValue('transform') ?? ''
	}

	private captureEditingParentSnapshots() {
		this.editingParentSnapshots.length = 0
		for (let i = 0; i < this.scrollAbleParents.length; i++) {
			const parentElement = this.scrollAbleParents[i]
			const snapshot = new UniAdjustPositionParentSnapshot()
			snapshot.index = i
			snapshot.scrollTop = parentElement.scrollTop
			snapshot.scrollLeft = parentElement.scrollLeft
			this.editingParentSnapshots.push(snapshot)
		}
	}

	private createNativeScrollPlan(distance: number): UniNativeScrollPlan {
		const plan = new UniNativeScrollPlan()
		plan.remainingDistance = distance > 0 ? CGFloat(distance) : 0.0
		if (plan.remainingDistance <= 0) {
			return plan
		}

		for (let i = 0; i < this.nativeScrollParents.length; i++) {
			const scrollView = this.nativeScrollParents[i]
			let canMoreScrollDistance = scrollView.contentSize.height - scrollView.contentOffset.y - scrollView.bounds.height
			if (canMoreScrollDistance <= 0) {
				continue
			}
			let shouldScrollDistance = canMoreScrollDistance
			if (shouldScrollDistance > plan.remainingDistance) {
				shouldScrollDistance = plan.remainingDistance
			}
			const parentPlan = new UniNativeScrollParentPlan()
			parentPlan.index = i
			parentPlan.originOffsetX = scrollView.contentOffset.x
			parentPlan.originOffsetY = scrollView.contentOffset.y
			parentPlan.offsetY = scrollView.contentOffset.y + shouldScrollDistance
			plan.parentPlans.push(parentPlan)
			plan.remainingDistance = plan.remainingDistance - shouldScrollDistance
			if (plan.remainingDistance < 0) {
				plan.remainingDistance = 0.0
			}
			if (plan.remainingDistance <= 0) {
				break
			}
		}

		return plan
	}

	private restoreNativeScrollParentIfUnchanged(scrollView: UIScrollView, parentPlan: UniNativeScrollParentPlan) {
		const currentOffsetY = scrollView.contentOffset.y
		if (currentOffsetY > parentPlan.offsetY + 1.0 || currentOffsetY < parentPlan.offsetY - 1.0) {
			return
		}
		scrollView.setContentOffset(CGPoint(x = parentPlan.originOffsetX, y = parentPlan.originOffsetY), animated = false)
	}

	private restoreSessionPageRootTransform() {
		if (UniInputAdjustPositionHelper.sessionPageRootElement == null) {
			return
		}
		UniInputAdjustPositionHelper.sessionPageRootElement!.style.setProperty('transform', UniInputAdjustPositionHelper.sessionPageRootOriginTransform)
	}

	private clearSharedSessionState(restorePageRootTransform: boolean) {
		this.cancelPendingSessionReset()
		if (restorePageRootTransform) {
			this.restoreSessionPageRootTransform()
		}
		UniInputAdjustPositionHelper.sessionPageRootElement = null
		UniInputAdjustPositionHelper.sessionPageRootOriginTransform = ''
		UniInputAdjustPositionHelper.activeHelper = null
	}

	private getPageRootElement(): UniElement | null {
		if (this.pageRootElement != null) {
			return this.pageRootElement
		}

		let rootElement = this.element.parentElement
		while (rootElement?.parentElement != null) {
			rootElement = rootElement.parentElement
		}
		this.pageRootElement = rootElement
		return this.pageRootElement
	}

	private collectScrollAbleParents() {
		if (this.hasCollectedScrollAbleParents) {
			return
		}

		let currentParent = this.element.parentElement
		while (currentParent != null) {
			if (isScrollAbleTagName(currentParent.tagName)) {
				this.scrollAbleParents.push(currentParent)
			}
			currentParent = currentParent.parentElement
		}
		this.hasCollectedScrollAbleParents = true
	}

	private collectNativeScrollParents() {
		if (this.hasCollectedNativeScrollParents) {
			return
		}

		let currentView = this.element.getIOSView()?.superview
		while (currentView != null) {
			if (UTSiOS.instanceof(currentView, UIScrollView.self)) {
				this.nativeScrollParents.push(currentView as UIScrollView)
			}
			currentView = currentView!.superview
		}
		this.hasCollectedNativeScrollParents = true
	}
}

const UNI_INPUT_DEFAULT_FONT_SIZE = 16

class UniEditSharedState {
	maxLength: number = -1
	beginEditValue: string = ''
	confirmHold: boolean = false
	holdKeyboard: boolean = false
	adjustPosition: boolean = true
	isFocusing: boolean = false
	keyboardHeight: number = 0
	keyboardAnimationDuration: number = 0
	cursorSpacing: number = 0
	cursor: number = -1
	selectionStart: number = -1
	selectionEnd: number = -1
	fontSize: number = UNI_INPUT_DEFAULT_FONT_SIZE
	fontWeight: string = 'normal'
	fontStyle: string = 'normal'
	fontFamily: string = ''
}

class UniEditKeyboardController {
	private state: UniEditSharedState
	private positionHelper: UniInputAdjustPositionHelper

	constructor(element: UniNativeViewElement, state: UniEditSharedState, resolveCursorBottomOffset: UniCursorBottomOffsetResolver) {
		this.state = state
		this.positionHelper = new UniInputAdjustPositionHelper(element, resolveCursorBottomOffset)
	}

	destroy() {
		this.positionHelper.destroy()
	}

	beginEditing() {
		this.positionHelper.prepareForEditing()
	}

	handleKeyboardDismissStart() {
		this.positionHelper.cancelPendingSessionReset()
		if (this.state.keyboardHeight > 0) {
			this.positionHelper.resetSessionPosition()
		}
	}

	scheduleDismissReset() {
		if (this.state.keyboardHeight > 0) {
			this.positionHelper.scheduleSessionReset(this.state.keyboardAnimationDuration)
		}
	}

	setCursorBottomOffsetResolver(resolveCursorBottomOffset: UniCursorBottomOffsetResolver) {
		this.positionHelper.setCursorBottomOffsetResolver(resolveCursorBottomOffset)
	}

	handleKeyboardWillShow(notification: NSNotification, isFirstResponder: boolean) {
		if (!isFirstResponder) {
			return
		}
		this.state.keyboardAnimationDuration = this.getKeyboardAnimationDuration(notification)
	}

	handleKeyboardWillHide(notification: NSNotification) {
		if (!this.state.isFocusing && this.state.keyboardHeight <= 0) {
			return
		}
		this.state.keyboardAnimationDuration = this.getKeyboardAnimationDuration(notification)
		this.handleKeyboardDismissStart()
	}

	handleKeyboardFrameWillChange(notification: NSNotification, onKeyboardHeightChange: (height: number, duration: number) => void) {
		const keyboardHeight = this.getKeyboardHeight(notification)
		if (!this.state.isFocusing && !(this.state.keyboardHeight > 0 && keyboardHeight <= 0)) {
			return
		}
		const duration = this.getKeyboardAnimationDuration(notification)
		this.state.keyboardHeight = keyboardHeight
		this.state.keyboardAnimationDuration = duration
		onKeyboardHeightChange(keyboardHeight, duration)
		if (keyboardHeight <= 0) {
			this.state.keyboardHeight = 0
			this.positionHelper.resetSessionPosition()
			return
		}
		if (this.state.adjustPosition) {
			this.positionHelper.adjustForKeyboardHeight(keyboardHeight, this.state.cursorSpacing)
		} else {
			this.positionHelper.resetElementPosition()
		}
	}

	refreshPosition() {
		if (!this.state.isFocusing) {
			return
		}
		if (this.state.adjustPosition && this.state.keyboardHeight > 0) {
			this.positionHelper.adjustForKeyboardHeight(this.state.keyboardHeight, this.state.cursorSpacing)
		} else if (!this.state.adjustPosition) {
			this.positionHelper.resetElementPosition()
		}
	}

	resetPosition() {
		this.positionHelper.resetElementPosition()
	}

	private getKeyboardHeight(notification: NSNotification): number {
		const endFrameValue = notification.userInfo?.[UIResponder.keyboardFrameEndUserInfoKey]
		if (endFrameValue == null) {
			return 0
		}
		const endFrame = (endFrameValue as NSValue).cgRectValue
		// keyboardFrameEndUserInfoKey reports the full keyboard frame size even when it is
		// moving off-screen, so derive the visible overlap with the screen bottom instead.
		const screenHeight = NSNumber(value = Double(UIScreen.main.bounds.size.height))
		const keyboardTop = NSNumber(value = Double(endFrame.origin.y))
		const keyboardHeight = NSNumber(value = Double(endFrame.size.height))
		const visibleHeight = Math.max(0, Math.min(keyboardHeight, screenHeight - keyboardTop))
		return visibleHeight
	}

	private getKeyboardAnimationDuration(notification: NSNotification): number {
		const durationValue = notification.userInfo?.[UIResponder.keyboardAnimationDurationUserInfoKey]
		if (durationValue == null) {
			return 0
		}
		return NSNumber(value = (durationValue as NSNumber).doubleValue)
	}
}

export interface UniInputElement extends JSExport, UniViewElement {
	value: string
	name: string
	type: string
	disabled: boolean
	autofocus: boolean
	focus(): void
	blur(): void
}

export interface UniTextareaElement extends JSExport, UniViewElement {
	value: string
	name: string
	disabled: boolean
	autofocus: boolean
	focus(): void
	blur(): void
}

export class UniInputElementImpl extends UniViewElementImpl implements UniInputElement {
	_value: string = ''
	_name: string = ''
	_type: string = 'text'
	_disabled: boolean = false
	_autofocus: boolean = false
	private nativeInputView: NativeInputView | null = null

	private applyValue(value: any, syncNativeView: boolean) {
		const normalizedValue = normalizeElementStringValue(value)
		const changed = this._value != normalizedValue
		this._value = normalizedValue
		if (syncNativeView && changed) {
			this.nativeInputView?.updateValue(normalizedValue)
		}
	}

	private applyName(value: any) {
		const normalizedValue = normalizeElementStringValue(value)
		this._name = normalizedValue
	}

	private applyType(value: any, syncNativeView: boolean) {
		const normalizedValue = normalizeElementStringValue(value)
		const changed = this._type != normalizedValue
		this._type = normalizedValue
		if (syncNativeView && changed) {
			this.nativeInputView?.updateType(normalizedValue)
		}
	}

	private applyDisabled(value: any, syncNativeView: boolean) {
		const normalizedValue = toBoolean(value)
		const changed = this._disabled != normalizedValue
		this._disabled = normalizedValue
		if (syncNativeView && changed) {
			this.nativeInputView?.updateDisabled(normalizedValue)
		}
	}

	private applyAutofocus(value: any, syncNativeView: boolean) {
		const normalizedValue = toBoolean(value)
		const changed = this._autofocus != normalizedValue
		this._autofocus = normalizedValue
		if (syncNativeView && changed) {
			this.nativeInputView?.updateAutoFocus(normalizedValue)
		}
	}

	setNativeInputView(nativeInputView: NativeInputView | null) {
		this.nativeInputView = nativeInputView
		if (nativeInputView == null) {
			return
		}
		nativeInputView.updateValue(this._value)
		nativeInputView.updateType(this._type)
		nativeInputView.updateDisabled(this._disabled)
		nativeInputView.updateAutoFocus(this._autofocus)
	}

	updateValueFromNative(value: string) {
		this.applyValue(value, false)
	}

	updateTypeFromNative(value: string) {
		this.applyType(value, false)
	}

	updateDisabledFromNative(value: boolean) {
		this.applyDisabled(value, false)
	}

	updateAutofocusFromNative(value: boolean) {
		this.applyAutofocus(value, false)
	}

	get value(): string {
		return this._value
	}

	set value(value: string) {
		this.applyValue(value, true)
	}

	get name(): string {
		return this._name
	}

	set name(value: string) {
		this.applyName(value)
	}

	get type(): string {
		return this._type
	}

	set type(value: string) {
		this.applyType(value, true)
	}

	get disabled(): boolean {
		return this._disabled
	}

	set disabled(value: boolean) {
		this.applyDisabled(value, true)
	}

	get autofocus(): boolean {
		return this._autofocus
	}

	set autofocus(value: boolean) {
		this.applyAutofocus(value, true)
	}

	override focus() {
		this.nativeInputView?.updateFocus(true)
	}

	override blur() {
		this.nativeInputView?.updateFocus(false)
	}

	override getIOSView(): UIView | null {
		return this.nativeInputView?.textField
	}

	override tagName: string = 'INPUT'
	override nodeName: string = 'INPUT'
}

