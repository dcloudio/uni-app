/**
 * 路由错误码
 * - 4: 框架内部异常
 */
export type RouteErrorCode = 4

/**
 *
 * @tutorial http://uniapp.dcloud.io/api/router.html#event-channel
 */
export type EventChannel = {}

/**
 * 应用路由类型。
 */
export type AppRouteOpenType =
    /** 应用启动 */
    | 'appLaunch'
    /** 打开新页面 */
    | 'navigateTo'
    /** 返回上一页面或多级页面 */
    | 'navigateBack'
    /** 关闭当前页面并打开新页面 */
    | 'redirectTo'
    /** 关闭所有页面并打开新页面 */
    | 'reLaunch'
    /** 切换到 tabBar 页面 */
    | 'switchTab'

/**
 * 应用路由事件参数。
 */
export type AppRouteEvent = {
    /**
     * 路由页面路径，不包含开头的斜杠
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    path: string
    /**
     * 路由页面参数
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    query: UTSJSONObject
    /**
     * 路由类型
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    openType: AppRouteOpenType
    /**
     * 路由页面是否不存在。支付宝小程序不提供该信息，固定为 false
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    notFound: boolean
    /**
     * 事件触发时的时间戳
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    timeStamp: number
    /**
     * 路由事件唯一标识
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    routeEventId: string
}

/** 应用路由事件回调 */
export type AppRouteCallback = (event: AppRouteEvent) => void
/** 监听应用路由事件 */
export type OnAppRoute = (callback: AppRouteCallback) => void
/** 取消监听应用路由事件 */
export type OffAppRoute = (callback?: AppRouteCallback | null) => void

/**
 * 应用路由前置事件参数。
 */
export type BeforeAppRouteEvent = {
    /**
     * 路由页面路径，不包含开头的斜杠
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    path: string
    /**
     * 路由页面参数
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    query: UTSJSONObject
    /**
     * 路由类型
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    openType: AppRouteOpenType
    /**
     * 路由页面是否不存在。支付宝小程序不提供该信息，固定为 false
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    notFound: boolean
    /**
     * 路由事件唯一标识
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.5.5", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "2.10.19", "uniVer": "x", "unixVer": "5.31" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    routeEventId: string
}

/** 应用路由前置事件回调 */
export type BeforeAppRouteCallback = (event: BeforeAppRouteEvent) => void
/** 监听应用路由前置事件 */
export type OnBeforeAppRoute = (callback: BeforeAppRouteCallback) => void
/** 取消监听应用路由前置事件 */
export type OffBeforeAppRoute = (callback?: BeforeAppRouteCallback | null) => void

export type RewriteRouteSuccess = AsyncApiSuccessResult
type RewriteRouteSuccessCallback = (result: RewriteRouteSuccess) => void
export interface RewriteRouteFail extends IUniError {
    /**
     * 错误码。微信小程序原生回调不提供此属性
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "x", "uniVer": "x", "unixVer": "x" },
     *     "alipay": { "hostVer": "x", "uniVer": "x", "unixVer": "x" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    errCode: RouteErrorCode
}
type RewriteRouteFailCallback = (result: RewriteRouteFail) => void
export type RewriteRouteComplete = AsyncApiResult
type RewriteRouteCompleteCallback = (result: RewriteRouteComplete) => void
export type RewriteRouteOptions = {
    /**
     * 重写后的页面路径
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.8.0", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "x", "uniVer": "x", "unixVer": "x" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    url: string | string.PageURIString
    /**
     * 是否保留原路由参数，默认 false
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.8.0", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "x", "uniVer": "x", "unixVer": "x" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    preserveQuery?: boolean
    /**
     * 接口调用成功的回调函数
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.8.0", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "x", "uniVer": "x", "unixVer": "x" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    success?: RewriteRouteSuccessCallback | null
    /**
     * 接口调用失败的回调函数
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.8.0", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "x", "uniVer": "x", "unixVer": "x" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    fail?: RewriteRouteFailCallback | null
    /**
     * 接口调用结束的回调函数
     * @uniPlatform {
     *   "app": {
     *     "android": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "ios": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" },
     *     "harmony": { "uniVer": "x", "unixVer": "5.25", "unixVaporVer": "5.25" }
     *   },
     *   "mp": {
     *     "weixin": { "hostVer": "3.8.0", "uniVer": "5.25", "unixVer": "5.25" },
     *     "alipay": { "hostVer": "x", "uniVer": "x", "unixVer": "x" }
     *   },
     *   "web": { "uniVer": "x", "unixVer": "5.25" }
     * }
     */
    complete?: RewriteRouteCompleteCallback | null
}
/** 重写当前应用路由 */
export type RewriteRoute = (options: RewriteRouteOptions) => void

export type NavigateToSuccess = AsyncApiSuccessResult
type NavigateToSuccessCallback = (result: NavigateToSuccess) => void
export interface NavigateToFail extends IUniError {
    errCode: RouteErrorCode
}
type NavigateToFailCallback = (result: NavigateToFail) => void
export type NavigateToComplete = AsyncApiResult
type NavigateToCompleteCallback = (result: NavigateToComplete) => void
export type NavigateToOptions = {
    /**
     * 需要跳转的应用内非 tabBar 的页面的路径 , 路径后可以带参数
     * @uniPlatform {
     *  "app": {
     *    "android": {
     *        "uniVer": "√",
     *        "unixVer": "√"
     *      },
     *      "ios": {
     *          "uniVer": "√",
     *          "unixVer": "4.11",
     *          "unixVaporVer": "5.14"
     *      },
     *    "harmony": {
     *      "uniVer": "4.23",
     *      "unixVer": "4.61",
     *      "unixVaporVer": "5.0"
     *    }
     *  },
     *  "mp": {
     *    "weixin": {
     *        "hostVer": "√",
     *        "uniVer": "√",
     *        "unixVer": "4.41"
     *    },
     *    "alipay": {
     *        "hostVer": "√",
     *        "uniVer": "√",
     *        "unixVer": "5.31"
     *    },
     *    "baidu": {
     *        "hostVer": "√",
     *        "uniVer": "√",
     *        "unixVer": "x"
     *    },
     *    "toutiao": {
     *        "hostVer": "√",
     *        "uniVer": "√",
     *        "unixVer": "x"
     *    },
     *    "lark": {
     *        "hostVer": "√",
     *        "uniVer": "√",
     *        "unixVer": "x"
     *    },
     *    "qq": {
     *        "hostVer": "√",
     *        "uniVer": "√",
     *        "unixVer": "x"
     *    },
     *    "kuaishou": {
     *        "hostVer": "√",
     *        "uniVer": "√",
     *        "unixVer": "x"
     *    },
     *    "jd": {
     *        "hostVer": "√",
     *        "uniVer": "√",
     *        "unixVer": "x"
     *    }
     *  },
     *  "web": {
     *      "uniVer": "√",
     *      "unixVer": "4.0"
     *  }
     * }
     */
    url: string | string.PageURIString
    /**
     * 窗口显示的动画类型
     *
     * @uniPlatform {
     *  "app": {
     *    "android": {
     *        "uniVer": "√",
     *        "unixVer": "4.18"
     *      },
     *      "ios": {
     *          "uniVer": "√",
     *          "unixVer": "4.25",
     *          "unixVaporVer": "5.14"
     *      },
     *    "harmony": {
     *      "uniVer": "4.23",
     *      "unixVer": "4.61",
     *      "unixVaporVer": "5.0"
     *    }
     *  },
     *  "mp": {
     *    "weixin": {
     *        "hostVer": "√",
     *        "uniVer": "x",
     *        "unixVer": "x"
     *    },
     *    "alipay": {
     *        "hostVer": "√",
     *        "uniVer": "x",
     *        "unixVer": "x"
     *    },
     *    "baidu": {
     *        "hostVer": "√",
     *        "uniVer": "x",
     *        "unixVer": "x"
     *    },
     *    "toutiao": {
     *        "hostVer": "√",
     *        "uniVer": "x",
     *        "unixVer": "x"
     *    },
     *    "lark": {
     *        "hostVer": "√",
     *        "uniVer": "x",
     *        "unixVer": "x"
     *    },
     *    "qq": {
     *        "hostVer": "√",
     *        "uniVer": "x",
     *        "unixVer": "x"
     *    },
     *    "kuaishou": {
     *        "hostVer": "√",
     *        "uniVer": "x",
     *        "unixVer": "x"
     *    },
     *    "jd": {
     *        "hostVer": "√",
     *        "uniVer": "x",
     *        "unixVer": "x"
     *    }
     *  },
     *  "web": {
     *      "uniVer": "x",
     *      "unixVer": "x"
     *  }
     * }
     */
    animationType?:
    /**
     * 自动选择动画效果
     *
     * @uniPlatform {
     *   "app": {
     *     "android": {
     *       "uniVer": "√",
     *       "unixVer": "4.18"
     *     },
     *     "ios": {
     *       "uniVer": "√",
     *       "unixVer": "4.25"
     *     },
     *     "harmony": {
     *       "uniVer": "4.61",
     *       "unixVer": "5.0"
     *     }
     *   },
     *   "web": {
     *     "uniVer": "x",
     *     "unixVer": "x"
     *   }
     * }
     */
    'auto' |
    /**
     * 无动画效果
     *
     * @uniPlatform {
     *   "app": {
     *     "android": {
     *       "uniVer": "√",
     *       "unixVer": "4.18"
     *     },
     *     "ios": {
     *       "uniVer": "√",
     *       "unixVer": "4.25",
     *       "unixVaporVer": "5.14"
     *     },
     *     "harmony": {
     *       "uniVer": "4.23",
     *       "unixVer": "4.61",
     *       "unixVaporVer": "5.0"
     *     }
     *   },
     *   "web": {
     *     "uniVer": "x",
     *     "unixVer": "x"
     *   }
     * }
     */
    'none' |
    /**
     * 从右侧横向滑动效果
     *
     * @uniPlatform {
     *   "app": {
     *     "android": {
     *       "uniVer": "√",
     *       "unixVer": "4.18"
     *     },
     *     "ios": {
     *       "uniVer": "√",
     *       "unixVer": "4.25"
     *     },
     *     "harmony": {
     *       "uniVer": "x",
     *       "unixVer": "5.0"
     *     }
     *   },
     *   "web": {
     *     "uniVer": "x",
     *     "unixVer": "x"
     *   }
