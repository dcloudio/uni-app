import File from 'java.io.File'
import ParcelFileDescriptor from 'android.os.ParcelFileDescriptor'
import { OpenFileOptions, OpenFileSuccessResult, OpenFileSyncOptions } from '../interface';
import { UniErrorSubject,FileSystemManagerFailImpl,FileSystemManagerUniErrors } from '../unierror';

export class FileDescriptorUtil {
	public openMap : Map<string, File> = new Map()
	// 持有 open 返回的原始 descriptor，避免 Android 6 上 fd 在后续 read/write 前失效。
	public descriptorMap : Map<string, ParcelFileDescriptor> = new Map()

	public rememberDescriptor(file : File, pfd : ParcelFileDescriptor) : string {
		let fd = pfd.getFd().toString()
		this.openMap.set(fd, file)
		this.descriptorMap.set(fd, pfd)
		return fd
	}

	public getDescriptor(fd : string) : ParcelFileDescriptor | null {
		if (!this.descriptorMap.has(fd)) {
			return null
		}
		return this.descriptorMap.get(fd)!
	}

	public removeDescriptor(fd : string) : ParcelFileDescriptor | null {
		let descriptor = this.getDescriptor(fd)
		if (descriptor == null) {
			return null
		}
		// close 前先移除 map 引用，避免已关闭 descriptor 被后续逻辑再次取到。
		this.descriptorMap.delete(fd)
		if (this.openMap.has(fd)) {
			this.openMap.delete(fd)
		}
		return descriptor
	}

	public open(options : OpenFileOptions, file : File) {
		let currentDispatcher = UTSAndroid.getDispatcher("main")
		UTSAndroid.getDispatcher('io').async(function (_) {

			try {
				switch (options.flag) {
					case 'a': //	打开文件用于追加。 如果文件不存在，则创建该文件
						{
							let ret: OpenFileSuccessResult = {
								fd: this.open_a(file),
								errMsg: 'open:ok'
							}
							currentDispatcher.async(function (_) {
								options.success?.(ret)
								options.complete?.(ret)
							}, null)

							return
						}
					case 'ax': //类似于 'a'，但如果路径存在，则失败
						{
							if (file.exists()) {
								currentDispatcher.async(function (_) {
									let err = new FileSystemManagerFailImpl(1301005);
									options.fail?.(err)
									options.complete?.(err)
								}, null)
							} else {
								if (file.parentFile?.exists() == false) {
									currentDispatcher.async(function (_) {
										let err = new FileSystemManagerFailImpl(1300002);
										options.fail?.(err)
										options.complete?.(err)
									}, null)
									return
								}
								file.createNewFile()
								let ret :OpenFileSuccessResult = {
									fd: this.open_a(file),
									errMsg: 'open:ok'
								}
								currentDispatcher.async(function (_) {
									options.success?.(ret)
									options.complete?.(ret)
								}, null)
							}
							return
						}
					case 'a+': //打开文件用于读取和追加。 如果文件不存在，则创建该文件
						{
							let ret : OpenFileSuccessResult = {
								fd: this.open_ax(file),
								errMsg: 'open:ok'
							}
							currentDispatcher.async(function (_) {
								options.success?.(ret)
								options.complete?.(ret)
							}, null)

							return
						}
					case 'ax+': //类似于 'a+'，但如果路径存在，则失败
						{
							if (file.exists()) {
								currentDispatcher.async(function (_) {
									let err = new FileSystemManagerFailImpl(1301005);
									options.fail?.(err)
									options.complete?.(err)
								}, null)
							} else {
								let ret : OpenFileSuccessResult = {
									fd: this.open_ax(file),
									errMsg: 'open:ok'
								}
								currentDispatcher.async(function (_) {
									options.success?.(ret)
									options.complete?.(ret)
								}, null)
							}
							return
						}
					case 'r': //打开文件用于读取。 如果文件不存在，则会发生异常
						{
							if (!file.exists()) {
								currentDispatcher.async(function (_) {
									let err = new FileSystemManagerFailImpl(1300002);
									options.fail?.(err)
									options.complete?.(err)
								}, null)
							} else {
								let mode = ParcelFileDescriptor.MODE_READ_ONLY
								let pfd = ParcelFileDescriptor.open(file, mode);
								let ret : OpenFileSuccessResult = {
									fd: this.rememberDescriptor(file, pfd),
									errMsg: 'open:ok'
								}
								currentDispatcher.async(function (_) {
									options.success?.(ret)
									options.complete?.(ret)
								}, null)
							}
							return
						}
					case 'r+': //打开文件用于读取和写入。 如果文件不存在，则会发生异常
						{
							if (!file.exists()) {
								currentDispatcher.async(function (_) {
									let err = new FileSystemManagerFailImpl(1300002);
									options.fail?.(err)
									options.complete?.(err)
								}, null)
							} else {
								let mode = ParcelFileDescriptor.MODE_READ_WRITE
								let pfd = ParcelFileDescriptor.open(file, mode);
								let ret : OpenFileSuccessResult = {
									fd: this.rememberDescriptor(file, pfd),
									errMsg: 'open:ok'
								}
								currentDispatcher.async(function (_) {
									options.success?.(ret)
									options.complete?.(ret)
								}, null)
							}
							return
						}
					case 'w'://打开文件用于写入。 如果文件不存在则创建文件，如果文件存在则截断文件
						{
							let ret : OpenFileSuccessResult = {
								fd: this.open_w(file),
								errMsg: 'open:ok'
							}
							currentDispatcher.async(function (_) {
								options.success?.(ret)
								options.complete?.(ret)
							}, null)
							return
						}
					case 'wx'://类似于 'w'，但如果路径存在，则失败
						{
							if (file.exists()) {
								currentDispatcher.async(function (_) {
									let err = new FileSystemManagerFailImpl(1301005);
									options.fail?.(err)
									options.complete?.(err)
								}, null)
							} else {
								let ret : OpenFileSuccessResult = {
									fd: this.open_w(file),
									errMsg: 'open:ok'
								}
								currentDispatcher.async(function (_) {
									options.success?.(ret)
									options.complete?.(ret)
								}, null)
							}
							return
						}
					case 'w+': //打开文件用于读取和写入。 如果文件不存在则创建文件，如果文件存在则截断文件
						{
							let mode = ParcelFileDescriptor.MODE_CREATE | ParcelFileDescriptor.MODE_READ_WRITE | ParcelFileDescriptor.MODE_TRUNCATE
							let pfd = ParcelFileDescriptor.open(file, mode);
							let ret : OpenFileSuccessResult = {
								fd: this.rememberDescriptor(file, pfd),
								errMsg: 'open:ok'
							}
							currentDispatcher.async(function (_) {
								options.success?.(ret)
								options.complete?.(ret)
							}, null)
							return
						}
					case 'wx+': //	类似于 'w+'，但如果路径存在，则失败
						{
							if (file.exists()) {
								currentDispatcher.async(function (_) {
									let err = new FileSystemManagerFailImpl(1301005);
									options.fail?.(err)
									options.complete?.(err)
								}, null)
							} else {
								let mode = ParcelFileDescriptor.MODE_CREATE | ParcelFileDescriptor.MODE_READ_WRITE | ParcelFileDescriptor.MODE_TRUNCATE
								let pfd = ParcelFileDescriptor.open(file, mode);
								let ret : OpenFileSuccessResult = {
									fd: this.rememberDescriptor(file, pfd),
									errMsg: 'open:ok'
								}
								currentDispatcher.async(function (_) {
									options.success?.(ret)
									options.complete?.(ret)
								}, null)
							}
							return
						}
				}
			} catch (e) {
				currentDispatcher.async(function (_) {
					let err = new FileSystemManagerFailImpl(1300201);
					options.fail?.(err)
					options.complete?.(err)
				}, null)
			}
		})
	}

	public openSync(options : OpenFileSyncOptions, file : File) : string {
		let msgPrefix = "openSync:fail "
		switch (options.flag) {
			case 'a': //	打开文件用于追加。 如果文件不存在，则创建该文件
				{
					let fd = this.open_a(file)
					return fd
				}
			case 'ax': //类似于 'a'，但如果路径存在，则失败
				{
					if (file.exists()) {
						throw new Error(`${msgPrefix}${FileSystemManagerUniErrors[1301005]}`)
					} else {
						if (file.parentFile?.exists() == false) {
							throw new Error(`${msgPrefix}${FileSystemManagerUniErrors[1300002]}`)
						} else {
							file.createNewFile()
							let fd = this.open_a(file)
							return fd
						}
					}

				}
			case 'a+': //打开文件用于读取和追加。 如果文件不存在，则创建该文件
				{
					let fd = this.open_ax(file)
					return fd
				}
			case 'ax+': //类似于 'a+'，但如果路径存在，则失败
				{
					if (file.exists()) {
						throw new Error(`${msgPrefix}${FileSystemManagerUniErrors[1301005]}`)
					} else {
						let fd = this.open_ax(file)
						return fd
					}
				}
			case 'r': //打开文件用于读取。 如果文件不存在，则会发生异常
				{
					if (!file.exists()) {
						throw new Error(`${msgPrefix}${FileSystemManagerUniErrors[1300002]}`)
					} else {
						let mode = ParcelFileDescriptor.MODE_READ_ONLY
						let pfd = ParcelFileDescriptor.open(file, mode);
						let fd = this.rememberDescriptor(file, pfd)
						return fd
					}

				}
			case 'r+': //打开文件用于读取和写入。 如果文件不存在，则会发生异常
				{
					if (!file.exists()) {
						throw new Error(`${msgPrefix}${FileSystemManagerUniErrors[1300002]}`)
					} else {
						let mode = ParcelFileDescriptor.MODE_READ_WRITE
						let pfd = ParcelFileDescriptor.open(file, mode);
						let fd = this.rememberDescriptor(file, pfd)
						return fd
					}

				}
			case 'w'://打开文件用于写入。 如果文件不存在则创建文件，如果文件存在则截断文件
				{
					let fd = this.open_w(file)
					return fd
				}
			case 'wx'://类似于 'w'，但如果路径存在，则失败
				{
					if (file.exists()) {
						throw new Error(`${msgPrefix}${FileSystemManagerUniErrors[1301005]}`)
					} else {
						let fd = this.open_w(file)
						return fd
					}

				}
			case 'w+': //打开文件用于读取和写入。 如果文件不存在则创建文件，如果文件存在则截断文件
				{
					let mode = ParcelFileDescriptor.MODE_CREATE | ParcelFileDescriptor.MODE_READ_WRITE | ParcelFileDescriptor.MODE_TRUNCATE
					let pfd = ParcelFileDescriptor.open(file, mode);
					let fd = this.rememberDescriptor(file, pfd)
					return fd
				}
			case 'wx+': //	类似于 'w+'，但如果路径存在，则失败
				{
					if (file.exists()) {
						throw new Error(`${msgPrefix}${FileSystemManagerUniErrors[1301005]}`)
					} else {
						let mode = ParcelFileDescriptor.MODE_CREATE | ParcelFileDescriptor.MODE_READ_WRITE | ParcelFileDescriptor.MODE_TRUNCATE
						let pfd = ParcelFileDescriptor.open(file, mode);
						let fd = this.rememberDescriptor(file, pfd)
						return fd
					}
				}
		}
		return ""
	}
	open_a(file : File) : string {
		try {
			let mode = ParcelFileDescriptor.MODE_CREATE | ParcelFileDescriptor.MODE_WRITE_ONLY | ParcelFileDescriptor.MODE_APPEND
			let pfd = ParcelFileDescriptor.open(file, mode);
			return this.rememberDescriptor(file, pfd)
		} catch (e : Exception) {
			console.log(e)
		}
		return ""
	}
	open_ax(file : File) : string {
		let mode = ParcelFileDescriptor.MODE_CREATE | ParcelFileDescriptor.MODE_APPEND | ParcelFileDescriptor.MODE_READ_WRITE
		let pfd = ParcelFileDescriptor.open(file, mode);
		return this.rememberDescriptor(file, pfd)
	}
	open_w(file : File) : string {
		let mode = ParcelFileDescriptor.MODE_CREATE | ParcelFileDescriptor.MODE_WRITE_ONLY | ParcelFileDescriptor.MODE_TRUNCATE
		let pfd = ParcelFileDescriptor.open(file, mode);
		return this.rememberDescriptor(file, pfd)
	}
}
