import { GyAuthLoginDialog, GyLoginDialog } from '@getui/gysdk';

let GyManagerInstanceCallback: () => void = () => {};

export function setGyManagerInstanceCallback(callback: () => void): void {
  GyManagerInstanceCallback = callback;
}

@Builder
export function AuthPageComponent(): void {
  Flex({ direction: FlexDirection.RowReverse }) {
    Image("data:image/png;base64,\n")
      .height(25)
      .width(25)
      .margin({ right: 15 })
      .onClick(GyManagerInstanceCallback)
  }.width('100%')
  .margin({ top: 35 })
}

export function createDialogController(): CustomDialogController {
  return new CustomDialogController({
    builder: GyAuthLoginDialog({ dialogWidth: "100%", dialogHeight: "80%" }),
    alignment: DialogAlignment.BottomEnd,
    width: '100%'
  })
}

export function createNoUIDialogController(): CustomDialogController {
  return new CustomDialogController({
    builder: GyLoginDialog(),
    width: 0,
    height: 0,
    maskColor: Color.Transparent,
    isModal: false,
    autoCancel: false
  })
}
