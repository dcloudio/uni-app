	  *		"uniVer": "x",
	  *		"unixVer": "x"
	  *	}
	  * }
	  */
	pageOrientation ?: ChooseMediaPageOrientation | null,

	/**
	 * 最多可以选择的文件个数
	 * @defaultValue 9
	 * @uniPlatform {
	 *   "mp": {
	 *     "weixin": { "uniVer": "√", "unixVer": "4.41" },
	 *     "alipay": { "uniVer": "√", "unixVer": "5.31" }
	 *   },
	 *   "web": { "uniVer": "x", "unixVer": "x" },
	 * "app": {
		 *		"android": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
		 *		"ios": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
		 *    "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *	}
	 *}
	 */
	count ?: number | null
	/**
	 * image 只能拍摄图片或从相册选择图片，video 只能拍摄视频或从相册选择视频，mix 可同时选择图片和视频，合法值：'image'、'video'、'mix'
	 * @defaultValue 	['image', 'video']
	 * @uniPlatform {
	 *   "mp": {
	 *     "weixin": { "uniVer": "√", "unixVer": "4.41" },
	 *     "alipay": { "uniVer": "√", "unixVer": "5.31" }
	 *   },
	 *   "web": { "uniVer": "x", "unixVer": "x" },
	 * "app": {
		 *		"android": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
		 *		"ios": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
		 *    "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *	}
	 *}
	 */
	mediaType ?: (string[]) | null,
	/**
	 * album 从相册选择，camera 使用相机拍摄
	 * @defaultValue ['album', 'camera']
	 * @uniPlatform {
	 *   "mp": {
	 *     "weixin": { "uniVer": "√", "unixVer": "4.41" },
	 *     "alipay": { "uniVer": "√", "unixVer": "5.31" }
	 *   },
	 *   "web": { "uniVer": "x", "unixVer": "x" },
	 * "app": {
		 *		"android": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
		 *		"ios": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
		 *    "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *	}
	 *}
	 */
	sourceType ?: (string[]) | null,
	/**
	 * 拍摄视频最长拍摄时间，单位秒。时间范围为 3s 至 30s 之间
	 * @defaultValue 10
	 * @uniPlatform {
	 * "app": {
		 *		"android": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
		 *		"ios": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
   *    "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *	},
	*  "mp": {
	*    "weixin": {
	*        "uniVer": "√",
	*        "unixVer": "4.41"
	*    },
	*    "alipay": {
	*        "uniVer": "√",
	*        "unixVer": "5.31"
	*    },
	*    "baidu": {
	*        "uniVer": "√"
	*    },
	*    "toutiao": {
	*        "uniVer": "√"
	*    },
	*    "lark": {
	*        "uniVer": "√"
	*    },
	*    "qq": {
	*        "uniVer": "√"
	*    },
	*    "kuaishou": {
	*        "uniVer": "√"
	*    },
	*    "jd": {
	*        "uniVer": "√"
	*    }
	*  },
   *  "web": {
   *    "uniVer": "x",
   *    "unixVer": "x"
   *  }
	 * }
	 */
	maxDuration ?: number | null,
	/**
	 * 仅在 sourceType 为 camera 时生效，使用前置或后置摄像头
	 *
	 * @uniPlatform {
	 * "app": {
		 *		"android": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
		 *		"ios": {
		 *			"uniVer": "x",
		 *			"unixVer": "4.51"
		 *		},
   *    "harmony": { "uniVer": "4.25", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *	},
	*  "mp": {
	*    "weixin": {
	*        "uniVer": "√",
	*        "unixVer": "4.41"
	*    },
	*    "alipay": {
	*        "uniVer": "√",
	*        "unixVer": "5.31"
	*    },
	*    "baidu": {
	*        "uniVer": "√"
	*    },
	*    "toutiao": {
	*        "uniVer": "√"
	*    },
	*    "lark": {
	*        "uniVer": "√"
	*    },
	*    "qq": {
	*        "uniVer": "√"
	*    },
	*    "kuaishou": {
	*        "uniVer": "√"
	*    },
	*    "jd": {
	*        "uniVer": "√"
	*    }
	*  },
	 *  "web": {
	 *    "uniVer": "x",
	 *    "unixVer": "x"
	 *  }
	 * }
	 */
	camera ?:
	/**
	 * 前置摄像头
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "harmony": { "uniVer": "4.25", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *   }
	 * }
	 */
	'front' |
	/**
	 * 后置摄像头
	 * @uniPlatform {
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "harmony": { "uniVer": "4.25", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *   }
	 * }
	 */
	'back' | null,
	/**
	 * 接口调用成功，返回视频文件的临时文件路径，详见返回参数说明
	 * @uniPlatform {
	 *   "mp": {
	 *     "weixin": { "uniVer": "√", "unixVer": "4.41" },
	 *     "alipay": { "uniVer": "√", "unixVer": "5.31" }
	 *   },
	 *   "web": { "uniVer": "x", "unixVer": "x" },
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *   }
	 * }
	 */
	success ?: (ChooseMediaSuccessCallback) | null,
	/**
	 * 接口调用失败的回调函数
	 * @uniPlatform {
	 *   "mp": {
	 *     "weixin": { "uniVer": "√", "unixVer": "4.41" },
	 *     "alipay": { "uniVer": "√", "unixVer": "5.31" }
	 *   },
	 *   "web": { "uniVer": "x", "unixVer": "x" },
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *   }
	 * }
	 */
	fail ?: (ChooseMediaFailCallback) | null,
	/**
	 * 接口调用结束的回调函数（调用成功、失败都会执行）
	 * @uniPlatform {
	 *   "mp": {
	 *     "weixin": { "uniVer": "√", "unixVer": "4.41" },
	 *     "alipay": { "uniVer": "√", "unixVer": "5.31" }
	 *   },
	 *   "web": { "uniVer": "x", "unixVer": "x" },
	 *   "app": {
	 *     "android": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "ios": {
	 *       "uniVer": "x",
	 *       "unixVer": "4.51"
	 *     },
	 *     "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
	 *   }
	 * }
	 */
	complete ?: (ChooseMediaCompleteCallback) | null
};

/**
 * @uniPlatform {
 *   "app": {
 *     "android": { "uniVer": "x", "unixVer": "4.51" },
 *     "ios": { "uniVer": "x", "unixVer": "4.51" },
 *     "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
 *   }
 * }
 */
export type ChooseMedia = (options : ChooseMediaOptions) => void;

export interface Uni {
	/**
	  * 拍摄或从手机相册中选择图片或视频。
	  *
	  * @tutorial https://doc.dcloud.net.cn/uni-app-x/api/choose-media.html#choosemedia
	  * @uniPlatform {
	  *	 "app": {
	  *		"android": {
	  *			"uniVer": "x",
	  *			"unixVer": "4.51"
	  *		},
	  *		"ios": {
	  *			"uniVer": "x",
	  *			"unixVer": "4.51"
	  *		},
	  *    "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
	  *	},
	 *  "mp": {
	 *    "weixin": {
	 *        "uniVer": "√",
	 *        "unixVer": "4.41"
	 *    },
	 *    "alipay": {
	 *        "uniVer": "√",
	 *        "unixVer": "5.31"
	 *    },
	 *    "baidu": {
	 *        "uniVer": "√"
	 *    },
	 *    "toutiao": {
	 *        "uniVer": "√"
	 *    },
	 *    "lark": {
	 *        "uniVer": "√"
	 *    },
	 *    "qq": {
	 *        "uniVer": "√"
	 *    },
	 *    "kuaishou": {
	 *        "uniVer": "√"
	 *    },
	 *    "jd": {
	 *        "uniVer": "√"
	 *    }
	 *  },
	*  "web": {
	*    "uniVer": "x",
	*    "unixVer": "x"
	*  }
	  * }
	  */
	chooseMedia(options: ChooseMediaOptions): void;
}
