/**
 * @uniPlatform {
 *   "app": {
 *     "android": { "uniVer": "x", "unixVer": "4.51" },
 *     "ios": { "uniVer": "x", "unixVer": "4.51" },
 *     "harmony": { "uniVer": "4.31", "unixVer": "4.61", "unixVaporVer": "5.0" }
 *   }
 * }
 */
export type ChooseMediaOptions = {
	/**
	  * 屏幕方向。默认为pages.json中的pageOrientation。
	  * @uniPlatform {
	  *	 "app": {
	  *		"android": {
	  *			"uniVer": "x",
	  *			"unixVer": "4.51"
	  *		},
	  *		"ios": {
