<template>
  <view style="flex: 1;background-color: black;">
    <camera
      id="camera"
      style="flex: 1"
      resolution="high"
      frame-size="large"
      :flash="flash"
      @initdone="handleInitDone"
    ></camera>
    <view id="laser" class="uni-scan-code-scanner-laser"></view>
    <text v-if="isShowLight" class="uni-scan-code-light" @click="handleLight">{{
      "\ue9a1"
    }}</text>
    <view
      v-if="isShowAlbum"
      class="uni-scan-code-center"
      style="position: absolute; bottom: var(--uni-safe-area-inset-bottom); right: 20px;margin-bottom: 20px;"
    >
      <view
        class="uni-scan-code-album-wrap uni-scan-code-center"
        @click="handleChooseAlbum"
      >
        <text class="uni-scan-code-album">{{ "\ue9a0" }}</text>
      </view>
    </view>
    <text class="uni-scan-code-close" @click="handleClose">{{ "\uEA14" }}</text>

    <view v-show="isShowSelectionView" class="uni-scan-code-selection-view">
      <image id="selection-bg" style="width: 100%; height: 100%;"></image>
      <view class="uni-scan-code-mask"></view>

      <view
        v-for="marker in markers"
        class="uni-scan-code-tips"
        :style="{
          left: marker.left + Math.max(marker.width - 30, 0) / 2.0 + 'px',
          top: marker.top + Math.max(marker.height - 30, 0) / 2.0 + 'px',
          width: '30px',
          height: '30px',
          borderRadius: '15px',
        }"
        @click="selectMarker(marker)"
      >
        <text class="uni-scan-code-tips-text" :style="{ fontSize: '30px' }">{{
          "\uE9A3"
        }}</text>
      </view>

      <text class="uni-scan-code-close" @click="dismissSelectionView">{{
        cancelText
      }}</text>
      <text class="uni-scan-code-desc">{{ scanCodeDescText }}</text>
    </view>

    <view v-show="isShowImagePreview" class="uni-scan-code-selection-view">
      <image id="image-preview" style="width: 100%; height: 100%"></image>
      <view class="uni-scan-code-mask"></view>
      <text class="uni-scan-code-close" @click="closeImagePreview">{{ "\uEA14" }}</text>
      <text class="uni-scan-code-desc">{{ imageScanCodeFailDescText }}</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ScanCodeSupportedTypes } from "@/uni_modules/uni-scanCode";

//测试用导入
// import camera1 from "../../../uni-camera/components/camera/camera.vue";
// import { UniCameraInitDoneEvent } from "@/uni_modules/uni-camera/components/camera/global.uts";

// #ifdef APP-ANDROID
// #ifndef VUE3-VAPOR
import ImageProxy from "androidx.camera.core.ImageProxy";
import ImageView from "android.widget.ImageView";
import { DrawHelper } from "uts.sdk.modules.uniScanCode";

// import {
//   getAndroidScanner,
//   AndroidFrameScannerOptions,
//   AndroidScannerListener,
//   BarcodeInformation,
//   ScreenShot,
//   AndroidPhotoScannerOptions,
//   CameraContextSetZoomOptions,
// } from "uts.sdk.modules.DCloudUniCamera";

import {
  // createCameraContext,
  getAndroidScanner,
  AndroidFrameScannerOptions,
  AndroidScannerListener,
  BarcodeInformation,
  ScreenShot,
  AndroidPhotoScannerOptions,
  CameraContextSetZoomOptions,
} from "@/uni_modules/uni-camera";
// #endif
// #ifdef VUE3-VAPOR
import {
  utsNativeProcessScanBarCode,
  utsNativeProcessScanBarCodeWithPhoto,
  setScanCodeSelectionShowStatus,
} from "@/uni_modules/uni-scanCode";
// #endif
// #endif

// #ifdef APP-IOS
import {
  BarcodeInformation,
  CameraContextSetZoomOptions,
} from "@/uni_modules/uni-camera";

import {
  utsNativeProcessScanBarCode,
  utsNativeProcessScanBarCodeWithPhoto,
  setScanCodeSelectionShowStatus,
} from "@/uni_modules/uni-scanCode";
// #endif

// #ifdef APP-ANDROID
// #ifndef VUE3-VAPOR
type Marker = {
  left: number;
  top: number;
  width: number;
  height: number;
  information?: BarcodeInformation;
};
// #endif
// #ifdef VUE3-VAPOR
type ScanCodeBarcodeInformation = {
  result: string;
  scanType: string;
  charset: string;
  rawData: string;
  scanArea: Array<number>;
};

type Marker = {
  left: number;
  top: number;
  width: number;
  height: number;
  information?: ScanCodeBarcodeInformation;
};
// #endif
// #endif

// #ifdef APP-IOS
type Marker = {
  left: number;
  top: number;
  width: number;
  height: number;
  information?: BarcodeInformation;
};
// #endif

const doubleClickThreshold = 300; // 双击的时间间隔阈值（毫秒）
let lastClickTime = 0; // 上一次点击的时间戳

const instance = getCurrentInstance()

function getPage(): UniPage {
  return instance!.proxy!.$page;
}

const successEventName = ref("");
const failEventName = ref("");
const scanType = ref([] as ScanCodeSupportedTypes[]);
const maxZoom = ref(1);
const currentZoom = ref(1);
const isShowSelectionView = ref(false);
const isShowLight = ref(false);
const isShowAlbum = ref(false);
const markers = ref([] as Marker[]);
const animation = ref(null as UniAnimation | null);
const flash = ref("off");
const language = ref("zh-Hans");
const isShowImagePreview = ref(false);

const i18nCancelText = {
  en: "Cancel",
  es: "Cancelar",
  fr: "Annuler",
  "zh-Hans": "取消",
  "zh-Hant": "取消",
};

const i18nScanCodeDescText = {
  en: [
    "Multiple QR codes scanned. Select one to open.",
    "Multiple barcodes scanned. Select one to open.",
    "Multiple codes scanned. Select one to open.",
  ],
  es: [
    "Hay más de un código disponible. Seleccione unopara abrirlo.",
    "Hay más de un código disponible. Seleccione unopara abrirlo.",
    "Hay más de un código disponible. Seleccione unopara abrirlo.",
  ],
  fr: [
    "Plusieurs codes sont disponibles.Sélectionnez-en un pour ouvrir.",
    "Plusieurs codes sont disponibles.Sélectionnez-en un pour ouvrir.",
    "Plusieurs codes sont disponibles.Sélectionnez-en un pour ouvrir.",
  ],
  "zh-Hans": [
    "扫描到多个二维码，请选择一个打开",
    "扫描到多个条码，请选择一个打开",
    "扫描到多个码，请选择一个打开",
  ],
  "zh-Hant": [
    "掃描到多個 QR Code，請選擇一個開啟。",
    "掃描到多個碼，請選擇一個開啟。",
    "掃描到多個碼，請選擇一個開啟。",
  ],
};

const i18nImageScanCodeFailDescText = {
  en: "No valid barcode/QR code detected",
  es: "No se detectó ningún código de barras/QR válido",
  fr: "Aucun code-barres/QR code valide détecté",
  "zh-Hans": "未识别到一维/二维码",
  "zh-Hant": "未識別到一維/二維碼",
};

function isSupportedScanType(value: any): boolean {
  return (
    value == "barCode" ||
    value == "qrCode" ||
    value == "datamatrix" ||
    value == "pdf417"
  );
}

function isQRcode(format: string): boolean {
  return (
    format == "QR_CODE" ||
    format == "AZTEC" ||
    format == "DATA_MATRIX" ||
    format == "PDF_417"
  );
}

function isBarCode(format: string): boolean {
  return (
    format == "CODABAR" ||
    format == "CODE_39" ||
    format == "CODE_93" ||
    format == "CODE_128" ||
    format == "EAN_8" ||
    format == "EAN_13" ||
    format == "ITF" ||
    format == "UPC_A" ||
    format == "UPC_E"
  );
}

function closeDialogPage() {
  const page = getPage();
  uni.closeDialogPage({
    dialogPage: page,
    animationType: "none",
  });
}

function cancelAnimation() {
  animation.value?.cancel();
}

// #ifdef APP-ANDROID
// #ifndef VUE3-VAPOR
function emitSuccess(barcode: BarcodeInformation) {
  uni.$emit(successEventName.value, {
    result: barcode.result,
    scanType: barcode.scanType,
    charset: barcode.charset,
    rawData: barcode.rawData,
    scanArea: barcode.scanArea,
  });
  cancelAnimation();
  closeDialogPage();
}
// #endif
// #ifdef VUE3-VAPOR
function emitSuccess(barcode: ScanCodeBarcodeInformation) {
  uni.$emit(successEventName.value, {
    result: barcode.result,
    scanType: barcode.scanType,
    charset: barcode.charset,
    rawData: barcode.rawData,
    scanArea: barcode.scanArea,
  });
  cancelAnimation();
  closeDialogPage();
}
// #endif
// #endif

// #ifdef APP-IOS
function emitSuccess(barcode: BarcodeInformation) {
  uni.$emit(successEventName.value, {
    result: barcode.result,
    scanType: barcode.scanType,
    charset: barcode.charset,
    rawData: barcode.rawData,
    scanArea: barcode.scanArea,
  });
  cancelAnimation();
  closeDialogPage();
}
// #endif

function initPageOptions(options: UTSJSONObject) {
  successEventName.value = options["successEventName"]! as string;
  failEventName.value = options["failEventName"]! as string;
  isShowAlbum.value = (options["onlyFromCamera"]! as string) != "true";
  const pageScanType = options["scanType"] as string | null;
  if (pageScanType != null && pageScanType.length > 0) {
    const nextScanType: ScanCodeSupportedTypes[] = [];
    pageScanType.split(",").forEach((value: string) => {
      if (isSupportedScanType(value)) {
        nextScanType.push(value);
      }
    });
    scanType.value = nextScanType;
  }
}

// #ifdef APP-ANDROID
// #ifdef VUE3-VAPOR
function toBarcodeInformation(value: Map<string, any>): ScanCodeBarcodeInformation {
  return {
    result: value["result"] as string,
    scanType: value["scanType"] as string,
    charset: value["charset"] as string,
    rawData: value["rawData"] as string,
    scanArea: value["scanArea"] as Array<number>,
  };
}

function toBarcodeInformationList(values: Array<Map<string, any>>): Array<ScanCodeBarcodeInformation> {
  const barcodeInformation = [] as ScanCodeBarcodeInformation[];
  values.forEach((value: Map<string, any>) => {
    barcodeInformation.push(toBarcodeInformation(value));
  });
  return barcodeInformation;
}
// #endif
// #endif


function laserAnimation() {
  const page = getPage();
  const laser = page.getElementById("laser");
  const screenHeight = page.height;
  const beginPosition = screenHeight * 0.2;
  const endPosition = screenHeight * 0.8;
  animation.value = laser?.animate(
    [
      { top: `${beginPosition}px`, opacity: "1.0" },
      { top: `${endPosition}px`, opacity: "0.5" },
    ],
    {
      duration: 2500,
      iterations: Infinity,
    }
  );
}

function handleClose() {
  cancelAnimation();
  closeDialogPage();
}

function handleLight() {
  flash.value = flash.value == "off" ? "torch" : "off";
}

// #ifdef APP-ANDROID
// #ifndef VUE3-VAPOR
function attachTipsView(barcodeInformation: Array<BarcodeInformation>) {
  const nextMarkers = [] as Marker[];
  barcodeInformation.forEach((information) => {
    const scanArea = information.scanArea;
    if (scanArea.length == 4) {
      const marker: Marker = {
        left: scanArea[0],
        top: scanArea[1],
        width: scanArea[2],
        height: scanArea[3],
        information: information,
      };
      nextMarkers.push(marker);
    }
  });
  markers.value = nextMarkers;
}
// #endif
// #ifdef VUE3-VAPOR
function attachTipsView(barcodeInformation: Array<ScanCodeBarcodeInformation>) {
  const nextMarkers = [] as Marker[];
  barcodeInformation.forEach((information) => {
    const scanArea = information.scanArea;
    if (scanArea.length == 4) {
      const marker: Marker = {
        left: scanArea[0],
        top: scanArea[1],
        width: scanArea[2],
        height: scanArea[3],
        information: information,
      };
      nextMarkers.push(marker);
    }
  });
  markers.value = nextMarkers;
}
// #endif
// #endif

// #ifdef APP-IOS
function attachTipsView(barcodeInformation: Array<BarcodeInformation>) {
  const nextMarkers = [] as Marker[];
  barcodeInformation.forEach((information) => {
    const scanArea = information.scanArea;
    if (scanArea.length == 4) {
      const marker: Marker = {
        left: scanArea[0],
        top: scanArea[1],
        width: scanArea[2],
        height: scanArea[3],
        information: information,
      };
      nextMarkers.push(marker);
    }
  });
  markers.value = nextMarkers;
}
// #endif

function selectMarker(marker: Marker) {
  const barcode = marker.information;
  if (barcode != null) {
    emitSuccess(barcode);
  }
}

function bindDoubleClickListener() {
  const page = getPage();
  const element = page.getElementById("camera");
  element?.addEventListener("click", (_: MouseEvent) => {
    const currentTime = Date.now();
    if (currentTime - lastClickTime <= doubleClickThreshold) {
      const context = uni.createCameraContext();
      const targetZoom = Math.min(currentZoom.value * 1.2, maxZoom.value);
      // #ifdef APP-ANDROID
      // #ifndef VUE3-VAPOR
      context?.setZoom({
        zoom: targetZoom,
        success: (_result: any) => {
          currentZoom.value = targetZoom;
        },
      } as CameraContextSetZoomOptions);
      // #endif
      // #ifdef VUE3-VAPOR
      context?.setZoom({
        zoom: targetZoom,
        success: (_result: any) => {
          currentZoom.value = targetZoom;
        },
      });
      // #endif
      // #endif
      // #ifdef APP-IOS
      context?.setZoom({
        zoom: targetZoom,
        success: (_result: any) => {
          currentZoom.value = targetZoom;
        },
      } as CameraContextSetZoomOptions);
      // #endif
      lastClickTime = 0;
    } else {
      lastClickTime = currentTime;
    }
  });
}

// #ifdef APP-ANDROID
// #ifndef VUE3-VAPOR
function drawBgImage(screenShot: ScreenShot) {
  const page = getPage();
  const nativeView = page.getElementById("selection-bg")?.getAndroidView();
  if (nativeView != null && nativeView instanceof ImageView) {
    DrawHelper.drawImageWithBitmap(nativeView, screenShot.bitmap);
  }
}

function showSelectionViewFromVideoFrame(
  barcodeInformation: Array<BarcodeInformation>,
  screenShot: ScreenShot
) {
  if (isShowSelectionView.value) {
    return;
  }
  isShowSelectionView.value = true;
  drawBgImage(screenShot);
  if (barcodeInformation.length != 0) {
    attachTipsView(barcodeInformation);
  }
}
// #endif
// #endif

function startAnalysis() {
  const page = getPage();
  // #ifdef APP-ANDROID
  // #ifndef VUE3-VAPOR
  const context = uni.createCameraContext();
  currentZoom.value = context?.getCurrentZoom() ?? 1;
  const ratio = uni.getWindowInfo().pixelRatio;
  const width = page.width * ratio;
  const height = page.height * ratio;
  context?.onAndroidCameraOriginalFrame((imageProxy: ImageProxy) => {
    const options: AndroidFrameScannerOptions = {
      imageProxy: imageProxy,
      scanType: scanType.value,
      autoZoom: true,
      width: width.toInt(),
      height: height.toInt(),
      androidScannerListenner: new (class implements AndroidScannerListener {
        override onScanSuccess(
          barcodeInformation: Array<BarcodeInformation>,
          screenShot: ScreenShot | null
        ) {
          if (
            barcodeInformation.length > 1 &&
            screenShot != null &&
            !isShowSelectionView.value
          ) {
            context?.offAndroidCameraOriginalFrame();
            showSelectionViewFromVideoFrame(barcodeInformation, screenShot);
            return;
          }
          if (barcodeInformation.length == 0) {
            return;
          }
          emitSuccess(barcodeInformation[0]);
        }

        override onScanFailure(error: string) {}

        override needZoom(): void {
          const targetZoom = Math.min(currentZoom.value * 1.2, maxZoom.value);
          context?.setZoom({
            zoom: targetZoom,
            success: (_result: any) => {
              currentZoom.value = targetZoom;
            },
          } as CameraContextSetZoomOptions);
        }

        override onLight(light: boolean): void {
          if (flash.value == "torch") {
            return;
          }
          isShowLight.value = light;
        }
      }),
    };
    getAndroidScanner()?.processScanBarCode(options);
  });
  // #endif

  // #ifdef VUE3-VAPOR
  if (isShowSelectionView.value) {
    return;
  }
  const context = uni.createCameraContext();
  currentZoom.value = context?.getCurrentZoom() ?? 1;
  const ratio = uni.getWindowInfo().pixelRatio;
  const width = page.width * ratio;
  const height = page.height * ratio;
  const element = page.getElementById("selection-bg");
  if (element == null) {
    return;
  }
  utsNativeProcessScanBarCode(
    scanType.value,
    width,
    height,
    element,
    (show: boolean) => {
      isShowSelectionView.value = show;
    },
    (barcodeInformationMap: Array<Map<string, any>>) => {
      const barcodeInformation = toBarcodeInformationList(barcodeInformationMap);
      if (barcodeInformation.length != 0) {
        attachTipsView(barcodeInformation);
      }
    },
    (barcodeInformation: Array<Map<string, any>>) => {
      if (barcodeInformation.length == 0) {
        return;
      }
      uni.$emit(successEventName.value, new UTSJSONObject(barcodeInformation[0]));
      cancelAnimation();
      closeDialogPage();
    },
    (_error: string) => {},
    () => {
      const targetZoom = Math.min(currentZoom.value * 1.2, maxZoom.value);
      context?.setZoom({
        zoom: targetZoom,
        success: (_result: any) => {
          currentZoom.value = targetZoom;
        },
      });
    },
    (light: boolean) => {
      if (flash.value == "torch") {
        return;
      }
      isShowLight.value = light;
    }
  );
  // #endif
  // #endif

  // #ifdef APP-IOS
  if (isShowSelectionView.value) {
    return;
  }
  const context = uni.createCameraContext();
  const width = page.width;
  const height = page.height;
  const element = page.getElementById("selection-bg");
  utsNativeProcessScanBarCode(
    scanType.value,
    width,
    height,
    element,
    (show: boolean) => {
      isShowSelectionView.value = show;
    },
    (barcodeInformationMap: Array<Map<string, any>>) => {
      const barcodeInformation = [] as BarcodeInformation[];
      barcodeInformationMap.forEach((value: Map<string, any>) => {
        const barcode: BarcodeInformation = {
          result: value["result"],
          scanType: value["scanType"],
          charset: value["charset"],
          rawData: value["rawData"],
          scanArea: value["scanArea"],
        };
        barcodeInformation.push(barcode);
      });
      if (barcodeInformation.length != 0) {
        attachTipsView(barcodeInformation);
      }
    },
    (barcodeInformation: Array<Map<string, any>>) => {
      const barcode = barcodeInformation[0];
      uni.$emit(successEventName.value, new UTSJSONObject(barcode));
      cancelAnimation();
      closeDialogPage();
    },
    () => {
      const targetZoom = Math.min(currentZoom.value * 1.2, maxZoom.value);
      context?.setZoom({
        zoom: targetZoom,
        success: (_result: any) => {
          currentZoom.value = targetZoom;
        },
      } as CameraContextSetZoomOptions);
    },
    (light: boolean) => {
      if (flash.value == "torch") {
        return;
      }
      isShowLight.value = light;
    }
  );
  // #endif
}

function dismissSelectionView() {
  markers.value = [] as Marker[];
  isShowSelectionView.value = false;
  startAnalysis();
}

function closeImagePreview() {
  isShowImagePreview.value = false;
  startAnalysis();
}

function handleInitDone(event: UniCameraInitDoneEvent) {
  maxZoom.value = event.detail.maxZoom ?? 1;
  setTimeout(() => {
    startAnalysis();
  }, 300);
  bindDoubleClickListener();
}

function handleChooseAlbum() {
  uni.chooseImage({
    sourceType: ["album"],
    sizeType: ["original"],
    count: 1,
    albumMode: "system",
    success: (result: ChooseImageSuccess) => {
      const page = getPage();
      const filePath = result.tempFilePaths[0];
      // #ifdef APP-ANDROID
      // #ifndef VUE3-VAPOR
      const context = UTSAndroid.getAppContext()!!;
      const options: AndroidPhotoScannerOptions = {
        context,
        filePath,
        scanType: scanType.value,
        androidScannerListenner: new (class implements AndroidScannerListener {
          override onScanSuccess(
            barcodeInformation: Array<BarcodeInformation>,
            screenShot: ScreenShot | null
          ) {
            if (barcodeInformation.length == 0) {
              return;
            }
            emitSuccess(barcodeInformation[0]);
          }

          override onScanFailure(error: string) {
            if (error == "no barcode found") {
              const cameraContext = uni.createCameraContext();
              cameraContext?.offAndroidCameraOriginalFrame();
              isShowImagePreview.value = true;
              const element = page.getElementById("image-preview");
              element?.setAttribute("src", filePath);
              return;
            }
            uni.$emit(failEventName.value, {
              errMsg: error,
            });
            cancelAnimation();
            closeDialogPage();
          }

          override needZoom(): void {}

          override onLight(light: boolean): void {}
        }),
      };

      getAndroidScanner()?.processScanBarCodeWithPhoto(options);
      // #endif

      // #ifdef VUE3-VAPOR
      utsNativeProcessScanBarCodeWithPhoto(
        filePath,
        scanType.value,
        (barcodeInformationMap: Array<Map<string, any>>) => {
          if (barcodeInformationMap.length == 0) {
            return;
          }
          uni.$emit(
            successEventName.value,
            new UTSJSONObject(barcodeInformationMap[0])
          );
          cancelAnimation();
          closeDialogPage();
        },
        (error: string) => {
          if (error == "no barcode found") {
            const cameraContext = uni.createCameraContext();
            cameraContext?.offAndroidCameraOriginalFrame();
            isShowImagePreview.value = true;
            const element = page.getElementById("image-preview");
            element?.setAttribute("src", filePath);
            return;
          }
          uni.$emit(failEventName.value, {
            errMsg: error,
          });
          cancelAnimation();
          closeDialogPage();
        }
      );
      // #endif
      // #endif

      // #ifdef APP-IOS
      utsNativeProcessScanBarCodeWithPhoto(
        filePath,
        scanType.value,
        (barcodeInformationMap: Array<Map<string, any>>) => {
          if (barcodeInformationMap.length == 0) {
            return;
          }
          uni.$emit(
            successEventName.value,
            new UTSJSONObject(barcodeInformationMap[0])
          );
          cancelAnimation();
          closeDialogPage();
        },
        (error: string) => {
          if (error == "no barcode found") {
            const cameraContext = uni.createCameraContext();
            cameraContext?.offIosCameraOriginalFrame();
            isShowImagePreview.value = true;
            const element = page.getElementById("image-preview");
            element?.setAttribute("src", filePath);
            return;
          }
          uni.$emit(failEventName.value, {
            errMsg: error,
          });
          cancelAnimation();
          closeDialogPage();
        }
      );
      // #endif
    },
  });
}

const cancelText = computed((): string => {
  if (language.value.startsWith("en")) {
    return i18nCancelText["en"] as string;
  }
  if (language.value.startsWith("es")) {
    return i18nCancelText["es"] as string;
  }
  if (language.value.startsWith("fr")) {
    return i18nCancelText["fr"] as string;
  }
  if (language.value.startsWith("zh-Hans")) {
    return i18nCancelText["zh-Hans"] as string;
  }
  if (language.value.startsWith("zh-Hant")) {
    return i18nCancelText["zh-Hant"] as string;
  }
  return "取消";
});

const scanCodeDescText = computed((): string => {
  let type = 0;
  let qrCodeCount = 0;
  let barCodeCount = 0;
  markers.value.forEach((marker) => {
    const barcode = marker.information;
    if (barcode != null) {
      const currentScanType = barcode.scanType;
      if (isQRcode(currentScanType)) {
        qrCodeCount++;
      } else if (isBarCode(currentScanType)) {
        barCodeCount++;
      }
    }
  });

  if (qrCodeCount > 0 && barCodeCount > 0) {
    type = 2;
  } else if (qrCodeCount > 0) {
    type = 0;
  } else if (barCodeCount > 0) {
    type = 1;
  } else {
    return (i18nScanCodeDescText["zh-Hans"] as Array<string>)[2] as string;
  }

  if (language.value.startsWith("en")) {
    return (i18nScanCodeDescText["en"] as Array<string>)[type] as string;
  }
  if (language.value.startsWith("es")) {
    return (i18nScanCodeDescText["es"] as Array<string>)[type] as string;
  }
  if (language.value.startsWith("fr")) {
    return (i18nScanCodeDescText["fr"] as Array<string>)[type] as string;
  }
  if (language.value.startsWith("zh-Hans")) {
    return (i18nScanCodeDescText["zh-Hans"] as Array<string>)[type] as string;
  }
  if (language.value.startsWith("zh-Hant")) {
    return (i18nScanCodeDescText["zh-Hant"] as Array<string>)[type] as string;
  }
  return (i18nScanCodeDescText["zh-Hans"] as Array<string>)[2] as string;
});

const imageScanCodeFailDescText = computed((): string => {
  if (language.value.startsWith("en")) {
    return i18nImageScanCodeFailDescText["en"] as string;
  }
  if (language.value.startsWith("es")) {
    return i18nImageScanCodeFailDescText["es"] as string;
  }
  if (language.value.startsWith("fr")) {
    return i18nImageScanCodeFailDescText["fr"] as string;
  }
  if (language.value.startsWith("zh-Hans")) {
    return i18nImageScanCodeFailDescText["zh-Hans"] as string;
  }
  if (language.value.startsWith("zh-Hant")) {
    return i18nImageScanCodeFailDescText["zh-Hant"] as string;
  }
  return i18nImageScanCodeFailDescText["zh-Hans"] as string;
});

// #ifdef APP-ANDROID
// #ifdef VUE3-VAPOR
watch(isShowSelectionView, (value) => {
  setScanCodeSelectionShowStatus(value as boolean);
});
// #endif
// #endif

// #ifdef APP-IOS
watch(isShowSelectionView, (value) => {
  setScanCodeSelectionShowStatus(value as boolean);
});
// #endif

onLoad((options: UTSJSONObject) => {
  initPageOptions(options);
  const systemInfo = uni.getSystemInfoSync();
  const osLanguage = systemInfo.osLanguage;
  const appLanguage = systemInfo.appLanguage;
  if (appLanguage != null) {
    language.value = appLanguage;
  } else if (osLanguage != null) {
    language.value = osLanguage;
  }
});

onReady(() => {
  laserAnimation();
});

onUnload(() => {
  uni.$off(successEventName.value, null);
  uni.$off(failEventName.value, null);
});

onBackPress((_options: OnBackPressOptions): boolean | null => {
  closeDialogPage();
  return true;
});

</script>

<style>
@font-face {
  font-family: "UniScanCodeFontFamily";
  src: url("/uni_modules/uni-scanCode/static/font/uni-scanCode.ttf")
    format("truetype");
}

.uni-scan-code-light {
  font-family: "UniScanCodeFontFamily";
  color: white;
  position: absolute;
  bottom: 100px;
  left: 50%;
  font-size: 35px;
  transform: translateX(-50%);
}

.uni-scan-code-scanner-laser {
  position: absolute;
  top: 20%;
  left: 10%;
  width: 80%;
  height: 5px;
  opacity: 1;
  background-image: linear-gradient(to bottom, transparent, green);
}

.uni-scan-code-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.uni-scan-code-album-wrap {
  background-color: rgba(106, 122, 122, 0.2);
  width: 40px;
  height: 40px;
  border-radius: 20px;
}

.uni-scan-code-album {
  font-family: "UniScanCodeFontFamily";
  font-size: 20px;
  color: white;
}

.uni-scan-code-close {
  font-family: "uni-icon";
  color: white;
  position: absolute;
  top: var(--uni-safe-area-inset-top);
  left: 25px;
  margin-top: 5px;
}

.uni-scan-code-selection-view {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.uni-scan-code-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.uni-scan-code-tips {
  position: absolute;
  background-color: white;
  justify-content: center;
  align-items: center;
}

.uni-scan-code-tips-text {
  font-family: "UniScanCodeFontFamily";
  color: green;
}

.uni-scan-code-desc {
  position: absolute;
  bottom: 20%;
  left: 50%;
  transform: translateX(-50%);
  color: #c3c5c6;
  font-size: 14px;
  background: linear-gradient(to right, rgba(150, 150, 150, 0.3) , rgba(180, 180, 180, 0.3));
}
</style>
