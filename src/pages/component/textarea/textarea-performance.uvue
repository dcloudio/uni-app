<template>
  <view class="bg-f5f5f5">
    <!-- #ifndef MP -->
    <fps />
    <!-- #endif -->
    <!-- 控制按钮区域 -->
    <view class="bg-fff items-center u-p-2 flex-dir-row flex-wrap-wrap">
      <button @click="clearValue" size="mini" class="u-ml-2">清空内容</button>
      <button
        @click="toggleDisabled"
        :type="sharedDisabled ? 'primary' : 'default'"
        size="mini"
        class="u-ml-2"
      >
        {{ sharedDisabled ? "启用" : "禁用" }}输入
      </button>
      <text class="fs-11 color-666 ml-5"
        >值: {{ sharedValue == "" ? "(空)" : sharedValue }}</text
      >
    </view>

    <!-- 100个textarea组件 -->
    <view class="u-p-2 flex-dir-row flex-wrap-wrap">
      <template v-for="index in 100" :key="index">
        <textarea
          :value="sharedValue"
          :placeholder="index.toString()"
          :disabled="sharedDisabled"
          @input="onInput"
          class="border-1-solid-ddd fs-9 radius-2 bg-fff h-30 m-1 u-p-2 w-15pct"
        />
      </template>
    </view>
  </view>
</template>

<script setup lang="ts">
  const sharedValue = ref('')
  const sharedDisabled = ref(false)

  function onInput(e : UniInputEvent) {
    sharedValue.value = e.detail.value
    console.log('textarea value changed:', e.detail.value)
  }

  function clearValue() {
    sharedValue.value = ''
    console.log('value cleared')
  }

  function toggleDisabled() {
    sharedDisabled.value = !sharedDisabled.value
    console.log('disabled:', sharedDisabled.value)
  }
</script>
