<template>
  <scroll-view class="flex-1">
    <page-head :title="title"></page-head>
    <view class="p-0-15 mt-15">
      <view class="p-10-0 color-text-333">
        <text class="fs-15 fw-bold color-text-333">大图示例</text>
      </view>
      <view class="mt-15" v-for="_ in 10">
        <text class="color-888 fs-12 fw-bold u-mt-5">width={{width}}px height={{height}}px memory={{memory}}MB</text>
        <image class="w-full" mode="widthFix" :src="src" @load="load"></image>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">


// Data
const title = ref('image-large')
const src = ref('https://qiniu-web-assets.dcloud.net.cn/uni-app-x/static/img/building.jpg')
const width = ref(0)
const height = ref(0)
const memory = ref(0)

// Methods
function load(event : ImageLoadEvent) {
  width.value = event.detail.width
  height.value = event.detail.height
  memory.value = Math.round(width.value * height.value * 4 / 1024 / 1024 * 100) / 100
}
</script>
