<script setup lang="ts">
  const data = reactive({
    activeId: ''
  })

  const isActive = (id: string): boolean => {
    return data.activeId == id
  }

  const setActive = (id: string) => {
    data.activeId = data.activeId == id ? '' : id
  }
</script>

