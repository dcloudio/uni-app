<template>
  <page-head :title="data.title"></page-head>
  <scroll-view style="flex: 1">
    <view class="uni-padding-wrap" flatten>
      <text class="uni-title-text">fade-show 属性示例</text>
      <text class="uni-subtitle-text uni-common-mb">图片类型{{data.imageType}}，右边为拍平</text>
      <view class="styled-image-row">
        <image class="styled-image" mode="aspectFill" :src="data.imageSrc" :fade-show="data.fadeShow"></image>
        <image class="styled-image" mode="aspectFill" :src="data.imageSrc" :fade-show="data.fadeShow" flatten></image>
      </view>
      <button class="uni-button" @click="switchSrc">切换图片</button>
      <button class="uni-button" @click="swithchFadeShow">{{data.fadeShow?'关闭fade-show':'开启fade-show'}}</button>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
  type DataType = {
    title : string
    fadeShow: boolean
    imageSrc : string.ImageURIString
    imageType : string
  }
  const images = ['/static/test-image/logo.svg', '/static/test-image/logo.png', 'https://qiniu-web-assets.dcloud.net.cn/uni-app-x/static/img/building.jpg', '/static/test-image/logo.webp', '/static/test-image/animated.webp']
  const types = ['svg', 'static', 'https', 'webp', 'webp animation']
  let index = 0;
  // 使用reactive避免ref数据在自动化测试中无法访问
  const data = reactive({
    title: 'fade-show',
    fadeShow: true,
    imageSrc: '/static/test-image/logo.svg',
    imageType: 'svg',
    index: 0
  } as DataType)

  const switchSrc = () => {
    index ++
    if(index >= images.length){
      index = 0
    }
    data.imageSrc = images[index]
    data.imageType = types[index]
  }

  const swithchFadeShow = () => {
    data.fadeShow = !data.fadeShow
  }

</script>

<style>
  .styled-image-row {
    flex-direction: row;
    background-color: var(--list-background-color, #ffffff);
    justify-content: space-around;
    height: 160px;
    align-items: center;
    margin-bottom: 10px;
  }

  .styled-image {
    width: 120px;
    height: 120px;
    margin: 5px;
    padding: 5px;
    border: 2px solid #ff6b6b;
    border-radius: 10px;
  }
</style>
