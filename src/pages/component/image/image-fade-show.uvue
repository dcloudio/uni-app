<template>
  <page-head :title="data.title"></page-head>
  <scroll-view class="flex-1">
    <view class="p-0-15" flatten>
      <text class="fs-15 fw-bold color-text-333">fade-show 属性示例</text>
      <text class="color-888 fs-12 fw-bold u-mt-5 mb-15">图片类型{{data.imageType}}，右边为拍平</text>
      <view class="flex-dir-row bg-list-fff justify-around items-center mb-10 h-160">
        <image class="h-120 m-5 p-5 radius-10 styled-image border-2-solid-ff6b6b" mode="aspectFill" :src="data.imageSrc" :fade-show="data.fadeShow"></image>
        <image class="h-120 m-5 p-5 radius-10 styled-image border-2-solid-ff6b6b" mode="aspectFill" :src="data.imageSrc" :fade-show="data.fadeShow" flatten></image>
      </view>
      <button @click="switchSrc">切换图片</button>
      <button @click="swithchFadeShow">{{data.fadeShow?'关闭fade-show':'开启fade-show'}}</button>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
  type DataType = {
    title : string
    fadeShow: boolean
    imageSrc : string.ImageURIString
    imageType : string
  }
  const images = ['/static/test-image/logo.svg', '/static/test-image/logo.png', 'https://qiniu-web-assets.dcloud.net.cn/uni-app-x/static/img/building.jpg', '/static/test-image/logo.webp', '/static/test-image/animated.webp']
  const types = ['svg', 'static', 'https', 'webp', 'webp animation']
  let index = 0;
  // 使用reactive避免ref数据在自动化测试中无法访问
  const data = reactive({
    title: 'fade-show',
    fadeShow: true,
    imageSrc: '/static/test-image/logo.svg',
    imageType: 'svg',
    index: 0
  } as DataType)

  const switchSrc = () => {
    index ++
    if(index >= images.length){
      index = 0
    }
    data.imageSrc = images[index]
    data.imageType = types[index]
  }

  const swithchFadeShow = () => {
    data.fadeShow = !data.fadeShow
  }

</script>

<style>
  .styled-image {
    width: 120px;
  }
</style>
