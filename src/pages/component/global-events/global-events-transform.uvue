<template>
  <view>
    <view class="w-100 h-100 bg-a52a2a" @click="onclick"
      style="transform: rotate(180deg); margin: 8px auto;"
      @longpress="onLongPress" id="event-transform">
      <text class="text-center color-text lh-100">旋转180°后</text>
    </view>
  </view>
  <text class="color-text m-0-auto">点击上面view触发点击事件</text>
</template>

<script setup lang="ts">

type DataType = {
  clickTriger: boolean,
  longClickTriger: boolean,
}

// 使用reactive包装数据，便于自动化测试获取
const data = reactive({
  clickTriger: false,
  longClickTriger: false,
} as DataType)

function onclick(event : UniPointerEvent) {
  data.clickTriger = true
  uni.showToast({
    title: "触发了点击事件"
  })
}

function onLongPress(event : UniTouchEvent) {
  data.longClickTriger = true
  uni.showToast({
    title: "触发了长按事件"
  })
}

defineExpose({
  data
})
</script>
