<template>
    <page-head title="组件全局事件示例"></page-head>
    <page-intro content="本页演示组件全局事件：触摸区域展示 touchstart/touchmove/touchend/touchcancel，点击区域展示 tap/click/longpress，并显示事件详情与清除；可跳转冒泡、阻止默认、transform 等子示例。"></page-intro>
    <view class="p-0-15 mt-15 container pb-10">
      <view class="mb-20">
        <text class="fs-16 fw-bold mb-8 section-title">触摸事件区域：touchstart/touchmove/touchend/touchcancel</text>
        <text class="fs-14 mb-10 section-desc">在下方蓝色区域滑动查看触摸事件详情</text>
        <view class="w-full h-200 radius-10 d-flex items-center justify-center bg-409eff" id="touch-target" @touchstart="onTouchStart" @touchcancel="onTouchCancel"
          @touchmove="onTouchMove" @touchend="onTouchEnd">
          <text class="color-fff fs-16 fw-bold">在此区域滑动</text>
        </view>
      </view>

      <view class="mb-20">
        <text class="fs-16 fw-bold mb-8 section-title">点击/长按事件区域：tap/click/longpress</text>
        <text class="fs-14 mb-10 section-desc">点击或长按下方绿色区域查看事件详情</text>
        <view class="w-full h-200 radius-10 d-flex items-center justify-center bg-67c23a" id="longpress-target" @tap="onTap" @click="onClick" @longpress="onLongPress">
          <text class="color-fff fs-16 fw-bold">点击或长按</text>
        </view>
      </view>

      <view class="mb-20" v-if="touchStartEvent !== null || touchMoveEvent !== null || touchEndEvent !== null || touchCancelEvent !== null || tapEvent !== null || clickEvent !== null || longPressEvent !== null">
        <view class="d-flex justify-center m-20-0">
          <button class="w-full color-fff radius-6 fs-14 clear-btn" @click="clearAllEvents">清除所有事件</button>
        </view>
      </view>
      <view v-if="touchStartEvent !== null" class="u-p-15 radius-8 mb-20 event-detail">
        <text class="fs-18 fw-bold mb-12 color-global-title-303133">touchStart Event（触摸开始事件）</text>
        <view class="u-p-10 radius-6 mb-12 bg-list-fff">
          <text class="fs-15 fw-bold mb-8 color-global-body-606266">UniEvent 基础属性:</text>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.type (事件类型):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchStartEvent!.type }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.bubbles (是否冒泡):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchStartEvent!.bubbles }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.cancelable (是否可取消):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchStartEvent!.cancelable }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.timeStamp (时间戳):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchStartEvent!.timeStamp }}</text>
          </view>
        </view>
        <text class="fs-15 fw-bold mt-12 mb-8 color-global-body-606266">event.touches (当前所有触摸点):</text>
        <template v-for="(touch, index) in touchStartEvent!.touches" :key="index">
          <view class="u-p-10 radius-6 mb-10 bg-list-fff">
            <text class="fs-14 fw-bold mb-8 color-409eff">event.touches[{{ index }}]:</text>
            <view class="pl-10">
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .identifier (触摸点标识符):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-touch-identifier">{{ touch.identifier }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .pageX (相对于页面左边,含滚动):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-touch-page-x">{{ touch.pageX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .pageY (相对于页面顶部,含滚动):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-touch-page-y">{{ touch.pageY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .clientX (相对于可视区域左边):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-touch-client-x">{{ touch.clientX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .clientY (相对于可视区域顶部):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-touch-client-y">{{ touch.clientY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .screenX (相对于屏幕左边,不含滚动):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-touch-screen-x">{{ touch.screenX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .screenY (相对于屏幕顶部,不含滚动):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-touch-screen-y">{{ touch.screenY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .force (触摸点的压力大小):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-touch-force">{{ touch.force }}</text>
              </view>
            </view>
          </view>
        </template>
        <text class="fs-15 fw-bold mt-12 mb-8 color-global-body-606266">event.changedTouches (变化的触摸点):</text>
        <template v-for="(touch, index) in touchStartEvent!.changedTouches" :key="index">
          <view class="u-p-10 radius-6 mb-10 bg-list-fff">
            <text class="fs-14 fw-bold mb-8 color-409eff">event.changedTouches[{{ index }}]:</text>
            <view class="pl-10">
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .identifier:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-changed-touch-identifier">{{ touch.identifier }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .pageX:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-changed-touch-page-x">{{ touch.pageX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .pageY:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-changed-touch-page-y">{{ touch.pageY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .clientX:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-changed-touch-client-x">{{ touch.clientX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .clientY:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-changed-touch-client-y">{{ touch.clientY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .screenX:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-changed-touch-screen-x">{{ touch.screenX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .screenY:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-changed-touch-screen-y">{{ touch.screenY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .force:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-start-changed-touch-force">{{ touch.force }}</text>
              </view>
            </view>
          </view>
        </template>
      </view>
      <view v-if="touchCancelEvent !== null" class="u-p-15 radius-8 mb-20 event-detail">
        <text class="fs-18 fw-bold mb-12 color-global-title-303133">touchCancel Event（触摸取消事件）</text>
        <view class="u-p-10 radius-6 mb-12 bg-list-fff">
          <text class="fs-15 fw-bold mb-8 color-global-body-606266">UniEvent 基础属性:</text>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.type (事件类型):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchCancelEvent!.type }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.bubbles (是否冒泡):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchCancelEvent!.bubbles }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.cancelable (是否可取消):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchCancelEvent!.cancelable }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.timeStamp (时间戳):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchCancelEvent!.timeStamp }}</text>
          </view>
        </view>
        <text class="fs-15 fw-bold mt-12 mb-8 color-global-body-606266">event.touches (当前所有触摸点):</text>
        <template v-for="(touch, index) in touchCancelEvent!.touches" :key="index">
          <view class="u-p-10 radius-6 mb-10 bg-list-fff">
            <text class="fs-14 fw-bold mb-8 color-409eff">event.touches[{{ index }}]:</text>
            <view class="pl-10">
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .identifier (触摸点标识符):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-touch-identifier">{{
              touch.identifier
            }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .pageX (相对于页面左边,含滚动):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-touch-page-x">{{ touch.pageX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .pageY (相对于页面顶部,含滚动):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-touch-page-y">{{ touch.pageY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .clientX (相对于可视区域左边):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-touch-client-x">{{ touch.clientX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .clientY (相对于可视区域顶部):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-touch-client-y">{{ touch.clientY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .screenX (相对于屏幕左边,不含滚动):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-touch-screen-x">{{ touch.screenX }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .screenY (相对于屏幕顶部,不含滚动):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-touch-screen-y">{{ touch.screenY }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .force (触摸点的压力大小):</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-touch-force">{{ touch.force }}</text>
              </view>
            </view>
          </view>
        </template>
        <text class="fs-15 fw-bold mt-12 mb-8 color-global-body-606266">event.changedTouches (变化的触摸点):</text>
        <template v-for="(touch, index) in touchCancelEvent!.changedTouches" :key="index">
          <view class="u-p-10 radius-6 mb-10 bg-list-fff">
            <text class="fs-14 fw-bold mb-8 color-409eff">event.changedTouches[{{ index }}]:</text>
            <view class="pl-10">
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .identifier:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-changed-touch-identifier">{{
              touch.identifier
            }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .pageX:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-changed-touch-page-x">{{
              touch.pageX
            }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .pageY:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-changed-touch-page-y">{{
              touch.pageY
            }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .clientX:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-changed-touch-client-x">{{
              touch.clientX
            }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .clientY:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-changed-touch-client-y">{{
              touch.clientY
            }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .screenX:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-changed-touch-screen-x">{{
              touch.screenX
            }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .screenY:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-changed-touch-screen-y">{{
              touch.screenY
            }}</text>
              </view>
              <view class="d-flex flex-dir-row mb-6 items-flex-start">
                <text class="fs-13 mr-8 prop-label ws-normal color-global-muted-909399 max-w-120">  .force:</text>
                <text class="fs-13 fw-bold flex-1 text-right ws-normal color-global-title-303133 min-w-60" id="touch-cancel-changed-touch-force">{{
              touch.force
            }}</text>
              </view>
            </view>
          </view>
        </template>
      </view>
      <view v-if="touchMoveEvent !== null" class="u-p-15 radius-8 mb-20 event-detail">
        <text class="fs-18 fw-bold mb-12 color-global-title-303133">touchMove Event（触摸移动事件）</text>
        <view class="u-p-10 radius-6 mb-12 bg-list-fff">
          <text class="fs-15 fw-bold mb-8 color-global-body-606266">UniEvent 基础属性:</text>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.type (事件类型):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchMoveEvent!.type }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.bubbles (是否冒泡):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchMoveEvent!.bubbles }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.cancelable (是否可取消):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchMoveEvent!.cancelable }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.timeStamp (时间戳):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ touchMoveEvent!.timeStamp }}</text>
          </view>
        </view>
        <text class="fs-15 fw-bold mt-12 mb-8 color-global-body-606266">event.touches (当前所有触摸点):</text>
        <template v-for="(touch, index) in touchMoveEvent!.touches" :key="index">
          <view class="u-p-10 radius-6 mb-10 bg-list-fff">
            <text class="fs-14 fw-bold mb-8 color-409eff">event.touches[{{ index }}]:</text>
            <view class="pl-10">
