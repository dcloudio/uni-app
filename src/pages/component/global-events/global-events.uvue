            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.clientX (相对于可视区域左边):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ clickEvent!.clientX }}</text>
