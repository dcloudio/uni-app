          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.y (同clientY):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60" id="click-event-y">{{ clickEvent!.y }}</text>
          </view>
