        <view class="u-p-10 radius-6 mb-12 bg-list-fff">
          <text class="fs-15 fw-bold mb-8 color-global-body-606266">UniEvent 基础属性:</text>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.type (事件类型):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ clickEvent!.type }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.bubbles (是否冒泡):</text>
