            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ clickEvent!.clientY }}</text>
          </view>
          <view class="d-flex flex-dir-row justify-between items-flex-start mb-8">
            <text class="fs-14 mr-10 info-label ws-normal color-global-muted-909399 max-w-120">event.pageX (相对于页面左边,含滚动):</text>
            <text class="fs-14 fw-bold text-right flex-1 ws-normal color-global-title-303133 min-w-60">{{ clickEvent!.pageX }}</text>
