<template>
  <page-head title="glass-effect-view"></page-head>
  <scroll-view class="flex-1">
    <view class="p-0-15 mt-15">
      <text class="fs-15 fw-bold color-text-333">玻璃效果预览</text>
      <view class="pos-relative u-h-300 mt-12 overflow-hidden radius-8 bg-fff">
        <view class="pos-absolute right-0 top-0 bottom-0 flex-dir-row left-0">
          <view class="flex-1 color-red"></view>
          <view class="flex-1 color-yellow"></view>
          <view class="flex-1 color-green"></view>
          <view class="flex-1 color-blue"></view>
          <view class="flex-1 color-purple"></view>
        </view>
        <text class="pos-absolute fw-700 color-fff stage-text stage-text-top">GLASS</text>
        <text class="pos-absolute fw-700 color-fff stage-text stage-text-bottom bottom-18">iOS</text>
        <glass-effect-view
          v-if="data.glassStyle == 'regular'"
          id="clickable-glass-effect-view"
          class="glass-panel pos-absolute overflow-hidden"
          glass-style="regular"
          :interactive="data.interactive"
          :tint-color="data.tintColor"
          @click="onGlassClick">
          <view class="flex-1 justify-center items-center">
            <text class="fs-24 fw-700 glass-title">regular</text>
            <text class="mt-8 fs-13 glass-detail">interactive: {{ data.interactive }}</text>
            <text class="mt-8 fs-13 glass-detail">tint: {{ data.tintColor }}</text>
          </view>
        </glass-effect-view>
        <glass-effect-view
          v-else
          class="glass-panel pos-absolute overflow-hidden"
          glass-style="clear"
          :interactive="data.interactive"
          :tint-color="data.tintColor">
          <view class="flex-1 justify-center items-center">
            <text class="fs-24 fw-700 glass-title">clear</text>
            <text class="mt-8 fs-13 glass-detail">interactive: {{ data.interactive }}</text>
            <text class="mt-8 fs-13 glass-detail">tint: {{ data.tintColor }}</text>
          </view>
        </glass-effect-view>
      </view>
    </view>

    <view class="mt-10">
      <enum-data-checkbox
        title="glass-style 玻璃效果样式"
        :items="data.glassStyleItems"
        @change="changeGlassStyle"></enum-data-checkbox>
      <boolean-data
        title="interactive 启用交互行为"
        :value="false"
        @change="changeInteractive"></boolean-data>
      <enum-data-checkbox
        title="tint-color 玻璃效果着色"
        :items="data.tintColorItems"
        @change="changeTintColor"></enum-data-checkbox>
      <view class="h-30"></view>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types'

  type DataType = {
    glassStyle : string;
    interactive : boolean;
    tintColor : string;
    clickCount : number;
    glassStyleItems : ItemType[];
    tintColorItems : ItemType[];
  }

  const data = reactive({
    glassStyle: 'regular',
    interactive: false,
    tintColor: 'transparent',
    clickCount: 0,
    glassStyleItems: [
      { value: 0, name: 'regular', checked: true },
      { value: 1, name: 'clear' },
    ],
    tintColorItems: [
      { value: 0, name: '透明', checked: true },
      { value: 1, name: '红色' },
      { value: 2, name: '蓝色' },
      { value: 3, name: '绿色' },
    ],
  } as DataType)

  function changeGlassStyle(value : number) {
    data.glassStyle = value == 1 ? 'clear' : 'regular'
  }

  function changeInteractive(value : boolean) {
    data.interactive = value
  }

  function changeTintColor(value : number) {
    switch (value) {
      case 1:
        data.tintColor = 'rgba(255, 59, 48, 0.25)'
        break
      case 2:
        data.tintColor = 'rgba(0, 122, 255, 0.25)'
        break
      case 3:
        data.tintColor = 'rgba(52, 199, 89, 0.25)'
        break
      default:
        data.tintColor = 'transparent'
        break
    }
  }

  function onGlassClick() {
    data.clickCount++
  }

  function getGlassEffectViewRectForTest() : DOMRect | null {
    return uni.getElementById('clickable-glass-effect-view')?.getBoundingClientRect() ?? null
  }

  defineExpose({
    data,
    getGlassEffectViewRectForTest,
  })
</script>

<style>
  .color-red {
    background-color: #ff453a;
  }

  .color-yellow {
    background-color: #ffd60a;
  }

  .color-green {
    background-color: #30d158;
  }

  .color-blue {
    background-color: #0a84ff;
  }

  .color-purple {
    background-color: #bf5af2;
  }

  .stage-text {
    font-size: 48px;
  }

  .stage-text-top {
    left: 18px;
    top: 18px;
  }

  .stage-text-bottom {
    right: 18px;
  }

  .glass-panel {
    left: 42px;
    right: 42px;
    top: 74px;
    height: 152px;
    border-radius: 28px;
  }

  .glass-title {
    color: #111111;
  }

  .glass-detail {
    color: #222222;
  }
</style>
