<template>
    <button @click="testScroll">滚动测试</button>
    <list-view class="flex-1" :scroll-top="scrollTop" :scroll-with-animation="true">
      <sticky-section :push-pinned-header="false">
        <sticky-header>
          <text class="bg-ccc fs-18 lh-40">A</text>
        </sticky-header>
        <list-item v-for="item in 20" :key="item">
          <text class="fs-14 lh-30 bg-eee">item-{{item}}</text>
        </list-item>
      </sticky-section>
      <sticky-section>
        <sticky-header>
          <text class="bg-ccc fs-18 lh-40">B</text>
        </sticky-header>
        <list-item v-for="item in 20" :key="item">
          <text class="fs-14 lh-30 bg-eee">item-{{item}}</text>
        </list-item>
      </sticky-section>
      <sticky-section :push-pinned-header="false">
        <sticky-header>
          <text class="bg-ccc fs-18 lh-40">C</text>
        </sticky-header>
        <list-item v-for="item in 20" :key="item">
          <text class="fs-14 lh-30 bg-eee">item-{{item}}</text>
        </list-item>
      </sticky-section>
      <sticky-section>
        <sticky-header>
          <text class="bg-ccc fs-18 lh-40">D</text>
        </sticky-header>
        <list-item v-for="item in 20" :key="item">
          <text class="fs-14 lh-30 bg-eee">item-{{item}}</text>
        </list-item>
      </sticky-section>
      <sticky-section>
        <sticky-header>
          <text class="bg-ccc fs-18 lh-40">E</text>
        </sticky-header>
        <list-item v-for="item in 20" :key="item">
          <text class="fs-14 lh-30 bg-eee">item-{{item}}</text>
        </list-item>
      </sticky-section>
    </list-view>
</template>

<script setup lang="ts">
  const scrollTop = ref(0)
  const sectionHeight = 30 * 20 + 40;
  const sectionCount = 5
  let currentSection = 0
  function testScroll() {
    currentSection++
    if (currentSection > sectionCount) {
      currentSection = 0
    }
    scrollTop.value = currentSection * sectionHeight;
  }
  defineExpose({
    testScroll
  })
</script>
