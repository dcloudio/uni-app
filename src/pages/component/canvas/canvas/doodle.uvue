<template>
    <!-- #ifdef WEB -->
    <!-- TODO 后续支持配置时在移除 -->
    <canvas class="w-full flex-grow-1 mb-10 bg-d3d3d3" id="tablet" @pointerdown="pointerDown" @pointermove="pointerMove" @pointerup="pointerUp" @pointercancel="pointerUp" @pointerleave="pointerUp" @ready="onCanvasReady"></canvas>
    <!-- #endif -->
    <!-- #ifndef WEB -->
    <canvas class="w-full flex-grow-1 mb-10 bg-d3d3d3" id="tablet" @touchstart="touchStart" @touchmove="touchMove" @touchend="touchEnd" @ready="onCanvasReady"></canvas>
    <!-- #endif -->
    <button class="mb-20" @click="doClear()">清空</button>
</template>

<script setup lang="ts">
type Point = {
  x : number
  y : number
}

// Data
let lastPointX = 0
let lastPointY = 0
let offsetX = 0
let offsetY = 0
let isDrawing = false
let renderingContext: CanvasRenderingContext2D | null = null

// Methods
function startDraw(x : number, y : number) {
  lastPointX = x
  lastPointY = y
}

function drawLine(x : number, y : number) {
  const ctx = renderingContext!
  ctx.lineWidth = 5
  ctx.lineCap = "round"
  ctx.lineJoin = "round"
  ctx.beginPath()
  ctx.moveTo(lastPointX, lastPointY)
  ctx.lineTo(x, y)
  ctx.stroke()

  lastPointX = x
  lastPointY = y
}

function getPosition(event : TouchEvent) : Point {
  const touch = event.touches[0]
  // #ifndef MP
  return {
    x: touch.clientX - offsetX,
    y: touch.clientY - offsetY
  } as Point
  // #endif

  // #ifdef MP
  return {
    x: touch.x,
    y: touch.y
  } as Point
  // #endif
}

function touchStart(event : TouchEvent) {
  const position = getPosition(event)
  startDraw(position.x, position.y)
}

function touchMove(event : TouchEvent) {
  const position = getPosition(event)
  drawLine(position.x, position.y)
}

function touchEnd(event : TouchEvent) {
}

// #ifdef WEB
function pointerDown(event : PointerEvent) {
  isDrawing = true
  startDraw(event.clientX - offsetX, event.clientY - offsetY)
}

function pointerMove(event : PointerEvent) {
  if (!isDrawing) {
    return
  }
  drawLine(event.clientX - offsetX, event.clientY - offsetY)
}

function pointerUp(event : PointerEvent) {
  isDrawing = false
}
// #endif

function doClear() {
  if (renderingContext != null) {
    renderingContext!.clearRect(0, 0, renderingContext!.canvas.width, renderingContext!.canvas.height)
  }
}

function onCanvasReady() {
  // #ifdef MP-ALIPAY
  uni.createCanvasContextAsync({
    id: 'tablet',
    success: (context : CanvasContext) => {
      renderingContext = context.getContext('2d')!
      const canvas = renderingContext!.canvas

      uni.createSelectorQuery().select('#tablet').boundingClientRect().exec((ret) => {
        const rect = ret.length > 0 ? ret[0] as NodeInfo : null
        const canvasWidth = rect != null ? rect.width : 0
        const canvasHeight = rect != null ? rect.height : 0
        const dpr = uni.getWindowInfo().pixelRatio
        canvas.width = canvasWidth * dpr
        canvas.height = canvasHeight * dpr
        renderingContext!.scale(dpr, dpr)
      })
    }
  })
  // #endif
}

// Lifecycle
onReady(() => {
  // #ifndef MP-ALIPAY
  uni.createCanvasContextAsync({
    id: 'tablet',
    success: (context : CanvasContext) => {
      renderingContext = context.getContext('2d')!
      const canvas = renderingContext!.canvas

      const dpr = uni.getWindowInfo().pixelRatio
      canvas.width = canvas.offsetWidth * dpr
      canvas.height = canvas.offsetHeight * dpr
      renderingContext!.scale(dpr, dpr)

      // #ifndef MP
      const elRect = canvas.getBoundingClientRect()
      offsetX = elRect.left
      offsetY = elRect.top
      // #endif
      canvas.addEventListener('contextrestored', (event : Event)=>{
        renderingContext!.scale(dpr, dpr)
      })
    }
  })
  // #endif
})
</script>
