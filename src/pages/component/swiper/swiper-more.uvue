		<view class="mb-20">
			<text class="mb-10 color-swiper-description-666">事件监听（@change、@transition、@animationfinish）：</text>
			<text class="fs-12 mb-5 color-swiper-note-999">当前索引: {{eventCurrentIndex}}</text>
			<text class="fs-12 mb-5 color-swiper-note-999">上次触发: {{eventSource}}</text>
			<text class="fs-12 mb-5 color-swiper-note-999">过渡位置: dx={{transitionDx}}, dy={{transitionDy}}</text>
			<swiper
				@change="handleChange"
				@transition="handleTransition"
				@animationfinish="handleAnimationFinish"
				class="h-150"
			>
				<swiper-item>
					<view class="w-full h-full items-center justify-center" style="background-color: #2d3436;">
						<text class="color-white fs-24">Event 1</text>
