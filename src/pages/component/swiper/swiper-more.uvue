						<text class="color-white fs-24">Event 3</text>
					</view>
				</swiper-item>
			</swiper>
		</view>

		<!-- #ifndef MP-ALIPAY -->
		<view class="mb-20">
			<text class="mb-10 color-swiper-description-666">自定义数字指示器（slot）：</text>
			<swiper @change="handleCustomIndicatorChange" class="h-150">
				<swiper-item>
					<view class="w-full h-full items-center justify-center bg-16a085">
						<text class="color-white fs-24">Custom 1</text>
					</view>
				</swiper-item>
				<swiper-item>
					<view class="w-full h-full bg-fff items-center justify-center">
						<text class="color-black fs-24">Custom 2</text>
					</view>
				</swiper-item>
				<swiper-item>
					<view class="w-full h-full items-center justify-center bg-000">
						<text class="color-white fs-24">Custom 3</text>
					</view>
				</swiper-item>
				<template v-slot:indicator>
					<view class="pos-absolute bottom-10 right-10 radius-12" style="background-color: rgba(0,0,0,0.6); padding: 4px 12px;">
						<text class="color-white fs-14 fw-bold">{{customIndicatorIndex + 1}}/{{customIndicatorTotal}}</text>
					</view>
				</template>
			</swiper>
		</view>
		<!-- #endif -->

		<!-- #ifndef MP-ALIPAY -->
		<view class="mb-20">
			<text class="mb-10 color-swiper-description-666">自定义指示器并绑定点击事件(仅web支持点击)：</text>
			<swiper :current='customIndicatorCurrent' class="h-150" @change="handleCustomIndicatorHandleClickChange">
				<swiper-item>
					<view class="w-full h-full items-center justify-center bg-16a085">
						<text class="color-white fs-24">Custom 1</text>
					</view>
				</swiper-item>
				<swiper-item>
					<view class="w-full h-full bg-fff items-center justify-center">
						<text class="color-black fs-24">Custom 2</text>
					</view>
				</swiper-item>
				<swiper-item>
					<view class="w-full h-full items-center justify-center bg-000">
						<text class="color-white fs-24">Custom 3</text>
					</view>
				</swiper-item>
				<template v-slot:indicator>
					<view v-for="item in 3" class="m-0-10">
						<text class="u-p-10 custom-indicator-text color-ccc fs-14" :class="{ 'active': customIndicatorCurrent == item - 1 }" @click="handleCustomIndicatorClick(item - 1)">{{item - 1}}</text>
					</view>
				</template>
			</swiper>
		</view>
		<!-- #endif -->

		<!-- #ifndef MP-ALIPAY -->
		<view class="mb-20">
			<text class="mb-10 color-swiper-description-666">circular 和 disabled-bounce 同时设置：</text>
			<text class="fs-12 mb-5 color-swiper-note-999">以circular为优先</text>
			<swiper :disable-bounce="false" :circular="true" class="h-150">
				<swiper-item>
					<view class="w-full h-full items-center justify-center" style="background-color: #3742fa;">
						<text class="color-white fs-24">Rebound 1</text>
					</view>
				</swiper-item>
				<swiper-item>
					<view class="w-full h-full items-center justify-center" style="background-color: #5352ed;">
						<text class="color-white fs-24">Rebound 2</text>
					</view>
				</swiper-item>
				<swiper-item>
					<view class="w-full h-full items-center justify-center" style="background-color: #a29bfe;">
						<text class="color-white fs-24">Rebound 3</text>
