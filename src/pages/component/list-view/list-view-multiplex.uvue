<template>
    <scroll-view direction="horizontal" class="flex-dir-row">
      <button class="w-200" @click="delayShow">测试延时显示</button>
      <button class="w-200" @click="switchItemContent">修改item子元素</button>
    </scroll-view>
    <list-view v-show="data.list_show" id="listview" :scroll-top="data.scrollTop" class="flex-1" show-scrollbar=false @scrolltolower="onScrollTolower">
      <list-item v-for="(item,index) in list" :key="item.id" :id="'item_'+item.id" @click="itemClick(item.id)">
        <view class="u-p-15 m-0-0-5-0 radius-5 item">
          <view class="flex-dir-row">
            <text class="color-text-000">item-------{{item.id}}</text>
            <scroll-view direction="horizontal" show-scrollbar="false" class="flex-1 flex-dir-row overflow-hidden u-ml-10">
              <text class="color-text-000">scroll-view{{item.id}}：</text>
              <text class="border-style-solid radius-3 border-width-1 m-0-10 border-color-border-000 color-text-000" v-for="tab in 5">元素{{tab}}</text>
            </scroll-view>
          </view>
          <text v-show="data.displayArrow">item-------<text>{{item.id}}</text></text>
          <checkbox-group @change="checkedChange(index)">
              <checkbox :checked="item.checked" />
          </checkbox-group>
        </view>
      </list-item>
    </list-view>
</template>

<script setup lang="ts">

type Item = {
  id: number
  checked: boolean
}
const list = ref<Item[]>([])
const listViewElement = ref(null as UniListViewElement | null)

type DataType = {
  list_show: boolean,
  displayArrow: boolean,
  scrollTop: number
}

const data = reactive({
  list_show: true,
  displayArrow: false,
  scrollTop: 0
} as DataType)

function generateItems(count: number) {
  const startIndex = list.value.length
  for (let i = 0; i < count; i++) {
    list.value.push({
      id: startIndex + i + 1,
      checked: false,
    } as Item)
  }
}

function onScrollTolower(event : ScrollToLowerEvent) {
  setTimeout(() => {
    generateItems(20)
  }, 300)
}

onMounted(() => {
  generateItems(20)
})

//用于自动化测试
function listViewScrollByY(y : number) {
  listViewElement.value?.scrollBy(0, y)
}

function itemClick(index : number) {
  console.log("itemTextClick---" + index)
}

function checkedChange(index : number) {
  list.value[index].checked = !list.value[index].checked
}

function delayShow() {
  data.list_show = !data.list_show
  //延时显示list-view 测试list-item延时显示bug
  setTimeout(() => {
    data.list_show = !data.list_show
  }, 400)
}

function modifyItemPadding(index: number) {
  var element = uni.getElementById("item_"+index)
  element?.style.setProperty("padding", "0px")
}

function switchItemContent() {
  data.displayArrow = !data.displayArrow
  modifyItemPadding(1)
}

onReady(() => {
  listViewElement.value = uni.getElementById<UniListViewElement>('listview')
})

function jest_testReusedItemSize() {
  generateItems(100)
  nextTick(() => {
    data.scrollTop = 10000
  })
}

defineExpose({
  data,
  listViewScrollByY,
  delayShow,
  switchItemContent,
  jest_testReusedItemSize
})
</script>

<style>
  .item {
    border: 1px solid var(--border-color, #000000);
    background-color: var(--list-background-color, #fdfdfd);
  }
</style>
