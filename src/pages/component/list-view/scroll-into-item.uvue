<template>
	<view class="theme-list-scroll flex-1 d-flex flex-dir-column">
		<view class="pt-12 pr-16 pb-12 pl-16 bg-list-demo-panel-background d-flex flex-dir-column">
			<text class="fs-16 fw-600 color-list-demo-title">list-view scroll-into-item</text>
			<text class="mt-4 fs-13 lh-20 color-list-demo-text">list-view 无 section，验证 scroll-into-view 滚动到 item。</text>
			<text class="mt-6 fs-13 color-1677ff">current target: {{ currentTargetLabel }}</text>
		</view>
		<scroll-view class="pt-12 pr-12 pb-12 pl-12 bg-list-demo-panel-background d-flex flex-dir-row items-center" direction="horizontal" :show-scrollbar="false">
      <button class="mr-6" @click="scrollToItem('item-12')">滚动到 item-12</button>
      <button class="mr-6" @click="scrollToItem('item-36')">滚动到 item-36</button>
      <button class="mr-6" @click="resetScrollPosition">回到顶部</button>
		</scroll-view>
		<list-view
			id="scroll-into-item-list"
			class="flex-1 bg-list-demo-background pt-8 pr-12 pb-24 pl-12"
			direction="vertical"
			:show-scrollbar="true"
			:scroll-top="scrollTop"
			:scroll-into-view="scrollIntoView"
			:scroll-with-animation="false"
			@scroll="onScroll"
		>
			<list-item v-for="item in items" :key="item.id" :id="item.id" class="h-88 pb-12">
				<view class="bg-list-demo-card-background radius-8 d-flex flex-dir-column justify-center h-76 pr-16 pl-16 pt-14 pb-14">
					<text class="fs-16 fw-600 color-list-demo-title">{{ item.label }}</text>
					<text class="mt-6 fs-13 color-list-demo-text">{{ item.desc }}</text>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	type DemoItem = {
		id : string
		label : string
		desc : string
	}

	type ScrollMetrics = {
		viewportTop : number
		viewportBottom : number
		targetTop : number
		targetBottom : number
		currentTarget : string
		scrollTop : number
	}

	function createItems() : DemoItem[] {
		const result = [] as DemoItem[]
		for (let i = 1; i <= 80; i++) {
			const item : DemoItem = {
				id: 'item-' + i,
				label: 'Item ' + i,
				desc: 'scroll target ' + i,
			}
			result.push(item)
		}
		return result
	}

	const items = ref(createItems())
	const scrollIntoView = ref('')
	const scrollTop = ref(0)
	const currentScrollTop = ref(0)
	const currentTargetLabel = ref('none')

	function applyScrollTarget(targetId : string) {
		currentTargetLabel.value = targetId
		scrollIntoView.value = ''
		nextTick(() => {
			scrollIntoView.value = targetId
		})
	}

	function onScroll(event : UniScrollEvent) {
		currentScrollTop.value = Math.round(event.detail.scrollTop)
	}

	function scrollToItem(targetId : string) {
		applyScrollTarget(targetId)
	}

	function resetScrollPosition() {
		currentTargetLabel.value = 'top'
		scrollIntoView.value = ''
		scrollTop.value = 1
		nextTick(() => {
			scrollTop.value = 0
		})
		currentScrollTop.value = 0
	}

	function jest_reset() {
		resetScrollPosition()
	}

	function jest_scrollToTarget(targetId : string) {
		applyScrollTarget(targetId)
	}

	function jest_getScrollMetrics(targetId : string) : ScrollMetrics {
		const viewportRect = uni.getElementById('scroll-into-item-list')?.getBoundingClientRect()
		const targetRect = uni.getElementById(targetId)?.getBoundingClientRect()
		const metrics : ScrollMetrics = {
			viewportTop: viewportRect?.top ?? 0,
			viewportBottom: (viewportRect?.top ?? 0) + (viewportRect?.height ?? 0),
			targetTop: targetRect?.top ?? 0,
			targetBottom: (targetRect?.top ?? 0) + (targetRect?.height ?? 0),
			currentTarget: scrollIntoView.value,
			scrollTop: currentScrollTop.value,
		}
		return metrics
	}

	defineExpose({
		jest_reset,
		jest_scrollToTarget,
		jest_getScrollMetrics,
	})
</script>
