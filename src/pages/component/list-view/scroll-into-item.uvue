		flex: 1;
		display: flex;
		flex-direction: column;
		--list-demo-panel-background: #ffffff;
		--list-demo-background: #eef2f7;
		--list-demo-title-color: #1f2329;
		--list-demo-text-color: #4e5969;
		--list-demo-card-background: #ffffff;
	}

	.summary-panel {
		padding-top: 12px;
		padding-right: 16px;
		padding-bottom: 12px;
		padding-left: 16px;
		background-color: var(--list-demo-panel-background);
		display: flex;
		flex-direction: column;
	}

	.summary-title {
		font-size: 16px;
		font-weight: 600;
		color: var(--list-demo-title-color);
	}

	.summary-text {
		margin-top: 4px;
		font-size: 13px;
		line-height: 20px;
		color: var(--list-demo-text-color);
	}

	.summary-target {
		margin-top: 6px;
		font-size: 13px;
		color: #1677ff;
	}

	.toolbar-panel {
		padding-top: 12px;
		padding-right: 12px;
		padding-bottom: 12px;
		padding-left: 12px;
		background-color: var(--list-demo-panel-background);
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.toolbar-button {
		margin-right: 6px;
	}

	.list-root {
		flex: 1;
		background-color: var(--list-demo-background);
		padding-top: 8px;
		padding-right: 12px;
		padding-bottom: 24px;
		padding-left: 12px;
	}

	.list-item {
		height: 88px;
		padding-bottom: 12px;
	}

	.item-card {
		height: 76px;
		padding-top: 14px;
		padding-right: 16px;
		padding-bottom: 14px;
		padding-left: 16px;
		background-color: var(--list-demo-card-background);
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.item-title {
		font-size: 16px;
		font-weight: 600;
		color: var(--list-demo-title-color);
	}

	.item-desc {
		margin-top: 6px;
		font-size: 13px;
		color: var(--list-demo-text-color);
	}

	@media (prefers-color-scheme: dark) {
		.page-root {
			--list-demo-panel-background: #2d2d2d;
			--list-demo-background: #1a1a1a;
			--list-demo-title-color: #ffffff;
			--list-demo-text-color: #b8b8b8;
			--list-demo-card-background: #2d2d2d;
		}
	}
</style>
