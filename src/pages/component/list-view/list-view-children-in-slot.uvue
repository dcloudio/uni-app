<template>
    <page-head title="getApp"></page-head>
    <view class="p-0-15">
      <list-view-wrapper>
        <template #default>
          <list-item v-for="item in list" :key="item">
            <text class="text-in-list-item">{{item}}</text>
          </list-item>
        </template>
        <template #second>
          <list-item v-for="item in list" :key="item">
            <text class="text-in-list-item">{{item}}</text>
          </list-item>
        </template>
      </list-view-wrapper>
      <button id="add-btn" class="mt-15" @click="addItem">add item</button>
      <button id="empty-btn" class="mt-15" @click="emptyList">empty list</button>
    </view>
</template>

<script setup lang="ts">

import ListViewWrapper from './ListViewWrapper.uvue'

// Data
const list = ref([0, 1, 2])

// Methods
function addItem() {
  list.value.push(list.value.length)
}

function emptyList() {
  list.value = []
}
</script>
