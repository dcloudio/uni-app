<template>
	<view class="theme-list-scroll flex-1 d-flex flex-dir-column">
		<view class="pt-12 pr-16 pb-12 pl-16 bg-list-demo-panel-background d-flex flex-dir-column">
			<text class="fs-16 fw-600 color-list-demo-title">list-view scroll-anchoring</text>
			<text class="mt-4 fs-13 lh-20 color-list-demo-text">验证头部插入和尾部追加数据时，当前阅读位置是否保持稳定。</text>
			<text class="mt-6 fs-13 color-1677ff">scrollTop: {{ currentScrollTop }}</text>
		</view>
		<scroll-view class="pt-12 pr-12 pb-12 pl-12 bg-list-demo-panel-background d-flex flex-dir-row items-center" direction="horizontal" :show-scrollbar="false">
			<button class="mr-6" @click="scrollToProbePosition">滚动到测试位置</button>
			<button class="mr-6" @click="prependItems">头部插入20项</button>
			<button class="mr-6" @click="appendItems">尾部追加20项</button>
			<button class="mr-6" @click="resetList">重置数据</button>
			<button class="mr-6" @click="resetScrollPosition">回到顶部</button>
		</scroll-view>
		<list-view
			id="scroll-anchoring-list"
			ref="listRef"
			class="flex-1 bg-list-demo-background pt-8 pr-12 pb-24 pl-12"
			direction="vertical"
			:scroll-anchoring="true"
			:show-scrollbar="true"
			:scroll-top="scrollTop"
			@scroll="onScroll"
		>
			<list-item v-for="item in items" :key="item.id" :id="item.id" class="h-88 pb-12">
				<view class="bg-list-demo-card-background radius-8 d-flex flex-dir-column justify-center h-76 pr-16 pl-16 pt-14 pb-14">
					<text class="fs-16 fw-600 color-list-demo-title">{{ item.label }}</text>
					<text class="mt-6 fs-13 color-list-demo-text">{{ item.desc }}</text>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	type DemoItem = {
		id : string
		value : number
		label : string
		desc : string
	}

	type ItemMetrics = {
		listTop : number
		itemTop : number
		itemBottom : number
		relativeTop : number
		scrollTop : number
	}

	const BATCH_SIZE = 20
	const INITIAL_START = 0
	const INITIAL_END = 39
	const PROBE_ITEM_ID = 'item-10'
	const PROBE_SCROLL_TOP = 520

	function createItem(value : number) : DemoItem {
		const item : DemoItem = {
			id: 'item-' + value,
			value,
			label: 'Item ' + value,
			desc: 'anchoring probe ' + value,
		}
		return item
	}

	function createItems(start : number, end : number) : DemoItem[] {
		const result = [] as DemoItem[]
		for (let value = start; value <= end; value++) {
			result.push(createItem(value))
		}
		return result
	}

	const items = ref(createItems(INITIAL_START, INITIAL_END))
	const scrollTop = ref(0)
	const currentScrollTop = ref(0)
	const listRef = ref<UniListViewElement | null>(null)
	let start = INITIAL_START
	let end = INITIAL_END

	function onScroll(event : UniScrollEvent) {
		currentScrollTop.value = Math.round(event.detail.scrollTop)
	}

	function resetData() {
		start = INITIAL_START
		end = INITIAL_END
		items.value = createItems(start, end)
	}

	function prependItems() {
		const nextStart = start - BATCH_SIZE
		const prependList = createItems(nextStart, start - 1)
		items.value = prependList.concat(items.value)
		start = nextStart
	}

	function appendItems() {
		const nextEnd = end + BATCH_SIZE
		const appendList = createItems(end + 1, nextEnd)
		items.value = items.value.concat(appendList)
		end = nextEnd
	}

	function scrollToProbePosition() {
		scrollTop.value = PROBE_SCROLL_TOP - 1
		nextTick(() => {
			scrollTop.value = PROBE_SCROLL_TOP
		})
	}

	function resetScrollPosition() {
		scrollTop.value = 1
		nextTick(() => {
			scrollTop.value = 0
		})
		currentScrollTop.value = 0
	}

	function resetList() {
		resetData()
		resetScrollPosition()
	}

	function getProbeItemId() : string {
		return PROBE_ITEM_ID
	}

	function getItemMetrics(itemId : string) : ItemMetrics {
		const listRect = uni.getElementById('scroll-anchoring-list')?.getBoundingClientRect()
		const itemRect = uni.getElementById(itemId)?.getBoundingClientRect()
		const metrics : ItemMetrics = {
			listTop: listRect?.top ?? 0,
			itemTop: itemRect?.top ?? 0,
			itemBottom: (itemRect?.top ?? 0) + (itemRect?.height ?? 0),
			relativeTop: (itemRect?.top ?? 0) - (listRect?.top ?? 0),
			scrollTop: currentScrollTop.value,
		}
		return metrics
	}

	function getScrollTop() : number {
		return listRef.value?.scrollTop ?? currentScrollTop.value
	}

	function jest_reset() {
		resetList()
	}

	function jest_scrollToProbePosition() {
		scrollToProbePosition()
	}

	function jest_prependItems() {
		prependItems()
	}

	function jest_appendItems() {
		appendItems()
	}

	function jest_getProbeItemId() : string {
		return getProbeItemId()
	}

	function jest_getItemMetrics(itemId : string) : ItemMetrics {
		return getItemMetrics(itemId)
	}

	function jest_getScrollTop() : number {
		return getScrollTop()
	}

	defineExpose({
		jest_reset,
		jest_scrollToProbePosition,
		jest_prependItems,
		jest_appendItems,
		jest_getProbeItemId,
		jest_getItemMetrics,
		jest_getScrollTop,
	})
</script>
