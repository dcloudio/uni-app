<template>
  <list-view id="listview" class="list-view-page" style="flex: 1;" show-scrollbar=false @scrolltolower="onScrollTolower">
    <list-item v-for="index in data.item_count" :key="index" class="item" @click="itemClick(index)">
      <text class="text">item---<text class="text" @click.stop="childTextClick(index)">----{{index}}</text></text>
      <input class="item-input" :placeholder="index + ''"
        :value="index ==1 ? `第一个` :index " />
    </list-item>
  </list-view>
</template>

<script setup lang="ts">

type DataType = {
  item_count: number,
  isTesting: boolean,
}

// 使用reactive包装数据，便于自动化测试获取
const data = reactive({
  item_count: 20,
  isTesting: false,
} as DataType)

const listViewElement = ref(null as UniListViewElement | null)

function onScrollTolower(event : ScrollToLowerEvent) {
  setTimeout(() => {
    if (data.isTesting && data.item_count > 20) {
      return
    }
    data.item_count += 20
  }, 300)
}

function itemClick(index : number) {
  console.log("itemTextClick---" + index)
}

function childTextClick(index : number) {
  console.log("childTextClick---" + index)
}

onReady(() => {
  listViewElement.value = uni.getElementById<UniListViewElement>('listview')
})

defineExpose({
  data
})
</script>

<style>
  .item {
    padding: 15px;
    margin: 0 0 5px 0;
    background-color: var(--list-background-color, #fff);
    border-radius: 5px;
  }

  .item-input {
    border-width: 1px;
    border-style: solid;
    border-color: var(--border-color, #000000);
    /* #ifdef VUE3-VAPOR */
    color: var(--text-color, #000000);
    /* #endif */
  }

  .button_item {
    width: 200px;
  }

  .text {
    color: var(--text-color, #000000);
  }
</style>
