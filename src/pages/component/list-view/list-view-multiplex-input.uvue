<template>
  <list-view id="listview" class="flex-1" show-scrollbar=false @scrolltolower="onScrollTolower">
    <list-item v-for="index in data.item_count" :key="index" class="u-p-15 m-0-0-5-0 bg-list-fff radius-5" @click="itemClick(index)">
      <text class="color-text-000">item---<text class="color-text-000" @click.stop="childTextClick(index)">----{{index}}</text></text>
      <input class="border-width-1 border-style-solid item-input border-color-border-000" :placeholder="index + ''"
        :value="index ==1 ? `第一个` :index " />
    </list-item>
  </list-view>
</template>

<script setup lang="ts">

type DataType = {
  item_count: number,
  isTesting: boolean,
}

// 使用reactive包装数据，便于自动化测试获取
const data = reactive({
  item_count: 20,
  isTesting: false,
} as DataType)

const listViewElement = ref(null as UniListViewElement | null)

function onScrollTolower(event : ScrollToLowerEvent) {
  setTimeout(() => {
    if (data.isTesting && data.item_count > 20) {
      return
    }
    data.item_count += 20
  }, 300)
}

function itemClick(index : number) {
  console.log("itemTextClick---" + index)
}

function childTextClick(index : number) {
  console.log("childTextClick---" + index)
}

onReady(() => {
  listViewElement.value = uni.getElementById<UniListViewElement>('listview')
})

defineExpose({
  data
})
</script>

<style>
  .item-input {
    /* #ifdef VUE3-VAPOR */
    color: var(--text-color, #000000);
    /* #endif */
  }
</style>
