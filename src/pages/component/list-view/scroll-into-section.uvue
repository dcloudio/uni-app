		color: var(--list-demo-text-color);
	}

	@media (prefers-color-scheme: dark) {
		.page-root {
			--list-demo-panel-background: #2d2d2d;
			--list-demo-background: #1a1a1a;
			--list-demo-title-color: #ffffff;
			--list-demo-text-color: #b8b8b8;
			--list-demo-card-background: #2d2d2d;
			--list-demo-header-background: #3b3b3b;
			--list-demo-header-border: rgba(255, 255, 255, 0.1);
			--list-demo-item-border: rgba(255, 255, 255, 0.1);
		}
	}
</style>
