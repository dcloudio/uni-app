		flex-direction: column;
	}

	.summary-title {
		font-size: 16px;
		font-weight: 600;
		color: var(--list-demo-title-color);
	}

	.summary-text {
		margin-top: 4px;
		font-size: 13px;
		line-height: 20px;
		color: var(--list-demo-text-color);
	}

	.summary-target {
		margin-top: 6px;
		font-size: 13px;
		color: #1677ff;
	}

	.toolbar-panel {
		padding-top: 12px;
		padding-right: 12px;
		padding-bottom: 12px;
		padding-left: 12px;
		background-color: var(--list-demo-panel-background);
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.toolbar-button {
		margin-right: 6px;
	}

	.list-root {
		flex: 1;
		background-color: var(--list-demo-background);
	}

	.header-box {
		padding-top: 10px;
		padding-right: 16px;
		padding-bottom: 10px;
		padding-left: 16px;
		background-color: var(--list-demo-header-background);
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--list-demo-header-border);
	}

	.header-title {
		font-size: 15px;
		font-weight: 600;
		color: var(--list-demo-title-color);
	}

	.list-item {
		height: 76px;
		padding-top: 12px;
		padding-right: 16px;
		padding-bottom: 12px;
		padding-left: 16px;
		background-color: var(--list-demo-card-background);
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--list-demo-item-border);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.item-title {
		font-size: 15px;
		font-weight: 600;
		color: var(--list-demo-title-color);
	}

	.item-desc {
		margin-top: 4px;
