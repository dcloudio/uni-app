<template>
	<view class="theme-list-scroll flex-1 d-flex flex-dir-column page-root">
		<view class="pt-12 pr-16 pb-12 pl-16 bg-list-demo-panel-background d-flex flex-dir-column">
			<text class="fs-16 fw-600 color-list-demo-title">list-view scroll-into-section</text>
			<text class="mt-4 fs-13 lh-20 color-list-demo-text">list-view 带 sticky-section，验证滚动到 item、header、section。</text>
			<text class="mt-6 fs-13 color-1677ff">current target: {{ currentTargetLabel }}</text>
		</view>
		<scroll-view class="pt-12 pr-12 pb-12 pl-12 bg-list-demo-panel-background d-flex flex-dir-row items-center" direction="horizontal" :show-scrollbar="false">
			<button class="mr-6" @click="scrollToTarget('item-4-8')">滚动到 item</button>
			<button class="mr-6" @click="scrollToTarget('header-4')">滚动到 header</button>
			<button class="mr-6" @click="scrollToTarget('section-4')">滚动到 section</button>
			<button class="mr-6" @click="resetScrollPosition">回到顶部</button>
		</scroll-view>
		<list-view
			id="scroll-into-section-list"
			class="flex-1 bg-list-demo-background"
			direction="vertical"
			:show-scrollbar="true"
			:scroll-top="scrollTop"
			:scroll-into-view="scrollIntoView"
			:scroll-with-animation="false"
			@scroll="onScroll"
		>
			<sticky-section
				v-for="section in sections"
				:key="section.id"
				:id="section.id"
				:preload="true"
			>
				<sticky-header :id="section.headerId">
					<view class="pt-10 pr-16 pb-10 pl-16 border-b-width-1 border-b-style-solid header-box">
						<text class="fs-15 fw-600 color-list-demo-title">{{ section.title }}</text>
					</view>
				</sticky-header>
				<list-item v-for="item in section.items" :key="item.id" :id="item.id" class="h-76 pt-12 pr-16 pb-12 pl-16 bg-list-demo-card-background border-b-width-1 border-b-style-solid d-flex flex-dir-column justify-center list-item">
					<text class="fs-15 fw-600 color-list-demo-title">{{ item.label }}</text>
					<text class="mt-4 fs-12 color-list-demo-text">{{ item.desc }}</text>
				</list-item>
			</sticky-section>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	type SectionItem = {
		id : string
		label : string
		desc : string
	}

	type SectionData = {
		id : string
		headerId : string
		title : string
		items : SectionItem[]
	}

	type ScrollMetrics = {
		viewportTop : number
		viewportBottom : number
		targetTop : number
		targetBottom : number
		currentTarget : string
		scrollTop : number
	}

	function createSections() : SectionData[] {
		const result = [] as SectionData[]
		for (let sectionIndex = 1; sectionIndex <= 6; sectionIndex++) {
			const items = [] as SectionItem[]
			for (let itemIndex = 1; itemIndex <= 12; itemIndex++) {
				const item : SectionItem = {
					id: 'item-' + sectionIndex + '-' + itemIndex,
					label: 'Section ' + sectionIndex + ' Item ' + itemIndex,
					desc: 'scroll target ' + sectionIndex + '-' + itemIndex,
				}
				items.push(item)
			}
			const section : SectionData = {
				id: 'section-' + sectionIndex,
				headerId: 'header-' + sectionIndex,
				title: 'Section ' + sectionIndex,
				items,
			}
			result.push(section)
		}
		return result
	}

	const sections = ref(createSections())
	const scrollIntoView = ref('')
	const scrollTop = ref(0)
	const currentScrollTop = ref(0)
	const currentTargetLabel = ref('none')

	function applyScrollTarget(targetId : string) {
		currentTargetLabel.value = targetId
		scrollIntoView.value = ''
		nextTick(() => {
			scrollIntoView.value = targetId
		})
	}

	function onScroll(event : UniScrollEvent) {
		currentScrollTop.value = Math.round(event.detail.scrollTop)
	}

	function scrollToTarget(targetId : string) {
		applyScrollTarget(targetId)
	}

	function resetScrollPosition() {
		currentTargetLabel.value = 'top'
		scrollIntoView.value = ''
		scrollTop.value = 1
		nextTick(() => {
			scrollTop.value = 0
		})
		currentScrollTop.value = 0
	}

	function jest_reset() {
		resetScrollPosition()
	}

	function jest_scrollToTarget(targetId : string) {
		applyScrollTarget(targetId)
	}

	function jest_getScrollMetrics(targetId : string) : ScrollMetrics {
		const viewportRect = uni.getElementById('scroll-into-section-list')?.getBoundingClientRect()
		const targetRect = uni.getElementById(targetId)?.getBoundingClientRect()
		const metrics : ScrollMetrics = {
			viewportTop: viewportRect?.top ?? 0,
			viewportBottom: (viewportRect?.top ?? 0) + (viewportRect?.height ?? 0),
			targetTop: targetRect?.top ?? 0,
			targetBottom: (targetRect?.top ?? 0) + (targetRect?.height ?? 0),
			currentTarget: scrollIntoView.value,
			scrollTop: currentScrollTop.value,
		}
		return metrics
	}

	defineExpose({
		jest_reset,
		jest_scrollToTarget,
		jest_getScrollMetrics,
	})
</script>

<style>
	.page-root {
		--list-demo-header-background: #dfe7f3;
		--list-demo-header-border: #c5d0df;
		--list-demo-item-border: #edf1f5;
	}

	.header-box {
		background-color: var(--list-demo-header-background);
		border-bottom-color: var(--list-demo-header-border);
	}

	.list-item {
		border-bottom-color: var(--list-demo-item-border);
	}

	@media (prefers-color-scheme: dark) {
		.page-root {
			--list-demo-header-background: #3b3b3b;
			--list-demo-header-border: rgba(255, 255, 255, 0.1);
			--list-demo-item-border: rgba(255, 255, 255, 0.1);
		}
	}
</style>
