<template>
  <list-view v-if="list_show" id="listview" class="flex-1" show-scrollbar=false :refresher-enabled="true"
    :refresher-triggered="data.refresherTriggered"
    <!-- #ifdef APP-ANDROID && VUE3-VAPOR -->
    :android-refresher-color="getAndroidRefresherColorBinding()"
    <!-- #endif -->
    @refresherrefresh="onRefresherrefresh" @refresherabort="onRefresherabort"
    @refresherrestore="onRefresherrestore" @refresherpulling="onRefresherpulling">
    <list-item class="u-p-15 m-0-0-5-0 bg-list-fff radius-5">
      <text>向下滑动触发下拉刷新</text>
    </list-item>
    <list-item v-for="index in item_count" :key="index" class="u-p-15 m-0-0-5-0 bg-list-fff radius-5">
      <text>item-------{{index}}</text>
    </list-item>
  </list-view>
</template>

<script setup lang="ts">


type RefresherEventTest = {
  type : string;
  target : UniElement | null;
  currentTarget : UniElement | null;
  dy : number;
}

type DataType = {
  refresherTriggered: boolean,
  refresherrefreshTest: string,
  onRefresherabortTest: string,
  onRefresherrestoreTest: string,
  onRefresherpullingTest: string,
}

// Data
const item_count = ref(20)
const list_show = ref(false)
const data = reactive<DataType>({
  refresherTriggered: true,
  refresherrefreshTest: "",
  onRefresherabortTest: "",
  onRefresherrestoreTest: "",
  onRefresherpullingTest: "",
})

// Methods
function checkEventTest(e : RefresherEventTest, eventName : String) {
  const isPass = e.type === eventName && e.target instanceof UniElement && e.currentTarget instanceof UniElement && e.dy > 0
  const result = isPass ? `${eventName}:Success` : `${eventName}:Fail`
  switch (eventName) {
    case 'refresherrefresh':
      data.refresherrefreshTest = result
      break
    case 'refresherpulling':
      data.onRefresherpullingTest = result
      break
    case 'refresherrestore':
      data.onRefresherrestoreTest = result
      break
    case 'refresherabort':
      data.onRefresherabortTest = result
      break
    default:
      break
  }
}

function onRefresherrefresh(e : UniRefresherEvent) {
  console.log('refresherrefresh-----下拉刷新被触发', e.detail.dy)
  data.refresherTriggered = true
  const refresherrefreshEventTest : RefresherEventTest = {
    type: e.type,
    target: e.target,
    currentTarget: e.currentTarget,
    dy: e.detail.dy,
  }
  checkEventTest(refresherrefreshEventTest, 'refresherrefresh')
  setTimeout(() => {
    data.refresherTriggered = false
  }, 1000)
}

function onRefresherabort(e : UniRefresherEvent) {
  console.log("onRefresherabort------下拉刷新被中止", e.detail)
  const refresherabortEventTest : RefresherEventTest = {
    type: e.type,
    target: e.target,
    currentTarget: e.currentTarget,
    dy: e.detail.dy,
  }
  checkEventTest(refresherabortEventTest, 'refresherabort')
}

function onRefresherrestore(e : UniRefresherEvent) {
  console.log("onRefresherrestore------下拉刷新被复位", e.detail.dy)
  const refresherrestoreEventTest : RefresherEventTest = {
    type: e.type,
    target: e.target,
    currentTarget: e.currentTarget,
    dy: e.detail.dy,
  }
  checkEventTest(refresherrestoreEventTest, 'refresherrestore')
}

function onRefresherpulling(e : UniRefresherEvent) {
  console.log("onRefresherpulling------拉刷新控件被下拉-dy=" + e.detail.dy)
  const refresherpullingEventTest : RefresherEventTest = {
    type: e.type,
    target: e.target,
    currentTarget: e.currentTarget,
    dy: e.detail.dy,
  }
  checkEventTest(refresherpullingEventTest, 'refresherpulling')
}

// #ifdef APP-ANDROID && VUE3-VAPOR
const androidRefresherColor = ref("#000000" as string | null)

function getAndroidRefresherColorBinding() : any {
  return androidRefresherColor.value
}

// 自动化测试专用
function setAndroidRefresherColorForTest(value : string | null) {
  androidRefresherColor.value = value
}

// 自动化测试专用
function getAndroidRefresherColorForTest() : string | null {
  return androidRefresherColor.value
}
// #endif

// Lifecycle
onLoad(() => {
  setTimeout(() => {
    list_show.value = true
  }, 500)
})

defineExpose({
  data,
  // #ifdef APP-ANDROID && VUE3-VAPOR
  getAndroidRefresherColorForTest,
  setAndroidRefresherColorForTest,
  // #endif
})
</script>
