<template>
  <view class="w-full h-full bg-black-a30 d-flex justify-center items-center">
    <video id="myVideo" src="https://web-ext-storage.dcloud.net.cn/uni-app-x/video/uni-ai-5-16.mp4"
      title="这里是 dialogPage 中的 video"></video>
    <view class="w-80pct u-p-10 radius-6 bg-fff">
      <button id="fullscreen-btn" @click="requestFullScreen">
        requestFullScreen
      </button>
      <button @click="exitFullScreen">
        exitFullScreen
      </button>
      <button @click="closeThisPage">
        closeThisPage
      </button>
    </view>
  </view>
</template>

<script setup lang="ts">
  const currentPage = getCurrentInstance()?.proxy?.$page

  function requestFullScreen() {
    uni.createVideoContext('myVideo')?.requestFullScreen(null)
  }

  function exitFullScreen() {
    uni.createVideoContext('myVideo')?.exitFullScreen()
  }

  function closeThisPage() {
    if (currentPage != null) {
      uni.closeDialogPage({
        dialogPage: currentPage
      })
    }
  }

  onBackPress(() => {
    exitFullScreen()
    return true
  })
</script>

<style>
  page {
    background-color: transparent;
  }
</style>
