<template>
  <view class="p-5 items-center justify-center">
    <share-element share-key="left"
      :shuttle-on-pop="shuttleOnPush" :transition-on-gesture="transitionOnGesture" @tap="openPage()">
      <image src="https://web-ext-storage.dcloud.net.cn/hello-uni-app-x/drop-card-1.jpg" mode="widthFix">
      </image>
      <view class="pos-absolute bg-007aff opacity-0_8 text-center justify-center items-center bottom-0 right-0 h-30 left-0">
        <text class="color-white">每一口，都是幸福</text>
      </view>
    </share-element>
  </view>
  <share-element class="w-full bottom-0 h-80 pos-fixed" share-key="bottom" @tap="openPage()"
    transitionOnGesture=true>
    <view class="w-full h-full items-center justify-center bg-007aff">
      <text class="color-white">share-element(底部固定)</text>
    </view>
  </share-element>
</template>
<script setup lang="ts">

const shuttleOnPush = ref("to")
const transitionOnGesture = ref(false)

function openPage() {
  uni.navigateBack()
}

onLoad((event : OnLoadOptions) => {
  shuttleOnPush.value = event["shuttleOnPush"] as string
  transitionOnGesture.value = event["transitionOnGesture"] === "true"
  console.log(`shuttleOnPush:${shuttleOnPush.value} transitionOnGesture:${transitionOnGesture.value}`)
})
</script>
