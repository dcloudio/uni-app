<template>
  <!-- <view class="app-flex-1"> -->
    <page-head title="非下拉刷新的scroll-view属性示例"></page-head>
    <!-- 暂时分成两个方向不同的滚动视图，原因为：scroll-view组件不支持动态改变direction。 -->
    <scroll-view v-if="data.scrollX" direction="horizontal" :scroll-top="data.scrollTop" :scroll-left="data.scrollLeft"
      <!-- #ifdef APP-ANDROID && VUE3-VAPOR -->
      :android-overscroll="data.androidOverscroll"
      <!-- #endif -->
      :upper-threshold="data.upperThreshold" :lower-threshold="data.lowerThreshold" :scroll-into-view="data.scrollIntoView"
      :enable-back-to-top="data.enableBackToTop" :scroll-with-animation="data.scrollWithAnimation"
      class="h-250 m-0-25-25-25 flex-dir-row" :show-scrollbar="data.showScrollbar" :bounces="data.bounces" @scrolltoupper="scrolltoupper"
      @scrolltolower="scrolltolower" @scroll="scroll" @scrollend="scrollend" ref="scrollViewXRef" id="scrollViewX">
      <!-- h-margin-right末尾元素添加margin-right 测试bug #3866-->
      <view class="justify-center items-center h-250 w-full bg-f0ffff border-width-1 border-style-solid border-color-d2691e" :id="'horizontal_'+item.id" v-for="(item,index) in data.items"
        :class="index==9 ? 'h-margin-right': ''">
        <view :id="'horizontal_grand_child__' + item.id"></view>
        <text class="color-black fs-50">{{item.label}}</text>
      </view>
    </scroll-view>
    <scroll-view v-else direction="vertical" :scroll-top="data.scrollTop" :scroll-left="data.scrollLeft"
      :upper-threshold="data.upperThreshold" :lower-threshold="data.lowerThreshold" :scroll-into-view="data.scrollIntoView"
      :enable-back-to-top="data.enableBackToTop" :scroll-with-animation="data.scrollWithAnimation" :show-scrollbar="data.showScrollbar"
      :bounces="data.bounces" @scrolltoupper="scrolltoupper" @touchmove="onTouchMove" @scrolltolower="scrolltolower"
      @scroll="scroll" @scrollend="scrollend" ref="scrollViewYRef" id="scrollViewY" class="h-250 m-0-25-25-25">
      <!-- v-margin-bottom末尾元素添加margin-bottom 测试bug #3866-->
      <view class="justify-center items-center h-250 w-full bg-f0ffff border-width-1 border-style-solid border-color-d2691e" :id="item.id" v-for="(item, index) in data.items" :class="index==9 ? 'mb-50': ''">
        <view :id="'grand_child_' + item.id"></view>
        <text class="color-black fs-50">{{item.label}}</text>
      </view>
    </scroll-view>

    <scroll-view class="bg-list-fff pos-relative d-flex flex-dir-column border-b-1-solid-c8c7cc-dark-3a3a3c flex-1">
      <boolean-data :value="data.enableBackToTop" title="点击状态栏回到顶部（仅iOS）"
        @change="changeEnableBackToTop"></boolean-data>
      <!-- #ifndef MP-ALIPAY -->
      <boolean-data :value="data.showScrollbar" title="是否显示滚动条"
        @change="changeShowScrollbar"></boolean-data>
      <boolean-data :value="data.bounces" title="是否开启回弹效果"
        @change="handleBouncesChange"></boolean-data>
      <!-- #endif -->
      <!-- #ifdef APP-ANDROID && VUE3-VAPOR -->
      <boolean-data :value="data.androidOverscroll" :disabled="!data.bounces"
        title="是否开启弹簧回弹效果（仅Android蒸汽模式）" @change="handleAndroidOverscrollChange"></boolean-data>
      <!-- #endif -->
      <boolean-data :value="data.scrollWithAnimation" title="是否开启滚动时使用动画过渡"
        @change="changeScrollWithAnimation"></boolean-data>
      <boolean-data :value="data.scrollX" title="是否横向滚动" @change="changeDirectionX"></boolean-data>
      <boolean-data :value="data.scrollY" title="是否竖向滚动" @change="changeDirectionY"></boolean-data>
      <view class="justify-center p-10-15 color-text-333">
        <text>拖动设置scroll-top</text>
      </view>
      <view class="justify-center p-10-15 color-text-333">
        <slider :max="1000" :min="0" :step="10" :value="data.scrollTop" :show-value="true" @change="handleChangeScrollTop" />
      </view>
      <view class="justify-center p-10-15 color-text-333">
        <text>拖动设置scroll-left</text>
      </view>
      <view class="justify-center p-10-15 color-text-333">
        <slider :max="1000" :min="0" :step="10" :value="data.scrollLeft" :show-value="true"
          @change="handleChangeScrollLeft" />
      </view>
      <view class="pos-relative d-flex flex-dir-row justify-between items-center p-10-15 color-text-333">
        <text>设置触发scrolltoupper的距离</text>
        <input class="w-50 text-center border-1-solid-ccc uni-list-cell-input" type="number" :value="data.upperThreshold" @input="handleUpperThresholdInput" />
      </view>
      <view class="pos-relative d-flex flex-dir-row justify-between items-center p-10-15 color-text-333">
        <text>设置触发scrolltolower的距离</text>
        <input class="w-50 text-center border-1-solid-ccc uni-list-cell-input" type="number" :value="data.lowerThreshold" @input="handleLowerThresholdInput" />
      </view>
      <view class="pos-relative d-flex flex-dir-row justify-between items-center p-10-15 color-text-333">
        <button type="primary" class="flex-1" @click="handleScrollIntoView">
          滚动到id为`item3`的子视图
        </button>
      </view>
      <view class="pos-relative d-flex flex-dir-row justify-between items-center p-10-15 color-text-333">
      </view>
    </scroll-view>
  <!-- </view> -->
</template>

<script setup lang="ts">


type Item = {
  id : string,
  label : string,
}

type DataType = {
  items: Item[],
  scrollX: boolean,
  scrollY: boolean,
  bounces: boolean,
  androidOverscroll: boolean,
  scrollTop: number,
  scrollLeft: number,
  scrollChangeTop: number,
  scrollIntoView: string,
  enableBackToTop: boolean,
  scrollWithAnimation: boolean,
  showScrollbar: boolean,
  upperThreshold: number,
  lowerThreshold: number,
}

// 使用reactive包装数据，便于自动化测试获取
const data = reactive({
  items: [] as Item[],
  scrollX: false,
  scrollY: true,
  bounces: false,
  androidOverscroll: false,
  scrollTop: 0,
  scrollLeft: 0,
  scrollChangeTop: 0,
  scrollIntoView: "",
  enableBackToTop: false,
  scrollWithAnimation: false,
  showScrollbar: true,
  upperThreshold: 50,
  lowerThreshold: 50,
} as DataType)

const scrollViewXRef = ref<UniScrollViewElement | null>(null)
const scrollViewYRef = ref<UniScrollViewElement | null>(null)
// Methods
function handleChangeScrollLeft(e : UniSliderChangeEvent) {
  data.scrollLeft = e.detail.value
}

function handleChangeScrollTop(e : UniSliderChangeEvent) {
  data.scrollTop = e.detail.value
}

function changeEnableBackToTop(value : boolean) {
  data.enableBackToTop = value
}

function changeShowScrollbar(value : boolean) {
  data.showScrollbar = value
}

function changeScrollWithAnimation(value : boolean) {
  data.scrollWithAnimation = value
}

function changeDirectionX(value : boolean) {
  data.scrollX = value
  data.scrollY = !value
  data.scrollTop = 0
  data.scrollLeft = 0
}

function changeDirectionY(value : boolean) {
  data.scrollY = value
  data.scrollX = !value
  data.scrollTop = 0
  data.scrollLeft = 0
}

function handleScrollIntoView() {
  if (data.scrollX) {
    data.scrollIntoView = "horizontal_item3"
  } else {
    data.scrollIntoView = "item3"
  }
  setTimeout(() => {
    data.scrollIntoView = ""
  }, 0)
}

function handleUpperThresholdInput(e : InputEvent) {
  const value = e.detail.value
  if (value == "") {
    data.upperThreshold = 50
  } else {
    data.upperThreshold = parseInt(e.detail.value)
  }
}

function handleLowerThresholdInput(e : InputEvent) {
  const value = e.detail.value
  if (value == "") {
    data.lowerThreshold = 50
  } else {
    data.lowerThreshold = parseInt(e.detail.value)
  }
}

function handleBouncesChange(value : boolean) {
  data.bounces = value
  if(!data.bounces){
    data.androidOverscroll = false;
  }
}

function handleAndroidOverscrollChange(value : boolean) {
  data.androidOverscroll = value
}

function scrolltoupper() {
  console.log("滚动到顶部")
}

function scrolltolower() {
  console.log("滚动到底部")
}

function scroll(e : ScrollEvent) {
  data.scrollChangeTop = e.detail.scrollTop
  console.log("scroll-top : " + e.detail.scrollTop + " scroll-left : " + e.detail.scrollLeft)
}

function scrollend() {
  console.log("滚动停止")
}

function onTouchMove() {
  console.log("TouchMove")
}

function checkScrollHeight() : Boolean {
  var element = scrollViewYRef.value
  if (element != null) {
    var scrollHeight = element.scrollHeight
    console.log("checkScrollHeight" + scrollHeight)
    if (scrollHeight > 1900) {
      return true
    }
  }
  return false
}

function checkScrollWidth() : Boolean {
  var element = scrollViewXRef.value
  if (element != null) {
    var scrollWidth = element.scrollWidth
    console.log("checkScrollWidth---" + scrollWidth)
    if (scrollWidth > 1900) {
      return true
    }
  }
  return false
}

// Lifecycle
onLoad((options : OnLoadOptions) => {
  for (let i = 0; i < 10; i++) {
    const item = {
      id: "item" + i,
      label: "item" + i,
    } as Item
    data.items.push(item)
  }
})

defineExpose({
  data,
  checkScrollHeight,
  checkScrollWidth
})
</script>

<style>
  /*自动化测试专用*/

  /*自动化测试专用*/
  .h-margin-right {
    margin-right: 50px;
  }

  @media (prefers-color-scheme: dark) {
    .uni-list-cell-input {
      border-color: rgba(255, 255, 255, 0.1);
      background-color: #2d2d2d;
      color: #ffffff;
    }
  }
</style>
