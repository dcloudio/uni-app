<template>
  <page-head title="direction=all 属性示例"></page-head>
  <view class="flex-1 flex-dir-column">
    <scroll-view
      id="scrollViewAll"
      ref="scrollViewAllRef"
      class="mb-16 border-width-1 border-style-solid demo-scroll-view bg-f8fafc ml-24 mr-24"
      direction="all"
      :scroll-top="data.scrollTop"
      :scroll-left="data.scrollLeft"
      :scroll-into-view="data.scrollIntoView"
      :show-scrollbar="data.showScrollbar"
      :scroll-with-animation="data.scrollWithAnimation">
      <view class="flex-dir-column canvas">
        <view class="flex-dir-row" v-for="(row, rowIndex) in data.rows" :key="rowIndex">
          <view
            class="flex-dir-column pb-24 border-width-1 border-style-solid justify-between canvas-cell h-240 w-320 pt-24 pr-24 pl-24"
            v-for="(item, columnIndex) in row"
            :key="item.id"
            :id="item.id">
            <view class="flex-dir-column">
              <text class="fs-32 color-0f172a">{{item.label}}</text>
              <text class="fs-24 cell-subtitle">x={{columnIndex}} y={{rowIndex}}</text>
            </view>
            <view v-if="rowIndex == data.rows.length - 1 && columnIndex == row.length - 1" id="all_target_child"
              class="h-88 flex-dir-column justify-center items-center border-style-solid target-anchor border-width-2">
              <text class="fs-20 target-anchor-text">target</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <scroll-view class="flex-1 mb-24 ml-24 mr-24" direction="vertical">
      <!-- #ifndef MP-ALIPAY -->
      <boolean-data :value="data.showScrollbar" title="是否显示滚动条"
        @change="toggleScrollbar"></boolean-data>
      <!-- #endif -->
      <boolean-data :value="data.scrollWithAnimation" title="滚动时是否使用动画"
        @change="toggleScrollWithAnimation"></boolean-data>
      <view class="pos-relative d-flex flex-dir-row justify-between items-center p-10-15 color-text-333">
        <button type="primary" class="flex-1" @click="scrollToTargetCell">
          滚动到右下角子视图
        </button>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
type GridItem = {
  id : string,
  label : string,
}

type DataType = {
  rows : GridItem[][],
  scrollTop : number,
  scrollLeft : number,
  scrollIntoView : string,
  showScrollbar : boolean,
  scrollWithAnimation : boolean,
}

const data = reactive<DataType>({
  rows: [] as GridItem[][],
  scrollTop: 0,
  scrollLeft: 0,
  scrollIntoView: '',
  showScrollbar: true,
  scrollWithAnimation: true,
})

const scrollViewAllRef = ref<UniScrollViewElement | null>(null)

function buildRows() {
  if (data.rows.length > 0) {
    return
  }
  for (let rowIndex = 0; rowIndex < 4; rowIndex++) {
    const row = [] as GridItem[]
    for (let columnIndex = 0; columnIndex < 4; columnIndex++) {
      const item : GridItem = {
        id: 'all_item_' + rowIndex + '_' + columnIndex,
        label: 'item ' + rowIndex + '-' + columnIndex,
      }
      row.push(item)
    }
    data.rows.push(row)
  }
}

function toggleScrollbar(value : boolean) {
  data.showScrollbar = value
}

function toggleScrollWithAnimation(value : boolean) {
  data.scrollWithAnimation = value
}

function scrollToTargetCell() {
  data.scrollIntoView = 'all_target_child'
  setTimeout(() => {
    data.scrollIntoView = ''
  }, 0)
}

function resetScrollPosition() {
  data.scrollTop = 0
  data.scrollLeft = 0
  data.scrollIntoView = ''
}

function checkScrollHeight() : boolean {
  const element = scrollViewAllRef.value
  if (element == null) {
    return false
  }
  return element.scrollHeight > 900
}

function checkScrollWidth() : boolean {
  const element = scrollViewAllRef.value
  if (element == null) {
    return false
  }
  return element.scrollWidth > 1200
}

onLoad(() => {
  buildRows()
})

defineExpose({
  data,
  checkScrollHeight,
  checkScrollWidth,
  scrollToTargetCell,
  resetScrollPosition,
})
</script>

<style>
.demo-scroll-view {
  height: 280px;
  margin-top: 24px;
  border-color: #d0d7de;
}

.canvas {
  width: 1280px;
  height: 960px;
}

.canvas-cell {
  border-color: #94a3b8;
  background-color: #dbeafe;
}

.cell-subtitle {
  color: #334155;
}

.target-anchor {
  width: 88px;
  align-self: flex-end;
  border-color: #2563eb;
  background-color: #bfdbfe;
}

.target-anchor-text {
  color: #1d4ed8;
}
</style>
