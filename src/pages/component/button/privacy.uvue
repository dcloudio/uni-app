<template>
  <view class="w-full h-full d-flex justify-center items-center bg-black-a30 dialog-container">
    <view class="w-80pct radius-12 dialog-content">
      <view class="w-full justify-center items-center bg-list-fff">
        <image src="/static/test-image/logo.png" class="mt-20 w-60 h-60"></image>
      </view>
      <text class="pt-20 fs-20 text-center color-text-333 bg-list-fff">个人信息保护指引</text>
      <scroll-view class="flex-1 pt-10 bg-list-fff privacy-content content-center" show-scrollbar="false">
        <text>
          <!-- #ifdef APP-HARMONY -->
          <text class="privacy-text">欢迎使用DCloud开发者中心系统，我们将通过</text>
          <!-- #endif -->
          <!-- #ifndef APP-HARMONY -->
          <text class="privacy-text">欢迎使用 Hello uni-app x 应用，我们将通过</text>
          <!-- #endif -->
          <text class="fw-bold privacy-href text-underline" @click="hrefClick(hrefLicense)">《用户服务协议》</text>
          <text class="privacy-text">及</text>
          <text
            class="privacy-text">相关个人信息处理规则帮助你了解我们如何收集、处理个人信息。根据《常见类型移动互联网应用程序必要个人信息范围规定》，应用在演示 uni-app x 能力时仅收集、处理相关必要个人信息及数据。我们通过</text>
          <text class="fw-bold privacy-href text-underline" @click="hrefClick(hrefPrivacy)">《隐私政策》</text>
          <text class="privacy-text">帮助你全面了解我们的服务及收集、处理个人信息的详细情况。</text>
        </text>
        <text class="privacy-text">如你同意请点击“同意”按钮接受我们的服务。</text>
      </scroll-view>
      <button class="radius-0 fs-15 text-center button" @click="reject">不同意</button>
      <button class="radius-0 fs-15 text-center button" type="primary" open-type="agreePrivacyAuthorization" @click="agree">同意</button>
    </view>
  </view>
</template>

<script setup lang="ts">
  // #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
  import { openSchema } from '@/uni_modules/uts-openSchema'
  // #endif

  // Get page instance at component initialization
  const currentPage = getCurrentInstance()?.proxy?.$page

  let number = 0
  const hrefLicense = 'https://dcloud.io/license/DCloud.html'
  const hrefPrivacy = 'https://dcloud.io/license/hello-uni-app-x.html'

  function agree() {
    if (currentPage != null) {
      uni.closeDialogPage({
        dialogPage: currentPage
      })
    }
  }

  function reject() {
    uni.resetPrivacyAuthorization()
    if (currentPage != null) {
      uni.closeDialogPage({
        dialogPage: currentPage
      })
    }
  }

  function hrefClick(href : string) {
    // #ifdef APP-HARMONY
    uni.navigateTo({
      url: '/pages/component/button/privacy-web-view?url=/hybrid/html/privacy.html&title=隐私政策'
    })
    // #endif
    // #ifdef APP-ANDROID || APP-IOS
    openSchema(href)
    // #endif
  }

  onLoad((_) => {
    number = uni.onPrivacyAuthorizationChange((callback) => {
      uni.showToast({
        title: 'isPrivacyAgree:' + !callback.needAuthorization
      })
    })
  })

  onUnmounted(() => {
    uni.offPrivacyAuthorizationChange(number)
  })
</script>

<style>
  page {
    background-color: transparent;
  }

  .dialog-container {
    --privacy-text-color: grey;
    --privacy-href-color: cadetblue;
    --privacy-button-text-color: lightgrey;
  }

  .dialog-content {
    height: 60%;
    /* background-color: #fff; */
  }

  .privacy-content {
    padding-left: 25px;
    padding-right: 25px;
  }

  .button {
    border: 0px none;
    color: var(--privacy-button-text-color, lightgrey);
  }

  .privacy-text {
    color: var(--privacy-text-color, grey);
  }

  .privacy-href {
    color: var(--privacy-href-color, cadetblue);
  }

  @media (prefers-color-scheme: dark) {
    .dialog-container {
      --privacy-text-color: #b3b3b3;
      --privacy-href-color: #7bc7ca;
      --privacy-button-text-color: #f0f0f0;
    }
  }
</style>
