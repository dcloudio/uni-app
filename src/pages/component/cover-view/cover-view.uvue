<template>
    <page-head title="cover-view用于覆盖map、video等原生组件"></page-head>
    <view class="p-0-15 mb-15">
      <text class="color-888 fs-12 fw-bold u-mt-5">注意：Web和App需正确配置地图SDK的Key才能正常显示地图组件</text>
    </view>
    <view class="pos-relative" v-if="showMap">
      <map class="map w-full" :latitude="latitude" :longitude="longitude"></map>
      <cover-view class="pos-absolute text-center cover-view left-5 top-5"><text>简单的cover-view</text></cover-view>
      <cover-image class="pos-absolute top-0 right-0 bottom-0 cover-image left-0 m-auto" src="/static/test-image/logo.png"></cover-image>
    </view>
</template>

<script setup lang="ts">
  const showMap = ref(false)
  const latitude = ref(39.909)
  const longitude = ref(116.39742)
  onLoad(() => {
    showMap.value = true
  })
</script>

<style>
  .map {
    height: 600px;
  }

  .cover-view {
    width: 188px;
    background-color: #DDDDDD;
  }

  .cover-image {
    width: 96px;
    height: 96px;
  }

</style>
