<template>
  <boolean-data :value="false" title="associative-container（nested-scroll-view）" @change="onTypeChange"></boolean-data>
  <scroll-view class="flex-1" type="nested">
    <view v-for="item in 5" class="ml-6 mr-6 mt-6 bg-fff">
      <text class="lh-60 text-center color-555">item{{item}}</text>
    </view>
    <web-view id="web-view-test" class="ml-6 mr-6 mt-6 self-center border-1-solid-000 h-400" src="/hybrid/html/local.html" :associative-container="data.type"></web-view>
    <view v-for="item in 5" class="ml-6 mr-6 mt-6 bg-fff">
      <text class="lh-60 text-center color-555">item{{item}}</text>
    </view>
    <view class="h-safe-area-inset-bottom-20 min-h-20"></view>
  </scroll-view>
</template>

<script setup lang="ts">
  type DataType = {
    type : string;
    webviewX : number;
    webviewY : number;
    webviewWidth : number;
    webviewHeight : number;
  }

  const initialData : DataType = {
    type : '',
    webviewX : 0,
    webviewY : 0,
    webviewWidth : 0,
    webviewHeight : 0
  }

  const data = reactive<DataType>(initialData)

  const onTypeChange = (checked : boolean) => {
    data.type = checked ? 'nested-scroll-view' : ''
  };

  onReady(() => {
    const webviewElement = uni.getElementById('web-view-test')
    const rect = webviewElement?.getBoundingClientRect()
    if (rect != null) {
      data.webviewX = rect.x
      data.webviewY = rect.y
      data.webviewWidth = rect.width
      data.webviewHeight = rect.height
      const systemInfo = uni.getSystemInfoSync()
      data.webviewY += systemInfo.safeAreaInsets.top + 44
    }
  })

  defineExpose({
    data,
    onTypeChange
  })
</script>
