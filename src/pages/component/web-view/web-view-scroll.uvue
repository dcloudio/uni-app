<template>
  <enum-data-checkbox title="android-nested-scroll（默认值为all）" :items="types" @change="onTypeChange"></enum-data-checkbox>
  <scroll-view class="flex-1">
    <view v-for="item in 5" class="ml-6 mr-6 mt-6 bg-fff">
      <text class="lh-60 text-center color-555">item{{item}}</text>
    </view>
    <web-view class="w-300 u-h-300 ml-6 mr-6 mt-6 self-center border-1-solid-000" src="/hybrid/html/local.html" :android-nested-scroll="type"></web-view>
    <view v-for="item in 5" class="ml-6 mr-6 mt-6 bg-fff">
      <text class="lh-60 text-center color-555">item{{item}}</text>
    </view>
    <web-view class="w-300 u-h-300 ml-6 mr-6 mt-6 self-center border-1-solid-000" src="/hybrid/html/simple.html" :android-nested-scroll="type"></web-view>
    <view v-for="item in 5" class="ml-6 mr-6 mt-6 bg-fff">
      <text class="lh-60 text-center color-555">item{{item}}</text>
    </view>
    <text class="text-center mt-6" style="color: coral;">下面是测试嵌套横向滚动scroll-view的场景</text>
    <scroll-view class="flex-dir-row" direction="horizontal">
      <view v-for="item in 5" class="w-80 justify-center ml-6 mr-6 mt-6 bg-fff">
        <text class="text-center color-555">item{{item}}</text>
      </view>
      <web-view class="w-300 u-h-300 ml-6 mr-6 mt-6 self-center border-1-solid-000" src="/hybrid/html/local.html" :android-nested-scroll="type"></web-view>
      <view v-for="item in 5" class="w-80 justify-center ml-6 mr-6 mt-6 bg-fff">
        <text class="text-center color-555">item{{item}}</text>
      </view>
      <web-view class="w-300 u-h-300 ml-6 mr-6 mt-6 self-center border-1-solid-000" src="/hybrid/html/simple.html" :android-nested-scroll="type"></web-view>
      <view v-for="item in 5" class="w-80 justify-center ml-6 mr-6 mt-6 bg-fff">
        <text class="text-center color-555">item{{item}}</text>
      </view>
    </scroll-view>
    <view v-for="item in 5" class="ml-6 mr-6 mt-6 bg-fff">
      <text class="lh-60 text-center color-555">item{{item}}</text>
    </view>

    <view class="h-safe-area-inset-bottom-20 min-h-20"></view>
  </scroll-view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types';

  const types : ItemType[] = [{ "value": 0, "name": "all" }, { "value": 1, "name": "vertical" }, { "value": 2, "name": "horizontal" }, { "value": 3, "name": "none" }];
  const type = ref("all");

  const onTypeChange = (value : number) => {
    type.value = types[value].name;
  };
</script>
