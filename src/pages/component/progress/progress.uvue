<script setup lang="ts">
  import { state, setEventCallbackNum } from '@/store/index.ts'
  import progressSyntax from './progress-syntax.json'
  import { createTemplateModel, resetTemplateModel, updateTemplateModel, filterSyntaxAttributes } from '@/components/component-template/types'
  import type { TemplateValue, TemplateChange, TemplateControl } from '@/components/component-template/types'

  const syntax = ref(filterSyntaxAttributes(progressSyntax))
  const supportsActiveend = computed(() => syntax.value.attributes?.some((attribute) => attribute.name == '[event]activeend') === true)

  interface ProgressProperties {
    [name: string]: TemplateValue;
    duration: number;
    percent: number;
    'show-info': boolean;
    'border-radius': number;
    'font-size': number;
    'stroke-width': number;
    activeColor: string;
    'background-color': string;
    active: boolean;
    'active-mode': string;
  }

  const progressProps = createTemplateModel(syntax.value) as ProgressProperties
  const colorOptions = ref(['black', 'white', 'gray', 'red', 'green', 'blue'])
  const controls = ref<{ [name: string]: TemplateControl }>({
    duration: { min: 1, max: 100, step: 1, live: true },
    percent: { min: 0, max: 100, step: 1, live: true },
    'border-radius': { min: 0, max: 40, step: 1, live: true },
    'font-size': { min: 0, max: 40, step: 1, live: true },
    'stroke-width': { min: 0, max: 40, step: 1, live: true }
  })
  const previewLogs = ref<{ [name: string]: string }>({})

  function updateProgressProperty(change: TemplateChange) {
    updateTemplateModel(progressProps, change)
  }

  function resetProgressProps() {
    resetTemplateModel(progressProps, syntax.value)
    previewLogs.value = {}
  }

  async function runPreviewAnimation() {
    progressProps.active = true
    progressProps.percent = 0
    await nextTick()
    progressProps.percent = 70
  }

  function onPreviewActiveEnd(event: UniProgressActiveendEvent) {
    previewLogs.value.activeend = 'activeend：curPercent=' + event.detail.curPercent
  }

  function onPreviewGeneralEvent(name: string) {
    previewLogs.value.general = name + '：已触发'
  }

  type DataType = {
    pgList: number[];
    curPercent: number;
    showInfo: boolean;
    borderRadius: number;
    fontSize: number;
    strokeWidth: number;
    backgroundColor: string;
  }

  // 保留默认用法示例的 data 结构，供现有自动化测试读取。
  const data = reactive({
    pgList: [0, 0, 0, 0] as number[],
    curPercent: 0,
    showInfo: true,
    borderRadius: 0,
    fontSize: 16,
    strokeWidth: 3,
    backgroundColor: '#EBEBEB',
  } as DataType)

  // 自动化测试
  const getEventCallbackNum = () : number => {
    return state.eventCallbackNum
  }
  // 自动化测试
  const setEventCallbackNumTest = (num : number) => {
    setEventCallbackNum(num)
  }

  const setProgress = () => {
    data.pgList = [20, 40, 60, 80] as number[]
  }
  const clearProgress = () => {
    data.pgList = [0, 0, 0, 0] as number[]
  }
  const activeend = (e : UniProgressActiveendEvent) => {
    // 自动化测试
    if ((e.target?.tagName ?? '').includes('PROGRESS')) {
      setEventCallbackNumTest(state.eventCallbackNum + 1)
    }
    if (e.type === 'activeend') {
      setEventCallbackNumTest(state.eventCallbackNum + 2)
    }
    data.curPercent = e.detail.curPercent
  }

  defineExpose({ data, getEventCallbackNum, setEventCallbackNumTest, setProgress, clearProgress, updateProgressProperty })
</script>

<template>
  <component-template id="progress-template" title="progress 属性与事件示例" :syntax="syntax" :model-value="progressProps"
    :controls="controls" :color-options="colorOptions" control-prefix="progress" @change="updateProgressProperty">
    <template #preview>
      <view class="uni-card">
        <progress id="progress-preview" class="preview" :duration="progressProps.duration" :percent="progressProps.percent"
          :show-info="progressProps['show-info']" :border-radius="progressProps['border-radius']"
          :font-size="progressProps['font-size']" :stroke-width="progressProps['stroke-width']"
          :active-color="progressProps.activeColor" :background-color="progressProps['background-color']"
          :active="progressProps.active" :active-mode="progressProps['active-mode']"
          @activeend="onPreviewActiveEnd" @touchstart="onPreviewGeneralEvent('touchstart')"
          @touchmove="onPreviewGeneralEvent('touchmove')" @touchend="onPreviewGeneralEvent('touchend')"
          @touchcancel="onPreviewGeneralEvent('touchcancel')" @tap="onPreviewGeneralEvent('tap')" />
      </view>
    </template>
    <template #actions>
      <button id="progress-reset" @click="resetProgressProps">重置示例</button>
    </template>
    <template #events>
      <uni-card title="事件">
        <template v-if="supportsActiveend">
          <button id="progress-event-activeend-run" @click="runPreviewAnimation">触发 activeend</button>
          <text id="progress-event-activeend-log" class="uni-log">{{ previewLogs.activeend ?? '尚未触发' }}</text>
        </template>
        <text class="uni-comment">可触摸上方进度条，查看通用触摸与点击事件。</text>
        <text id="progress-general-log" class="uni-log">{{ previewLogs.general ?? '尚未触发通用事件' }}</text>
      </uni-card>
    </template>
  </component-template>

  <text class="uni-h4">默认用法示例</text>
  <view class="uni-card">
    <progress id="progress-default" :percent="data.pgList[0]" :active="true" :border-radius="data.borderRadius" :show-info="data.showInfo"
      :font-size="data.fontSize" :stroke-width="data.strokeWidth" :background-color="data.backgroundColor" class="progress progress-box p"
      @activeend="activeend" />
    <progress id="progress-plain" :percent="data.pgList[1]" :stroke-width="3" class="progress progress-box p1" />
    <progress id="progress-plain-second" :percent="data.pgList[2]" :stroke-width="3" class="progress progress-box p2" />
    <progress id="progress-blue" :percent="data.pgList[3]" active-color="#10AEFF" :stroke-width="3" class="progress progress-box p3" />
    <view class="progress-actions">
      <button id="progress-set" @click="setProgress" class="action-button">设置进度</button>
      <button id="progress-clear" @click="clearProgress" class="action-button">清除进度</button>
    </view>
  </view>

  <!-- #ifdef (APP && VUE3-VAPOR) || WEB -->
  <navigator class="performance-link" url="/pages/template/progress-100/progress-100">
    <button>组件性能测试</button>
  </navigator>
  <!-- #endif -->
</template>

<style>
  page {
    padding-top: 8px;
    padding-left: 8px;
    padding-right: 8px;
  }

  .uni-card {
    padding: 6px 8px;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: var(--list-background-color, #ffffff);
  }

  .preview {
    margin: 12px 0;
  }

  .progress-box {
    height: 20px;
    margin-top: 12px;
  }

  .progress-actions {
    flex-direction: row;
    margin-top: 12px;
  }

  .action-button {
    flex: 1;
    margin: 0 4px;
  }

  .performance-link {
    margin-top: 10px;
  }
</style>
