<script setup lang="ts">
  import { state, setEventCallbackNum } from '@/store/index.ts'

  const colorOptions = ref(['#09BB07', '#EBEBEB', 'black', 'white', 'gray', 'red', 'green', 'blue'])
  const activeModeOptions = ref([
    { value: 0, text: '从头播放' },
    { value: 1, text: '接续播放' }
  ])
  const percent = ref(0)
  const strokeWidth = ref(6)
  const showInfo = ref(false)
  const active = ref(false)
  const duration = ref(30)
  const activeMode = ref(0)
  const activeColor = ref('#09BB07')
  const backgroundColor = ref('#EBEBEB')

  type DataType = {
    pgList: number[];
    curPercent: number;
    showInfo: boolean;
    borderRadius: number;
    fontSize: number;
    strokeWidth: number;
    backgroundColor: string;
  }

  // 保留默认用法示例的 data 结构，供现有自动化测试读取。
  const data = reactive({
    pgList: [0, 0, 0, 0] as number[],
    curPercent: 0,
    showInfo: true,
    borderRadius: 0,
    fontSize: 16,
    strokeWidth: 3,
    backgroundColor: '#EBEBEB',
  } as DataType)

  // 自动化测试
  const getEventCallbackNum = () : number => {
    return state.eventCallbackNum
  }
  // 自动化测试
  const setEventCallbackNumTest = (num : number) => {
    setEventCallbackNum(num)
  }

  const setProgress = () => {
    data.pgList = [20, 40, 60, 80] as number[]
  }
  const clearProgress = () => {
    data.pgList = [0, 0, 0, 0] as number[]
  }
  const activeend = (e : UniProgressActiveendEvent) => {
    // 自动化测试
    if ((e.target?.tagName ?? '').includes('PROGRESS')) {
      setEventCallbackNumTest(state.eventCallbackNum + 1)
    }
    if (e.type === 'activeend') {
      setEventCallbackNumTest(state.eventCallbackNum + 2)
    }
    data.curPercent = e.detail.curPercent
  }
  const progress_touchstart = () => { console.log("手指触摸动作开始") }
  const progress_touchmove = () => { console.log("手指触摸后移动") }
  const progress_touchcancel = () => { console.log("手指触摸动作被打断，如来电提醒，弹窗") }
  const progress_touchend = () => { console.log("手指触摸动作结束") }
  const progress_tap = () => { console.log("手指触摸后马上离开") }

  defineExpose({
    data,
    getEventCallbackNum,
    setEventCallbackNumTest,
    setProgress,
    clearProgress,
  })
</script>

<template>
  <uni-card title="进度预览">
    <progress id="progress-preview" class="preview" :duration="duration" :percent="percent"
      :show-info="showInfo" :stroke-width="strokeWidth" :active-color="activeColor" :background-color="backgroundColor"
      :active="active" :active-mode="activeMode == 0 ? 'backwards' : 'forwards'"
      @touchstart="progress_touchstart" @touchmove="progress_touchmove" @touchcancel="progress_touchcancel"
      @touchend="progress_touchend" @tap="progress_tap" />
  </uni-card>

  <uni-card title="进度与显示">
    <uni-data-slider control-id="progress-percent" label="进度（%）" v-model="percent" live />
    <uni-data-slider control-id="progress-stroke-width" label="线宽（px）" v-model="strokeWidth" :max="10" live />
    <uni-data-switch control-id="progress-show-info" label="显示百分比" v-model="showInfo" />
  </uni-card>

  <uni-card title="动画设置">
    <uni-data-switch control-id="progress-active" label="启用动画" v-model="active" />
    <!-- #ifndef MP-ALIPAY -->
    <uni-data-slider control-id="progress-duration" label="每增加 1% 的耗时（ms）" v-model="duration" :min="1" />
    <enum-data-checkbox id="progress-active-mode" title="播放方式" v-model="activeMode" :items="activeModeOptions" :show-toast="false" />
    <!-- #endif -->
  </uni-card>

  <uni-card title="颜色设置">
    <uni-data-combobox control-id="progress-active-color" label="已完成进度" v-model="activeColor"
      :options="colorOptions" placeholder="请选择颜色" />
    <uni-data-combobox control-id="progress-background-color" label="未完成进度" v-model="backgroundColor"
      :options="colorOptions" placeholder="请选择颜色" />
  </uni-card>

  <uni-card title="默认用法示例">
    <progress id="progress-default" :percent="data.pgList[0]" :active="true" :border-radius="data.borderRadius" :show-info="data.showInfo"
      :font-size="data.fontSize" :stroke-width="data.strokeWidth" :background-color="data.backgroundColor" class="progress progress-box p"
      @activeend="activeend" />
    <progress id="progress-plain" :percent="data.pgList[1]" :stroke-width="3" class="progress progress-box p1" />
    <progress id="progress-plain-second" :percent="data.pgList[2]" :stroke-width="3" class="progress progress-box p2" />
    <progress id="progress-blue" :percent="data.pgList[3]" active-color="#10AEFF" :stroke-width="3" class="progress progress-box p3" />
    <view class="progress-actions">
      <button id="progress-set" @click="setProgress" class="action-button">设置进度</button>
      <button id="progress-clear" @click="clearProgress" class="action-button">清除进度</button>
    </view>
  </uni-card>

  <!-- #ifdef (APP && VUE3-VAPOR) || WEB -->
  <navigator class="button" url="/pages/template/progress-100/progress-100">
    <button>组件性能测试</button>
  </navigator>
  <!-- #endif -->
</template>

<style>
  page {
    padding: 8px;
  }

  .preview {
    margin: 12px 0 8px;
  }

  .progress-box {
    height: 20px;
    margin-top: 12px;
  }

  .progress-actions {
    flex-direction: row;
    margin-top: 12px;
  }

  .action-button {
    flex: 1;
    margin: 0 4px;
  }

  .button {
    margin-top: 10px;
  }
</style>
