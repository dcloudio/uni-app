<template>
	<view class="items-center pos-relative w-full h-full d-flex flex-dir-column">
		<!-- 视频组件 -->
		<video id="myVideo" :src="src" :controls="true" :autoplay="false" class="w-full h-420rpx" @play="onVideoPlay">
		</video>
		<!-- 信息流广告 - 覆盖在视频上方 -->
		<view v-if="adVisible" class="pos-absolute top-0 h-420rpx z-index-999 w-full bg-black-a70 d-flex items-center justify-center left-0">
			<ad adpid="1597617406" class="w-full h-420rpx" @load="loadFun" @error="errorFun" @close="closeAd"></ad>
		</view>
	</view>
</template>

<script setup lang="ts">
	const src = ref("https://qiniu-web-assets.dcloud.net.cn/video/sample/2minute-demo.mp4")
	let showAd: boolean = false
	const adVisible = ref(false)

	function onVideoPlay() {
		if (!showAd) {
			showAd = true;
			adVisible.value = true;
			const videoContext = uni.createVideoContext('myVideo')
			videoContext!.stop();
		}
	}

	function closeAd() {
		console.log("执行了关闭");
		adVisible.value = false;
		const videoContext = uni.createVideoContext('myVideo')
		videoContext!.play()
	}

	function loadFun(){
		console.log("加载成功");
	}

	function errorFun(e : UniAdErrorEvent){
		console.log(e.detail);
	}

	onLoad(() => {
		// 页面加载逻辑
	})
</script>
