<template>
	<view class="pos-relative w-full h-full d-flex flex-dir-column">
		<!-- 视频组件 -->
		<video id="myVideo2" :src="src" :controls="true" :autoplay="false" class="w-full h-420rpx d-flex items-center justify-center"  @play="onVideoPlay">
			<!-- 信息流广告 - 覆盖在视频上方 -->
			<view v-if="adVisible" class="h-full w-full bg-black-a70 d-flex items-center justify-center">
				<ad adpid="1597617406" class="w-full h-full d-flex items-center justify-center" @load="loadFun" @error="errorFun" @close="closeAd"></ad>
			</view>
		</video>
	</view>
</template>

<script setup lang="ts">
	const src = ref("https://qiniu-web-assets.dcloud.net.cn/video/sample/2minute-demo.mp4")
	let showAd: boolean = false
	const adVisible = ref(false)

	function setfs(){
		const videoContext = uni.createVideoContext('myVideo2');
		const direction : RequestFullScreenOptions = {direction:-90} as RequestFullScreenOptions;
		videoContext!.requestFullScreen(direction);
	}

	function onVideoPlay() {
		if (!showAd) {
			const videoContext = uni.createVideoContext('myVideo2')
			videoContext!.stop();
			showAd = true;
			const direction : RequestFullScreenOptions = {direction:90} as RequestFullScreenOptions;
			videoContext!.requestFullScreen(direction);
      setTimeout(() => {
        adVisible.value = true;
      }, 100)

		}
	}

	function closeAd() {
		console.log("执行了关闭");
		adVisible.value = false;
		const videoContext = uni.createVideoContext('myVideo2')
		videoContext!.play()
	}

	function loadFun(){
		console.log("加载成功");
	}

	function errorFun(e : UniAdErrorEvent){
		console.log(e.detail);
	}

	onLoad(() => {
		// 页面加载逻辑
	})
</script>
