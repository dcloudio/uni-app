<template>
  <view class="flex-dir-column app-flex-1">
    <unicloud-db ref="udbRef" class="udb" v-slot:default="{data, pagination, loading, hasMore, error}"
      :collection="collection" :page-size="15" :getcount="true" loadtime="manual">
      <view v-if="error!=null" class="color-text-333">{{error.errMsg}}</view>
      <scroll-view ref="listView" class="flex-1 flex-dir-column" @scrolltolower="loadMore()">
        <view class="flex-dir-row u-p-10 bg-list-fff mb-1" v-for="(item, _) in data" @click="gotoDetailPage(item['_id'] as string)">
          <view>
            <text class="color-text-333">{{item['username']}}</text>
            <text class="u-mt-5 color-active-666">{{item['mobile']}}</text>
          </view>
        </view>
      </scroll-view>
      <loading class="color-999 self-center m-20" v-if="loading"></loading>
      <view v-if="data.length>0" class="items-center bg-page-f8f8f8 u-p-15">
        <text class="color-text-333">{{data.length}} / {{pagination.count}}</text>
      </view>
    </unicloud-db>
    <view class="pos-absolute items-center justify-center btn-plus bg-dodgerblue bottom-20 right-20" @click="gotoAddPage">
      <text class="fs-30 color-fff">+</text>
    </view>
  </view>
</template>

<script setup lang="ts">

  import { COLLECTION_NAME, UNICLOUD_DB_CONTACTS_ADD, UNICLOUD_DB_CONTACTS_UPDATE, UNICLOUD_DB_CONTACTS_DELETE } from './types.ts'

  const collection = ref(COLLECTION_NAME)
  const udbRef = ref<UniCloudDBElement | null>(null)

  function loadMore() {
    if (udbRef.value != null) {
      udbRef.value!.loadMore()
    }
  }
  function onDataChange(event : string) {
    if (udbRef.value != null) {
      udbRef.value!.loadData({
        clear: true
      })
    }
  }
  function gotoAddPage() {
    // TODO 后续通过 EventChannel 实现
    uni.$on(UNICLOUD_DB_CONTACTS_ADD, onDataChange);
    uni.navigateTo({
      url: './add'
    })
  }
  function gotoDetailPage(id : string) {
    // TODO 后续通过 EventChannel 实现
    uni.$on(UNICLOUD_DB_CONTACTS_UPDATE, onDataChange);
    uni.navigateTo({
      url: './detail?id=' + id
    })
  }

  onReady(() => {
    // TODO 后续通过 EventChannel 实现
    uni.$on(UNICLOUD_DB_CONTACTS_DELETE, onDataChange);
    if (udbRef.value != null) {
      udbRef.value!.loadData()
    }
  })
  onUnload(() => {
    // TODO 后续通过 EventChannel 实现
    uni.$off(UNICLOUD_DB_CONTACTS_ADD, onDataChange);
    uni.$off(UNICLOUD_DB_CONTACTS_UPDATE, onDataChange);
    uni.$off(UNICLOUD_DB_CONTACTS_DELETE, onDataChange);
  })
  onPageShow(() => {
    // TODO 后续通过 EventChannel 实现
    uni.$off(UNICLOUD_DB_CONTACTS_ADD, onDataChange);
    uni.$off(UNICLOUD_DB_CONTACTS_UPDATE, onDataChange);
  })
  onPullDownRefresh(() => {
    if (udbRef.value != null) {
      udbRef.value!.loadData({
        clear: true,
        success: (_ : UniCloudDBGetResult) => {
          uni.stopPullDownRefresh()
        }
      })
    }
  })
</script>

<style>
  .udb {
    flex: 1;
    /* TODO */
    /* #ifdef WEB */
    display: flex;
    /* #endif */
    flex-direction: column;
  }

  .btn-plus {
    width: 64px;
    height: 64px;
    border-radius: 64px;
  }
</style>
