<template>
  <view class="page u-p-15">
    <unicloud-db ref="udbRef" :collection="collection" loadtime="manual"></unicloud-db>
    <form @submit="onFormSubmit">
      <view class="flex-dir-row mb-15 items-center">
        <text class="w-45 mr-10 color-contact-text-333">姓名</text>
        <input class="flex-1 fs-14 border-1-solid-contact-border-e5e5e5 radius-5 h-34 pl-8 pr-8 color-contact-input-a1a1a1" placeholder="姓名" name="username" />
      </view>
      <view class="flex-dir-row mb-15 items-center">
        <text class="w-45 mr-10 color-contact-text-333">电话</text>
        <input class="flex-1 fs-14 border-1-solid-contact-border-e5e5e5 radius-5 h-34 pl-8 pr-8 color-contact-input-a1a1a1" placeholder="电话" name="mobile" />
      </view>
      <view class="flex-dir-row mb-15 items-center">
        <text class="w-45 mr-10 color-contact-text-333">邮箱</text>
        <input class="flex-1 fs-14 border-1-solid-contact-border-e5e5e5 radius-5 h-34 pl-8 pr-8 color-contact-input-a1a1a1" placeholder="邮箱地址" name="email" />
      </view>
      <view class="flex-dir-row mb-15 items-center">
        <text class="w-45 mr-10 color-contact-text-333">备注</text>
        <textarea class="flex-1 fs-14 border-1-solid-contact-border-e5e5e5 radius-5 p-8 color-contact-input-a1a1a1" placeholder="备注" name="comment" :maxlength="-1" />
      </view>
      <view class="flex-dir-row mb-15 items-center">
        <text class="w-45 mr-10 color-contact-text-333">性别</text>
        <enum-data-checkbox
          class="flex-1"
          :model-value="selectedGender"
          :items="genderList"
          mode="default"
          :show-toast="false"
          @change="selectedGender = $event as number"
        />
      </view>
      <button class="mt-50" type="primary" form-type="submit">保存</button>
    </form>
  </view>
</template>

<script setup lang="ts">
  const selectedGender = ref<number>(-1)


  import { COLLECTION_NAME, GenderType, GenderList, UNICLOUD_DB_CONTACTS_ADD } from './types.ts'

  const collection = ref(COLLECTION_NAME)
  const genderList = ref(GenderList as GenderType[])
  const udbRef = ref<UniCloudDBElement | null>(null)

  function onFormSubmit(e : UniFormSubmitEvent) {
    const formData = e.detail.value
    formData['gender'] = selectedGender.value
    console.log('formData', formData)
    if (udbRef.value != null) {
      udbRef.value!.add(formData, {
      showToast: false,
      needLoading: true,
      loadingTitle: "正在保存...",
      success: (_ : UniCloudDBAddResult) => {
        // TODO 后续通过 EventChannel 实现
        uni.$emit(UNICLOUD_DB_CONTACTS_ADD, '')
        setTimeout(() => {
          uni.navigateBack()
        }, 500)
      },
        fail: (err : any | null) => {
          const error = err as UniCloudError
          uni.showModal({
            content: error.errMsg,
            showCancel: false
          })
        }
      })
    }
  }
</script>

<style>
  .color-contact-input-a1a1a1 {
    color: var(--contact-input-color, #a1a1a1);
  }

  .page {
    --contact-text-color: #333333;
    --contact-border-color: #e5e5e5;
    --contact-input-color: #a1a1a1;
  }

  @media (prefers-color-scheme: dark) {
    .page {
      --contact-text-color: #ffffff;
      --contact-border-color: rgba(255, 255, 255, 0.1);
      --contact-input-color: #ffffff;
    }
  }
</style>
