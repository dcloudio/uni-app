<template>
  <scroll-view class="scroll-view u-p-15 flex-1">
    <unicloud-db ref="udbRef" v-slot:default="{data, loading, error}" :collection="collection" :where="where"
      page-data="replace">
      <view v-if="error!=null">{{error.errMsg}}</view>
      <view v-if="loading" class="items-center">正在加载...</view>
      <form v-if="data.length>0" @submit="onFormSubmit($event, data[0].gender as number)">
        <view class="flex-dir-row mb-15 items-center">
          <text class="w-45 mr-10 color-contact-text-333">姓名</text>
          <input class="flex-1 fs-14 border-1-solid-contact-border-e5e5e5 radius-5 h-34 pl-8 pr-8 color-contact-secondary-666" placeholder="姓名" name="username" :value="(data[0].username as string)" />
        </view>
        <view class="flex-dir-row mb-15 items-center">
          <text class="w-45 mr-10 color-contact-text-333">电话</text>
          <input class="flex-1 fs-14 border-1-solid-contact-border-e5e5e5 radius-5 h-34 pl-8 pr-8 color-contact-secondary-666" placeholder="电话" name="mobile" :value="(data[0].mobile as string)" />
        </view>
        <view class="flex-dir-row mb-15 items-center">
          <text class="w-45 mr-10 color-contact-text-333">邮箱</text>
          <input class="flex-1 fs-14 border-1-solid-contact-border-e5e5e5 radius-5 h-34 pl-8 pr-8 color-contact-secondary-666" placeholder="邮箱地址" name="email" :value="(data[0].email as string)" />
        </view>
        <view class="flex-dir-row mb-15 items-center">
          <text class="w-45 mr-10 color-contact-text-333">备注</text>
          <textarea class="flex-1 fs-14 border-1-solid-contact-border-e5e5e5 radius-5 p-8 color-contact-secondary-666" placeholder="备注" name="comment" :maxlength="-1"
            :value="(data[0].comment as string)" />
        </view>
        <view class="flex-dir-row mb-15 items-center">
          <text class="w-45 mr-10 color-contact-text-333">性别</text>
          <enum-data-checkbox
            class="flex-1"
            :model-value="selectedGender ?? (data[0].gender as number)"
            :items="genderList"
            mode="default"
            :show-toast="false"
            @change="selectedGender = $event as number"
          />
        </view>
        <view class="mt-30">
          <button type="primary" form-type="submit">保存</button>
          <button class="mt-15" type="warn"
            @click="remove((data[0]._id as string), (data[0].username as string))">删除联系人</button>
        </view>
      </form>
    </unicloud-db>
  </scroll-view>
</template>

<script setup lang="ts">
  const selectedGender = ref<number | null>(null)


  import { COLLECTION_NAME, GenderType, GenderList, UNICLOUD_DB_CONTACTS_UPDATE, UNICLOUD_DB_CONTACTS_DELETE } from './types.ts'

  const collection = ref('')
  const where = ref('')
  const genderList = ref(GenderList as GenderType[])
  const whereID = ref('')
  const udbRef = ref<UniCloudDBElement | null>(null)

  function onFormSubmit(e : UniFormSubmitEvent, originalGender : number | null = null) {
    const formData = e.detail.value
    formData['gender'] = selectedGender.value ?? originalGender ?? -1
    if (udbRef.value != null) {
      udbRef.value!.update(whereID.value, formData, {
      showToast: false,
      needLoading: true,
      needConfirm: false,
      loadingTitle: "正在保存...",
      success: (_ : UniCloudDBUpdateResult) => {
        // TODO 后续通过 EventChannel 实现
        uni.$emit(UNICLOUD_DB_CONTACTS_UPDATE, whereID.value)
        setTimeout(() => {
          uni.navigateBack()
        }, 500)
      },
        fail: (err : any | null) => {
          const error = err as UniCloudError
          uni.showModal({
            content: error.errMsg,
            showCancel: false
          })
        }
      })
    }
  }
  function remove(id : string | null, name : string | null) {
    if (udbRef.value != null) {
      udbRef.value!.remove(id!, {
      needConfirm: true,
      needLoading: true,
      loadingTitle: "正在删除...",
      confirmTitle: "确定删除?",
      confirmContent: name,
      success: (_ : UniCloudDBRemoveResult) => {
        // TODO 后续通过 EventChannel 实现
        uni.$emit(UNICLOUD_DB_CONTACTS_DELETE, whereID.value)
        setTimeout(() => {
          uni.navigateBack({
            delta: 2
          })
        }, 500)
      },
        fail: (err : any | null) => {
          const error = err as UniCloudError
          uni.showModal({
            content: error.errMsg,
            showCancel: false
          })
        }
      })
    }
  }

  onLoad((options) => {
    collection.value = COLLECTION_NAME;
    whereID.value = options['id'] as string;
    where.value = `_id=='${whereID.value}'`;
  })
</script>

<style>
  .scroll-view {
    --contact-text-color: #333333;
    --contact-secondary-color: #666;
    --contact-border-color: #e5e5e5;
  }

  @media (prefers-color-scheme: dark) {
    .scroll-view {
      --contact-text-color: #ffffff;
      --contact-secondary-color: #a0a0a0;
      --contact-border-color: rgba(255, 255, 255, 0.1);
    }
  }
</style>
