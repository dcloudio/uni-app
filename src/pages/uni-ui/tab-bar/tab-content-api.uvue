<template>
	<view class="content-page">
		<text class="page-text">当前索引: {{ activeIndex }}</text>
		<view class="panel-card">
			<text class="panel-title">Tab 切换</text>
			<button class="action-button primary-button" @click="switchToFirstTab">切换到第一个 tab-item</button>
		</view>
		<view class="panel-card">
			<text class="panel-title">当前 tab-item 角标</text>
			<button class="action-button" @click="setBadgeNumber">设置数字角标</button>
			<button class="action-button" @click="setBadgeDot">设置红点角标</button>
			<button class="action-button" @click="clearBadge">取消角标</button>
			<button class="action-button accent-button" @click="setBadgeClass">自定义 badgeClass 样式</button>
			<text class="panel-tip">当前操作目标 tab 索引: {{ currentTabItemIndex }}</text>
		</view>
	</view>
</template>

<script setup lang="ts">
import { inject, ref } from 'vue'
import { Ref } from 'vue'

// 从父组件注入当前激活的索引
const activeIndex = inject<Ref<number>>('uniTabBarCurrentIndex', ref(0))
const changeTab = inject<(index : number) => void>('uniTabBarChangeTab', (index : number) => {})
const currentTabItemIndex = inject<number>('tabContent2Index', 1)
const setCurrentBadgeNumber = inject<() => void>('tabContent2SetBadgeNumber', () => {})
const setCurrentBadgeDot = inject<() => void>('tabContent2SetBadgeDot', () => {})
const clearCurrentBadge = inject<() => void>('tabContent2ClearBadge', () => {})
const setCurrentBadgeClass = inject<() => void>('tabContent2SetBadgeClass', () => {})

function switchToFirstTab() : void {
	changeTab(0)
}

function setBadgeNumber() : void {
	setCurrentBadgeNumber()
}

function setBadgeDot() : void {
	setCurrentBadgeDot()
}

function clearBadge() : void {
	clearCurrentBadge()
}

function setBadgeClass() : void {
	setCurrentBadgeClass()
}
</script>

