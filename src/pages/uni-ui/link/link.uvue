<template>
  <text class="uni-h4">基础用法</text>
  <view class="link-block">
    <uni-link href="https://uniapp.dcloud.net.cn" @error="onError">https://uniapp.dcloud.net.cn</uni-link>
  </view>

  <text class="uni-h4">自定义样式</text>
  <view class="link-block">
    <uni-link href="https://doc.dcloud.net.cn/uni-app-x/" class="custom-link" @error="onError">
      查看 uni-app x 文档
    </uni-link>
  </view>

  <text class="uni-h4">href</text>
  <view class="link-block">
    <uni-link href="https://uniapp.dcloud.net.cn" @error="onError">点击打开 href 配置的地址</uni-link>
  </view>

  <text class="uni-h4">target="_self"（默认）</text>
  <view class="link-block">
    <uni-link href="https://uniapp.dcloud.net.cn" target="_self" @error="onError">
      在内置 webview 中打开
    </uni-link>
  </view>

  <text class="uni-h4">target="_blank"</text>
  <view class="link-block">
    <uni-link href="https://uniapp.dcloud.net.cn" target="_blank" @error="onError">
      使用外部浏览器打开
    </uni-link>
  </view>
  <text class="tip-text">APP 使用 openSchema 插件，小程序回退到内置 webview 打开，Web 打开新页签</text>

  <text class="uni-h4">blank-fallback="copy-link-modal"</text>
  <view class="link-block">
    <uni-link href="https://uniapp.dcloud.net.cn" target="_blank" blank-fallback="copy-link-modal" @error="onError">
      打开失败时复制链接并弹框提示
    </uni-link>
  </view>

  <text class="uni-h4">blank-fallback="none"</text>
  <view class="link-block">
    <uni-link href="https://uniapp.dcloud.net.cn" target="_blank" blank-fallback="none" @error="onError">
      不回退，打开失败时触发 error 事件
    </uni-link>
  </view>
  <text class="tip-text">使用外部浏览器打开失败时不回退，直接触发 error 事件</text>

  <text class="uni-h4">失败示例（error 事件）</text>
  <view class="link-block">
    <uni-link href="" @error="onError">空链接（触发 error）</uni-link>
  </view>

  <text class="uni-h4">最近事件</text>
  <text class="log-text">{{ data.lastEvent }}</text>
</template>

<script setup lang="ts">
  type Data = {
    lastEvent: string
  }

  const data = reactive<Data>({
    lastEvent: '暂无事件'
  })

  function onError(message : string) {
    data.lastEvent = `error: ${message}`
    console.error(`[link] error: ${message}`)
  }

  defineExpose({
    data,
    onError
  })
</script>

<style>
  page {
    padding: 12px;
  }

  .link-block {
    margin-bottom: 12px;
  }

  .tip-text {
    margin-bottom: 12px;
    font-size: 12px;
    color: var(--text-color, #333333);
    opacity: 0.6;
  }

  .custom-link {
    color: #007aff;
    font-size: 20px;
  }

  .log-text {
    font-size: 13px;
    color: #007aff;
  }

  @media (prefers-color-scheme: dark) {
    .custom-link {
      color: #4dabff;
    }
  }
</style>
