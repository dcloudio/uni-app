<template>
	<text class="desc">
	评分组件用于商品评价打分、服务态度评价、用户满意度等场景。\n
	高性能模式仅有一个text组件，不可修改评分，适合长列表中显示的场景。\n
	普通模式可以通过点击星星进行评分，且专门调大字号、调宽间距以适合点击。
	</text>

	<text class="uni-h4">高性能：只读，不显示灰星，不支持小数</text>
		<uni-rate :value="3.6"/>
	<text class="uni-h4">只读，显示灰星</text>
		<uni-rate full readonly/>
	<text class="uni-h4">只读，小数4.3</text>
		<uni-rate full readonly :value="4.3"/>
	<text class="uni-h4">只读，value大于5超限测试</text>
		<uni-rate full readonly :value="100"/>
	<text class="uni-h4">只读，value小于0超限测试</text>
		<uni-rate full readonly :value="-1"/>
	<text class="uni-h4">未选中的星星为镂空状态 + letterSpacing组件属性</text>
		<uni-rate full :value="3.5" :plain="true" :letter-spacing="10" star-class="big-font" star-active-class="big-font" />
	<text class="uni-h4">未选中的星星为实心且响应change事件</text>
		<uni-rate full :letter-spacing="10" star-class="big-font" star-active-class="big-font" @change="onRateChange" />
	<text class="uni-h4">响应点击并双向绑定响应式变量</text>
		<uni-rate full :letter-spacing="10" v-model="data.vModelRateValue" star-class="big-font" star-active-class="big-font" />
		<text>{{data.vModelRateValue}}</text>
	<text class="uni-h4">向右偏移 100px，点击评分</text>
		<view id="rate-offset-test" class="offset-rate">
			<uni-rate full v-model="data.offsetRateValue" :letter-spacing="10" star-class="big-font" star-active-class="big-font" />
		</view>
		<text class="desc">当前评分：{{ data.offsetRateValue }}</text>
	<text class="uni-h4">只读，不触发change</text>
		<uni-rate readonly :value="5" @change="onRateChange" />
	<text class="uni-h4">高性能只读，自定义大小和颜色（class方式），此时小数不生效</text>
		<uni-rate :value="4.6" star-active-class="high-perf-custom" />
	<text class="uni-h4">高性能只读，自定义间隔letter-spacing（class方式）</text>
		<uni-rate :value="4" star-active-class="big-letter-spacing"/>
	<text class="uni-h4">自定义默认颜色和选中颜色 class方式</text>
		<uni-rate :value="3" full star-class="custom-default big-font" star-active-class="custom-selected big-font"/>
	<text class="uni-h4">只读，程序动态赋值，不触发change</text>
		<uni-rate :value="data.rateValue" @change="onRateChange"/>
</template>
<script setup lang="ts">
	type Data = {
		vModelRateValue: number
		rateValue: number
		offsetRateValue: number
	}

	const data = reactive<Data>({
		vModelRateValue: 0,
		rateValue: 0,
		offsetRateValue: 0
	})

	let interval = 0

	function onRateChange(value: number) {
		console.log('onRateChange received value:', value, 'type:', typeof value)

		// 检查值是否有效
		if (isNaN(value)) {
			console.error('Invalid value received:', value)
			uni.showToast({
				title: '无效值: ' + value,
				position: "bottom"
			})
			return
		}

		uni.showToast({
			title: 'rate改变:' + value,
			position: "bottom"
		})
	}

	// 动态赋值示例
	onMounted(() => {
		// 每2秒改变一次评分值
		interval = setInterval(() => {
			data.rateValue = Math.floor(Math.random() * 6) // 0-5之间的随机整数
		}, 2000)
	})

	onUnmounted(() => {
		if (interval != 0) {
			clearInterval(interval)
		}
	})

	defineExpose({
		data,
		onRateChange
	})
</script>
<style>
page{
	padding: 10px;
}
.offset-rate {
	margin-left: 100px;
	align-self: flex-start;
}
.desc {
	color: var(--text-color, #333333);
}
.custom-default{
	color:black
}
.custom-selected{
	color:red
}
.high-perf-custom{
	font-size: 32px;
	color: red;
}
.big-letter-spacing{
	letter-spacing: 10px;
}
.big-font{
	font-size: 24px;
}
@media (prefers-color-scheme: dark) {
	.custom-default {
		color: #cccccc;
	}
}
</style>
