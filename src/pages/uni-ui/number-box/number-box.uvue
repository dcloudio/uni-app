<template>
	<text class="uni-h4">基础用法：</text>
	<uni-number-box v-model="data.value1" @change="onChange" />
	<text class="hint">当前值：{{ data.value1 }}</text>

	<text class="uni-h4">设置范围 (min=5, max=20)：</text>
	<uni-number-box v-model="data.value2" :min="5" :max="20" />
	<text class="hint">当前值：{{ data.value2 }}</text>

	<text class="uni-h4">步长为5 (step=5)：</text>
	<uni-number-box v-model="data.value3" :step="5" />
	<text class="hint">当前值：{{ data.value3 }}</text>

	<text class="uni-h4">小数步长 (step=0.1)：</text>
	<uni-number-box v-model="data.value4" :step="0.1" :min="0" :max="10" />
	<text class="hint">当前值：{{ data.value4 }}</text>

	<text class="uni-h4">禁用状态 (disabled)：</text>
	<uni-number-box :value="5" :disabled="true" />

	<text class="uni-h4">自定义按钮样式 (btn-class)：</text>
	<uni-number-box v-model="data.value5" btn-class="custom-btn" />

	<text class="uni-h4">自定义输入框样式 (input-class)：</text>
	<uni-number-box v-model="data.value6" input-class="custom-input" />

	<text class="uni-h4">自定义样式组合 (蓝色主题)：</text>
	<uni-number-box v-model="data.value7" btn-class="blue-btn" input-class="blue-input" icon-class="blue-icon" />

	<text class="uni-h4">聚焦 / 失焦事件 (focus / blur)：</text>
	<uni-number-box v-model="data.value8" @focus="onFocus" @blur="onBlur" />
	<text class="hint">最近一次事件：{{ data.eventLog }}</text>
</template>

<script setup lang="ts">
type Data = {
	value1 : number
	value2 : number
	value3 : number
	value4 : number
	value5 : number
	value6 : number
	value7 : number
	value8 : number
	eventLog : string
}

const data = reactive<Data>({
	value1: 1,
	value2: 10,
	value3: 0,
	value4: 0.5,
	value5: 1,
	value6: 1,
	value7: 1,
	value8: 1,
	eventLog: '无'
})

const onChange = (value : number) : void => {
	console.log('number-box change:', value)
}

const onFocus = (event : UniInputFocusEvent) : void => {
	data.eventLog = 'focus: ' + event.detail.value
}

const onBlur = (event : UniInputBlurEvent) : void => {
	data.eventLog = 'blur: ' + event.detail.value
}

defineExpose({
	data
})
</script>

<style>
page {
	padding: 15px;
}

.hint {
	color: var(--text-color, #333333);
	opacity: 0.6;
	margin-top: 5px;
	margin-bottom: 10px;
}

.custom-btn {
	background-color: #28a745;
}

.custom-input {
	background-color: #fff3cd;
	color: #856404;
	width: 80px;
}

.blue-btn {
	background-color: #007aff;
}

.blue-input {
	background-color: #e8f4ff;
	color: #007aff;
}

.blue-icon {
	background-color: #fff;
}
</style>
