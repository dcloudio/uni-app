				{ id: 703, name: '草莓圣代', desc: '香甜草莓', price: 13 }
			]
		},
		{
			name: '其他',
			items: [
				{ id: 801, name: '餐具包', desc: '含刀叉纸巾', price: 1 },
				{ id: 802, name: '调味酱', desc: '番茄 / 甜辣', price: 2 }
