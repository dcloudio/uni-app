			items: [
				{ id: 401, name: '黄金薯条', desc: '现炸酥脆', price: 12 },
				{ id: 402, name: '洋葱圈', desc: '香甜可口', price: 14 },
				{ id: 403, name: '鸡肉卷', desc: '墨西哥风味', price: 16 }
			]
		},
