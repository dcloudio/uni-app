<template>
	<!-- 小程序（默认 WebView）没有原生分段吸顶能力，改用「页面滚动 + CSS position: sticky」实现推出式吸顶 -->
	<!-- #ifdef MP -->
	<view class="page">
		<view class="sidebar-wrap">
			<uni-sidebar class="sidebar" :list="categories" target-id="food-list" :page-scroll="true">
				<template #default="{ item, index, active }">
					<view class="sidebar-item" :class="active ? 'sidebar-item--active' : ''">
						<view class="sidebar-item__bar" v-if="active"></view>
						<text class="sidebar-item__text" :class="active ? 'sidebar-item__text--active' : ''">{{ item }}</text>
					</view>
				</template>
			</uni-sidebar>
		</view>
		<view class="list">
			<view class="header">
				<text class="header__title">uni-sidebar 侧边滚动导航</text>
				<text class="header__desc">点击左侧分类滚动，右侧分组标题吸顶并推出上一段</text>
			</view>
			<view v-for="(group, index) in groups" :key="group.name" :id="'food-list-item-' + index" class="section">
				<view class="group__header">
					<text class="group__header-text">{{ group.name }}</text>
				</view>
				<view v-for="food in group.items" :key="food.id" class="food">
					<view class="food__thumb">
						<text class="food__thumb-text">{{ food.name.substring(0, 1) }}</text>
					</view>
					<view class="food__info">
						<text class="food__name">{{ food.name }}</text>
						<text class="food__desc">{{ food.desc }}</text>
					</view>
					<text class="food__price">￥{{ food.price }}</text>
				</view>
			</view>
		</view>
	</view>
	<!-- #endif -->
	<!-- 其他平台：独立滚动容器 + sticky-section 原生分段吸顶 -->
	<!-- #ifndef MP -->
	<view class="page">
		<view class="header">
			<text class="header__title">uni-sidebar 侧边滚动导航</text>
			<text class="header__desc">点击左侧分类，右侧列表滚动到对应位置；滚动右侧列表，左侧分类自动高亮</text>
		</view>
		<view class="body">
			<uni-sidebar class="sidebar" :list="categories" target-id="food-list">
				<template #default="{ item, index, active }">
					<view class="sidebar-item" :class="active ? 'sidebar-item--active' : ''">
						<view class="sidebar-item__bar" v-if="active"></view>
						<text class="sidebar-item__text" :class="active ? 'sidebar-item__text--active' : ''">{{ item }}</text>
					</view>
				</template>
			</uni-sidebar>
			<list-view id="food-list" class="food-list">
				<sticky-section v-for="(group, index) in groups" :key="group.name" :id="'food-list-item-' + index">
					<sticky-header>
						<view class="group__header">
							<text class="group__header-text">{{ group.name }}</text>
						</view>
					</sticky-header>
					<list-item v-for="food in group.items" :key="food.id">
						<view class="food">
							<view class="food__thumb">
								<text class="food__thumb-text">{{ food.name.substring(0, 1) }}</text>
							</view>
							<view class="food__info">
								<text class="food__name">{{ food.name }}</text>
								<text class="food__desc">{{ food.desc }}</text>
							</view>
							<text class="food__price">￥{{ food.price }}</text>
						</view>
					</list-item>
				</sticky-section>
			</list-view>
		</view>
	</view>
	<!-- #endif -->
</template>

