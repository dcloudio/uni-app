	const categories = groups.map((group : Group) : string => group.name)
</script>

<style>
	.page {
		flex-direction: column;
		background-color: var(--background-color, #ffffff);
	}

	/* #ifndef MP */
	.page {
		flex: 1;
	}
	/* #endif */
	.header {
		padding: 12px 16px;
		flex-direction: column;
		background-color: var(--background-color, #f0f7ff);
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--border-color, #eeeeee);
	}

	.header__title {
		font-size: 16px;
		font-weight: bold;
		color: var(--text-color, #333333);
	}

	.header__desc {
		margin-top: 4px;
		font-size: 12px;
		color: var(--secondary-text-color, #999999);
	}

	/* #ifdef MP */
	/* 小程序：侧边栏固定在左侧，右侧列表随页面滚动。
	   uni-app x 给所有 view 默认加了 overflow: hidden，会破坏 position: sticky，
	   因此这里把 sticky 标题的所有祖先容器改为 overflow: visible */
	.page {
		overflow: visible;
	}

	/* 用固定容器显式给定宽度和背景，避免组件根节点宽度为 0 导致左侧漏内容 */
	.sidebar-wrap {
		position: fixed;
		left: 0;
		top: 0;
		bottom: 0;
		width: 90px;
		z-index: 30;
		background-color: var(--background-color, #f7f7f7);
	}

	.sidebar {
		width: 100%;
		height: 100%;
	}

	.list {
		flex-direction: column;
		padding-left: 90px;
		overflow: visible;
	}

	.section {
		flex-direction: column;
		overflow: visible;
	}
	/* #endif */

	/* #ifndef MP */
	.body {
		flex: 1;
		flex-direction: row;
	}

	.sidebar {
		height: 100%;
	}

	.food-list {
		flex: 1;
		height: 100%;
		background-color: var(--list-background-color, #ffffff);
	}
	/* #endif */

	.sidebar-item {
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 16px 6px;
	}

	.sidebar-item__bar {
		position: absolute;
		left: 0;
		width: 3px;
		height: 18px;
		background-color: var(--sidebar-active-color, #ff5500);
		border-top-right-radius: 2px;
		border-bottom-right-radius: 2px;
	}

	.sidebar-item__text {
		font-size: 14px;
		color: var(--text-color, #666666);
	}

	.sidebar-item__text--active {
		color: var(--sidebar-active-color, #ff5500);
		font-weight: bold;
	}

	.sidebar-item--active {
		background-color: var(--list-background-color, #ffffff);
	}

	.group__header {
		padding: 10px 16px;
		background-color: var(--background-color, #f5f5f5);
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--border-color, #eeeeee);
	}

	/* #ifdef MP */
	/* 页面滚动下用 CSS sticky 实现分段吸顶（下一段标题会推出上一段） */
	.group__header {
		position: sticky;
		top: 0;
		z-index: 10;
	}
	/* #endif */

	.group__header-text {
		font-size: 14px;
		font-weight: bold;
		color: var(--text-color, #333333);
		opacity: 0.8;
	}

	.food {
		flex-direction: row;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--border-color, #f0f0f0);
	}

	.food__thumb {
		width: 48px;
		height: 48px;
		border-radius: 6px;
		background-color: var(--active-background-color, #ffe8d9);
		align-items: center;
		justify-content: center;
	}

	.food__thumb-text {
		font-size: 18px;
		color: var(--sidebar-active-color, #ff5500);
		font-weight: bold;
	}

	.food__info {
		flex: 1;
		flex-direction: column;
		margin-left: 12px;
	}

	.food__name {
		font-size: 15px;
		color: var(--text-color, #333333);
	}

	.food__desc {
		margin-top: 4px;
		font-size: 12px;
		color: var(--secondary-text-color, #999999);
	}

	.food__price {
		font-size: 15px;
		font-weight: bold;
		color: var(--sidebar-active-color, #ff5500);
	}
</style>
