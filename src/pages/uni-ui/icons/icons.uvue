<template>
	<text class="intro-text">图标组件可以减少小图片的使用，并支持自定义颜色和尺寸。</text>

	<view class="section-header">
		<text class="uni-h4">图标</text>
		<view class="display-mode">
			<text class="display-mode-text">{{ checked ? 'Unicode' : '名称' }}</text>
			<switch class="display-mode-switch" :checked="checked" @change="change" />
		</view>
	</view>

	<view class="icon-content">
		<view
			v-for="(item, index) in iconlist"
			:key="index"
			class="icon-item"
			@click="switchActive(index, item)"
			<!-- #ifdef WEB -->
			:tabindex="'0'"
			@keydown="onItemKeydown($event, index, item)"
			<!-- #endif -->
		>
			<uni-icons
				:type="item.font_class"
				class="icon-glyph"
				:class="{ 'icon-glyph-active': activeIndex == index }"
			/>
			<text
				class="icon-label"
				:class="{ 'icon-label-active': activeIndex == index }"
			>{{ checked ? item.unicode : item.font_class }}</text>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { state } from '@/store/index.ts'
	import { iconlist, iconType } from './icons_type.uts'

	const activeIndex = ref(-1)
	const checked = ref(false)
	const isDarkMode = computed(() : boolean => state.isDarkMode)

	const syncNavigationBar = () : void => {
		// #ifdef APP
		const dark = isDarkMode.value
		uni.setNavigationBarColor({
			frontColor: dark ? '#ffffff' : '#000000',
			backgroundColor: dark ? '#1a1a1a' : '#efeff4'
		})
		// #endif
	}

	const change = (event : UniSwitchChangeEvent) => {
		checked.value = event.detail.value
	}

	const switchActive = (index : number, item : iconType) => {
		activeIndex.value = index
		uni.setClipboardData({
			data: checked.value ? item.unicode : item.font_class,
			showToast: false,
			success: () => {
				uni.showToast({
					icon: 'none',
					title: (checked.value ? 'Unicode' : '图标名称') + '复制成功'
				})
			}
		})
	}

	// #ifdef WEB
	const onItemKeydown = (event : KeyboardEvent, index : number, item : iconType) : void => {
		const key = event.key as string
		if (key == 'Enter' || key == ' ') {
			event.preventDefault()
			switchActive(index, item)
		}
	}
	// #endif

	watch(isDarkMode, syncNavigationBar, { immediate: true })
	onShow(syncNavigationBar)

	defineExpose({
		activeIndex,
		checked
	})
</script>

<style>
	page {
		--background-color: #efeff4;
		--list-background-color: #ffffff;
		--text-color: #333333;
		padding: 16px;
		background-color: var(--background-color);
	}

	.intro-text {
		font-size: 14px;
		line-height: 22px;
		color: var(--text-color, #333333);
	}

	.section-header {
		margin-top: 10px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.display-mode {
		flex-direction: row;
		align-items: center;
	}

	.display-mode-text {
		margin-right: 8px;
		font-size: 13px;
		color: var(--text-color, #333333);
		opacity: 0.65;
	}

	.display-mode-switch {
		transform: scale(0.7);
	}

	.icon-content {
		margin-top: 8px;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: flex-start;
	}

	.icon-item {
		width: 25%;
		padding: 12px 4px 10px;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-start;
		/* #ifdef WEB */
		cursor: pointer;
		outline: none;
		/* #endif */
	}

	/* #ifdef WEB */
	.icon-item:focus-visible {
		outline: 2px solid #2979ff;
		outline-offset: -2px;
	}
	/* #endif */

	.icon-label {
		width: 100%;
		margin-top: 8px;
		font-size: 12px;
		line-height: 16px;
		text-align: center;
		color: var(--text-color, #333333);
		opacity: 0.65;
	}

	.icon-label-active {
		color: #007aff;
		opacity: 1;
	}

	.icon-glyph {
		width: 30px;
		height: 30px;
		line-height: 30px;
		text-align: center;
		align-self: center;
		flex-shrink: 0;
		color: var(--text-color, #333333);
		font-size: 30px;
		opacity: 0.65;
	}

	.icon-glyph-active {
		color: #007aff;
		opacity: 1;
	}

	@media (prefers-color-scheme: dark) {
		page {
			--background-color: #1a1a1a;
			--list-background-color: #2d2d2d;
			--text-color: #ffffff;
		}
	}
</style>
