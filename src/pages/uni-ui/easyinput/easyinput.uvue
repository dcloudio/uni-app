<template>
	<text class="page-title">Easyinput 增强输入框</text>
	<text class="page-desc">支持单行、多行、密码、清空、前后插槽和自定义内部样式。</text>

	<text class="uni-h4">基础输入</text>
	<uni-easyinput
		v-model="data.basicValue"
		clearable
		placeholder="请输入内容"
		input-class="test-basic-input"
		icon-class="test-clear-icon"
		@clear="onClear"
		@change="onChange"
		@confirm="onConfirm"
		@blur="handleBlur"
	/>
	<text
		class="result-text test-basic-result"
		:data-change-count="data.changeCount"
		:data-confirm-count="data.confirmCount"
		:data-blur-count="data.blurCount"
	>当前值：{{ data.basicValue }}</text>

	<text class="uni-h4">name：原生表单控件名称</text>
	<uni-easyinput v-model="data.nameValue" name="account" placeholder="name 会透传给原生控件" />
	<text class="result-text">当前值：{{ data.nameValue }}</text>

	<text class="uni-h4">maxlength：最大输入长度</text>
	<uni-easyinput v-model="data.maxlengthValue" :maxlength="6" placeholder="最多输入 6 个字符" />
	<text class="result-text">当前长度：{{ data.maxlengthValue.length }}/6</text>

	<text class="uni-h4">focus：自动聚焦与程序控制焦点</text>
	<uni-easyinput
		ref="methodInputRef"
		v-model="data.focusValue"
		:focus="data.focusEnabled"
		placeholder="点击下方按钮控制焦点"
	/>
	<view class="button-row">
		<button class="small-button" size="mini" @click="toggleFocus">切换 focus 属性（当前：{{ data.focusEnabled ? 'true' : 'false' }}）</button>
		<button class="small-button" size="mini" @click="callFocusInput">focusInput() 方法</button>
		<button class="small-button" size="mini" @click="callBlurInput">blurInput() 方法</button>
	</view>

	<text class="uni-h4">confirm-type / cursor-spacing / adjust-position</text>
	<uni-easyinput v-model="data.keyboardValue" confirm-type="search" :cursor-spacing="24" :adjust-position="true" placeholder="回车显示搜索，键盘与光标间距 24px" />
	<text class="result-text">confirm-type=search，cursor-spacing=24，adjust-position=true</text>

	<text class="uni-h4">外部值同步</text>
	<view class="button-row">
		<button class="small-button" size="mini" @click="setExternalValue(0)">设为 0</button>
		<button class="small-button" size="mini" @click="setExternalValue(null)">设为 null</button>
		<button class="small-button" size="mini" @click="setExternalValue('外部更新')">设为文本</button>
	</view>
	<uni-easyinput
		v-model="data.externalValue"
		value="后备值"
		placeholder="观察外部值同步"
		input-class="test-external-input"
	/>
	<text class="result-text">当前值：{{ data.externalValue == null ? 'null' : data.externalValue }}</text>

	<text class="uni-h4">Vue 修饰符</text>
	<uni-easyinput
		v-model.trim="data.modifierValue"
		placeholder="首尾空格由 v-model.trim 处理"
		input-class="test-modifier-input"
	/>
	<text class="result-text">当前值：[{{ data.modifierValue }}]</text>

	<text class="uni-h4">密码和清空</text>
	<uni-easyinput
		v-model="data.passwordValue"
		type="password"
		password-icon
		clearable
		placeholder="请输入密码"
		input-class="test-password-input"
		icon-class="test-password-icon"
		@eyes="onEyes"
	/>
	<text class="result-text">密码显隐：{{ data.passwordVisible ? '显示' : '隐藏' }}</text>

	<text class="uni-h4">多行输入</text>
	<uni-easyinput
		v-model="data.textareaValue"
		type="textarea"
		auto-height
		placeholder="请输入多行内容"
		input-class="demo-textarea test-textarea"
	/>
	<text class="result-text">当前值：{{ data.textareaValue }}</text>

	<text class="uni-h4">状态</text>
	<uni-easyinput
		class="state-input"
		value="disabled-secret"
		type="password"
		password-icon
		clearable
		disabled
		input-class="test-disabled-input"
		icon-class="test-disabled-icon"
	/>
	<uni-easyinput
		class="state-input state-borderless"
		v-model="data.borderlessValue"
		placeholder="无边框（class 覆盖）"
	/>

	<text class="uni-h4">左右插槽</text>
	<uni-easyinput v-model="data.slotValue" placeholder="请输入域名">
		<template #left>
			<text class="slot-prefix">https://</text>
		</template>
		<template #right>
			<text class="slot-suffix">.com</text>
		</template>
	</uni-easyinput>

	<text class="uni-h4">自定义样式与窄布局</text>
	<uni-easyinput
		class="custom-root"
		v-model="data.customValue"
		clearable
		placeholder="宽度受限时保持输入区域可用"
		input-class="custom-field"
		placeholder-class="custom-placeholder"
		icon-class="custom-icon"
	/>

	<text class="uni-h4">自定义图标颜色（自定义样式）</text>
	<uni-easyinput
		v-model="data.iconColorValue"
		clearable
		placeholder="示例：紫色清空图标"
		icon-class="custom-icon-purple"
	/>

	<text class="uni-h4">事件示例</text>
	<uni-easyinput
		v-model="data.eventValue"
		clearable
		placeholder="输入或清空观察事件"
		@update:modelValue="onUpdateModelValue"
		@input="onInput"
		@focus="onFocus"
		@blur="handleBlur"
		@confirm="onConfirm"
		@change="onChange"
		@clear="onClear"
		@keyboardheightchange="onKeyboardHeightChange"
	/>
	<text class="result-text">update:modelValue：{{ data.eventValue }}</text>
	<text class="result-text">input 事件次数：{{ data.inputCount }}</text>
	<text class="result-text">focus 事件次数：{{ data.focusCount }}</text>
	<text class="result-text">blur / change / confirm / clear 次数：{{ data.blurCount }} / {{ data.changeCount }} / {{ data.confirmCount }} / {{ data.clearCount }}</text>
	<text class="result-text">键盘高度：{{ data.keyboardHeight }}</text>
</template>

<script setup lang="ts">
type Data = {
	basicValue : string,
	nameValue : string,
	maxlengthValue : string,
	focusValue : string,
	focusEnabled : boolean,
	keyboardValue : string,
	externalValue : string | number | null,
	modifierValue : string,
	passwordValue : string,
	passwordVisible : boolean,
	textareaValue : string,
	borderlessValue : string,
	slotValue : string,
	customValue : string,
	iconColorValue : string,
	eventValue : string,
	clearCount : number,
	eyesCount : number,
	changeCount : number,
	confirmCount : number,
	blurCount : number,
	inputCount : number,
	focusCount : number,
	keyboardHeight : number,
	lastChangeValue : string,
	lastConfirmValue : string
}

const data = reactive<Data>({
	basicValue: '初始内容',
	nameValue: '',
	maxlengthValue: '',
	focusValue: '',
	focusEnabled: false,
	keyboardValue: '',
	externalValue: '初始值',
	modifierValue: '',
	passwordValue: '123456',
	passwordVisible: false,
	textareaValue: '',
	borderlessValue: '',
	slotValue: '',
	customValue: '窄布局内容',
	iconColorValue: '',
	eventValue: '',
	clearCount: 0,
	eyesCount: 0,
	changeCount: 0,
	confirmCount: 0,
	blurCount: 0,
	inputCount: 0,
	focusCount: 0,
	keyboardHeight: 0,
	lastChangeValue: '',
	lastConfirmValue: ''
})

const methodInputRef = ref<any>(null)

function setExternalValue(value : string | number | null) {
	data.externalValue = value
}

function toggleFocus() {
	data.focusEnabled = !data.focusEnabled
}

function callFocusInput() {
	methodInputRef.value?.focusInput()
}

function callBlurInput() {
	methodInputRef.value?.blurInput()
}

function onUpdateModelValue(value : string) {
	data.eventValue = value
}

function onInput(value : string) {
	data.inputCount += 1
	console.log('easyinput input:', value)
}

function onFocus(event : UniInputFocusEvent | UniTextareaFocusEvent) {
	data.focusCount += 1
	console.log('easyinput focus:', event.detail.value)
}

function onClear() {
	data.clearCount += 1
}

function onEyes(visible : boolean) {
	data.passwordVisible = visible
	data.eyesCount += 1
}

function onChange(value : string) {
	data.lastChangeValue = value
	data.changeCount += 1
}

function onConfirm(value : string) {
	data.lastConfirmValue = value
	data.confirmCount += 1
}

function handleBlur(_event : UniInputBlurEvent | UniTextareaBlurEvent) {
	data.blurCount += 1
}

function onKeyboardHeightChange(event : UniInputKeyboardHeightChangeEvent) {
	data.keyboardHeight = event.detail.height
}

defineExpose({
	data,
	setExternalValue,
	toggleFocus,
	callFocusInput,
	callBlurInput
})
</script>

<style>
page {
	--list-background-color: #ffffff;
	--background-color: #f5f5f5;
	--active-color: #a0a0a0;
	--active-background-color: #f8f8f8;
	--text-color: #333333;
	--arrow-color: #999999;
	--content-background-color: #ffffff;
	--secondary-text-color: #657180;
	--input-border-color: #dcdfe6;
	background-color: var(--background-color);
	padding: 12px;
}

.page-title {
	font-size: 20px;
	font-weight: bold;
	color: var(--text-color, #222222);
}

.page-desc {
	margin-top: 8px;
	margin-bottom: 8px;
	font-size: 14px;
	line-height: 21px;
	color: var(--secondary-text-color, #657180);
}

.result-text {
	margin-top: 8px;
	margin-bottom: 8px;
	font-size: 13px;
	color: var(--secondary-text-color, #657180);
}

.button-row {
	margin-top: 10px;
	margin-bottom: 10px;
	flex-direction: row;
	flex-wrap: wrap;
}

.small-button {
	margin: 0 8px 6px 0;
	color: var(--text-color, #333333);
	background-color: var(--active-background-color, #f8f8f8);
}

.state-input {
	margin-bottom: 10px;
}

.state-borderless {
	border-width: 0;
}

.slot-prefix,
.slot-suffix {
	padding: 0 8px;
	font-size: 13px;
	color: var(--secondary-text-color, #657180);
}

.slot-prefix {
	border-right-width: 1px;
	border-right-style: solid;
	border-right-color: var(--input-border-color, #dcdfe6);
}

.slot-suffix {
	border-left-width: 1px;
	border-left-style: solid;
	border-left-color: var(--input-border-color, #dcdfe6);
}

.demo-textarea {
	min-height: 96px;
}

.custom-root {
	width: 260px;
	border-color: #0f766e;
	border-radius: 0;
	background-color: #f0fdfa;
}

.custom-field {
	color: #115e59;
	font-size: 15px;
}

.custom-placeholder {
	color: #5f8f89;
}

.custom-icon {
	color: #0f766e;
}

.custom-icon-purple {
	color: #7c3aed;
}

@media (prefers-color-scheme: dark) {
	page {
		--list-background-color: #2d2d2d;
		--background-color: #1a1a1a;
		--active-color: rgba(255, 255, 255, 0.35);
		--active-background-color: #3b3b3b;
		--text-color: #ffffff;
		--arrow-color: #a0a0a0;
		--content-background-color: #2d2d2d;
		--secondary-text-color: rgba(255, 255, 255, 0.65);
		--input-border-color: rgba(255, 255, 255, 0.18);
	}

	.custom-root {
		background-color: #12312d;
	}

	.custom-field {
		color: #99f6e4;
	}

	.custom-placeholder {
		color: #5f8f89;
	}

	.custom-icon {
		color: #5eead4;
	}

	.custom-icon-purple {
		color: #a78bfa;
	}
}
</style>
