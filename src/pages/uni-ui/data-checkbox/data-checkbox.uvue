<template>
	<view class="intro">
		<text class="page-title">uni-data-checkbox 数据选择器</text>
		<text class="page-desc">使用本地数据完成单选、多选、选择约束和多种展示模式，并通过 external class 调整选项样式。</text>
	</view>

	<text class="uni-h4">单选与事件</text>
	<text class="section-desc">数字 0 作为有效默认值，同时监听 modelValue 和 change。</text>
	<uni-data-checkbox
		v-model="sexValue"
		:localdata="sex"
		label-class="demo-inline-label"
		label-selected-class="test-zero-selected"
		@update:modelValue="onUpdate"
		@change="onChange"
	/>
	<view class="result-block">
		<text class="result-text">当前值：{{ sexValue }}</text>
		<text class="event-text">最近事件：{{ latestEvent }}</text>
	</view>

	<text class="uni-h4">多选与事件</text>
	<text class="section-desc">支持数组模型和默认选中项。</text>
	<uni-data-checkbox
		v-model="sexMultiValue"
		:localdata="hobby"
		multiple
		label-class="demo-inline-label"
		text-class="test-dynamic-text"
		@update:modelValue="onMultiUpdate"
		@change="onMultiChange"
	/>
	<view class="result-block">
		<text class="result-text">当前值：{{ JSON.stringify(sexMultiValue) }}</text>
		<text class="event-text">最近事件：{{ latestMultiEvent }}</text>
	</view>

	<text class="uni-h4">选择数量限制</text>
	<text class="section-desc">最多选择 3 项，数据中的 disable 可单独禁用选项。</text>
	<uni-data-checkbox
		v-model="sexMultiMaxValue"
		:localdata="hobbyMore"
		:max="3"
		multiple
		label-class="demo-inline-label"
	/>
	<text class="result-text result-standalone">当前值：{{ JSON.stringify(sexMultiMaxValue) }}</text>

	<text class="uni-h4">Button 模式</text>
	<text class="section-desc">mode 为 button 时以分段按钮展示选项。</text>
	<uni-data-checkbox v-model="buttonValue" mode="button" :localdata="buttonOptions" />
	<text class="result-text result-standalone">当前值：{{ buttonValue }}</text>

	<text class="uni-h4">Tag 模式与字段映射</text>
	<text class="section-desc">使用 map 映射 name/code 字段，并限制选择 1 至 3 项。</text>
	<uni-data-checkbox
		v-model="tagValue"
		mode="tag"
		multiple
		:localdata="mappedOptions"
		:map="mappedFields"
		:min="1"
		:max="3"
		label-class="demo-tag-label"
		text-class="demo-tag-text test-map-text"
	/>
	<text class="result-text result-standalone">当前值：{{ JSON.stringify(tagValue) }}</text>

	<text class="uni-h4">List 模式与图标位置</text>
	<text class="subsection-title">默认图标</text>
	<view class="list-frame">
		<uni-data-checkbox
			v-model="listValue"
			mode="list"
			:localdata="hobby"
			label-class="demo-list-label"
			text-class="demo-list-text"
			label-selected-class="demo-list-selected"
			icon-class="demo-right-icon"
		/>
	</view>

	<text class="subsection-title subsection-spaced">右侧对勾</text>
	<view class="list-frame">
		<uni-data-checkbox
			v-model="listRightValue"
			mode="list"
			icon="right"
			:localdata="hobby"
			label-class="demo-list-label"
			text-class="demo-list-text"
			label-selected-class="demo-list-selected"
			icon-class="demo-right-icon"
		/>
	</view>

	<text class="subsection-title subsection-spaced">左右对齐</text>
	<view class="list-frame">
		<uni-data-checkbox
			v-model="listAlignValue"
			mode="list"
			:localdata="alignOptions"
			label-class="demo-list-label demo-list-align"
			text-class="demo-list-text-align"
			label-selected-class="demo-list-selected"
			text-selected-class="demo-list-text-selected"
		/>
	</view>

	<text class="uni-h4">value 兼容属性</text>
	<text class="section-desc">不使用 v-model 时，可通过 value 传入当前值，并监听 update:modelValue 更新。</text>
	<uni-data-checkbox :value="compatValue" :localdata="sex" @update:modelValue="onCompatUpdate" />
	<text class="result-text result-standalone">当前值：{{ compatValue }}</text>

	<text class="uni-h4">checkbox-class 与 checkbox-selected-class</text>
	<text class="section-desc">external class 可分别定制原生选择控件与选中态控件。</text>
	<uni-data-checkbox
		v-model="controlClassValue"
		:localdata="hobby"
		multiple
		checkbox-class="demo-checkbox"
		checkbox-selected-class="demo-checkbox-selected"
	/>
	<text class="result-text result-standalone">当前值：{{ JSON.stringify(controlClassValue) }}</text>

	<text class="uni-h4">禁用状态与外部样式</text>
	<text class="section-desc">组合全局 disabled、数据项 disabled、min/max 与 external class。</text>
	<uni-data-checkbox
		v-model="disabledValues"
		multiple
		:localdata="disabledOptions"
		:min="1"
		:max="2"
		disabled
		empty-text="暂无可选数据"
		empty-text-class="demo-empty-text"
		label-class="demo-inline-label"
		label-selected-class="test-default-selected"
	/>
	<text class="result-text result-standalone">当前值：{{ JSON.stringify(disabledValues) }}</text>

	<text class="uni-h4">云端数据与 datacom 参数</text>
	<text class="section-desc">不传 localdata 并设置 collection 后使用 uniCloud 数据，可通过 field、where、orderby、分页、树形等参数查询。需关联服务空间。</text>
	<uni-data-checkbox
		ref="cloudCheckbox"
		collection="opendb-city-china"
		field="code as value, name as text"
		where="eq(type, 2)"
		orderby="value asc"
		:page-size="50"
		:page-current="1"
		:getcount="true"
		:gettree="false"
		:gettreepath="false"
		startwith=""
		:limitlevel="10"
		groupby=""
		group-field=""
		:distinct="false"
		action=""
		:options="{}"
		:manual="false"
		empty-text="暂无城市数据"
		@change="onChange"
	/>
	<view class="btn-row">
		<button class="demo-btn" size="mini" @click="loadCloudData">loadData</button>
		<button class="demo-btn" size="mini" @click="refreshCloudData">refresh</button>
		<button class="demo-btn" size="mini" @click="clearCloudData">clear</button>
	</view>
</template>

<script setup lang="ts">
const sex = [
	{ text: '男', value: 0 },
	{ text: '女', value: 1 },
	{ text: '未知', value: 2 }
]
const hobby = reactive([
	{ text: '足球', value: 0 },
	{ text: '篮球', value: 1 },
	{ text: '游泳', value: 2 }
])
const buttonOptions = [
	{ text: '选项一', value: 'normal' },
	{ text: '选项二', value: 'other' },
	{ text: '选项三', value: 'third' }
]
const mappedOptions = [
	{ name: '流行', code: 'pop', label: 'POP', id: 'p' },
	{ name: '摇滚', code: 'rock', label: 'ROCK', id: 'r' },
	{ name: '爵士', code: 'jazz', label: 'JAZZ', id: 'j' },
	{ name: '蓝调', code: 'blues', label: 'BLUES', id: 'b' },
	{ name: '古典', code: 'classic', label: 'CLASSIC', id: 'c' }
]
const disabledOptions = [
	{ text: '固定选中', value: 'fixed', selected: true },
	{ text: '不可用', value: 'unavailable', disabled: true },
	{ text: '普通选项', value: 'available' }
]

const sexValue = ref(0)
const sexMultiValue = ref([1])
const sexMultiMaxValue = ref([])
const hobbyMore = [
	{ text: '足球', value: 0 },
	{ text: '篮球', value: 1 },
	{ text: '游泳', value: 2 },
	{ text: '乒乓球', value: 3 },
	{ text: '羽毛球', value: 4 },
	{ text: '网球', value: 5, disable: true }
]
const buttonValue = ref('normal')
const tagValue = ref(['pop'])
const listValue = ref(1)
const listRightValue = ref(1)
const alignOptions = [
	{ text: '50毫秒', value: 50 },
	{ text: '200毫秒', value: 200 },
	{ text: '400毫秒', value: 400 }
]
const listAlignValue = ref(200)
const disabledValues = ref([])
const compatValue = ref(0)
const controlClassValue = ref([1])
const cloudCheckbox = ref<any>(null)
const mappedFields = reactive({ text: 'name', value: 'code' })
const latestEvent = ref('未触发')
const latestMultiEvent = ref('未触发')

const onUpdate = (event) => {
	latestEvent.value = 'update:modelValue：' + JSON.stringify(event)
	console.log('onUpdate:', event)
}
const onChange = (event) => {
	const detail = event.detail
	const dataCount = Array.isArray(detail.data) ? detail.data.length : (detail.data != null ? 1 : 0)
	latestEvent.value = 'change：' + JSON.stringify(detail.value) + '，data 条数：' + dataCount
	console.log('onChange:', event)
}
const onCompatUpdate = (event) => {
	compatValue.value = event
}
const onMultiUpdate = (event) => {
	latestMultiEvent.value = 'update:modelValue：' + JSON.stringify(event)
	console.log('onMultiUpdate:', event)
}
const onMultiChange = (event) => {
	const detail = event.detail
	latestMultiEvent.value = 'change：' + JSON.stringify(detail.value) + '，data 条数：' + detail.data.length
	console.log('onMultiChange:', event)
}

function loadCloudData() : void {
	cloudCheckbox.value?.loadData()
}

function refreshCloudData() : void {
	cloudCheckbox.value?.refresh()
}

function clearCloudData() : void {
	cloudCheckbox.value?.clear()
}

const clearDisabledValues = () => {
	disabledValues.value = []
}

const updateFirstHobby = () => {
	hobby[0].text = '足球（已更新）'
}

const useAlternateMap = () => {
	mappedFields.text = 'label'
	mappedFields.value = 'id'
}

defineExpose({
	clearDisabledValues,
	updateFirstHobby,
	useAlternateMap
})
</script>

<style>
page {
	--background-color: #f5f5f5;
	--active-background-color: #f8f8f8;
	--text-color: #333333;
	--tips-color: #0958d9;
	--tips-background-color: #e6f4ff;
	--content-background-color: #ffffff;
	--secondary-text-color: #657180;
	--input-border-color: #dcdfe6;
	--divider-color: #e5e5e5;
	--data-checkbox-demo-error-color: #dd524d;
	padding: 12px;
	background-color: var(--background-color);
}

.intro {
	padding: 4px;
	margin-bottom: 12px;
}

.page-title {
	font-size: 18px;
	font-weight: bold;
	color: var(--text-color, #222222);
}

.page-desc {
	margin-top: 6px;
	font-size: 13px;
	line-height: 20px;
	color: var(--secondary-text-color, #657180);
}

.section-desc {
	margin-top: 4px;
	margin-bottom: 8px;
	font-size: 13px;
	line-height: 20px;
	color: var(--secondary-text-color, #657180);
}

.subsection-title {
	margin-top: 12px;
	margin-bottom: 8px;
	font-size: 13px;
	font-weight: bold;
	color: var(--secondary-text-color, #657180);
}

.subsection-spaced {
	margin-top: 18px;
}

.result-block,
.result-standalone {
	margin-top: 10px;
}

.result-block {
	flex-direction: column;
}

.result-text,
.event-text {
	font-size: 13px;
	line-height: 20px;
	color: var(--secondary-text-color, #657180);
}

.event-text {
	margin-top: 2px;
}

.list-frame {
	margin-bottom: 12px;
	border-width: 1px;
	border-style: solid;
	border-color: var(--divider-color, #e2e5e9);
	border-radius: 6px;
	overflow: hidden;
}

.demo-inline-label {
	margin-right: 20px;
	margin-bottom: 8px;
}

.demo-tag-label {
	margin-right: 8px;
	margin-bottom: 8px;
	border-radius: 6px;
}

.demo-tag-text {
	font-size: 14px;
}

.demo-list-label {
	padding-left: 12px;
	padding-right: 12px;
}

.demo-list-text {
	flex: 1;
}

.demo-list-align {
	justify-content: space-between;
}

.demo-list-text-align {
	flex: 1;
	text-align: right;
}

.demo-list-selected {
	background-color: var(--active-background-color, #f2f7ff);
}

.demo-list-text-selected {
	color: var(--tips-color, #007aff);
}

.demo-right-icon {
	width: 7px;
	height: 13px;
}

.demo-empty-text {
	color: var(--data-checkbox-demo-error-color, #dd524d);
}

.demo-checkbox {
	transform: scale(1.1);
}

.demo-checkbox-selected {
	transform: scale(1.15);
}

.btn-row {
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 12px;
}

.demo-btn {
	margin-right: 8px;
	margin-bottom: 8px;
}

@media (prefers-color-scheme: dark) {
	page {
		--background-color: #1a1a1a;
		--active-background-color: #3b3b3b;
		--text-color: #ffffff;
		--tips-color: #91caff;
		--tips-background-color: #0b1b3a;
		--content-background-color: #2d2d2d;
		--secondary-text-color: rgba(255, 255, 255, 0.65);
		--input-border-color: rgba(255, 255, 255, 0.18);
		--divider-color: rgba(255, 255, 255, 0.12);
		--data-checkbox-demo-error-color: #ff7875;
	}
}
</style>
