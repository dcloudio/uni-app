					</view>
				</uni-forms-item>
			</uni-forms>
		</view>

		<view class="section">
			<text class="section-title">宽度</text>
			<text class="section-desc">没写宽度时，标签按文字排开。写了相同的 label-width，输入框左边缘才对齐。</text>
			<uni-forms border>
				<uni-forms-item label="是否阻止祖先节点出现点击态">
					<view class="trail">
						<switch />
					</view>
				</uni-forms-item>
			</uni-forms>
			<text class="sub-title">label-width="70"</text>
			<uni-forms border>
				<uni-forms-item label="是否阻止祖先节点出现点击态" label-width="70">
					<view class="trail">
						<switch />
					</view>
				</uni-forms-item>
			</uni-forms>
			<text class="sub-title">label-width="96"</text>
			<uni-forms border>
				<uni-forms-item label="用户名" label-width="96">
					<view class="trail">
						<input class="field" placeholder-class="field-placeholder" placeholder="请输入用户名" />
					</view>
				</uni-forms-item>
				<uni-forms-item label="邮箱地址" label-width="96">
					<view class="trail">
						<input class="field" placeholder-class="field-placeholder" placeholder="请输入邮箱" />
					</view>
				</uni-forms-item>
			</uni-forms>
		</view>

		<view class="section">
			<text class="section-title">垂直对齐</text>
			<text class="section-desc">标签和右侧控件在同一行里垂直居中。有说明时，说明在标签下方，这一列仍和控件居中。</text>
			<uni-forms border>
				<uni-forms-item label="用户名">
					<view class="trail">
						<input class="field" placeholder-class="field-placeholder" placeholder="请输入用户名" />
					</view>
				</uni-forms-item>
				<uni-forms-item label="接收通知">
					<view class="trail">
						<switch />
					</view>
				</uni-forms-item>
				<uni-forms-item label="深色模式" description="跟随系统外观">
					<view class="trail">
						<switch />
					</view>
				</uni-forms-item>
			</uni-forms>
		</view>

		<view class="section">
			<text class="section-title">向右箭头</text>
			<text class="section-desc">箭头在行尾，留在这一行里面。开关控制「个人资料」那一行。</text>
			<uni-forms border>
				<uni-forms-item label="显示箭头">
					<view class="trail">
						<switch :checked="arrowOn" @change="onArrowChange" />
					</view>
				</uni-forms-item>
				<uni-forms-item label="个人资料" description="头像、昵称" :show-arrow="arrowOn">
					<view class="trail">
						<text class="value-text">已填写</text>
					</view>
				</uni-forms-item>
				<uni-forms-item label="语言" show-arrow>
					<view class="trail">
						<text class="value-text">简体中文</text>
					</view>
				</uni-forms-item>
				<uni-forms-item label="密码">
					<view class="trail">
						<input class="field" placeholder-class="field-placeholder" placeholder="请输入密码" />
					</view>
				</uni-forms-item>
			</uni-forms>
		</view>

		<view class="section">
			<text class="section-title">说明</text>
			<text class="section-desc">说明在标签下方，字更小、颜色更浅，本身不设宽度。邮箱那一行用 description-class 改成蓝色。</text>
			<uni-forms border>
				<uni-forms-item label="用户名" description="登录时使用">
					<view class="trail">
						<input class="field" placeholder-class="field-placeholder" placeholder="请输入用户名" />
					</view>
				</uni-forms-item>
				<uni-forms-item label="邮箱" description="用于找回密码" description-class="desc-custom">
					<view class="trail">
						<input class="field" placeholder-class="field-placeholder" placeholder="请输入邮箱" />
					</view>
				</uni-forms-item>
				<uni-forms-item label="点击态延迟" description="单位是毫秒" label-position="top">
					<view class="top-field">
						<slider class="slider" :min="50" :max="200" :step="50" show-value />
					</view>
				</uni-forms-item>
			</uni-forms>
		</view>

		<view class="section section-last">
			<text class="section-title">错误提示</text>
			<text class="section-desc">点校验。失败时 toast 只提示第一条，控件下面不写文案。没通过的表单项会套上红框。邮箱这一行用 error-class 改了边框颜色。</text>
			<uni-forms ref="errorFormRef" v-model="errorForm" :rules="errorRules" err-show-type="toast" label-width="80">
				<uni-forms-item name="name" label="用户名">
					<view class="trail">
						<input class="field" placeholder-class="field-placeholder" v-model="errorForm.name" placeholder="请输入用户名" />
					</view>
				</uni-forms-item>
				<uni-forms-item name="email" label="邮箱" error-class="email-error">
					<view class="trail">
						<input class="field" placeholder-class="field-placeholder" v-model="errorForm.email" placeholder="请输入邮箱" />
					</view>
				</uni-forms-item>
			</uni-forms>
			<view class="button-row">
				<button class="action-button" size="mini" @click="submitErrorForm">校验</button>
				<button class="action-button secondary-button" size="mini" @click="clearErrorForm">清除</button>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
	import { state } from '@/store/index.ts'

	const isDarkMode = computed((): boolean => state.isDarkMode)

	/**
	 * 暗黑模式下把导航栏改成深色，和其它表单示例一致。
	 */
	function syncNavigationBar(): void {
		// #ifdef APP
		const dark = isDarkMode.value
		uni.setNavigationBarColor({
			frontColor: dark ? '#ffffff' : '#000000',
			backgroundColor: dark ? '#1a1a1a' : '#efeff4'
		})
		// #endif
	}

	watch(isDarkMode, syncNavigationBar, { immediate: true })
	onShow(syncNavigationBar)

	const arrowOn = ref(true)
	const errorFormRef = ref<any>(null)
	const errorForm = ref({
		name: '',
		email: ''
	})
	const errorRules = {
		name: {
			label: '用户名',
			rules: [{ required: true, errorMessage: '请输入用户名' }]
		},
		email: {
			label: '邮箱',
			rules: [{ required: true, errorMessage: '请输入邮箱' }]
		}
	}

	/**
	 * 切换「个人资料」一行的向右箭头。
	 * @param event 开关变更事件，detail.value 为当前是否打开
	 */
	function onArrowChange(event : UniSwitchChangeEvent) : void {
		arrowOn.value = event.detail.value
	}

	/**
	 * 校验底部示例。失败时由组件 toast，并给出错项加红框。
	 */
	function submitErrorForm() : void {
		errorFormRef.value.validate().catch(() : void => {})
	}

	/**
	 * 清掉底部示例的红框。
	 */
	function clearErrorForm() : void {
		errorFormRef.value.clearValidate()
	}
</script>

<style>
