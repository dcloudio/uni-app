			<text class="card-group">分组标题</text>
			<uni-forms label-width="80">
				<view class="demo-card demo-card-color">
					<uni-forms-item label="用户名" label-class="card-label" class="card-line">
						<input placeholder="请输入用户名" />
					</uni-forms-item>
					<uni-forms-item label="密码" label-class="card-label">
						<input placeholder="请输入密码" />
					</uni-forms-item>
				</view>
			</uni-forms>
		</view>

		<view class="section">
			<text class="section-title">字号</text>
			<text class="section-desc">左侧标签不写字号，应和「默认字号」一样大。标签在上方时固定 14px。</text>
			<view class="sample-row">
				<text class="sample-name">默认字号</text>
