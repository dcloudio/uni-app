<template>
	<scroll-view class="flex-1 bg-page-f5f5f5 page" :class="{ 'page-dark': isDarkMode }">
		<view class="u-p-16 bg-content-background-fff intro">
			<text class="fw-bold color-text-222 fs-18 page-title">Valibot Standard Schema</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 page-desc">本页默认引用页面同级的本地 Valibot 1.5.0 运行时创建 schema，再通过 uni-forms 的 schema 属性接入；业务项目可以改用 npm 安装。legacy validate.js 示例仍在“完整校验”页面。</text>
		</view>

		<view class="u-p-16 bg-content-background-fff mt-10 section setup-section">
			<text class="fw-bold color-text-222 mb-12 fs-16 section-title">1. 引入与 schema 组成</text>
			<text class="code-text">import * as v from './valibot-local.mjs'</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">schema 可以组合 string、number、boolean、picklist、array、object、optional、union 和 pipe。Valibot 会通过 ~standard.validate 暴露给 uni-forms。</text>
			<text class="code-text">const schema = v.object({ profile, role, tags, contact })</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">本页的表单覆盖嵌套对象、数组路径、可选字段、联合类型和跨字段确认密码。</text>
		</view>

		<view class="u-p-16 bg-content-background-fff mt-10 section">
			<text class="fw-bold color-text-222 mb-12 fs-16 section-title">2. 同步 schema 表单</text>
			<uni-forms
				ref="formRef"
				v-model="formData"
				:schema="profileSchema"
				validate-trigger="submit"
				err-show-type="undertext"
				label-position="left"
				label-width="112"
				border
				@validate="onValidate"
			>
				<uni-forms-item name="username" label="用户名" required label-class="demo-label" error-message-class="demo-error">
					<uni-easyinput v-model="formData.username" placeholder="3-16 个字符" clearable />
				</uni-forms-item>

				<uni-forms-item name="email" label="邮箱" required label-class="demo-label" error-message-class="demo-error">
					<uni-easyinput v-model="formData.email" placeholder="name@example.com" />
				</uni-forms-item>

				<uni-forms-item name="password" label="密码" required label-class="demo-label" error-message-class="demo-error">
					<uni-easyinput v-model="formData.password" type="password" placeholder="至少 8 位" />
				</uni-forms-item>

				<uni-forms-item name="confirmPassword" label="确认密码" required label-class="demo-label" error-message-class="demo-error">
					<uni-easyinput v-model="formData.confirmPassword" type="password" placeholder="需要与密码一致" />
				</uni-forms-item>

				<uni-forms-item name="profile.age" label="年龄" required label-class="demo-label" error-message-class="demo-error">
					<input class="flex-1 w-full fs-14 color-text-333 box-border-box min-h-38 p-0-10 border-width-1 border-style-solid border-color-input-border-d8dfe8 radius-4 native-input" type="number" v-model="ageInput" placeholder="18-120" :adjust-position="false" @input="onAgeInput" />
				</uni-forms-item>

				<uni-forms-item name="profile.bio" label="个人简介" label-class="demo-label" error-message-class="demo-error">
					<textarea class="flex-1 w-full fs-14 color-text-333 box-border-box min-h-38 p-0-10 border-width-1 border-style-solid border-color-input-border-d8dfe8 radius-4 native-textarea" v-model="formData.profile.bio" placeholder="可选；会先 trim 再校验" />
				</uni-forms-item>

				<uni-forms-item name="role" label="角色枚举" required label-class="demo-label" error-message-class="demo-error">
					<view class="flex-dir-row flex-wrap-wrap choice-list">
						<view v-for="item in roleOptions" :key="item.value" class="choice-item" :class="formData.role == item.value ? 'choice-active' : ''" @click="formData.role = item.value">
							<text class="choice-text">{{ item.label }}</text>
						</view>
					</view>
				</uni-forms-item>

				<uni-forms-item name="tags" label="标签数组" required label-class="demo-label" error-message-class="demo-error">
					<view class="flex-dir-row flex-wrap-wrap choice-list">
						<view v-for="tag in tagOptions" :key="tag" class="choice-item" :class="formData.tags.indexOf(tag) >= 0 ? 'choice-active' : ''" @click="toggleTag(tag)">
							<text class="choice-text">{{ tag }}</text>
						</view>
					</view>
				</uni-forms-item>

				<uni-forms-item name="termsAccepted" label="布尔同意项" required label-class="demo-label" error-message-class="demo-error">
					<switch :checked="formData.termsAccepted" @change="onTermsChange" />
				</uni-forms-item>

				<uni-forms-item name="contact.value" label="联系信息" required label-class="demo-label" error-message-class="demo-error">
					<uni-easyinput v-model="formData.contact.value" :placeholder="formData.contact.kind == 'email' ? '邮箱格式' : '手机号格式'" />
				</uni-forms-item>
			</uni-forms>

			<view class="flex-dir-row flex-wrap-wrap button-grid">
				<button class="mr-10 color-fff bg-007aff action-button" size="mini" @click="validateForm">uni-forms.validate</button>
				<button class="mr-10 color-fff bg-007aff action-button" size="mini" @click="validateField">validateField（legacy）</button>
				<button class="mr-10 color-fff bg-007aff color-text-333 bg-active-e9eef5 action-button secondary-button" size="mini" @click="clearForm">clearValidate</button>
				<button class="mr-10 color-fff bg-007aff color-text-333 bg-active-e9eef5 action-button secondary-button" size="mini" @click="resetForm">resetFields</button>
			</view>
			<text class="mt-8 fs-14 color-007aff status-text">{{ statusText }}</text>
			<text class="data-text">当前模型：{{ dataText }}</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 hint-text">兼容边界：validateField 只执行指定字段的 legacy rules；表级 Valibot schema 请使用 uni-forms.validate，或直接使用下方 safeParse。</text>
		</view>

		<view class="u-p-16 bg-content-background-fff mt-10 section">
			<text class="fw-bold color-text-222 mb-12 fs-16 section-title">3. 联合类型和跨字段规则</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">contact 使用 variant('kind', ...)：kind 为 email 时按邮箱校验，kind 为 phone 时按手机号校验。修改联系类型后，下面的值会按另一条分支解释。</text>
			<view class="flex-dir-row flex-wrap-wrap choice-list">
				<view class="choice-item" :class="formData.contact.kind == 'email' ? 'choice-active' : ''" @click="changeContactKind('email')"><text class="choice-text">email 分支</text></view>
				<view class="choice-item" :class="formData.contact.kind == 'phone' ? 'choice-active' : ''" @click="changeContactKind('phone')"><text class="choice-text">phone 分支</text></view>
			</view>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">确认密码使用 forward(check(...), ['confirmPassword'])，所以错误会映射回确认密码字段，而不是只显示表单级错误。</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">profile.age、profile.bio 和 contact.value 展示了 Standard Schema 的嵌套 path 到 uni-forms-item name 的映射。</text>
		</view>

		<view class="u-p-16 bg-content-background-fff mt-10 section">
			<text class="fw-bold color-text-222 mb-12 fs-16 section-title">4. 异步 schema 与唯一性校验</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">asyncSchema 使用 checkAsync 模拟服务端唯一性查询。输入 taken 会失败，输入其它非空用户名会通过。</text>
			<uni-forms ref="asyncFormRef" v-model="asyncData" :schema="asyncSchema" err-show-type="undertext" label-position="left" label-width="112" border>
				<uni-forms-item name="username" label="异步用户名" required label-class="demo-label" error-message-class="demo-error">
					<uni-easyinput v-model="asyncData.username" placeholder="taken 表示已被占用" />
				</uni-forms-item>
			</uni-forms>
			<view class="flex-dir-row flex-wrap-wrap button-grid">
				<button class="mr-10 color-fff bg-007aff action-button" size="mini" @click="validateAsyncForm">校验 asyncSchema</button>
				<button class="mr-10 color-fff bg-007aff color-text-333 bg-active-e9eef5 action-button secondary-button" size="mini" @click="runSafeParseAsync">safeParseAsync</button>
			</view>
			<text class="mt-8 fs-14 color-007aff status-text">{{ asyncStatusText }}</text>
		</view>

		<view class="u-p-16 bg-content-background-fff mt-10 section">
			<text class="fw-bold color-text-222 mb-12 fs-16 section-title">5. Valibot 原生 API 对照</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">safeParse 不抛异常，适合按钮预览和实时提示；parse 校验失败会抛出 ValiError；safeParseAsync 适合异步 schema。</text>
			<view class="flex-dir-row flex-wrap-wrap button-grid">
				<button class="mr-10 color-fff bg-007aff action-button" size="mini" @click="runSafeParse">safeParse</button>
				<button class="mr-10 color-fff bg-007aff action-button" size="mini" @click="runParse">parse / catch</button>
				<button class="mr-10 color-fff bg-007aff action-button" size="mini" @click="runOptional">optional / default</button>
				<button class="mr-10 color-fff bg-007aff action-button" size="mini" @click="runTransform">查看 transform 输出</button>
			</view>
			<text class="mt-8 fs-14 color-007aff status-text">{{ apiStatusText }}</text>
			<text class="data-text">schema 校验输出：{{ parsedText }}</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 hint-text">transform 只展示 Valibot 的 output；uni-forms 不会把 transform 自动写回 formData，这样可以保持旧版 validate 返回值语义稳定。</text>
		</view>

		<view class="u-p-16 bg-content-background-fff mt-10 pb-32 section section-last">
			<text class="fw-bold color-text-222 mb-12 fs-16 section-title">6. 选择方案</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">Schema2code：使用 :rules，兼容 datacom、DB Schema 和原版 validate.js。</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">Valibot：本示例使用页面同级的本地副本，避免示例工程必须先安装依赖；业务侧推荐通过 npm 安装并从 valibot 导入，使用 :schema。uni-forms 只依赖 Standard Schema，不绑定 Valibot 私有 API。</text>
			<text class="fs-13 lh-21 color-secondary-text-657180 body-text">迁移期：rules 和 schema 可以同时传入；整表校验会合并两套结果，旧字段规则不会被 Valibot 改写。</text>
			<text class="code-text"># 业务项目（推荐）
npm install valibot
import * as v from 'valibot'</text>
			<text class="data-text">最近一次 validate 结果：{{ resultText }}</text>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
import { state } from '@/store/index.ts'
import * as v from './valibot-local.mjs'

const isDarkMode = computed((): boolean => state.isDarkMode)

/** 暗黑模式下同步导航栏颜色，与图标示例页保持一致 */
function syncNavigationBar(): void {
	// #ifdef APP
	const dark = isDarkMode.value
	uni.setNavigationBarColor({
		frontColor: dark ? '#ffffff' : '#000000',
		backgroundColor: dark ? '#1a1a1a' : '#efeff4'
	})
	// #endif
}

watch(isDarkMode, syncNavigationBar, { immediate: true })
onShow(syncNavigationBar)


type ContactKind = 'email' | 'phone'
type Role = 'admin' | 'editor' | 'viewer'

type FormData = {
	username: string,
	email: string,
	password: string,
	confirmPassword: string,
	profile: {
		age: number | null,
		bio?: string
	},
	role: Role | '',
	tags: string[],
	termsAccepted: boolean,
	contact: {
		kind: ContactKind,
		value: string
	}
}

const roleOptions : { label: string, value: Role }[] = [
	{ label: '管理员', value: 'admin' },
	{ label: '编辑', value: 'editor' },
	{ label: '访客', value: 'viewer' }
]
const tagOptions : string[] = ['uni-app', '表单', '跨端', 'Valibot']

const formRef = ref<any>(null)
const asyncFormRef = ref<any>(null)
const formData = ref<FormData>({
	username: '',
	email: '',
	password: '',
	confirmPassword: '',
	profile: { age: null, bio: '' },
	role: '',
	tags: [],
	termsAccepted: false,
	contact: { kind: 'email', value: '' }
})
const asyncData = ref<{ username: string }>({ username: '' })
const ageInput = ref<string>('')
const statusText = ref<string>('等待 uni-forms 校验')
const asyncStatusText = ref<string>('等待异步校验')
const apiStatusText = ref<string>('等待原生 API 调用')
const parsedText = ref<string>('无')
const resultText = ref<string>('无')
const dataText = computed<string>(() : string => JSON.stringify(formData.value))

const profileSchema = v.pipe(
	v.object({
		username: v.pipe(v.string('用户名必须是文本'), v.nonEmpty('请输入用户名'), v.minLength(3, '用户名至少 3 个字符'), v.maxLength(16, '用户名最多 16 个字符')),
		email: v.pipe(v.string(), v.nonEmpty('请输入邮箱'), v.email('请输入正确的邮箱')),
		password: v.pipe(v.string(), v.minLength(8, '密码至少 8 位'), v.regex(/[A-Za-z]/, '密码需要包含字母'), v.regex(/[0-9]/, '密码需要包含数字')),
		confirmPassword: v.string(),
		profile: v.object({
			age: v.pipe(v.number('年龄必须是数字'), v.integer('年龄必须是整数'), v.minValue(18, '年龄不能小于 18'), v.maxValue(120, '年龄不能大于 120')),
			bio: v.optional(v.pipe(v.string(), v.trim(), v.maxLength(80, '简介最多 80 个字符'), v.transform((value: string) => value)))
		}),
		role: v.picklist(['admin', 'editor', 'viewer'] as const, '请选择角色'),
		tags: v.pipe(v.array(v.pipe(v.string(), v.minLength(2, '标签至少 2 个字符'))), v.minLength(1, '至少选择一个标签')),
		termsAccepted: v.literal(true, '请先同意服务条款'),
		contact: v.variant('kind', [
			v.object({ kind: v.literal('email'), value: v.pipe(v.string(), v.nonEmpty('请输入联系邮箱'), v.email('联系邮箱格式不正确')) }),
			v.object({ kind: v.literal('phone'), value: v.pipe(v.string(), v.regex(/^1[3-9][0-9]{9}$/, '请输入 11 位手机号')) })
		])
	}),
	v.forward(v.check((value: { password: string, confirmPassword: string }) => value.password == value.confirmPassword, '两次输入的密码不一致'), ['confirmPassword'])
)

const asyncSchema = v.pipeAsync(
	v.object({ username: v.pipe(v.string(), v.nonEmpty('请输入异步用户名'), v.minLength(3, '用户名至少 3 个字符')) }),
	v.forwardAsync(v.checkAsync(async (value: { username: string }) => {
		await new Promise((resolve) => setTimeout(resolve, 180))
		return value.username != 'taken'
	}, '用户名已被占用'), ['username'])
)

const transformSchema = v.pipe(v.string(), v.trim(), v.transform((value: string) => value.toUpperCase()))
const optionalSchema = v.object({ nickname: v.optional(v.pipe(v.string(), v.trim()), '匿名用户') })

function onAgeInput(event : any) {
	const value = event?.detail?.value ?? ''
	ageInput.value = value.toString()
	formData.value.profile.age = value == '' ? null : Number(value)
}

function toggleTag(tag : string) {
	const next = formData.value.tags.slice()
	const index = next.indexOf(tag)
	if (index >= 0) {
		next.splice(index, 1)
	} else {
		next.push(tag)
	}
	formData.value.tags = next
}

function onTermsChange(event : any) {
	formData.value.termsAccepted = Boolean(event?.detail?.value)
}

function changeContactKind(kind : ContactKind) {
	formData.value = {
		...formData.value,
		contact: { kind, value: '' }
	}
}

async function validateForm() {
	uni.hideKeyboard()
	try {
		const data = await formRef.value.validate()
		statusText.value = 'uni-forms.validate 通过'
		resultText.value = JSON.stringify(data)
	} catch (errors) {
		const list = errors as any[]
		statusText.value = list != null && list.length > 0 ? list[0].errorMessage : '校验未通过'
		resultText.value = JSON.stringify(errors)
	}
}

async function validateField() {
	try {
		await formRef.value.validateField(['email', 'profile.age'])
		statusText.value = 'validateField（legacy）：邮箱和年龄通过'
	} catch (errors) {
		const list = errors as any[]
		statusText.value = list != null && list.length > 0 ? 'validateField（legacy）：' + list[0].errorMessage : '字段校验未通过'
	}
}

function clearForm() {
	formRef.value.clearValidate()
	statusText.value = '已清除字段错误'
}

function resetForm() {
	formRef.value.resetFields()
	ageInput.value = ''
	statusText.value = '已恢复挂载时快照'
}

async function validateAsyncForm() {
	try {
		await asyncFormRef.value.validate()
		asyncStatusText.value = 'asyncSchema 校验通过'
	} catch (errors) {
		const list = errors as any[]
		asyncStatusText.value = list != null && list.length > 0 ? list[0].errorMessage : '异步校验未通过'
	}
}

async function runSafeParseAsync() {
	const result = await v.safeParseAsync(asyncSchema, asyncData.value)
	if (result.success) {
		asyncStatusText.value = 'safeParseAsync 成功：' + JSON.stringify(result.output)
	} else {
		asyncStatusText.value = 'safeParseAsync 失败：' + result.issues[0].message
	}
}

function runSafeParse() {
	const result = v.safeParse(profileSchema, formData.value)
	if (result.success) {
		apiStatusText.value = 'safeParse 成功，不抛异常'
		parsedText.value = JSON.stringify(result.output)
	} else {
		apiStatusText.value = 'safeParse 失败：' + result.issues.length + ' 个问题'
		parsedText.value = JSON.stringify(result.issues)
	}
}

function runParse() {
	try {
		const output = v.parse(profileSchema, formData.value)
		apiStatusText.value = 'parse 成功：' + JSON.stringify(output)
		parsedText.value = JSON.stringify(output)
	} catch (error) {
		const valiError = error as any
		apiStatusText.value = 'parse 捕获 ValiError：' + (valiError.issues?.length ?? 0) + ' 个问题'
		parsedText.value = JSON.stringify(valiError.issues ?? error)
	}
}

function runTransform() {
	const result = v.safeParse(transformSchema, '  uni-forms  ')
	if (result.success) {
		apiStatusText.value = 'transform 成功，原值未被改写'
		parsedText.value = JSON.stringify({ input: '  uni-forms  ', output: result.output, model: formData.value.username })
	} else {
		apiStatusText.value = 'transform 校验失败'
		parsedText.value = JSON.stringify(result.issues)
	}
}

function runOptional() {
	const missing = v.safeParse(optionalSchema, {})
	const provided = v.safeParse(optionalSchema, { nickname: '  uni-forms  ' })
	if (missing.success && provided.success) {
		apiStatusText.value = 'optional 成功：缺省值和输入值都通过'
		parsedText.value = JSON.stringify({ missing: missing.output, provided: provided.output })
	} else {
		apiStatusText.value = 'optional 校验失败'
		parsedText.value = JSON.stringify(missing.success ? provided.issues : missing.issues)
	}
}

function onValidate(result : any) {
	if (result == null) {
		return
	}
	const list = Array.isArray(result) ? result : [result]
	if (list.length > 0) {
		statusText.value = list[0].errorMessage
	}
}

watch(() : number | null => formData.value.profile.age, (value : number | null) => {
	const nextValue = value == null ? '' : value.toString()
	if (ageInput.value != nextValue) {
		ageInput.value = nextValue
	}
})

defineExpose({ formData, validateForm, validateAsyncForm, runSafeParse })
</script>

<style>
.section-title {
	margin-bottom: 10px;
}

.body-text {
	margin-bottom: 8px;
}

.code-text {
	margin: 5px 0;
	padding: 8px;
	font-family: monospace;
	font-size: 12px;
	line-height: 18px;
	color: var(--tips-color, #245b8f);
	background-color: var(--tips-background-color, #f1f6fb);
	border-radius: 4px;
}

.native-textarea {
	min-height: 76px;
	padding: 8px 10px;
}

.choice-item {
	padding: 7px 12px;
	margin: 0 8px 8px 0;
	border-radius: 14px;
	background-color: var(--active-background-color, #eef2f7);
}

.choice-active {
	background-color: var(--tips-background-color, #d9edff);
}

.choice-text {
	font-size: 13px;
	color: var(--text-color, #3b4b5d);
}

.button-grid {
	margin-top: 10px;
}

.action-button {
	width: 48%;
	margin: 0 2% 8px 0;
}

.status-text {
	margin-top: 5px;
	line-height: 21px;
}

.data-text,
.hint-text {
	margin-top: 8px;
	font-size: 12px;
	line-height: 20px;
}

.demo-label {
	font-weight: bold;
	color: #007aff;
}

.demo-error {
	font-weight: bold;
	color: #dd524d;
}
</style>
