.property-row {
	min-height: 30px;
	padding: 5px 0;
	flex-direction: row;
	justify-content: space-between;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: var(--divider-color, #eef1f5);
}

