<template>
	<scroll-view class="page" :class="{ 'page-dark': isDarkMode }">
		<view class="intro">
			<text class="page-title">样式与属性示例</text>
			<text class="page-desc">示例按移动端排列：标签在左，输入在右。label-width、label-align 和 border 调整这一行；标签、星号、错误文字用样式类覆盖。</text>
		</view>

		<view class="section property-section">
			<text class="section-title">属性对照</text>
			<view class="property-row"><text class="property-name">label-position</text><text class="property-value">left，移动端默认</text></view>
			<view class="property-row"><text class="property-name">label-width</text><text class="property-value">数字或 CSS 宽度</text></view>
			<view class="property-row"><text class="property-name">label-align</text><text class="property-value">left / center / right</text></view>
			<view class="property-row"><text class="property-name">border</text><text class="property-value">控制字段分隔线</text></view>
			<view class="property-row"><text class="property-name">class / style</text><text class="property-value">直接作用于 uni-forms 外层</text></view>
		</view>

		<view class="section">
			<text class="section-title">左侧标签</text>
			<uni-forms
				class="left-form-surface"
				style="border-radius: 8px;"
				v-model="leftForm"
				label-position="left"
				label-width="86"
				label-align="right"
				border
			>
				<uni-forms-item label="标题" name="title" required label-class="left-label" content-class="left-content">
					<uni-easyinput v-model="leftForm.title" placeholder="右对齐标签" />
				</uni-forms-item>
				<uni-forms-item label="说明" name="description" label-class="left-label" content-class="left-content">
					<uni-easyinput v-model="leftForm.description" placeholder="border 会显示字段分隔线" />
				</uni-forms-item>
			</uni-forms>
		</view>

		<view class="section section-last">
			<text class="section-title">左侧标签样式</text>
			<uni-forms
				ref="topFormRef"
				class="theme-form-surface"
				style="padding: 12px; border-radius: 8px;"
				v-model="topForm"
				:rules="topRules"
				label-position="left"
				label-width="80"
				label-align="left"
				err-show-type="undertext"
			>
				<uni-forms-item
					name="account"
					label="账号"
					required
					label-class="theme-label"
					required-class="theme-required"
					error-message-class="theme-error"
				>
					<uni-easyinput v-model="topForm.account" placeholder="观察标签、必填星号和错误文字颜色" />
				</uni-forms-item>
				<uni-forms-item
					name="phone"
					label="手机号"
					label-class="theme-label"
					error-message-class="theme-error"
				>
					<uni-easyinput v-model="topForm.phone" placeholder="错误样式由 externalClasses 控制" />
				</uni-forms-item>
			</uni-forms>

			<view class="button-row">
				<button class="action-button" size="mini" @click="validateTopForm">显示错误样式</button>
				<button class="action-button secondary-button" size="mini" @click="clearTopForm">清除错误</button>
			</view>
			<text class="status-text">{{ statusText }}</text>
			<text class="class-list">本例使用 label-class、required-class、error-message-class。上一例另外使用 content-class。</text>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
import { state } from '@/store/index.ts'

const isDarkMode = computed((): boolean => state.isDarkMode)

/** 暗黑模式下同步导航栏颜色，与图标示例页保持一致 */
function syncNavigationBar(): void {
	// #ifdef APP || WEB
	const dark = isDarkMode.value
	uni.setNavigationBarColor({
		frontColor: dark ? '#ffffff' : '#000000',
		backgroundColor: dark ? '#1a1a1a' : '#efeff4'
	})
	// #endif
}

watch(isDarkMode, syncNavigationBar, { immediate: true })
onShow(syncNavigationBar)

const leftForm = ref({
	title: '',
	description: ''
})

const topForm = ref({
	account: '',
	phone: ''
})

const topFormRef = ref<any>(null)

const topRules = {
	account: { label: '账号', rules: [{ required: true, errorMessage: '请输入账号' }] },
	phone: { label: '手机号', rules: [{ pattern: '^1[3-9]\\d{9}$', errorMessage: '手机号格式不正确' }] }
}

const statusText = ref<string>('点击校验查看错误样式')

async function validateTopForm() {
	try {
		await topFormRef.value.validate()
		statusText.value = '校验通过'
	} catch (errors) {
		statusText.value = '错误样式已展示'
	}
}

function clearTopForm() {
	topFormRef.value.clearValidate()
	statusText.value = '已清除错误'
}
</script>

<style>
