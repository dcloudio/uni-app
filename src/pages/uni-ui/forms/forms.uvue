	flex-direction: row;
	flex-wrap: wrap;
}

.demo-link {
	width: 48%;
	padding: 12px;
	margin: 0 2% 10px 0;
	border-radius: 6px;
	background-color: var(--active-background-color, #f3f7fc);
	box-sizing: border-box;
	min-width: 0;
}

