	margin-top: 16px;
	border-top: 1px solid var(--divider-color, #e5e5e5);
}

.property-title {
	margin-bottom: 6px;
	font-size: 14px;
	font-weight: bold;
	color: var(--text-color, #333333);
}

.property-text {
	font-size: 12px;
	line-height: 20px;
	color: var(--secondary-text-color, #657180);
}

