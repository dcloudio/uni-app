  }

  .header {
    flex-direction: column;
    margin-bottom: 24px;
  }

  .eyebrow {
    color: #0F766E;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .title {
    color: #0F172A;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .subtitle {
    color: #64748B;
    font-size: 15px;
  }

  .chart-card {
    flex-direction: column;
    background-color: #FFFFFF;
    border-radius: 8px;
    padding: 12px;
  }

  .chart {
    height: 300px;
  }

  .action-button {
    background-color: #0F766E;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
    margin-top: 20px;
  }

  @media (prefers-color-scheme: dark) {
    .eyebrow {
      color: #5EEAD4;
    }

    .title {
      color: #F8FAFC;
    }

    .subtitle {
      color: #CBD5E1;
    }

    .chart-card {
      background-color: #1E293B;
    }
  }
</style>
