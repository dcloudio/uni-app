<template>
  <!-- #ifdef APP -->
  <scroll-view class="page-scroll">
  <!-- #endif -->
    <view class="page">
      <view class="hero-panel">
        <text class="hero-title">插屏海报示例</text>
        <text class="hero-desc">使用 page-container 实现一个居中的插屏海报。</text>
        <button class="hero-button" type="primary" @click="openPoster">打开插屏海报</button>
      </view>

      <page-container
        <!-- #ifdef MP -->
        v-if="showPoster"
        <!-- #endif -->
        :show="showPoster"
        position="center"
        :overlay="true"
        overlay-style="background-color: rgba(14, 20, 34, 0.68);"
        :custom-style="alignContainerStyle"
        @clickoverlay="closePoster"
        @afterenter="onPosterAfterEnterTest"
        @afterleave="onPosterAfterLeave">
        <scroll-view class="poster-scroll" :style="posterScrollStyle" @click="closePoster">
          <view class="poster-dialog" :style="posterDialogStyle">
            <!-- 阻止海报内部点击冒泡到透明区域，避免误触关闭弹层 -->
            <view class="poster-card" @click.stop>
              <view class="poster-top-strip"></view>

              <view class="poster-head">
                <text class="poster-badge">活动海报</text>
                <text class="poster-tag">INTERSTITIAL</text>
              </view>

              <view class="poster-body">
                <text class="poster-title">插屏海报</text>
                <text class="poster-subtitle">海报主体和底部关闭按钮都由多个 view 组合而成，其中关闭按钮的 X 使用两条旋转的 view 实现。</text>

                <view class="poster-highlight">
                  <text class="poster-highlight-label">示例内容</text>
                  <text class="poster-highlight-main">新人立减 X 元</text>
                  <text class="poster-highlight-note">支持标题、说明、主按钮与关闭交互组合展示</text>
                </view>

                <view class="poster-mock-art">
                  <view class="mock-card mock-card-main">
                    <text class="mock-card-title">POSTER</text>
                  </view>
                  <view class="mock-card mock-card-side"></view>
                  <view class="mock-line"></view>
                </view>

                <view class="poster-footer">
                  <button class="poster-action" type="primary" @click="closePoster">立即查看</button>
                  <text class="poster-footnote">活动说明：示例仅用于演示插屏布局与关闭交互</text>
                </view>
              </view>
            </view>

            <view class="poster-close-wrap" @click.stop="closePoster">
              <view class="poster-close-circle">
                <view class="poster-close-line poster-close-line-a"></view>
                <view class="poster-close-line poster-close-line-b"></view>
              </view>
            </view>
          </view>
        </scroll-view>
      </page-container>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="ts">
  /**
   * @description: 演示使用 `page-container` 实现居中的插屏海报弹层，海报主体与关闭按钮都由 `view` 组合完成。
   * @logic: 点击页面按钮后展示居中弹层，点击海报底部关闭按钮或遮罩层时关闭弹层，离场后同步重置显示状态。
   * @optimization: 将弹层的打开、关闭和离场收口为统一状态控制，保持交互简单并方便复用当前海报结构。
   */
  const showPoster = ref<boolean>(false)
  // 居中布局样式，为避免微信小程序端弹框不居中
  const alignContainerStyle = ref('display: flex; justify-content: center; background-color: transparent;')
  const posterScrollStyle = ref('')
  const posterDialogStyle = ref('')

  type TestData = {
    testPosterEnterCount : number
    testPosterLeaveCount : number
  }

  // 仅用于自动化测试：记录 page-container 生命周期，测试通过这些计数等待进入/离开动画完成，
  // 避免在 App 端依赖隐藏或退场中原生节点的查询时序。
  const testData = reactive<TestData>({
    testPosterEnterCount: 0,
    testPosterLeaveCount: 0
  })

  function updatePosterViewportStyle() {
    const height = Math.max(0, uni.getWindowInfo().windowHeight - 24)
    posterScrollStyle.value = `height: ${height}px;`
    posterDialogStyle.value = `min-height: ${height}px;`
  }

  function openPoster() {
    updatePosterViewportStyle()
    showPoster.value = true
  }

  function closePoster() {
    showPoster.value = false
  }

  // 自动化测试辅助
  function onPosterAfterEnterTest() {
    testData.testPosterEnterCount += 1
  }

  function onPosterAfterLeaveTest() {
    testData.testPosterLeaveCount += 1
  }

  function onPosterAfterLeave() {
    showPoster.value = false
    onPosterAfterLeaveTest()
  }

  onReady(() => {
    updatePosterViewportStyle()
  })

  onResize(() => {
    updatePosterViewportStyle()
  })

  // 暴露自动化测试辅助数据
  defineExpose({
    testData
  })
</script>

<style>
  .page-scroll {
    flex: 1;
  }

  .page {
    padding: 24px;
  }

  .hero-panel {
    display: flex;
    flex-direction: column;
