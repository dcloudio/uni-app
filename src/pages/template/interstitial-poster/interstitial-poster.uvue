    border-radius: 12px;
    background-color: var(--list-background-color, #ffffff);
  }

  .hero-title {
    color: var(--text-color, #333333);
    font-size: 24px;
    font-weight: 700;
  }

  .hero-desc {
    margin-top: 12px;
    color: var(--text-color, #666666);
    opacity: 0.75;
    font-size: 14px;
    line-height: 20px;
  }

  .hero-button {
    margin-top: 20px;
  }

  .poster-scroll {
    width: 100%;
  }

  .poster-dialog {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .poster-card {
    position: relative;
    width: 320px;
    padding: 18px;
    border-radius: 20px;
    border-width: 1px;
    border-style: solid;
    border-color: #e5e5e5;
    background-color: #ffffff;
    overflow: hidden;
  }

  .poster-top-strip {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background-color: #007aff;
  }

  .poster-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .poster-badge {
    margin-top: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background-color: #eef5ff;
    color: #007aff;
    font-size: 12px;
    font-weight: 700;
  }

  .poster-tag {
    margin-top: 6px;
    color: #999999;
    font-size: 11px;
    letter-spacing: 1px;
  }

  .poster-body {
    display: flex;
    flex-direction: column;
    margin-top: 14px;
  }

  .poster-title {
    color: #333333;
    font-size: 26px;
    font-weight: 700;
    line-height: 34px;
  }

  .poster-subtitle {
    margin-top: 10px;
    color: #666666;
    font-size: 14px;
    line-height: 20px;
  }

  .poster-highlight {
    display: flex;
    flex-direction: column;
    margin-top: 14px;
    padding: 14px;
    border-radius: 12px;
    background-color: #f8f8f8;
  }

  .poster-highlight-label {
    color: #007aff;
    font-size: 12px;
  }

  .poster-highlight-main {
    margin-top: 6px;
    color: #333333;
    font-size: 22px;
    font-weight: 700;
    line-height: 30px;
  }

  .poster-highlight-note {
    margin-top: 6px;
    color: #666666;
    font-size: 13px;
    line-height: 18px;
  }

  .poster-mock-art {
    position: relative;
    height: 126px;
    margin-top: 16px;
    border-radius: 12px;
    background-color: #f3f7ff;
    overflow: hidden;
  }

  .mock-card {
    position: absolute;
    border-radius: 12px;
  }

  .mock-card-main {
    top: 20px;
    left: 20px;
    width: 150px;
    height: 82px;
    padding-top: 50px;
    padding-left: 14px;
    background-color: #007aff;
  }

  .mock-card-title {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
  }

  .mock-card-side {
    top: 28px;
