    }

    .poster-tag,
    .poster-footnote {
      color: #b8b8b8;
    }

    .poster-title,
    .poster-highlight-main {
      color: #ffffff;
    }

    .poster-subtitle,
    .poster-highlight-note {
      color: #d0d0d0;
    }

    .poster-highlight {
      background-color: #3b3b3b;
    }

    .poster-highlight-label {
      color: #8fc2ff;
    }

    .poster-mock-art {
      background-color: #253247;
    }

    .mock-card-side,
    .mock-line {
      background-color: #496383;
    }
