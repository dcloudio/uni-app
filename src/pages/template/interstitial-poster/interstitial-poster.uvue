    text-align: center;
  }

  .poster-close-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 18px;
  }

  .poster-close-circle {
    position: relative;
    width: 42px;
    height: 42px;
    border-width: 1px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.9);
    border-radius: 42px;
    background-color: rgba(255, 255, 255, 0.18);
  }

  .poster-close-line {
    position: absolute;
    top: 20px;
    left: 11px;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background-color: #ffffff;
  }

  .poster-close-line-a {
    transform: rotate(45deg);
  }

  .poster-close-line-b {
    transform: rotate(-45deg);
  }

  @media (prefers-color-scheme: dark) {
    .poster-card {
      border-color: rgba(255, 255, 255, 0.16);
      background-color: #2d2d2d;
    }

    .poster-badge {
      background-color: #17345c;
