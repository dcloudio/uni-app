<template>
  <!-- #ifdef APP -->
  <scroll-view class="flex-1">
  <!-- #endif -->
    <view class="p-24">
      <view class="d-flex flex-dir-column radius-12 bg-list-fff p-24">
        <text class="color-text-333 fs-24 fw-700 hero-title">插屏海报示例</text>
        <text class="color-text-666 opacity-0_75 fs-14 lh-20 mt-12 hero-desc">使用 page-container 实现一个居中的插屏海报。</text>
        <button class="mt-20 hero-button" type="primary" @click="openPoster">打开插屏海报</button>
      </view>

      <page-container
        <!-- #ifdef MP -->
        v-if="showPoster"
        <!-- #endif -->
        :show="showPoster"
        position="center"
        :overlay="true"
        overlay-style="background-color: rgba(14, 20, 34, 0.68);"
        :custom-style="alignContainerStyle"
        @clickoverlay="closePoster"
        @afterenter="onPosterAfterEnterTest"
        @afterleave="onPosterAfterLeave">
        <scroll-view class="w-full" :style="posterScrollStyle" @click="closePoster">
          <view class="d-flex flex-dir-column items-center justify-center pt-12 pb-12" :style="posterDialogStyle">
            <!-- 阻止海报内部点击冒泡到透明区域，避免误触关闭弹层 -->
            <view class="pos-relative radius-20 border-width-1 border-style-solid overflow-hidden bg-fff poster-card w-320" @click.stop>
              <view class="pos-absolute top-0 right-0 h-6 bg-007aff left-0"></view>

              <view class="d-flex flex-dir-row items-center justify-between">
                <text class="mt-6 fs-12 fw-700 color-007aff poster-badge radius-999">活动海报</text>
                <text class="mt-6 fs-11 letter-spacing-1 color-999 poster-tag">INTERSTITIAL</text>
              </view>

              <view class="d-flex flex-dir-column mt-14">
                <text class="fs-26 fw-700 color-333 poster-title">插屏海报</text>
                <text class="mt-10 fs-14 lh-20 color-666 poster-subtitle">海报主体和底部关闭按钮都由多个 view 组合而成，其中关闭按钮的 X 使用两条旋转的 view 实现。</text>

                <view class="d-flex flex-dir-column mt-14 radius-12 p-14 poster-highlight bg-f8f8f8">
                  <text class="fs-12 color-007aff poster-highlight-label">示例内容</text>
                  <text class="mt-6 fs-22 fw-700 lh-30 color-333 poster-highlight-main">新人立减 X 元</text>
                  <text class="mt-6 fs-13 lh-18 color-666 poster-highlight-note">支持标题、说明、主按钮与关闭交互组合展示</text>
                </view>

                <view class="pos-relative mt-16 radius-12 overflow-hidden poster-mock-art">
                  <view class="pos-absolute radius-12 bg-007aff w-150 mock-card-main top-20 left-20">
                    <text class="color-fff fs-15 fw-700">POSTER</text>
                  </view>
                  <view class="pos-absolute radius-12 w-60 h-60 mock-card-side right-20 bg-dceaff"></view>
                  <view class="pos-absolute h-8 radius-10 mock-line right-20 bottom-18 left-20 bg-dceaff"></view>
                </view>

                <view class="d-flex flex-dir-column mt-16">
                  <button class="bg-007aff color-fff poster-action" type="primary" @click="closePoster">立即查看</button>
                  <text class="mt-10 fs-12 text-center color-999 poster-footnote">活动说明：示例仅用于演示插屏布局与关闭交互</text>
                </view>
              </view>
            </view>

            <view class="d-flex flex-dir-column items-center justify-center w-full mt-18 poster-close-wrap" @click.stop="closePoster">
              <view class="pos-relative w-42 border-width-1 border-style-solid h-42 poster-close-circle">
                <view class="pos-absolute w-20 u-h-2 radius-2 bg-fff poster-close-line transform-rotate-45deg top-20"></view>
                <view class="pos-absolute w-20 u-h-2 radius-2 bg-fff poster-close-line transform-rotate-neg45deg top-20"></view>
              </view>
            </view>
          </view>
        </scroll-view>
      </page-container>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="ts">
  /**
   * @description: 演示使用 `page-container` 实现居中的插屏海报弹层，海报主体与关闭按钮都由 `view` 组合完成。
   * @logic: 点击页面按钮后展示居中弹层，点击海报底部关闭按钮或遮罩层时关闭弹层，离场后同步重置显示状态。
   * @optimization: 将弹层的打开、关闭和离场收口为统一状态控制，保持交互简单并方便复用当前海报结构。
   */
  const showPoster = ref<boolean>(false)
  // 居中布局样式，为避免微信小程序端弹框不居中
  const alignContainerStyle = ref('display: flex; justify-content: center; background-color: transparent;')
  const posterScrollStyle = ref('')
  const posterDialogStyle = ref('')

  type TestData = {
    testPosterEnterCount : number
    testPosterLeaveCount : number
  }

  // 仅用于自动化测试：记录 page-container 生命周期，测试通过这些计数等待进入/离开动画完成，
  // 避免在 App 端依赖隐藏或退场中原生节点的查询时序。
  const testData = reactive<TestData>({
    testPosterEnterCount: 0,
    testPosterLeaveCount: 0
  })

  function updatePosterViewportStyle() {
    const height = Math.max(0, uni.getWindowInfo().windowHeight - 24)
    posterScrollStyle.value = `height: ${height}px;`
    posterDialogStyle.value = `min-height: ${height}px;`
  }

  function openPoster() {
    updatePosterViewportStyle()
    showPoster.value = true
  }

  function closePoster() {
    showPoster.value = false
  }

  // 自动化测试辅助
  function onPosterAfterEnterTest() {
    testData.testPosterEnterCount += 1
  }

  function onPosterAfterLeaveTest() {
    testData.testPosterLeaveCount += 1
  }

  function onPosterAfterLeave() {
    showPoster.value = false
    onPosterAfterLeaveTest()
  }

  onReady(() => {
    updatePosterViewportStyle()
  })

  onResize(() => {
    updatePosterViewportStyle()
  })

  // 暴露自动化测试辅助数据
  defineExpose({
    testData
  })
</script>

<style>
  .poster-card {
    padding: 18px;
    border-color: #e5e5e5;
  }

  .poster-badge {
    padding: 6px 12px;
    background-color: #eef5ff;
  }

  .poster-title {
    line-height: 34px;
  }

  .poster-mock-art {
    height: 126px;
    background-color: #f3f7ff;
  }

  .mock-card-main {
    height: 82px;
    padding-top: 50px;
    padding-left: 14px;
  }

  .mock-card-side {
    top: 28px;
  }

  .poster-action {
    border-color: #007aff;
  }

  .poster-close-circle {
    border-color: rgba(255, 255, 255, 0.9);
    border-radius: 42px;
    background-color: rgba(255, 255, 255, 0.18);
  }

  .poster-close-line {
    left: 11px;
  }

  @media (prefers-color-scheme: dark) {
    .poster-card {
      border-color: rgba(255, 255, 255, 0.16);
      background-color: #2d2d2d;
    }

    .poster-badge {
      background-color: #17345c;
      color: #8fc2ff;
    }

    .poster-tag,
    .poster-footnote {
      color: #b8b8b8;
    }

    .poster-title,
    .poster-highlight-main {
      color: #ffffff;
    }

    .poster-subtitle,
    .poster-highlight-note {
      color: #d0d0d0;
    }

    .poster-highlight {
      background-color: #3b3b3b;
    }

    .poster-highlight-label {
      color: #8fc2ff;
    }

    .poster-mock-art {
      background-color: #253247;
    }

    .mock-card-side,
    .mock-line {
      background-color: #496383;
    }
  }
</style>
