<template>
	<view class="theme-list-demo bg-list-demo-page-background flex-1 d-flex flex-dir-column min-h-0 p-12-12-0">
		<view class="d-flex flex-dir-column p-4-4-12">
			<text class="fs-20 fw-bold color-list-demo-title">Rich-text 撑高</text>
			<text class="mt-4 fs-12 color-list-demo-secondary">200 项 · key 唯一 · 富文本段落数不同</text>
		</view>

		<list-view id="item-list" class="flex-1 bg-list-demo-panel-background radius-6" show-scrollbar="false">
			<list-item v-for="item in items" :key="item.id" class="border-b-width-1 border-b-style-solid border-b-color-list-demo-border">
				<view class="d-flex flex-dir-column item-content">
					<view class="d-flex flex-dir-row items-center mb-8">
						<text class="d-flex flex-dir-column items-center justify-center bg-list-demo-badge-background fw-bold color-list-demo-badge w-24 h-24 radius-12 fs-12 text-center lh-24">{{item.id + 1}}</text>
						<text class="fs-15 fw-bold color-list-demo-title u-ml-10">{{item.title}}</text>
					</view>
					<rich-text class="fs-13 color-list-demo-text" :nodes="item.html" mode="native"></rich-text>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	type Item = {
		id: number
		title: string
		html: string
	}

	function createItems(): Item[] {
		const items: Item[] = []
		for (let index = 0; index < 200; index++) {
			const paragraphs = (index % 5) + 1
			let html = ''
			for (let p = 0; p < paragraphs; p++) {
				html += `<p>段落 ${p + 1}：由 rich-text 撑开高度，段落数不同则高度不同。</p>`
			}
			items.push({
				id: index,
				title: `条目 ${index + 1}`,
				html: html
			})
		}
		return items
	}

	const items = reactive(createItems())

	defineExpose({
		items
	})
</script>

<style>
	.item-content {
		padding: 10px 14px;
	}
</style>
