<template>
	<view class="theme-list-demo bg-list-demo-page-background flex-1 d-flex flex-dir-column min-h-0 p-12-12-0">
		<view class="d-flex flex-dir-column p-4-4-12">
			<text class="fs-20 fw-bold color-list-demo-title">出屏后高度变化</text>
			<text class="mt-4 fs-12 color-list-demo-secondary">200 项 · 切换内容后 item 高度变化</text>
			<button id="toggle-content" class="fs-13 toggle-button" type="primary" @click="toggleContent">
				{{expanded ? '收起内容' : '展开内容'}}
			</button>
		</view>

		<list-view id="item-list" class="flex-1 bg-list-demo-panel-background radius-6" show-scrollbar="false">
			<list-item v-for="item in items" :key="item.id" class="border-b-width-1 border-b-style-solid border-b-color-list-demo-border">
				<view class="d-flex flex-dir-column p-12-14">
					<view class="d-flex flex-dir-row items-center">
						<text class="d-flex flex-dir-column items-center justify-center bg-list-demo-badge-background fw-bold color-list-demo-badge w-24 h-24 radius-12 fs-12 text-center lh-24">{{item.id + 1}}</text>
						<text class="fs-15 fw-bold color-list-demo-title u-ml-10">{{item.title}}</text>
					</view>
					<text class="mt-8 fs-13 lh-22 color-list-demo-text" v-if="expanded">{{item.description}}</text>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	type Item = {
		id: number
		title: string
		description: string
	}

	function createItems(): Item[] {
		const items: Item[] = []
		for (let index = 0; index < 200; index++) {
			const lines = (index % 8) + 1
			let description = ''
			for (let line = 0; line < lines; line++) {
				description += `展开第 ${line + 1} 行：内容行数随 item 变化，展开后每个 item 高度不同。`
				if (line < lines - 1) {
					description += '\n'
				}
			}
			items.push({
				id: index,
				title: `条目 ${index + 1}`,
				description: description
			})
		}
		return items
	}

	const items = reactive(createItems())
	const expanded = ref(false)

	function toggleContent() {
		expanded.value = !expanded.value
	}

	defineExpose({
		items,
		expanded,
		toggleContent
	})
</script>

<style>
	.toggle-button {
		margin: 10px 0 0 0;
	}
</style>
