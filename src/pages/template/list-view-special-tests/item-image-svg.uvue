<template>
	<view class="theme-list-demo bg-list-demo-page-background flex-1 d-flex flex-dir-column min-h-0 p-12-12-0">
		<view class="d-flex flex-dir-column p-4-4-12">
			<text class="fs-20 fw-bold color-list-demo-title">Image (SVG) 撑高</text>
			<text class="mt-4 fs-12 color-list-demo-secondary">200 项 · key 唯一 · 每项 1-4 张随机乱序图片</text>
		</view>

		<list-view id="item-list" class="flex-1 bg-list-demo-panel-background radius-6" show-scrollbar="false" :scroll-anchoring="true">
			<list-item v-for="item in items" :key="item.id" class="border-b-width-1 border-b-style-solid border-b-color-list-demo-border">
				<view class="d-flex flex-dir-column p-10-12">
					<view class="d-flex flex-dir-row items-center mb-6">
						<text class="d-flex flex-dir-column items-center justify-center bg-list-demo-badge-background fw-bold color-list-demo-badge w-24 h-24 radius-12 fs-12 text-center lh-24">{{item.id + 1}}</text>
						<text class="fs-15 fw-bold color-list-demo-title u-ml-10">{{item.title}}</text>
					</view>
					<text class="fs-12 color-list-demo-secondary mb-8">{{item.summary}}</text>
					<image
						v-for="img in item.images"
						:key="img.key"
						class="radius-6 mb-6"
						:src="img.src"
						mode="widthFix"
						:style="{ width: img.width + 'px' }"
					></image>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	import { SeededRandom } from './SeededRandom.ts'

	type ImageItem = {
		key: string
		src: string
		width: number
	}

	type Item = {
		id: number
		title: string
		images: ImageItem[]
		summary: string
	}

	const random = new SeededRandom(1001)

	function createItems(): Item[] {
		const items: Item[] = []
		for (let index = 0; index < 200; index++) {
			const count = random.int(1, 4)
			const order = random.shuffle([1, 2, 3, 4]).slice(0, count)

			const images: ImageItem[] = []
			let widthText = ''
			for (let i = 0; i < order.length; i++) {
				const width = random.int(60, 220)
				images.push({
					key: `img-${index}-${i}`,
					src: `/static/recycle-list/svg/list-${order[i]}.svg`,
					width: width
				})
				if (i > 0) {
					widthText += '、'
				}
				widthText += `${width}`
			}

			items.push({
				id: index,
				title: `条目 ${index + 1}`,
				images: images,
				summary: `共 ${images.length} 张图 · 宽度：${widthText}`
			})
		}
		return items
	}

	const items = reactive(createItems())

	defineExpose({
		items
	})
</script>
