<template>
	<view class="theme-list-demo bg-list-demo-page-background flex-1 d-flex flex-dir-column min-h-0 p-12-12-0">
		<view class="d-flex flex-dir-column p-4-4-12">
			<text class="fs-20 fw-bold color-list-demo-title">View + Text 撑高</text>
			<text class="mt-4 fs-12 color-list-demo-secondary">200 项 · key 唯一 · 高度由内容决定</text>
		</view>

		<list-view id="item-list" class="flex-1 bg-list-demo-panel-background radius-6" show-scrollbar="false">
			<list-item v-for="item in items" :key="item.id" class="border-b-width-1 border-b-style-solid border-b-color-list-demo-border">
				<view class="d-flex flex-dir-row items-flex-start p-12-14">
					<text class="d-flex flex-dir-column items-center justify-center bg-list-demo-badge-background fw-bold color-list-demo-badge w-24 h-24 radius-12 fs-12 text-center lh-24">{{item.id + 1}}</text>
					<view class="flex-1 d-flex flex-dir-column min-w-0 u-ml-10">
						<text class="fs-15 fw-bold color-list-demo-title">{{item.title}}</text>
						<text class="mt-6 fs-13 lh-22 color-list-demo-text">{{item.body}}</text>
					</view>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	type Item = {
		id: number
		title: string
		body: string
	}

	function createItems(): Item[] {
		const items: Item[] = []
		for (let index = 0; index < 200; index++) {
			const lines = (index % 8) + 1
			let body = ''
			for (let line = 0; line < lines; line++) {
				body += `第 ${line + 1} 行：由 view + text 撑开高度，行数不同则高度不同。`
				if (line < lines - 1) {
					body += '\n'
				}
			}
			items.push({
				id: index,
				title: `条目 ${index + 1}`,
				body: body
			})
		}
		return items
	}

	const items = reactive(createItems())

	defineExpose({
		items
	})
</script>
