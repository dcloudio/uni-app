<template>
	<view class="page">
		<view class="header">
			<text class="title">View + Text 撑高</text>
			<text class="subtitle">200 项 · key 唯一 · 高度由内容决定</text>
		</view>

		<list-view id="item-list" class="list" show-scrollbar="false">
			<list-item v-for="item in items" :key="item.id" class="list-item">
				<view class="item-content">
					<text class="item-index">{{item.id + 1}}</text>
					<view class="item-copy">
						<text class="item-title">{{item.title}}</text>
						<text class="item-body">{{item.body}}</text>
					</view>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	type Item = {
		id: number
		title: string
		body: string
	}

	function createItems(): Item[] {
		const items: Item[] = []
		for (let index = 0; index < 200; index++) {
			const lines = (index % 8) + 1
			let body = ''
			for (let line = 0; line < lines; line++) {
				body += `第 ${line + 1} 行：由 view + text 撑开高度，行数不同则高度不同。`
				if (line < lines - 1) {
					body += '\n'
				}
			}
			items.push({
				id: index,
				title: `条目 ${index + 1}`,
				body: body
			})
		}
		return items
	}

	const items = reactive(createItems())

	defineExpose({
		items
	})
</script>

<style>
