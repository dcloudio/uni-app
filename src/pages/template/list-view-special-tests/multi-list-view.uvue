<template>
	<view id="multi-list-view-page" class="theme-list-demo bg-list-demo-page-background flex-1 d-flex flex-dir-column min-h-0 p-12-12-0 page">
		<view class="d-flex flex-dir-row items-center justify-between pb-12">
			<view class="flex-1 d-flex flex-dir-column min-w-0">
				<text class="fs-20 fw-bold color-list-demo-title">Multi List View</text>
				<text class="mt-4 fs-12 color-list-demo-secondary">横向均分布局，每列独立纵向滚动</text>
			</view>
			<button id="toggle-list-count" class="fs-12 toggle-button" type="primary" @click="cycleListCount">
				切换为 {{nextListCount()}} 个列表
			</button>
		</view>

		<view class="flex-1 d-flex flex-dir-row min-h-0 w-full items-stretch">
			<list-view
				v-for="column in data.columns"
				:key="column.id"
				:id="getListId(column.id)"
				class="flex-1 h-full min-w-0 bg-list-demo-panel-background border-r-width-1 border-r-style-solid column-list"
				direction="vertical"
				show-scrollbar="false"
				:scroll-top="data.scrollTops[column.id - 1]"
			>
				<list-item v-for="item in data.items" :key="item.id" class="border-b-width-1 border-b-style-solid h-54 border-b-color-list-demo-divider">
					<view class="d-flex flex-dir-row items-center h-full item-content">
						<view class="d-flex flex-dir-column items-center justify-center bg-list-demo-badge-background radius-11 w-22 h-22">
							<text class="fw-bold color-list-demo-badge fs-11">{{item.id + 1}}</text>
						</view>
						<view class="flex-1 d-flex flex-dir-column min-w-0 ml-6">
							<text class="fs-12 color-list-demo-title item-title">列表 {{column.id}} · {{item.title}}</text>
							<text class="fs-10 color-list-demo-secondary mt-3">{{item.description}}</text>
						</view>
					</view>
				</list-item>
			</list-view>
		</view>
	</view>
</template>

<script setup lang="ts">
	type MultiColumn = {
		id: number
	}

	type MultiListItem = {
		id: number
		title: string
		description: string
	}

	type ScrollRequest = {
		columnId: number
		top: number
	}

	function createColumns(count: number): MultiColumn[] {
		const columns: MultiColumn[] = []
		for (let index = 0; index < count; index++) {
			columns.push({
				id: index + 1
			})
		}
		return columns
	}

	function createItems(): MultiListItem[] {
		const items: MultiListItem[] = []
		for (let index = 0; index < 36; index++) {
			items.push({
				id: index,
				title: `项目 ${index + 1}`,
				description: '每个 list-view 拥有独立的纵向滚动区域'
			})
		}
		return items
	}

	const data = reactive({
		listCount: 4,
		columns: createColumns(4),
		scrollTops: [0, 0, 0, 0, 0, 0],
		items: createItems()
	})

	function getListId(columnId: number): string {
		return `column-list-${columnId}`
	}

	function nextListCount(): number {
		return data.listCount >= 6 ? 4 : data.listCount + 1
	}

	function cycleListCount() {
		data.listCount = nextListCount()
		data.columns = createColumns(data.listCount)
		for (let index = 0; index < data.scrollTops.length; index++) {
			data.scrollTops[index] = 0
		}
	}

	function scrollList(request: ScrollRequest): boolean {
		if (request.columnId < 1 || request.columnId > data.listCount || request.top < 0) {
			return false
		}
		data.scrollTops[request.columnId - 1] = request.top
		return true
	}

	defineExpose({
		data,
		cycleListCount,
		scrollList
	})
</script>

<style>
	.page {
		--list-demo-border-color: #e5e7eb;
		--list-demo-divider-color: #eef0f4;
	}

	.toggle-button {
		margin: 0 0 0 8px;
	}

	.column-list {
		border-right-color: var(--list-demo-border-color);
	}

	.item-content {
		padding: 0 8px;
	}

	@media (prefers-color-scheme: dark) {
		.page {
			--list-demo-border-color: #3a3a3a;
			--list-demo-divider-color: #3a3a3a;
		}
	}
</style>
