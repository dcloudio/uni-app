<template>
	<view id="multi-list-view-page" class="page">
		<view class="toolbar">
			<view class="toolbar-copy">
				<text class="title">Multi List View</text>
				<text class="subtitle">横向均分布局，每列独立纵向滚动</text>
			</view>
			<button id="toggle-list-count" class="toggle-button" type="primary" @click="cycleListCount">
				切换为 {{nextListCount()}} 个列表
			</button>
		</view>

		<view class="list-area">
			<list-view
				v-for="column in data.columns"
				:key="column.id"
				:id="getListId(column.id)"
				class="column-list"
				direction="vertical"
				show-scrollbar="false"
				:scroll-top="data.scrollTops[column.id - 1]"
			>
				<list-item v-for="item in data.items" :key="item.id" class="column-list-item">
					<view class="item-content">
						<view class="item-index">
							<text class="item-index-text">{{item.id + 1}}</text>
						</view>
						<view class="item-copy">
							<text class="item-title">列表 {{column.id}} · {{item.title}}</text>
							<text class="item-description">{{item.description}}</text>
						</view>
					</view>
				</list-item>
			</list-view>
		</view>
	</view>
</template>

<script setup lang="ts">
	type MultiColumn = {
		id: number
	}

	type MultiListItem = {
		id: number
		title: string
		description: string
	}

	type ScrollRequest = {
		columnId: number
		top: number
	}

	function createColumns(count: number): MultiColumn[] {
		const columns: MultiColumn[] = []
		for (let index = 0; index < count; index++) {
			columns.push({
				id: index + 1
			})
		}
		return columns
	}

	function createItems(): MultiListItem[] {
		const items: MultiListItem[] = []
		for (let index = 0; index < 36; index++) {
			items.push({
				id: index,
				title: `项目 ${index + 1}`,
				description: '每个 list-view 拥有独立的纵向滚动区域'
			})
		}
		return items
	}

	const data = reactive({
		listCount: 4,
		columns: createColumns(4),
		scrollTops: [0, 0, 0, 0, 0, 0],
		items: createItems()
	})

	function getListId(columnId: number): string {
		return `column-list-${columnId}`
	}

	function nextListCount(): number {
		return data.listCount >= 6 ? 4 : data.listCount + 1
	}

	function cycleListCount() {
		data.listCount = nextListCount()
		data.columns = createColumns(data.listCount)
		for (let index = 0; index < data.scrollTops.length; index++) {
			data.scrollTops[index] = 0
		}
	}

	function scrollList(request: ScrollRequest): boolean {
		if (request.columnId < 1 || request.columnId > data.listCount || request.top < 0) {
			return false
		}
		data.scrollTops[request.columnId - 1] = request.top
		return true
	}

	defineExpose({
		data,
		cycleListCount,
		scrollList
	})
</script>

