		background-color: var(--list-demo-panel-background);
		border-right-width: 1px;
		border-right-style: solid;
		border-right-color: var(--list-demo-border-color);
	}

	.column-list-item {
		height: 54px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--list-demo-divider-color);
	}

	.item-content {
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 100%;
		padding: 0 8px;
	}

	.item-index {
		width: 22px;
		height: 22px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 11px;
		background-color: var(--list-demo-badge-background);
	}

	.item-index-text {
		font-size: 11px;
