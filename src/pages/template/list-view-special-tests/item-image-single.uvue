<template>
	<view class="page">
		<view class="header">
			<text class="title">Image (SVG) 单图</text>
			<text class="subtitle">200 项 · key 唯一 · 每项仅一张图片</text>
		</view>

		<list-view id="item-list" class="list" show-scrollbar="false" :scroll-anchoring="true">
			<list-item v-for="item in items" :key="item.id" class="list-item">
				<view class="item-content">
					<view class="item-head">
						<text class="item-index">{{item.id + 1}}</text>
						<text class="item-title">{{item.title}}</text>
					</view>
					<image
						class="item-image"
						:src="item.src"
						mode="widthFix"
						:style="{ width: item.width + 'px' }"
					></image>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	import { SeededRandom } from './SeededRandom.ts'

	type Item = {
		id: number
		title: string
		src: string
		width: number
	}

	const random = new SeededRandom(1003)

	function createItems(): Item[] {
		const items: Item[] = []
		for (let index = 0; index < 200; index++) {
			items.push({
				id: index,
				title: `条目 ${index + 1}`,
				src: `/static/recycle-list/svg/list-${(index % 4) + 1}.svg`,
				width: 60 + random.int(0, 160)
			})
		}
		return items
	}

	const items = reactive(createItems())

	defineExpose({
		items
	})
</script>

