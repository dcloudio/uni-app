<template>
	<view class="page">
		<view class="header">
			<text class="title">随机 Text 撑高</text>
			<text class="subtitle">200 项 · key 唯一 · 每项 1-100 个不同底色 text</text>
		</view>

		<list-view id="item-list" class="list" show-scrollbar="false" :scroll-anchoring="true">
			<list-item v-for="item in items" :key="item.id" class="list-item">
				<view class="item-content">
					<view class="item-head">
						<text class="item-index">{{item.id + 1}}</text>
						<text class="item-title">{{item.title}}</text>
					</view>
					<text class="item-summary">{{item.summary}}</text>
					<view class="node-list">
						<text
							v-for="node in item.nodes"
							:key="node.key"
							class="node-text"
							:style="{ backgroundColor: node.color }"
						>{{node.text}}</text>
					</view>
				</view>
			</list-item>
		</list-view>
	</view>
</template>

<script setup lang="ts">
	import { SeededRandom } from './SeededRandom.ts'

	type TextNode = {
		key: string
		text: string
		color: string
	}

	type Item = {
		id: number
		title: string
		nodes: TextNode[]
		summary: string
	}

	const random = new SeededRandom(1005)

	function randomColor(): string {
		const r = random.int(0, 255)
		const g = random.int(0, 255)
		const b = random.int(0, 255)
		return `rgb(${r},${g},${b})`
	}

	function createItems(): Item[] {
		const items: Item[] = []
		for (let index = 0; index < 200; index++) {
			const count = random.int(1, 100)
			const nodes: TextNode[] = []
			for (let i = 0; i < count; i++) {
				nodes.push({
					key: `t-${index}-${i}`,
					text: `文本 ${i + 1}`,
					color: randomColor()
				})
			}
			items.push({
				id: index,
				title: `条目 ${index + 1}`,
				nodes: nodes,
				summary: `共 ${nodes.length} 个 text`
			})
		}
		return items
	}

	const items = reactive(createItems())

	defineExpose({
		items
	})
</script>

