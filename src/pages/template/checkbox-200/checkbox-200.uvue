<template>
  <view class="flex-dir-column pos-relative">
    <!-- #ifndef MP -->
    <fps />
    <!-- #endif -->
    <view class="flex-dir-row items-center u-p-2">
      <button @click="toggleAll" size="mini" class="m-2">{{ sharedChecked ? '取消' : '全选' }}</button>
    </view>
		<checkbox-group class="u-p-2 flex-dir-row flex-wrap-wrap m-2">
			<checkbox v-for="index in 200" :key="index" :checked="sharedChecked" />
		</checkbox-group>
  </view>
</template>

<script setup lang="ts">
  const sharedChecked = ref(false)

  function toggleAll() {
    sharedChecked.value = !sharedChecked.value
    console.log('切换全选状态:', sharedChecked.value)
  }

</script>
