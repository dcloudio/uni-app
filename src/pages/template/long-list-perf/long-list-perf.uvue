          <view class="flex-dir-row justify-between items-center mb-4 border-width-1 border-style-solid u-p-2 b1 bg-active-f9f9f9" flatten>
            <text class="fs-13 fw-bold color-text-333" @click.stop="onTitleClick(item.id + 1)">#{{ item.id + 1 }} Type5 视频</text>
            <view class="flex-dir-row items-center" flatten>
              <text class="color-fff bg-333 radius-2 mr-4 fs-9 p-1-3" flatten>HD</text>
