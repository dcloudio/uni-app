    <!-- #endif -->
    <view class="p-10-15 bg-333">
      <text class="fs-10 color-aaa mt-2">{{ listData.length }}行 | 每行40+元素 | 共近20万元素 | 10+层嵌套 | 圆角边框阴影 | 视频</text>
    </view>
    <list-view ref="listViewRef" class="flex-1" :scroll-with-animation="true" @scrollend="onScrollEnd" android-scrollbar-draggable>
