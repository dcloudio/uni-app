                <view class="flex-dir-row items-center flex-1 u-ml-2 border-width-1 border-style-solid u-p-2 b5" flatten>
                  <text class="color-text-555 bg-active-f0f0f0 radius-8 mr-4 fs-9 tag-pill" flatten>搞笑</text>
