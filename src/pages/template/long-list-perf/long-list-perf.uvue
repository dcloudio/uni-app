                    <view class="flex-dir-row items-center flex-1 border-width-1 border-style-solid u-p-2 b5" flatten>
                      <text class="radius-2 mr-4 fs-9 tag-sm color-text-666 p-1-3" flatten>优惠</text>
                      <view class="flex-dir-row items-center flex-1 border-width-1 border-style-solid u-p-2 b6" flatten>
                        <text class="radius-2 mr-4 fs-9 tag-sm color-text-666 p-1-3" flatten>L6</text>
                        <view class="flex-dir-row items-center flex-1 border-width-1 border-style-solid u-p-2 b7" flatten>
