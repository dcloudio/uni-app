                          <view class="flex-dir-row items-center flex-1 border-width-1 border-style-solid u-p-2 b8" flatten>
                            <text class="mr-4 fs-9 card-info-text" flatten>进行中</text>
                            <view class="flex-dir-row items-center flex-1 border-width-1 border-style-solid u-p-2 b9" flatten>
