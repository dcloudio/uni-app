                    <view class="flex-dir-row items-center flex-1 u-ml-2 border-width-1 border-style-solid u-p-2 b7" flatten>
                      <text class="color-text-555 bg-active-f0f0f0 radius-8 mr-4 fs-9 tag-pill" flatten>L7</text>
                      <view class="flex-dir-row items-center flex-1 u-ml-2 border-width-1 border-style-solid u-p-2 b8" flatten>
                        <text class="color-text-555 bg-active-f0f0f0 radius-8 mr-4 fs-9 tag-pill" flatten>L8</text>
                        <view class="flex-dir-row items-center flex-1 u-ml-2 border-width-1 border-style-solid u-p-2 b9" flatten>
