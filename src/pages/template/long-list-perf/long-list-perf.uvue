    </list-view>
    <view class="pos-fixed h-32 bg-rgba-0-0-0-0_5 bottom-20 right-20 w-32 radius-16" @click="scrollToTop">
      <text class="color-fff fs-16 text-center scroll-top-top-btn-icon">▲</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  import { generateMockList, type ListItemData } from './mock-data.ts'

  // 使用预生成的数据
  const listData = ref<ListItemData[]>([])
  const listViewRef = ref<UniListViewElement | null>(null)

  onMounted(() => {
    // console.log('加载预生成的4000条数据')
    listData.value = generateMockList()
    // console.log('数据加载完成')
  })

  function onTitleClick(index : number) {
    uni.showToast({
      title: `序号: ${index}`,
      icon: 'none'
    })
  }

  function onImageClick(urls : string[], current : number) {
    uni.previewImage({
      urls: urls,
      current: current
    })
  }

  let startFpsCounter = false
  type FpsMonitorResult = {
    frameCount: number
    duration: number
    fpsArr: number[]
  }
  function startFpsMonitor(startTime: number, callback: (result: FpsMonitorResult) => void) {
    let lastTime = startTime
    let frameCount = 0
    const fpsArr: number[] = []
    function updateFPS(currentTime: number) {
      frameCount++
      const delta = currentTime - lastTime
      lastTime = currentTime
      const currentFps = Math.round(1000 / delta)
      fpsArr.push(currentFps)
      if (startFpsCounter) {
        requestAnimationFrame((currentTime) => {
          updateFPS(currentTime)
        })
      } else {
        const duration = currentTime - startTime
        callback({
          frameCount,
          duration,
          fpsArr
        })
      }
    }
    requestAnimationFrame((currentTime) => {
      updateFPS(currentTime)
    })
  }
  function scrollToTop() {
    if (listViewRef.value) {
      if(!startFpsCounter) {
        startFpsCounter = true
        requestAnimationFrame((currentTime) => {
          startFpsMonitor(currentTime, (result) => {
            const avgFps = result.frameCount / (result.duration / 1000)
            const maxFps = Math.max(...result.fpsArr)
            const minFps = Math.min(...result.fpsArr)
            console.log(`平均FPS: ${avgFps.toFixed(2)}, 最高FPS: ${maxFps}, 最低FPS: ${minFps}`)
          })
          listViewRef.value!.scrollTop = 0
        })
      } else {
        listViewRef.value!.scrollTop = 0
      }
    }
  }
  function onScrollEnd() {
    startFpsCounter = false
  }

  function jest_scrollTo(scrollTop : number) : boolean {
    if (listViewRef.value == null) {
      return false
    }
    listViewRef.value.scrollTop = scrollTop
    return true
  }

  defineExpose({
    jest_scrollTo,
  })
</script>

