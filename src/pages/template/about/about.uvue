<template>
  <scroll-view class="flex-1">
    <view class="w-full u-p-16 items-center">
      <image class="qrcode h-160" src="https://web-ext-storage.dcloud.net.cn/uni-app-x/hello-uniappx-qrcode.png"></image>
      <text class="fs-14 color-text m-12">扫码体验 uni-app x</text>
      <text class="fs-14 lh-18 desc color-text">
        <text class="fs-14 code">uni-app x </text>
        <text class="fs-14 lh-18 desc color-text">是下一代uni-app，基于uts的、兼容vue语法的跨平台开发框架。</text>
      </text>
      <text class="self-flex-start mt-18 fs-14 lh-18 desc color-text">本应用源码获取方式：</text>
      <view class="flex-dir-row self-flex-start sourcelist">
        <text class="fs-14 lh-18 desc color-text">1. </text>
        <text class="fs-14 lh-18 desc color-text">
          <text class="fs-14 lh-18 desc color-text">在 HBuilderX 中新建 uni-app 项目时选择 </text>
          <text class="fs-14 code">Hello uni-app x</text>
          <text class="fs-14 lh-18 desc color-text"> 模板</text>
        </text>
      </view>
      <view class="flex-dir-row self-flex-start sourcelist">
        <text class="fs-14 lh-18 desc color-text">2. </text>
        <text class="fs-14 lh-18 desc color-007aff text-underline" @click="openUrl('https://gitcode.com/dcloud/hello-uni-app-x')">https://gitcode.com/dcloud/hello-uni-app-x</text>
      </view>
    </view>
<!-- #ifdef APP -->
    <view class="panel">
      <text class="color-text-333 fw-normal fs-14 m-8">服务协议</text>
      <view class="radius-6">
        <view style="border-top-style: none;" class="flex-dir-row items-center bg-list border-t-color-border border-t-width-1 p-12-16 justify-between pl-18" hover-class="bg-active" @click="openUrl('https://dcloud.io/license/DCloud.html')">
          <text class="color-text-333 fs-14 fw-normal w-94pct ws-nowrap overflow-hidden text-overflow-ellipsis">用户协议</text>
          <image :src="arrowRightIcon" class="w-14 h-14"></image>
        </view>
        <view class="flex-dir-row items-center bg-list border-t-style-solid border-t-color-border border-t-width-1 p-12-16 justify-between pl-18" hover-class="bg-active" @click="openUrl('https://dcloud.io/license/hello-uni-app-x.html')">
          <text class="color-text-333 fs-14 fw-normal w-94pct ws-nowrap overflow-hidden text-overflow-ellipsis">隐私政策</text>
          <image :src="arrowRightIcon" class="w-14 h-14"></image>
        </view>
      </view>
    </view>

    <button class="mr-18 clear" @click="clearCache">清空缓存</button>
<!-- #endif -->
    <text class="w-full fs-14 lh-18 text-center color-ccc version">当前版本：{{version}}</text>
  </scroll-view>
</template>

<script setup lang="ts">
/**
 * @description: 展示 hello uni-app x 项目的二维码、源码获取方式、协议入口和当前版本信息。
 * @logic: 页面根据平台显示源码地址、服务协议与隐私政策入口，并在加载时读取当前应用版本号展示在底部。
 * @optimization: 通过统一的 `openUrl` 方法处理不同平台下的链接打开或复制逻辑，减少页面内重复的平台分支代码。
 */

// #ifdef APP
import { openSchema } from '@/uni_modules/uts-openSchema'
// #endif
const version = ref('')
const arrowRightIcon = '/static/icons/arrow-right.png'

function openUrl(url:string) {
  // #ifdef APP
  openSchema(url)
  // #endif
  // #ifdef MP-WEIXIN
  wx.setClipboardData({
    data: url,
    success: () => {
      wx.showToast({ title: '链接已复制到剪贴板' });
    }
  })
  // #endif
}

// #ifdef APP
function clearCache() {
  const fileManager = uni.getFileSystemManager()
  fileManager.rmdir({
    "dirPath":uni.env.CACHE_PATH,
    "recursive":true,
    success: (res : FileManagerSuccessResult) => {
      console.log("rmdir success", res)
      uni.showToast({
        title:"清空缓存目录成功",
        icon:"success"
      })
    },
    fail: (res : IFileSystemManagerFail) => {
      console.error('清空缓存目录失败', res)
      uni.showModal({
      	title: '清空缓存目录失败',
      	content: res.errMsg,
      	showCancel: false
      })
    },
    complete: (res : any) => {
      console.log("rmdir complete", res)
    }
  })
}
// #endif

onLoad(() => {
  version.value = uni.getAppBaseInfo().appVersion??''
})
</script>

<style>
.qrcode {
  width: 160px;
}
.desc {
  /* #ifdef MP-WEIXIN */
  width: fit-content;
  /* #endif */
  /* #ifdef WEB */
  width: fit-content;
  /* #endif */
}
.code {
  color: #e96900;
}
.sourcelist {
  align-content: flex-start;
}
.version {
  margin: 18px 0px;
}
.panel {
  margin: 18px;
}
.clear {
  margin-left: 18px;
}
</style>
