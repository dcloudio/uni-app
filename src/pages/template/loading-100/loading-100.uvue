<template>
  <view class="page">
    <!-- #ifndef MP -->
    <fps />
    <!-- #endif -->

    <view style="flex-direction: row;flex-wrap: wrap;align-items: center;margin-top: 40px;">
      <button size="mini" @click="toggleTimer" style="margin-right:4px;">停止/启动 计时</button>
      <text>{{datetime}}</text>
    </view>
    <text>计时器主线程一直占用绘制文字，但100个loading圈不卡顿</text>
    <!-- 控制按钮区域 -->
    <button size="mini" @click="changePaused">{{ paused ? '旋转' : '暂停' }}</button>

    <!-- 100个loading组件 -->
    <view style="flex-direction: row;flex-wrap: wrap;padding: 2px;">
      <loading v-for="index in 100" :key="index" :paused="paused" style="margin: 10px;"/>
    </view>
  </view>
</template>

<script setup lang="ts">
  const paused = ref(false)
  const datetime = ref('')

  let timerId : number | null = null
  let timerRunning = false

  let isBackPress = false;
  let startime = Date.now();

  onBackPress(() => {
    isBackPress = true
  });

  function updateTime() {
    const now = new Date()
    const hours = now.getHours().toString().padStart(2, '0')
    const minutes = now.getMinutes().toString().padStart(2, '0')
    const seconds = now.getSeconds().toString().padStart(2, '0')
    const milliseconds = now.getMilliseconds().toString()
    datetime.value = `${hours}:${minutes}:${seconds}.${milliseconds}`
  }

  function startTimer() {
    updateTime()
    // 每3ms更新一次时间显示。 但请注意：低于3ms（比如1ms）更新一次文字时鸿蒙系统会降低帧率至很低，导致页面卡顿，此时点击屏幕会恢复正常帧率。另外，如果低于3ms更新一次文字，但页面上同时有cavans正常绘制内容，harmony系统不会降低帧率。
    timerId = setInterval(() => {
      updateTime()
    }, 3)
    timerRunning = true
  }

  function stopTimer() {
    if (timerId !== null) {
      clearInterval(timerId as number)
      timerId = null
    }
    timerRunning = false
  }

  function toggleTimer() {
    if (timerRunning) {
      stopTimer()
    } else {
      startTimer()
    }
  }

  onReady(() => {
    startTimer()
    // #ifdef APP
    if (isBackPress) { return }
    const endtime = Date.now();
    console.log(`total duration(click -> render end):${endtime - startime}`)
    // #endif

  })

  onUnload(() => {
    stopTimer()
  })

  function changePaused() {
    paused.value = !paused.value
  }

</script>

<style>
  .page {
    flex-direction: column;
    color: var(--text-color, #333333);
    padding: 3px;
  }
</style>
