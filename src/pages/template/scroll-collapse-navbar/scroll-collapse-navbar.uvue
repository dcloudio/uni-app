<template>
  <scroll-view :scroll-top="testState.scrollTop" @scroll="onScroll" class="flex-1" show-scrollbar="false">
    <view ref="seatbarRef" class="seatbar"></view>
    <view class="p-5-15">
      <view class="u-p-15 m-5-0 bg-list-fff radius-5">
        <text class="fs-14 color-text-666 opacity-0_75 lh-20">1. 当前示例监听了 scroll-view 的 scroll 事件 ，滚动页面实时监听scrollTop。</text>
        <text class="fs-14 color-text-666 opacity-0_75 lh-20">2. 使用 ref 直接获取元素的节点，并在 scroll 事件中通过节点的 setProperty
          方法来修改搜索导航栏的高度、位置和背景颜色等样式，从而达到滚动折叠的效果。</text>
        <text class="fs-14 color-text-666 opacity-0_75 lh-20">3. 请向上\向下滚动页面观察效果。</text>
      </view>
      <view class="u-p-15 m-5-0 bg-list-fff radius-5" v-for="(item,index) in 20" :key="index">
        <text class="fs-14 color-text-666 opacity-0_75 lh-20">content-{{item}}</text>
      </view>
    </view>

    <view ref="navigatorbarRef" class="pos-fixed border-b-width-1 border-b-style-solid w-full bg-page-f5f5f5 navigatorbar">
      <view class="flex-dir-row items-center h-44">
        <!-- #ifndef MP-ALIPAY -->
        <uni-backarrow-circle auto-back style="background-color: transparent;" class="arrow"></uni-backarrow-circle>
        <!-- #endif -->
        <!-- #ifdef MP-ALIPAY -->
        <view class="w-36"></view>
        <!-- #endif -->
        <text ref="titleRef" class="color-text-333 title">DCloud 为开发者而生</text>
      </view>
      <view :style="inputWidthStyle" ref="searchbarRef" class="pos-absolute right-0 bg-list-fff h-32 radius-100 p-8 flex-dir-row items-center justify-center searchbar left-0 border-1-solid-fbdf0d" @tap="search">
        <image class="w-15" src="/static/template/scroll-fold-nav/search.png" mode="widthFix"></image>
        <text class="fs-12 flex-grow-1 color-666 searchinput">请输入你要搜索的内容</text>
        <text class="fs-12 bg-ff6900 color-fff p-5-8 radius-100">搜索</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
/**
 * @description: 支持页面滚动时让顶部搜索导航栏逐步折叠收起，并保留搜索入口的自定义导航栏页面。
 * @logic: 页面在滚动过程中实时计算 scrollTop，并直接更新导航栏高度、标题透明度和搜索栏位置，形成折叠过渡效果。
 * @optimization: 通过复用同一组导航栏节点并直接更新样式属性，避免滚动过程中重复创建吸顶节点带来的额外开销。
 */
//导航栏高度
const NAVIBARHEIGHT = 88;
//搜索栏高度
const SEARCHBARHEIGHT = 40;
//返回键按钮宽度
const BACKWIDTH = 32;

let statusBarHeight = 0
let nviBarHeight = 0
const navigatorbarRef = ref<UniElement | null>(null)
const searchbarRef = ref<UniElement | null>(null)
const titleRef = ref<UniElement | null>(null)
const seatbarRef = ref<UniElement | null>(null)
const inputWidth = ref<string | null>(null)
const inputWidthStyle = computed(() : string => {
  return inputWidth.value == null ? '' : 'width: ' + inputWidth.value + ';'
})
let hasInitMenuButtonInputWidth = false

type ScrollCollapseNavbarTestState = {
  scrollTop: number;
  currentScrollTop: number;
}

const testState = reactive({
  scrollTop: 0,
  currentScrollTop: 0,
} as ScrollCollapseNavbarTestState)

function updateNavbarByScrollTop(scrollTop : number) {
  testState.currentScrollTop = scrollTop
  let offset = scrollTop>SEARCHBARHEIGHT?SEARCHBARHEIGHT:scrollTop;//(scrollTop<0?0:scrollTop)
  navigatorbarRef.value?.style?.setProperty('height', (nviBarHeight -offset)+'px');
  titleRef.value?.style?.setProperty('opacity', (1-offset/SEARCHBARHEIGHT).toString());
  searchbarRef.value?.style?.setProperty('left', ((offset<0)?0:BACKWIDTH*offset/SEARCHBARHEIGHT)+'px');
}

// #ifdef MP
function updateMenuButtonInputWidth(scrollTop : number) {
  if (scrollTop < SEARCHBARHEIGHT) {
    inputWidth.value = null
    hasInitMenuButtonInputWidth = false
    return
  }
  // 这里的阈值和导航栏折叠动画一致，先在折叠到位时取一次宽度，后续继续滚动则恢复为 null
  if (hasInitMenuButtonInputWidth) {
    return
  }
  const menuButton = uni.getMenuButtonBoundingClientRect();
  // #ifdef MP-ALIPAY
  const leftButton = my.getLeftButtonsBoundingClientRect();
  inputWidth.value = ((menuButton.optionMenuLeft || menuButton.left) - leftButton.backButtonInteractive.right - 20) + 'px'
  // #endif
  // #ifdef MP-WEIXIN
  inputWidth.value = Math.max(menuButton.left - BACKWIDTH - 24, 0) + 'px'
  // #endif
  hasInitMenuButtonInputWidth = true
}
// #endif

function onScroll(e : ScrollEvent) {
  const scrollTop = e.detail.scrollTop
  updateNavbarByScrollTop(scrollTop)
  // #ifdef MP
  updateMenuButtonInputWidth(scrollTop)
  // #endif
}

function search() {
  uni.showToast({
    title: '暂不支持',
    icon: 'none'
  });
}

function setStyle() {
  navigatorbarRef.value?.style?.setProperty('padding-top', statusBarHeight + 'px');
  navigatorbarRef.value?.style?.setProperty('height', (NAVIBARHEIGHT + statusBarHeight) + 'px');
  seatbarRef.value?.style?.setProperty('height', (NAVIBARHEIGHT + statusBarHeight) + 'px');
}

onLoad(() => {
  // #ifdef APP || MP
    statusBarHeight = uni.getWindowInfo().statusBarHeight;
  // #endif

  nviBarHeight = NAVIBARHEIGHT + statusBarHeight;
})

onReady(() => {
  setStyle();
})


onPageShow(() => {
  // #ifdef MP-ALIPAY
  // 支付宝小程序导航栏返回图标不可隐藏,当导航栏背景透明时，系统会默认使用白色前景色（即返回箭头为白色）通过frontColor设置黑色。
  // frontColor 必须和 backgroundColor 一起传才能生效
  uni.setNavigationBar({
    frontColor: '#000000',
    backgroundColor: '#ffffff',
  })
  // #endif
})

onResize((event : OnResizeOptions) => {
  // #ifdef APP-ANDROID
  // 监听多窗口模式
  statusBarHeight = uni.getWindowInfo().statusBarHeight;
  nviBarHeight = NAVIBARHEIGHT + statusBarHeight;
  setStyle();
  // #endif
})

function jest_scrollTo(scrollTop : number) : boolean {
  testState.scrollTop = scrollTop
  return true
}

function jest_getScrollTop() : number {
  return testState.currentScrollTop
}

defineExpose({
  jest_scrollTo,
  jest_getScrollTop,
})
</script>

<style>
.navigatorbar {
/* #ifdef APP */
  padding-top: 35px;
  height: 124px;
/* #endif */
/* #ifdef WEB */
  height: 88px;
/* #endif */
  border-bottom-color: var(--border-color, #efefef);
}

/* uni-backarrow-circle组件 自定义样式 */
.arrow {
  /* 导航栏已处理顶部安全区，按钮无需重复偏移。 */
  margin-top: 0;
  --uni-backarrow-circle-color: #555;
}

.title {
  margin: 0px 2px;
}
.searchbar {
  bottom: 2px;
  margin: 6px 12px;
}
.seatbar {
/* #ifdef APP */
  height: 124px;
/* #endif */
/* #ifdef WEB */
  height: 88px;
/* #endif */
}

@media (prefers-color-scheme: dark) {
  .arrow {
    --uni-backarrow-circle-color: #ffffff;
  }

  .searchinput {
    color: #b8b8b8;
  }
}

</style>
