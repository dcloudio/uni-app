<template>
    <!-- #ifndef MP -->
    <fps />
    <!-- #endif -->

    <!-- 控制按钮 -->
    <view class="u-p-2 flex-dir-row flex-wrap-wrap items-center">
      <button @click="toggleChecked" :type="sharedChecked ? 'primary' : 'default'" size="mini" class="m-2">{{ sharedChecked ? '关闭' : '开启' }}</button>
      <button @click="toggleDisabled" :type="sharedDisabled ? 'primary' : 'default'" size="mini" class="m-2">{{ sharedDisabled ? '启用' : '禁用' }}</button>
    </view>

    <!-- 100个switch组件 -->
    <view class="flex-dir-row flex-wrap-wrap u-p-2">
      <switch v-for="index in 100" :key="index" :checked="sharedChecked" :disabled="sharedDisabled" @change="onSharedChange" class="m-2" />
    </view>
</template>

<script setup lang="ts">
  const sharedChecked = ref(false)
  const sharedDisabled = ref(false)

  function toggleChecked() {
    sharedChecked.value = !sharedChecked.value
    console.log('切换checked状态:', sharedChecked.value)
  }

  function toggleDisabled() {
    sharedDisabled.value = !sharedDisabled.value
    console.log('切换disabled状态:', sharedDisabled.value)
  }

  function onSharedChange(e : UniSwitchChangeEvent) {
    sharedChecked.value = e.detail.value
    console.log('switch状态改变:', e.detail.value)
  }
</script>
