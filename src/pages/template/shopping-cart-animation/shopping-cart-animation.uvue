		top: 29px;
		width: 14px;
		height: 2px;
		background-color: #ffffff;
	}

	.cart-total-text {
		margin-left: 10px;
		font-size: 17px;
		font-weight: 700;
		color: #ffffff;
	}

	.checkout-button {
		width: 94px;
		height: 38px;
		align-items: center;
		justify-content: center;
	}

	.checkout-button-active {
		background-color: #ffb21f;
	}

	.checkout-button-disabled {
		background-color: #51647f;
	}

	.checkout-button-text {
		font-size: 15px;
		font-weight: 700;
		color: #132238;
	}

	.popup-panel {
		width: 100%;
		height: 360px;
		background-color: #ffffff;
		flex-direction: column;
	}

	.popup-header {
		padding: 14px 12px 10px 12px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--shopping-border-color, #e8edf4);
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.popup-title {
		font-size: 17px;
		font-weight: 700;
		color: var(--shopping-popup-title-color, #132238);
	}

	.popup-actions {
		flex-direction: row;
		align-items: center;
