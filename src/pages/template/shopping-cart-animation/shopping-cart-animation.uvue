		padding: 12px 14px 10px 14px;
		background-color: #132238;
		flex-direction: column;
	}

	.header-kicker {
		font-size: 11px;
		letter-spacing: 1.5px;
		color: #7eb7ff;
	}

	.header-title {
		margin-top: 4px;
		font-size: 22px;
		font-weight: 700;
		color: #ffffff;
	}

	.header-subtitle {
		margin-top: 5px;
		font-size: 12px;
		line-height: 17px;
		color: #bfd2ea;
	}

	.food-card {
		padding: 10px 12px;
		/* background-color: #ffffff; */
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: var(--shopping-border-color, #e8edf4);
		flex-direction: row;
		align-items: center;
	}

	.food-cover {
		width: 58px;
		height: 58px;
		background-color: var(--shopping-cover-background, #edf2f8);
	}

	.food-info {
		margin-left: 10px;
		flex: 1;
		flex-direction: column;
	}

	.food-name {
		font-size: 15px;
		font-weight: 600;
		color: var(--shopping-name-color, #16202f);
	}

	.rating-row {
		margin-top: 5px;
		flex-direction: row;
		align-items: center;
	}

	.rating-text {
		margin-left: 6px;
		font-size: 12px;
		color: var(--shopping-secondary-color, #738396);
	}

	.food-side {
		width: 108px;
		margin-left: 8px;
		flex-direction: column;
		align-items: flex-end;
	}

	.price-row {
		flex-direction: row;
		align-items: flex-end;
	}

	.price-unit {
		margin-bottom: 1px;
		font-size: 12px;
		font-weight: 700;
		color: #ff5d2a;
	}

	.price-value {
		margin-left: 1px;
		font-size: 20px;
		font-weight: 700;
		color: #ff5d2a;
	}

	.qty-anchor {
		width: 104px;
		height: 30px;
		margin-top: 8px;
		align-items: flex-end;
		justify-content: center;
	}

	.add-button {
		width: 28px;
		height: 28px;
		background-color: #132238;
