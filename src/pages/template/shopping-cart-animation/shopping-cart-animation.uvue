<template>
	<list-view class="flex-1 food-list">
			<list-item :type="0">
				<view class="flex-dir-column page-header bg-132238">
					<text class="fs-11 header-kicker letter-spacing-1_5">FAST ORDER</text>
					<text class="mt-4 fs-22 fw-700 color-fff">今日鲜食 50 选</text>
				</view>
			</list-item>

			<list-item v-for="item in foods" :key="item.id" :type="item.id" class="p-10-12 border-b-width-1 border-b-style-solid flex-dir-row items-center border-b-color-shopping-border-e8edf4">
				<!-- <view class="p-10-12 border-b-width-1 border-b-style-solid flex-dir-row items-center food-card"> -->
					<image class="food-cover" :src="item.cover" mode="aspectFill"></image>
					<view class="u-ml-10 flex-1 flex-dir-column">
						<text class="fs-15 fw-600 food-name">{{ item.name }}</text>
						<view class="u-mt-5 flex-dir-row items-center">
							<uni-rate :value="item.rating" full></uni-rate>
							<text class="ml-6 fs-12 rating-text">{{ formatRating(item.rating) }}</text>
						</view>
					</view>
					<view class="ml-8 flex-dir-column food-side items-end">
						<view class="flex-dir-row items-end">
							<text class="fs-12 fw-700 mb-1 color-ff5d2a">￥</text>
							<text class="fs-20 fw-700 ml-1 color-ff5d2a">{{ formatPrice(item.price) }}</text>
						</view>
						<view :id="getAnchorId(item.id)" class="w-104 h-30 mt-8 justify-center items-end">
							<view v-if="item.count <= 0" class="w-28 h-28 items-center justify-center bg-132238" @click="onFirstAdd(item.id)">
								<view class="pos-absolute w-14 u-h-2 bg-fff plus-bar-horizontal"></view>
								<view class="pos-absolute w-14 u-h-2 bg-fff plus-bar-vertical"></view>
							</view>
							<uni-number-box v-else :modelValue="item.count" :min="0" :max="99"
								btn-class="qty-btn" input-class="qty-input" icon-class="qty-icon"
								@change="onCountChange(item.id, $event as number)"></uni-number-box>
						</view>
					</view>
				<!-- </view> -->
			</list-item>
		</list-view>

		<view class="h-60 border-t-width-1 border-t-style-solid flex-dir-row items-center justify-between cart-bar overflow-visible p-0-12 bg-132238">
			<view class="flex-1 flex-dir-row items-center overflow-visible" @click="toggleCartPopup">
				<view class="self-center overflow-visible">
				<uni-badge-view :text="badgeText" :alwaysWrapWithContent="true"
					badge-style="min-width: 20px; height: 20px; line-height: 20px; border-radius: 10px; background-color: #ff5d2a; color: #ffffff; font-size: 11px; font-weight: 700;"
					style="align-self: center;">
					<view id="cart-target" class="w-36 h-36 pos-relative">
						<view class="pos-absolute h-8 border-style-solid cart-handle border-width-2 border-color-fff border-b-width-0"></view>
						<view class="pos-absolute w-24 border-style-solid cart-basket border-width-2 left-5 border-color-fff"></view>
						<view class="pos-absolute left-10 w-14 u-h-2 bg-fff cart-base"></view>
					</view>
				</uni-badge-view>
				</view>
				<text class="u-ml-10 fs-17 fw-700 color-fff">共{{ totalPriceText }}元</text>
			</view>
			<view class="items-center justify-center checkout-button" :class="canCheckout ? 'checkout-button-active' : 'checkout-button-disabled'" @click="submitOrder">
				<text class="fs-15 fw-700 checkout-button-text">下单</text>
			</view>
		</view>

		<page-container :show="cartPopupVisible" position="bottom" :overlay="true"
			:overlay-style="overlayStyle" @beforeleave="onCartPopupBeforeLeave"
			@clickoverlay="closeCartPopup" @afterleave="onCartPopupAfterLeave">
			<view class="w-full flex-dir-column bg-fff popup-panel">
				<view class="border-b-width-1 border-b-style-solid flex-dir-row items-center justify-between popup-header border-b-color-shopping-border-e8edf4">
					<text class="fs-17 fw-700 color-shopping-popup-title-132238">{{ popupTitle }}</text>
					<view class="flex-dir-row items-center">
						<view class="p-4-8 ml-6 popup-action-button" @click="clearCart">
							<text class="fs-12 fw-600 popup-action-text">清空</text>
						</view>
						<view class="p-4-8 ml-6 popup-action-button" @click="closeCartPopup">
							<text class="fs-12 fw-600 popup-action-text">收起</text>
						</view>
					</view>
				</view>

				<scroll-view class="flex-1 popup-scroll" direction="vertical" :show-scrollbar="false">
					<view v-if="cartItems.length > 0" class="flex-dir-column p-0-12">
						<view v-for="item in cartItems" :key="item.id" class="h-48 border-b-width-1 border-b-style-solid flex-dir-row items-center popup-item">
							<text class="flex-1 fs-14 color-shopping-popup-title-132238">{{ item.name }}</text>
							<text class="w-40 fs-13 text-center popup-item-count">x{{ item.count }}</text>
							<text class="w-84 fs-14 fw-700 text-right color-ff5d2a">￥{{ formatPrice(item.price * item.count) }}</text>
						</view>
					</view>
					<view v-else class="items-center justify-center h-220">
						<text class="fs-14 popup-empty-text">购物车还是空的，先去加几样喜欢的吧</text>
					</view>
				</scroll-view>

				<view class="border-t-width-1 border-t-style-solid justify-center popup-footer h-52 items-end p-0-12">
					<text class="fs-15 fw-700 color-shopping-popup-title-132238">共 {{ totalCount }} 件，合计 ￥{{ totalPriceText }}</text>
				</view>
			</view>
		</page-container>

		<view class="pos-fixed top-0 right-0 bottom-0 w-full h-full flex-dir-column z-index-999 fly-layer overflow-visible left-0">
			<view id="fly-ball" class="fly-ball pos-absolute w-32 h-32 overflow-hidden opacity-0 z-index-999 bg-fff border-width-1 border-style-solid border-color-fff">
				<image class="w-full h-full" :src="flyBallImage" mode="aspectFill"></image>
			</view>
		</view>

</template>

<script setup lang="ts">
	import foodListRaw from './foods.json'

	type FoodSeed = {
		id: number
		name: string
		price: number
		rating: number
		cover: string
	}

	type FoodItem = {
		id: number
		name: string
		price: number
		rating: number
		cover: string
		count: number
	}

	const seeds = foodListRaw as FoodSeed[]
	const initialFoods = seeds.map((item: FoodSeed): FoodItem => {
		return {
			id: item.id,
			name: item.name,
			price: item.price,
			rating: item.rating,
			cover: item.cover,
			count: 0
		}
	}) as FoodItem[]

	const foods = ref<FoodItem[]>(initialFoods)
	const cartPopupVisible = ref(false)
	const flyBallImage = ref(initialFoods[0].cover)
	const displayedBadgeCount = ref(0)
	let overlayStyle = 'background-color: rgba(0, 0, 0, 0.4);'
	// #ifdef MP
	const flyBallDuration = 260
	// #endif
	// #ifndef MP
	const flyBallDuration = 100
	// #endif

	// #ifdef MP-ALIPAY
	overlayStyle += ' z-index: 0;'
	// #endif

	let cartTargetElement: UniElement | null = null
	let flyBallElement: UniElement | null = null
	let currentBallAnimation: UniAnimation | null = null
	let latestFlyAnimationRequestId = 0
	let pendingBadgeCount = 0

	const cartItems = computed((): FoodItem[] => {
		const items: FoodItem[] = []
		for (let index = 0; index < foods.value.length; index++) {
			const currentFood = foods.value[index]
			if (currentFood.count > 0) {
				items.push(currentFood)
			}
		}
		return items
	})

	const totalCount = computed((): number => {
		let sum = 0
		for (let index = 0; index < foods.value.length; index++) {
			sum += foods.value[index].count
		}
		return sum
	})

	const totalPrice = computed((): number => {
		let sum = 0
		for (let index = 0; index < foods.value.length; index++) {
			const currentFood = foods.value[index]
			sum += currentFood.price * currentFood.count
		}
		return sum
	})

	const totalPriceText = computed((): string => {
		return totalPrice.value.toFixed(2)
	})

	const badgeText = computed((): string => {
		return displayedBadgeCount.value > 0 ? `${displayedBadgeCount.value}` : '0'
	})

	const canCheckout = computed((): boolean => {
		return totalCount.value > 0
	})

	const popupTitle = computed((): string => {
		return cartItems.value.length > 0 ? '已选商品明细' : '购物车为空'
	})

	function formatPrice(price: number): string {
		return price.toFixed(2)
	}

	function formatRating(rating: number): string {
		return rating.toFixed(1)
	}

	function getAnchorId(foodId: number): string {
		return `qty-anchor-${foodId}`
	}

	function getFoodIndex(foodId: number): number {
		for (let index = 0; index < foods.value.length; index++) {
			if (foods.value[index].id == foodId) {
				return index
			}
		}
		return -1
	}

	function flushPendingBadgeCount(): void {
		if (pendingBadgeCount <= 0) {
			return
		}
		displayedBadgeCount.value += pendingBadgeCount
		pendingBadgeCount = 0
	}

	function syncBadgeCountForDecrease(delta: number): void {
		if (delta <= 0) {
			return
		}
		if (pendingBadgeCount >= delta) {
			pendingBadgeCount -= delta
			return
		}

		const visibleDecrease = delta - pendingBadgeCount
		pendingBadgeCount = 0
		let nextBadgeCount = displayedBadgeCount.value - visibleDecrease
		if (nextBadgeCount < 0) {
			nextBadgeCount = 0
		}
		displayedBadgeCount.value = nextBadgeCount
	}

	function resetFlyBall(): void {
		const animation = currentBallAnimation
		if (animation != null) {
			animation.onfinish = null
			animation.oncancel = null
			animation.cancel()
			currentBallAnimation = null
		}
		const ballElement = flyBallElement
		if (ballElement != null) {
			ballElement.style.setProperty('transition', 'none')
			ballElement.style.setProperty('left', '-999px')
			ballElement.style.setProperty('top', '-999px')
			ballElement.style.setProperty('opacity', '0')
			ballElement.style.setProperty('transform', 'translate(0px, 0px) scale(1)')
		}
	}

	function finalizeFlyBallAnimation(animation: UniAnimation): void {
		if (currentBallAnimation != animation) {
			return
		}
		currentBallAnimation = null
		flushPendingBadgeCount()
		const ballElement = flyBallElement
		if (ballElement != null) {
			ballElement.style.setProperty('transition', 'none')
			ballElement.style.setProperty('left', '-999px')
			ballElement.style.setProperty('top', '-999px')
			ballElement.style.setProperty('opacity', '0')
			ballElement.style.setProperty('transform', 'translate(0px, 0px) scale(1)')
		}
	}

	async function getElementRect(element: UniElement): Promise<DOMRect | null> {
		const rectPromise = element.getBoundingClientRectAsync()
		if (rectPromise == null) {
			return null
		}
		return await rectPromise
	}

	async function playFlyToCartAnimation(sourceElement: UniElement): Promise<boolean> {
		const requestId = latestFlyAnimationRequestId + 1
		latestFlyAnimationRequestId = requestId
		const cartElement = cartTargetElement
		const ballElement = flyBallElement
		if (cartElement == null || ballElement == null) {
			return false
		}

		resetFlyBall()

		const startRect = await getElementRect(sourceElement)
		const endRect = await getElementRect(cartElement)
		if (startRect == null || endRect == null) {
			return latestFlyAnimationRequestId != requestId
		}
		if (latestFlyAnimationRequestId != requestId) {
			return true
		}
		const startLeft = startRect.left + startRect.width / 2 - 16
		const startTop = startRect.top + startRect.height / 2 - 16
		const endLeft = endRect.left + endRect.width / 2 - 16
		const endTop = endRect.top + endRect.height / 2 - 16
		const deltaX = endLeft - startLeft
		const deltaY = endTop - startTop
		const crestX = deltaX * 0.24
		const crestY = -34
		const midX = deltaX * 0.68
		const midY = deltaY * 0.58

		ballElement.style.setProperty('left', `${startLeft}px`)
		ballElement.style.setProperty('top', `${startTop}px`)
		ballElement.style.setProperty('transition', 'none')
		ballElement.style.setProperty('opacity', '1')
		ballElement.style.setProperty('transform', 'translate(0px, 0px) scale(1)')

		if (latestFlyAnimationRequestId != requestId) {
			return true
		}
		// #ifdef MP
		const firstLegDuration = 110
		const secondLegDuration = flyBallDuration - firstLegDuration
		setTimeout((): void => {
			if (latestFlyAnimationRequestId != requestId) {
				return
			}
			ballElement.style.setProperty('transition', `transform ${firstLegDuration}ms ease-out, opacity ${firstLegDuration}ms linear`)
			ballElement.style.setProperty('transform', `translate(${crestX.toFixed(1)}px, ${crestY.toFixed(1)}px) scale(0.94)`)
			ballElement.style.setProperty('opacity', '0.98')
		}, 16)
		setTimeout((): void => {
			if (latestFlyAnimationRequestId != requestId) {
				return
			}
			ballElement.style.setProperty('transition', `transform ${secondLegDuration}ms ease-in, opacity ${secondLegDuration}ms linear`)
			ballElement.style.setProperty('transform', `translate(${deltaX.toFixed(1)}px, ${deltaY.toFixed(1)}px) scale(0.42)`)
			ballElement.style.setProperty('opacity', '0.12')
		}, firstLegDuration + 16)
		setTimeout((): void => {
			if (latestFlyAnimationRequestId != requestId) {
				return
			}
			resetFlyBall()
		}, flyBallDuration + 40)
		return true
		// #endif
		let animation: UniAnimation | null = null
		// #ifndef MP
		animation = ballElement.animate([
			{
				offset: 0,
				transform: 'translate(0px, 0px) scale(1)',
				opacity: '1'
			},
			{
				offset: 0.34,
				transform: `translate(${crestX.toFixed(1)}px, ${crestY.toFixed(1)}px) scale(0.94)`,
				opacity: '0.98'
			},
			{
				offset: 0.74,
				transform: `translate(${midX.toFixed(1)}px, ${midY.toFixed(1)}px) scale(0.66)`,
				opacity: '0.88'
			},
			{
				offset: 1,
				transform: `translate(${deltaX.toFixed(1)}px, ${deltaY.toFixed(1)}px) scale(0.22)`,
				opacity: '0.12'
			}
		], {
			duration: flyBallDuration,
			easing: 'ease-in-out',
			fill: 'forwards'
		})
		// #endif
		if (animation == null) {
			resetFlyBall()
			return false
		}
		// #ifndef MP
		animation.onfinish = (_event: UniAnimationPlaybackEvent) => {
			if(animation != null) {
				finalizeFlyBallAnimation(animation)
			}
		}
		animation.oncancel = (_event: UniAnimationPlaybackEvent) => {
			if (currentBallAnimation == animation) {
				currentBallAnimation = null
			}
		}
		// #endif
		currentBallAnimation = animation
		setTimeout((): void => {
			if(animation != null) {
				finalizeFlyBallAnimation(animation)
			}
		}, flyBallDuration + 20)

		return true
	}

	async function playFlyFromFood(foodId: number): Promise<boolean> {
		const anchorId = getAnchorId(foodId)
		const sourceElement = uni.getElementById(anchorId)
		if (sourceElement != null) {
			return await playFlyToCartAnimation(sourceElement)
		}
		return false
	}

	async function updateFoodCount(foodId: number, nextCount: number): Promise<void> {
		const foodIndex = getFoodIndex(foodId)
		if (foodIndex < 0) {
			return
		}

		const targetFood = foods.value[foodIndex]
		const previousCount = targetFood.count
		let safeCount = nextCount
		if (safeCount < 0) {
			safeCount = 0
		}
		if (safeCount > 99) {
			safeCount = 99
		}
		if (safeCount == previousCount) {
			return
		}

		targetFood.count = safeCount
		if (safeCount > previousCount) {
			pendingBadgeCount += safeCount - previousCount
			flyBallImage.value = targetFood.cover
			const animationStarted = await playFlyFromFood(foodId)
			// #ifdef MP
			// TODO 微信小程序上动画finish事件未支持，暂时需条件编译，改成不等动画结束就加角标
			if (animationStarted) {
				flushPendingBadgeCount()
			}
			// #endif
			if (!animationStarted) {
				flushPendingBadgeCount()
			}
		} else {
			syncBadgeCountForDecrease(previousCount - safeCount)
		}
		if (safeCount == 0 && totalCount.value == 0) {
			cartPopupVisible.value = false
		}
	}

	async function onFirstAdd(foodId: number): Promise<void> {
		await updateFoodCount(foodId, 1)
	}

	async function onCountChange(foodId: number, nextCount: number): Promise<void> {
		await updateFoodCount(foodId, nextCount)
	}

	function toggleCartPopup(): void {
		cartPopupVisible.value = !cartPopupVisible.value
	}

	function closeCartPopup(): void {
		cartPopupVisible.value = false
	}

	function onCartPopupBeforeLeave(): void {
		cartPopupVisible.value = false
	}

	function onCartPopupAfterLeave(): void {
		cartPopupVisible.value = false
	}

	function clearCart(): void {
		for (let index = 0; index < foods.value.length; index++) {
			foods.value[index].count = 0
		}
		pendingBadgeCount = 0
		displayedBadgeCount.value = 0
		resetFlyBall()
		cartPopupVisible.value = false
	}

	function submitOrder(): void {
		if (!canCheckout.value) {
			uni.showToast({
				title: '请先选择商品',
				icon: 'none'
			})
			return
		}
		uni.showToast({
			title: `已提交 ${totalCount.value} 件，合计 ${totalPriceText.value} 元`,
			icon: 'none'
		})
	}

	onReady(() => {
		cartTargetElement = uni.getElementById('cart-target')
		flyBallElement = uni.getElementById('fly-ball')
		resetFlyBall()
	})

	onUnload(() => {
		resetFlyBall()
	})
</script>

<style>
	.border-b-color-shopping-border-e8edf4 {
		border-bottom-color: var(--shopping-border-color, #e8edf4);
	}

	.color-shopping-popup-title-132238 {
		color: var(--shopping-popup-title-color, #132238);
	}

	.food-list {
		--shopping-border-color: #e8edf4;
		--shopping-item-border-color: #edf2f7;
		--shopping-cover-background: #edf2f8;
		--shopping-name-color: #16202f;
		--shopping-secondary-color: #738396;
		--shopping-surface-background: #ffffff;
		--shopping-popup-title-color: #132238;
		--shopping-action-background: #eef3f8;
		--shopping-action-text-color: #31445d;
		--shopping-count-color: #65768b;
		--shopping-empty-color: #6f8095;
		--shopping-footer-background: #f7f9fc;
	}

	.page-header {
		padding: 12px 14px 10px 14px;
	}

	.header-kicker {
		color: #7eb7ff;
	}

	.food-cover {
		width: 58px;
		height: 58px;
		background-color: var(--shopping-cover-background, #edf2f8);
	}

	.food-name {
		color: var(--shopping-name-color, #16202f);
	}

	.rating-text {
		color: var(--shopping-secondary-color, #738396);
	}

	.food-side {
		width: 108px;
	}

	.plus-bar-horizontal {
		transform: rotate(0deg);
	}

	.plus-bar-vertical {
		transform: rotate(90deg);
	}

	.qty-btn {
		background-color: #132238;
		width: 28px;
		height: 28px;
	}

	.qty-input {
		width: 42px;
		height: 28px;
		margin: 0px 1px;
		background-color: #eef3f8;
		color: #132238;
		font-size: 13px;
	}

	.qty-icon {
		background-color: #ffffff;
	}

	.cart-bar {
		border-top-color: #243653;
	}

	.cart-handle {
		left: 8px;
		top: 4px;
		width: 16px;
	}

	.cart-basket {
		top: 12px;
		height: 15px;
	}

	.cart-base {
		top: 29px;
	}

	.checkout-button {
		width: 94px;
		height: 38px;
	}

	.checkout-button-active {
		background-color: #ffb21f;
	}

	.checkout-button-disabled {
		background-color: #51647f;
	}

	.checkout-button-text {
		color: #132238;
	}

	.popup-panel {
		height: 360px;
	}

	.popup-header {
		padding: 14px 12px 10px 12px;
	}

	.popup-action-button {
		background-color: var(--shopping-action-background, #eef3f8);
	}

	.popup-action-text {
		color: var(--shopping-action-text-color, #31445d);
	}

	.popup-scroll {
		background-color: var(--shopping-surface-background, #ffffff);
	}

	/* #ifdef MP-ALIPAY */
	.popup-scroll::-webkit-scrollbar {
		display: none;
	}
	/* #endif */

	.popup-item {
		border-bottom-color: var(--shopping-item-border-color, #edf2f7);
	}

	.popup-item-count {
		color: var(--shopping-count-color, #65768b);
	}

	.popup-empty-text {
		color: var(--shopping-empty-color, #6f8095);
	}

	.popup-footer {
		border-top-color: var(--shopping-border-color, #e8edf4);
		background-color: var(--shopping-footer-background, #f7f9fc);
	}

	.fly-layer {
		pointer-events: none;
	}

	.fly-ball {
		left: -999px;
		top: -999px;
	}

	@media (prefers-color-scheme: dark) {
		.food-list,
		.popup-panel {
			--shopping-border-color: rgba(255, 255, 255, 0.1);
			--shopping-item-border-color: rgba(255, 255, 255, 0.1);
			--shopping-cover-background: #3b3b3b;
			--shopping-name-color: #ffffff;
			--shopping-secondary-color: #a0a0a0;
			--shopping-surface-background: #2d2d2d;
			--shopping-popup-title-color: #ffffff;
			--shopping-action-background: #3b3b3b;
			--shopping-action-text-color: #d0d0d0;
			--shopping-count-color: #a0a0a0;
			--shopping-empty-color: #a0a0a0;
			--shopping-footer-background: #1f1f1f;
		}

		.popup-panel {
