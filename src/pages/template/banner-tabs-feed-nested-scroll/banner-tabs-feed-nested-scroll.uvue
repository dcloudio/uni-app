<template>
  <scroll-view ref="pageScrollView" class="page" :bounces="false"
  <!-- #ifndef VUE3-VAPOR -->
  @startnestedscroll="onStartNestedScroll" @nestedprescroll="onNestedPreScroll"
  :nested-scroll-child="nestedScrollChildId"
  <!-- #endif -->
  :refresher-triggered="refresherTriggered" refresher-enabled="true" @refresherrefresh="onRefresherrefresh"
    >
    <swiper ref="header" indicator-dots="true" circular="true">
      <swiper-item v-for="i in 3" :item-id="'' + i">
        <image src="/static/shuijiao.jpg" style="width:100% ;height: 240px;"></image>
      </swiper-item>
    </swiper>
    <view class="swiper-list">
      <scroll-view ref="tabScroll" class="swiper-tabs" direction="horizontal" :show-scrollbar="false">
        <view class="flex-row" style="align-self: flex-start;">
          <text ref="swipertab" class="swiper-tabs-item" :class="swiperIndex==index ? 'swiper-tabs-item-active' : ''"
            v-for="(item, index) in swiperList" :key="index" @click="onTabClick(index)">
            {{item.name}}
          </text>
        </view>
        <view ref="indicator" class="swiper-tabs-indicator"></view>
      </scroll-view>
      <swiper ref="swiper" class="swiper-view" :current="swiperIndex" @transition="onSwiperTransition"
        @animationfinish="onSwiperAnimationfinish">
        <swiper-item class="swiper-item" v-for="(item, index) in swiperList" :key="index">
          <long-page ref="longPageRef" :id="item.id" :type="item.type" :preload="item.preload"></long-page>
        </swiper-item>
      </swiper>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
  /**
   * @description: 支持顶部 Banner、横滑分页标签栏和长列表内容联动的嵌套滚动页面。
   * @logic: 页面顶部先展示 Banner 轮播图，再通过横向标签切换不同信息流列表；父级 scroll-view 与子级长列表通过嵌套滚动衔接滚动手势。
   * @optimization: 首屏只预加载当前标签页的数据，切换到其他标签页时再按需触发对应长列表加载，减少初始化内容和滚动联动时的开销。
   */
  import longPage from '../search-header-long-list/long-list-page.uvue';

  type SwiperTabsItem = {
    x : number,
    w : number
  }

  type SwiperViewItem = {
    type : string,
    name : string,
    id: string,
    preload : boolean,
  }

  type JestTabsPageState = {
    swiperIndex : number,
    animationFinishIndex : number,
    tabCount : number,
    currentType : string,
    currentName : string,
    currentPreload : boolean,
    nestedScrollChildId : string,
  }

  type JestLongListState = {
    type : string,
    renderedCount : number,
    currentPage : number,
    loading : boolean,
    isEnded : boolean,
    firstTitle : string,
    mockEnabled : boolean,
  }

  /**
   * 根据权重在两个值之间执行线性插值.
   * @constructor
   * @param {number} value1 - 第一个值，该值应为下限.
   * @param {number} value2 - 第二个值，该值应为上限.
   * @param {number} amount - 应介于 0 和 1 之间，指示内插的权重.
   * @returns {number} 内插值
   */
  function lerpNumber(value1 : number, value2 : number, amount : number) : number {
    return (value1 + (value2 - value1) * amount)
  }

  const swiperList = ref<SwiperViewItem[]>([
    {
      type: 'UpdatedDate',
      name: '最新上架',
      id: "list-id-1",
      preload: true
    },
    {
      type: 'FreeHot',
      name: '免费热榜',
      id: "list-id-2",
      preload: false
    },
    {
      type: 'PaymentHot',
      name: '付费热榜',
      id: "list-id-3",
      preload: false
    },
    {
      type: 'HotList',
      name: '热门总榜',
      id: "list-id-4",
      preload: false
    }
  ])

  const swiperIndex = ref(0)
  const pageScrollView = ref<UniScrollViewElement|null>(null)
  const header = ref<UniElement|null>(null)
  let headerHeight = 0
  let animationFinishIndex = 0
  const tabScroll = ref<UniScrollViewElement|null>(null)
  const indicator = ref<UniElement|null>(null)
  const swiper = ref<UniSwiperElement|null>(null)
  let swiperWidth = 0
  let swiperTabsRect: SwiperTabsItem[] = []
  const nestedScrollChildId = ref("")
  const longPageRef = ref<ComponentPublicInstance[]|null>(null)
  const swipertab = ref<UniTextElement[]|null>(null)
  // 仅在自动化测试程序化切页时启用，避免晚到的旧 animationfinish 把目标索引回写成旧值。
  let isTestFinishGuardEnabled = false

  function onStartNestedScroll() : boolean {
    return true
  }

  function onNestedPreScroll(event : NestedPreScrollEvent) {
    const deltaY = event.deltaY
    const scrollTop = pageScrollView.value!.scrollTop

    if (deltaY > 0) {
      // 向上滚动，如果父容器 header scrollTop < offsetHeight，先滚动父容器
      if (scrollTop < headerHeight) {
        const difference = headerHeight - scrollTop - deltaY
        if (difference > 0) {
          pageScrollView.value!.scrollBy(event.deltaX, deltaY)
          event.consumed(event.deltaX, deltaY)
        } else {
          const top : number = deltaY + difference
          event.consumed(event.deltaX, top)
          pageScrollView.value!.scrollBy(event.deltaX, top)
        }
      }
    }
  }

  function initSwiperItemData(index : number) {
    if (!Number.isFinite(index) || index < 0 || index >= swiperList.value.length) {
      return
    }

    const item = swiperList.value[index]
    const pageRefs = longPageRef.value
    if (!item || pageRefs == null || index >= pageRefs.length || pageRefs[index] == null) {
      return
    }

    if (!item.preload) {
      item.preload = true;
      pageRefs[index].$callMethod('loadData', null)
    }
    //swiper页面切换需要重新赋值嵌套滚动子元素的id
    nestedScrollChildId.value = item.id
  }

  function updateTabIndicator(current_index : number, move_to_index : number, percentage : number) {
    const current_size = swiperTabsRect[current_index]
    const move_to_size = swiperTabsRect[move_to_index]
    if (current_size == null || move_to_size == null) {
      return
    }

    // 计算指示线 左边距 和 宽度 在移动过程中的线性值
    const indicator_line_x = lerpNumber(current_size.x, move_to_size.x, percentage)
    const indicator_line_w = lerpNumber(current_size.w, move_to_size.w, percentage)

    // 更新指示线
    // #ifdef APP
    const x = indicator_line_x + indicator_line_w / 2
    indicator.value?.style?.setProperty('transform', `translateX(${x}px) scaleX(${indicator_line_w})`)
    // #endif
    // #ifdef WEB || MP
    // TODO chrome windows系统 transform scaleX渲染bug
    const x = indicator_line_x
    indicator.value?.style?.setProperty('width', `${indicator_line_w}px`)
    indicator.value?.style?.setProperty('transform', `translateX(${x}px)`)
    // #endif

    // 滚动到水平中心位置
    const scroll_x = x - swiperWidth / 2
    // app 平台后续支持 scrollTo()
    // #ifndef MP-WEIXIN
    tabScroll.value!.scrollLeft = scroll_x
    // #endif
    // #ifdef MP-WEIXIN
    tabScroll.value!.scrollTo({
      left: scroll_x
    })
    // #endif
  }

  function setSwiperIndex(index : number, updateIndicator : boolean) {
    if (swiperIndex.value === index) {
      return
    }

    swiperIndex.value = index

    initSwiperItemData(index)

    if (updateIndicator) {
      updateTabIndicator(index, index, 1)
    }
  }

  function onTabClick(index : number) {
    isTestFinishGuardEnabled = false
    setSwiperIndex(index, false)
  }

  function onSwiperTransition(e : SwiperTransitionEvent) {
    // 微信 skyline 每项完成触发 Animationfinish，偏移值重置
    // 微信 webview 全部完成触发 Animationfinish，偏移值累加
    // 在滑动到下一个项的过程中，再次反向滑动，偏移值递减
    // uni-app-x 和微信 webview 行为一致

    const offset_x = e.detail.dx

    // 首次布局完成前宽度尚未测量，避免除以 0 生成 NaN/Infinity 索引。
    if (!Number.isFinite(swiperWidth) || swiperWidth <= 0 || !Number.isFinite(offset_x)) {
      return
    }

    // 计算当前索引并重置差异
    const current_offset_x = offset_x % swiperWidth
    const current_offset_i = offset_x / swiperWidth
    const current_index = animationFinishIndex + parseInt(current_offset_i + '')

    // 计算目标索引及边界检查
    let move_to_index = current_index
    if (current_offset_x > 0 && move_to_index < swiperList.value.length - 1) {
      move_to_index += 1
    } else if (current_offset_x < 0 && move_to_index > 0) {
      move_to_index -= 1
    }

    // 计算偏移百分比
    const percentage = Math.abs(current_offset_x) / swiperWidth

    // 通知更新指示线
    if (current_index != move_to_index) {
      updateTabIndicator(current_index, move_to_index, percentage)
      // 首次可见时初始化数据
      initSwiperItemData(move_to_index)
    }
  }

  function onSwiperAnimationfinish(e : SwiperAnimationFinishEvent) {
    // 程序化切页时忽略晚到的旧完成事件。
    if (isTestFinishGuardEnabled && e.detail.current != swiperIndex.value) {
      return
    }
    isTestFinishGuardEnabled = false
    setSwiperIndex(e.detail.current, true)
    animationFinishIndex = e.detail.current
  }

  async function cacheTabItemsSize() {
    swiperTabsRect.length = 0;
    const tabs = swipertab.value as UniElement[]
    for (let i = 0; i < tabs.length; i++) {
      const element = tabs[i];
      // #ifdef MP
      const rect = await element.getBoundingClientRectAsync()!
      const x = rect.left
      const w = rect.width
      // #endif
      // #ifndef MP
      const x = element.offsetLeft
      const w = element.offsetWidth
      // #endif
      swiperTabsRect.push({
        x,
        w
      } as SwiperTabsItem)
    }
  }

  const refresherTriggered = ref(false);
  function onRefresherrefresh(e : UniRefresherEvent) {
    refresherTriggered.value = true;
    (longPageRef.value! as ComponentPublicInstance[])[swiperIndex.value].$callMethod('refreshData', () => {
      refresherTriggered.value = false;
    })
  }

  onReady(() => {
    headerHeight = (header.value as UniElement).offsetHeight
    swiper.value?.getBoundingClientRectAsync()!.then((res : DOMRect) : Promise<void> => {
      swiperWidth = res.width
      return cacheTabItemsSize()
    }).then(() => {
      updateTabIndicator(swiperIndex.value, swiperIndex.value, 1)
    });
  })

  // 自动化测试辅助
  function jest_prepareMockData() : boolean {
    const pageRefs = longPageRef.value
    if (pageRefs == null || pageRefs.length == 0) {
      return false
    }

    for (let i = 0; i < pageRefs.length; i++) {
      pageRefs[i].$callMethod('jest_useMockData', i == swiperIndex.value)
      swiperList.value[i].preload = i == swiperIndex.value
    }
    nestedScrollChildId.value = swiperList.value[swiperIndex.value].id
    return true
  }

  function jest_setSwiperCurrent(index : number) : boolean {
    if (index < 0 || index >= swiperList.value.length) {
      return false
    }
    isTestFinishGuardEnabled = true
    swiperIndex.value = index
    initSwiperItemData(index)
    updateTabIndicator(index, index, 1)
    animationFinishIndex = index
    nestedScrollChildId.value = swiperList.value[index].id
    return true
  }

  function jest_getState() : JestTabsPageState {
    const currentItem = swiperList.value[swiperIndex.value]
    return {
      swiperIndex: swiperIndex.value,
      animationFinishIndex: animationFinishIndex,
      tabCount: swiperList.value.length,
      currentType: currentItem.type,
      currentName: currentItem.name,
      currentPreload: currentItem.preload,
      nestedScrollChildId: currentItem.id,
    } as JestTabsPageState
  }

  function jest_getListState(index : number) : JestLongListState | null {
    if (index < 0 || index >= swiperList.value.length || longPageRef.value == null) {
      return null
    }
    return longPageRef.value[index].$callMethod('jest_getState', null) as JestLongListState | null
  }

  defineExpose({
    jest_prepareMockData,
    jest_setSwiperCurrent,
    jest_getState,
    jest_getListState,
  })

</script>

<style>
  .flex-row {
    flex-direction: row;
  }

  .page {
    flex: 1;
  }

  .search-bar {
    padding: 10px;
  }

  .swiper-list {
    height: 100%;
    background-color: var(--background-color, #f8f8f8);
    /* #ifdef WEB */
    flex: 1;
    /* #endif */
  }

  .swiper-tabs {
    background-color: var(--list-background-color, #ffffff);
    flex-direction: column;
  }

  .swiper-tabs-item {
    color: var(--text-color, #555555);
    font-size: 16px;
    padding: 12px 25px;
    white-space: nowrap;
  }

  .swiper-tabs-item-active {
    color: #007AFF;
  }

  .swiper-tabs-indicator {
    width: 1px;
    height: 2px;
    background-color: #007AFF;
  }

  .swiper-view {
    flex: 1;
  }

  .swiper-item {
    /* #ifndef APP-HARMONY */
    flex: 1;
    /* #endif */

    /* #ifdef APP-HARMONY */
    /* 临时兼容，非蒸汽，harmony 高度异常 */
    height: 100%;
    /* #endif */
  }
</style>
