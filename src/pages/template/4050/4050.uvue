<template>
    <text>1帧内显示110个元素。勿使用debug方式运行来测试性能</text>
    <text>当前页面：拍平示例（启用 flatten）</text>
		<view>
		    <view class="flex-dir-row" v-for="(_) in 5" flatten>
		        <view v-for="(_,i) in 10" style="background-color: #85d8b4;margin: 0.5px;" flatten>
		            <text flatten>{{i}}</text>
		        </view>
		    </view>
		</view>
    <view class="h-48 m-16 bg-1677ff radius-8 justify-center items-center" @click="ShowEvent()">
        <text class="color-fff">同屏显示4050个元素</text>
    </view>
		<view>
        <view v-if="show" class="flex-dir-row" v-for="(_) in 50" flatten>
            <view v-for="(_,i) in 40" style="background-color: #85d8b4;margin: 0.5px;" flatten>
                <text style="font-size: 5px;line-height: 5px;" flatten>{{i}}</text>
            </view>
        </view>
    </view>

</template>

<script setup lang="ts">
    const show = ref(false);
    let isBackPress = false;
    let startime = Date.now();
    const ShowEvent = (() => {
			startime = Date.now();
      show.value = !show.value
			// nextTick(() => {
			// 	const endtime = Date.now();
			// 	console.log('nextTick duration', endtime - startime);
			// })
    });

		// #ifdef APP
    // const instance = getCurrentInstance();
    const insPage = getCurrentInstance().proxy.$page;
    insPage.onRenderChange(({ duration }) => {
      if (isBackPress) { return }
			const endtime = Date.now();
			uni.showToast({
				title: `${endtime - startime}ms`,
			})
			console.log(`show.value :${show.value} total duration(click -> render end):${endtime - startime}  render duration:${duration}`)
    });
		// #endif
		onBackPress(() => {
			show.value = false
      isBackPress = true
		});

</script>
