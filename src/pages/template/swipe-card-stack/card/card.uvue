<template>
  <view class="card" ref="card" @touchstart="touchstart($event as TouchEvent)"
    @touchmove="touchmove($event as TouchEvent)" @touchend="touchend" @touchcancel="touchend">
    <view class="card-content" ref="cardContent" :style="{ backgroundColor: color }"></view>
    <view class="state">
      <image class="state-icon like" ref="stateIconLike" src="/static/template/drop-card/like.png" mode="widthFix">
      </image>
      <image class="state-icon dislike" ref="stateIconDislike" src="/static/dislike.png"
        mode="widthFix"></image>
      <!-- cardIndex:{{cardIndex}} -->
    </view>
  </view>
</template>
<script setup lang="ts">
/**
 * @description: 作为卡片堆叠中的单张卡片，支持拖拽跟手、状态提示和划走动画。
 * @logic: 记录手势起点后实时更新卡片位移与旋转角度，松手时根据水平位移判断回弹或飞出，并通知父级更新堆叠顺序。
 * @optimization: 通过缓存模板元素引用并直接更新 transform 和 opacity，降低拖拽过程中的样式计算与节点查询开销。
 */
// Template refs
const card = ref<UniElement | null>(null)
const cardContent = ref<UniElement | null>(null)
const stateIconLike = ref<UniElement | null>(null)
const stateIconDislike = ref<UniElement | null>(null)

// Props
const props = defineProps({
  color: {
    type: String,
    default: '#4F6D9B'
  },
  cardIndex: {
    type: Number,
    default: 0
  },
  stackIndex: {
    type: Number,
    default: 0
  },
  windowWidth: {
    type: Number,
    default: 0
  },
  windowHeight: {
    type: Number,
    default: 0
  }
})
// Module-level variables
let sX : number = 0
let sY : number = 0
let floating : boolean = false
let touchstartAfter : boolean = false

// Data
const $elementMap = new Map<string, UniElement>()
const x = ref(0 as number)
const y = ref(0 as number)

// Computed
const movePercent = computed(() : number => {
  return Math.abs(x.value) / (Math.max(1, props.windowWidth) / 2 * 3)
})

const likeOpacity = computed(() : number => {
  return x.value < 0 ? 0 : movePercent.value * 100
})

const dislikeOpacity = computed(() : number => {
  return x.value > 0 ? 0 : movePercent.value * 100
})

// Methods
function getTouchX(touch : Touch) : number {
  if (touch.pageX >= 0) {
    return touch.pageX
  }
  if (touch.clientX >= 0) {
    return touch.clientX
  }
  return touch.screenX >= 0 ? touch.screenX : 0
}

function getTouchY(touch : Touch) : number {
  if (touch.pageY >= 0) {
    return touch.pageY
  }
  if (touch.clientY >= 0) {
    return touch.clientY
  }
  return touch.screenY >= 0 ? touch.screenY : 0
}

function setElementStyle(refName : string, propertyName : string, propertyStyle : any) : void {
  let element : UniElement | null = $elementMap.get(refName)
  if (element == null) {
    // Map ref name to corresponding ref variable
    if (refName == 'card') {
      element = card.value
    } else if (refName == 'card-content') {
      element = cardContent.value
    } else if (refName == 'state-icon-like') {
      element = stateIconLike.value
    } else if (refName == 'state-icon-dislike') {
      element = stateIconDislike.value
    }

    if (element != null) {
      $elementMap.set(refName, element)
    }
  }

  if (element != null) {
    element.style.setProperty(propertyName, propertyStyle.toString())
  }
}

let _index = 0
function initCardStyle() {
  _index = props.stackIndex
  const stackOffset = Math.max(30, props.windowHeight * 0.03)
  // TODO 临时处理 setProperty设置z-index无效的问题
  setElementStyle('card', 'z-index', _index.toString())
  // 将整个卡片堆按层间距补偿回可视区域中心。
  setElementStyle('card', 'margin-top', props.windowHeight * 0.15 + stackOffset - stackOffset * _index + 'px')
  setElementStyle('card', 'transform', 'scale(' + (0.9 + 0.05 * _index) + ')')
}

function moveCard() {
	if (_index != 2){
		// console.log('不是顶层卡片不允许移动')
		return
	}
  setElementStyle("card",
    'transform',
    `translate(${x.value}px,${y.value}px) rotate(${x.value / -30}deg) scale(1)`
  )
  setElementStyle("state-icon-like", 'opacity', x.value < 0 ? 0 : movePercent.value * 10)
  setElementStyle("state-icon-dislike", 'opacity', x.value > 0 ? 0 : movePercent.value * 10)
}

function touchstart(e : TouchEvent) {
  e.preventDefault()
  if (props.stackIndex != 2 || floating) {
    return
  }
  const touch = e.touches[0]
  if (touch == null) {
    return
  }
  sX = getTouchX(touch)
  sY = getTouchY(touch)
  x.value = 0
  y.value = 0
  touchstartAfter = true
}

function touchmove(e : TouchEvent) {
  e.preventDefault()
  if (!touchstartAfter || floating) {
    return
  }
  const touch = e.touches[0]
  if (touch == null) {
    return
  }
  const touchX = getTouchX(touch)
  const touchY = getTouchY(touch)
  x.value += touchX - sX
  y.value += touchY - sY
  sX = touchX
  sY = touchY
  moveCard()
}

function touchend() {
  if (!touchstartAfter || floating) {
    return
  }
  touchstartAfter = false
  floating = true

  let k : number = 0
  if (x.value > props.windowWidth / 10) {
    k = 1
  } else if (x.value < props.windowWidth * -1 / 10) {
    k = -1
  }

  function cardTo(targetX : number, targetY : number, callback : () => void, speed : number = 10) {
    let interval : number = 0
    let acceleration : number = 1
    let frameCount : number = 0
    let completed : boolean = false
    interval = setInterval(() => {
      frameCount++
      acceleration += 0.2

      const dx = targetX - x.value
      if (Math.abs(dx) < 1) {
        x.value = targetX
      } else {
        x.value += dx / speed * acceleration
      }

      const dy = targetY - y.value
      if (Math.abs(dy) < 1) {
        y.value = targetY
      } else {
        y.value += dy / speed * acceleration
      }

      moveCard()
      if ((Math.abs(targetX - x.value) < 1 && Math.abs(targetY - y.value) < 1) || frameCount >= 120) {
        x.value = targetX
        y.value = targetY
        if (completed) {
          return
        }
        completed = true
        clearInterval(interval)
        callback()
      }
    }, 16)
  }

  if (Math.floor(k) != 0) {
    cardTo(k * props.windowWidth * 1.3, y.value * 3, () => {
      setElementStyle("state-icon-like", 'opacity', 0)
      setElementStyle("state-icon-dislike", 'opacity', 0)
      setElementStyle("card", 'opacity', 0)
      setTimeout(() => {
        setElementStyle("card", 'opacity', 1)
      }, 300)
      x.value = 0
      y.value = 0
      uni.$emit('swipe-card-stack-swiped', props.cardIndex)
      floating = false
    }, 8)
  } else {
    const _x : number = x.value
    const _y : number = y.value
    cardTo(Math.floor(_x * -0.05), Math.floor(_y * -0.05), () => {
      cardTo(0, 0, () => {
        console.log('bounce')
        floating = false
      }, 30)
    })
  }
}

// Lifecycle
function applyCardLayout() : void {
  if (props.windowWidth <= 0 || props.windowHeight <= 0) {
    return
  }

  const cardHeight = props.windowHeight * 0.7
  const horizontalPadding = 24
  const availableWidth = Math.max(0, props.windowWidth - horizontalPadding)
  // 窄屏尽量利用可用宽度，宽屏收窄卡片，避免卡片过度横向拉伸。
  const cardWidth = props.windowWidth < 700
    ? availableWidth
    : Math.min(availableWidth, props.windowWidth * 0.6)
  const sideMargin = Math.max(12, (props.windowWidth - cardWidth) / 2)
  setElementStyle('card', 'height', cardHeight + 'px')
  setElementStyle('card-content', 'height', cardHeight + 'px')
  setElementStyle('card', 'width', cardWidth + 'px')
  setElementStyle('card', 'margin-left', sideMargin + 'px')
  setElementStyle('card', 'margin-right', sideMargin + 'px')
  initCardStyle()
}

onMounted(() => {
  setTimeout(() => {
    applyCardLayout()
  }, 200)
})

watch(() => props.stackIndex, () => {
  applyCardLayout()
})

watch(() => props.windowWidth, () => {
  applyCardLayout()
})

watch(() => props.windowHeight, () => {
  applyCardLayout()
})

defineOptions({
  options: {
    virtualHost: true
  }
})
</script>

<style>
  .card {
    width: calc(100% - 24px);
    height: 70%;
    box-sizing: border-box;
    position: absolute;
    top: 0px;
    /* left: 0px; */
    margin: 0 12px;
    margin-top: 50px;
    border-radius: 10px;
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
    background-color: #FFF;
    transition: margin-top 300ms;
    transition-timing-function: ease-in;
  }

  .card-content {
    width: 100%;
    height: 100%;
    border-radius: 10px;
  }

  .state {
    top: 10px;
    left: 10px;
    width: 86%;
    padding: 4px;
    position: absolute;
    flex-direction: row;
    justify-content: space-between;
  }

  .state-icon {
    width: 30px;
    height: 30px;
    border: 1px solid #FFF;
    background-color: #FFF;
    padding: 3px;
    border-radius: 100px;
    box-shadow: 0 0 1px #EBEBEB;
    opacity: 0;
  }
</style>
