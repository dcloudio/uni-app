<template>
  <view class="area">
    <page-intro content="本页演示 WXS/SJS（script module）：在 wxs/sjs 中导出 setColor、touchstart、touchmove 等，通过 ins.setStyle 改样式、ins.selectComponent 取子节点并设 left/top 实现拖拽；上方点击文字变红，下方橙色块可触摸拖拽移动。"></page-intro>
    <view @click="test.setColor" class="setColor">点击变成红色: {{test.msg}}</view>
    <view @touchstart="test.touchstart" @touchmove="test.touchmove" class="movable">{{test.msg}}</view>
  </view>
</template>
<!-- #ifdef MP-ALIPAY -->
<script src="./test.sjs" module="test" lang="sjs"></script>
<!-- #endif -->
<!-- #ifndef MP-ALIPAY -->
<script module="test" lang="wxs">
  var startX = 0
  var startY = 0
  var lastLeft = 50;
  var lastTop = 50

  function touchstart(event, ins) {
    console.log("touchstart")
    var touch = event.touches[0] || event.changedTouches[0]
    startX = touch.pageX
    startY = touch.pageY
  }

  function touchmove(event, ins) {
    console.log("touchmove")
    var touch = event.touches[0] || event.changedTouches[0]
    var pageX = touch.pageX
    var pageY = touch.pageY
    var left = pageX - startX + lastLeft
    var top = pageY - startY + lastTop
    startX = pageX
    startY = pageY
    lastLeft = left
    lastTop = top
    ins.selectComponent('.movable').setStyle({
      left: left + 'px',
      top: top + 'px'
    })
    return false
  }

  module.exports = {
    msg: 'Hello',
    touchstart: touchstart,
    touchmove: touchmove,
    setColor: function(event,ins) {
      ins.setStyle({
        color: "red"
      })
    }
  }
</script>
<!-- #endif -->
<script setup lang="ts">
  /**
   * @description: 演示 WXS 脚本模块如何响应点击和触摸事件，并驱动页面元素变色与拖拽移动。
   * @logic: 点击上方文字时通过 WXS 调用 `setStyle` 修改文本颜色，拖动下方色块时通过 WXS 记录触点位移并实时更新元素位置。
   * @optimization: 把交互逻辑放在 WXS 模块内直接处理样式和位置更新，减少页面脚本参与，让事件响应链路更直接。
   */
</script>
<style>
  .area {
    position: absolute;
    width: 100%;
    height: 100%;
  }
  .movable {
    position: absolute;
    width: 100px;
    height: 100px;
    left: 50px;
    top: 50px;
    color: #fff000;
    text-align: center;
    line-height: 100px;
    background-color: #ff5500;
  }
</style>
