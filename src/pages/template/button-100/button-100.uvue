<template>
    <!-- #ifndef MP -->
    <fps />
    <!-- #endif -->

    <!-- 控制按钮 -->
    <view class="u-p-2 flex-dir-row flex-wrap-wrap items-center">
      <button @click="toggleDisabled" :type="sharedDisabled ? 'primary' : 'default'" size="mini" class="m-2">{{ sharedDisabled ? '启用' : '禁用' }}</button>
      <button @click="togglePlain" :type="sharedPlain ? 'primary' : 'default'" size="mini" class="m-2">{{ sharedPlain ? '实心' : '镂空' }}</button>
      <button @click="cycleType" size="mini" class="m-2">type: {{ sharedType }}</button>
      <button @click="cycleSize" size="mini" class="m-2">size: {{ sharedSize }}</button>
    </view>

    <!-- 100个button组件 -->
    <view class="flex-dir-row flex-wrap-wrap p-5">
      <view class="items-center w-15pct m-4rpx" v-for="index in 100" :key="index">
        <button
          :disabled="sharedDisabled"
          :plain="sharedPlain"
          :type="sharedType"
          :size="sharedSize"
          @click="onButtonClick(index)"
          class="w-full"
        >
          {{ index }}
        </button>
      </view>
    </view>
</template>

<script setup lang="ts">
  const sharedDisabled = ref(false)
  const sharedPlain = ref(false)
  const sharedType = ref('default')
  const sharedSize = ref('mini')

  function toggleDisabled() {
    sharedDisabled.value = !sharedDisabled.value
    console.log('disabled:', sharedDisabled.value)
  }

  function togglePlain() {
    sharedPlain.value = !sharedPlain.value
    console.log('plain:', sharedPlain.value)
  }

  const types = ['default', 'primary', 'warn']
  let typeIndex = 0
  const sizes = ['mini', 'default']
  let sizeIndex = 0

  function cycleType() {
    typeIndex = (typeIndex + 1) % types.length
    sharedType.value = types[typeIndex]
    console.log('type:', sharedType.value)
  }

  function cycleSize() {
    sizeIndex = (sizeIndex + 1) % sizes.length
    sharedSize.value = sizes[sizeIndex]
    console.log('size:', sharedSize.value)
  }

  function onButtonClick(index : number) {
    console.log('button clicked:', index - 1)
  }
</script>
