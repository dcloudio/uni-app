    border-radius: 8px;
    flex-direction: row;
    background-color: var(--background-color, #eef1f4);
  }

  .order-option {
    flex: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
  }

  .order-option-default {
    background-color: transparent;
  }

  .order-option-active {
    background-color: var(--list-background-color, #ffffff);
    box-shadow: 0px 2px 6px rgba(33, 45, 58, 0.12);
  }

  .order-option-hover {
    opacity: 0.72;
  }

  .order-option-text {
