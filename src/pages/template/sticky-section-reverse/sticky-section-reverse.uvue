    background-color: #edf7f2;
  }

  .section-count-value {
    font-size: 20px;
    line-height: 24px;
    font-weight: 700;
    color: #147a51;
  }

  .section-count-label {
    margin-left: 3px;
    font-size: 12px;
    line-height: 18px;
    color: #3f725f;
  }

  .order-switch {
    height: 44px;
    margin-top: 14px;
