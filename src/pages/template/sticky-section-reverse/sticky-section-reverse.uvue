  }

  .order-option-text-default {
    color: var(--text-color-secondary, #68717c);
  }

  .order-option-text-active {
    color: #176b50;
  }

  .range-row {
    margin-top: 14px;
    flex-direction: row;
    align-items: center;
  }

  .range-item {
    flex: 1;
    flex-direction: row;
    align-items: center;
  }

  .range-item-right {
    justify-content: flex-end;
  }

  .range-label {
    font-size: 12px;
    line-height: 18px;
    color: var(--text-color-secondary, #8a929c);
  }

  .range-value {
    margin-left: 7px;
