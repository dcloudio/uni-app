<template>
    <page-intro
      style="margin: 10px 0;"
      content="本页演示支付宝小程序自定义组件：父组件通过属性向 my-counter 传值，监听 change 回调更新计数，并通过 ref 调用子组件 increment/decrement 方法。"
    ></page-intro>
    <view class="pt-20">
      <text class="mt-10 color-text-333 fs-15 lh-22">父组件中的值：{{ data.count }}</text>
      <text class="mt-10 color-text-333 fs-15 lh-22">已收到 change 回调：{{ data.changeCount }} 次</text>

      <view class="mt-20 items-flex-start">
        <my-counter
          ref="nativeCounter"
          :initial-count="data.count"
          :step="data.step"
          :min="0"
          :max="20"
          @change="onCounterChange"
        ></my-counter>
      </view>
    </view>
</template>

<script setup lang="ts">
  type CounterChangeDetail = {
    value : number
  }

  type DataType = {
    count : number
    step : number
    changeCount : number
  }

  const nativeCounter = ref(null)

  const data = reactive<DataType>({
    count: 4,
    step: 2,
    changeCount: 0
  })

  function onCounterChange(detail : CounterChangeDetail) {
    data.count = detail.value
    data.changeCount += 1
  }

  function decrement() {
    nativeCounter.value?.decrement()
  }

  function increment() {
    nativeCounter.value?.increment()
  }

  defineExpose({
    data,
    decrement,
    increment
  })
</script>

<style>
page {
  padding: 0px 24px 32px;
}
</style>
