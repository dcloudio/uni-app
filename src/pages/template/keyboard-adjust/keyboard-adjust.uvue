<template>
    <uni-nav-bar :navigationBarTextStyle="navigationBarTextColor">
      <template #left>
        <uni-backarrow-circle auto-back class="back-arrow"></uni-backarrow-circle>
      </template>
      <template #mid>
        <text class="nav-title">{{ title }}</text>
      </template>
    </uni-nav-bar>
    <view class="items-center">
      <enum-data-checkbox
        :model-value="data.indexView.toString()"
        :items="viewOptions"
        mode="default"
        :show-toast="false"
        @change="ChangeView"
      />
    </view>
    <scroll-view v-if="data.indexView==0" class="scroll-view" :refresher-enabled="false">
      <view class="content-item" v-for="item in 10">
        <view class="cell-item">
          <text class="text">内容：{{item}}</text>
          <input class="input-text" style="margin-top: 8px;" placeholder="备注输入框:" :id="`input-in-scroll-view-${item}`" :focus="item == 5 ? data.scrollViewInputFocus : false" />
        </view>
      </view>
    </scroll-view>
    <list-view v-if="data.indexView==1" class="scroll-view">
      <list-item class="content-item" v-for="item in 10" :key="item">
        <view class="cell-item">
          <text class="text">列表项内容：{{item}}</text>
          <input class="input-text" style="margin-top: 8px;" placeholder="备注输入框:" :id="`input-in-list-view-${item}`" :focus="item == 5 ? data.listViewInputFocus : false" />
        </view>
      </list-item>
    </list-view>
    <web-view v-if="data.indexView==2" src="/hybrid/html/local.html" id="webv" class="scroll-view"></web-view>
    <view ref="refInputBottom" class="bottomInput" :style="{transform: inputTranslate}">
      <input class="bottom-input" placeholder="滚动视图外底部输入框，焦点时手动控制显示位置" :adjust-position="false" @focus="onInputFocus" @blur="onInputBlur" />
    </view>
</template>

<script setup lang="ts">
  const viewOptions = [
    { value: '0', text: 'scroll-view' },
    { value: '1', text: 'list-view' },
    // #ifndef MP
    { value: '2', text: 'web-view' },
    // #endif
  ]

  /**
   * @description: 演示软键盘弹起时，scroll-view、list-view、web-view 等容器中的输入框避让与底部输入框位置调整效果。
   * @logic: 页面通过切换不同容器场景，对比输入框获取焦点后的页面表现，并在底部输入框中监听键盘高度变化实现手动避让。
   * @optimization: 统一复用键盘高度变化处理逻辑，并在 iOS 与 HarmonyOS 平台扣除安全区高度，减少不同场景下的重复适配。
   */
  const currentPage = getCurrentInstance()?.proxy?.$page

  import { state, setLifeCycleNum as setLifeCycleNumStore } from '@/store/index.ts'

  const title = ref('输入框上推示例')
  const navigationBarTextColor = ref('#000')
  const data = reactive({
    indexView: 0,
    scrollViewInputFocus: false,
    listViewInputFocus: false,
  })
  const inputTranslate = ref('translateY(0px)')
  const refInputBottom = ref<UniElement | null>(null)
  let inputFocused = false
  let inputTranslateY = 0
  let inputBlured = false
  let inputBluredTimer = 0

  // 自动化测试
  function setLifeCycleNum(num : number) {
    setLifeCycleNumStore(num)
  }

  function setNavigationBarColor1() {
    uni.setNavigationBarColor({
      frontColor: '#ffffff',
      backgroundColor: '#0000',
      success: () => {
        navigationBarTextColor.value = '#fff'
        console.log('setNavigationBarColor success')
        setLifeCycleNum(state.lifeCycleNum + 1)
      },
      fail: () => {
        console.log('setNavigationBarColor fail')
        setLifeCycleNum(state.lifeCycleNum - 1)
      },
      complete: () => {
        console.log('setNavigationBarColor complete')
        setLifeCycleNum(state.lifeCycleNum + 1)
      }
    })
  }

  function setNavigationBarColor2() {
    uni.setNavigationBarColor({
      frontColor: '#000000',
      backgroundColor: '#0000',
      success: () => {
        navigationBarTextColor.value = '#000'
        console.log('setNavigationBarColor success')
        setLifeCycleNum(state.lifeCycleNum + 1)
      },
      fail: () => {
        console.log('setNavigationBarColor fail')
        setLifeCycleNum(state.lifeCycleNum - 1)
      },
      complete: () => {
        console.log('setNavigationBarColor complete')
        setLifeCycleNum(state.lifeCycleNum + 1)
      }
    })
  }

  function ChangeView(value : string){
    data.indexView = parseInt(value)
  }

  function onKeyboardAnimationChange(e: UniKeyboardAnimationChangeEvent) {
    let height = e.height
    // #ifdef APP
    if (currentPage != null && height > currentPage.safeAreaInsets.bottom) {
      height -= currentPage.safeAreaInsets.bottom
    }
    // #endif
    if(inputFocused){
      inputTranslateY = height>0?-height:0
      refInputBottom.value?.style.setProperty('transform', `translateY(${inputTranslateY}px)`)
      if(0!=inputBluredTimer && 'running'==e.state){
        clearTimeout(inputBluredTimer)
        inputBlured = true
        inputBluredTimer = 0
      }
      if(inputBlured && 'end'==e.state && 0==height){
        inputFocused = false
      }
    }
  }

  function onInputFocus(_: UniInputFocusEvent) {
    inputFocused = true
    inputBlured = false
  }

  function onInputBlur(_:UniInputBlurEvent) {
    if(0 == inputTranslateY){
      inputFocused = false
      inputBlured = true
    }else{
      inputBluredTimer = setTimeout(() => {
        inputTranslateY = 0
        refInputBottom.value?.style.setProperty('transform', `translateY(${inputTranslateY}px)`)
        inputBluredTimer = 0
        inputFocused = false
      }, 300)
    }
  }

  // 自动化测试
  function getLifeCycleNum() : number {
    return state.lifeCycleNum
  }

  defineExpose({
    getLifeCycleNum,
    setLifeCycleNum,
    setNavigationBarColor1,
    setNavigationBarColor2,
    data
  })

  // 页面加载时监听键盘高度变化
  onMounted(() => {
    uni.onKeyboardAnimationChange(onKeyboardAnimationChange)
  })
  // 页面卸载时清理监听
  onUnmounted(() => {
    uni.offKeyboardAnimationChange(onKeyboardAnimationChange)
  })
</script>

<style>
.items-center {
  align-items: center;
}


  /* 导航栏已处理顶部安全区，按钮无需重复偏移。 */
  .back-arrow {
    margin-top: 0;
  }

  .content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .nav-title,
  .section-title,
  .option-text {
    color: var(--text-color, #333333);
  }

  .scroll-view {
    flex: 1;
    background-color: var(--background-color, #f5f5f5);
    padding: 5px 0;
  }

  .view-radio-group {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .view-radio-item {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .content-item {
  }

  .cell-item {
    display: flex;
    flex-direction: column;
    padding: 15px;
    margin: 5px 10px;
    background-color: var(--list-background-color, #ffffff);
    border-radius: 5px;
  }

  .text {
    font-size: 14px;
    color: var(--text-color, #666666);
    opacity: 0.75;
  }

  .input-text,
  .bottom-input {
    color: #333333;
    background-color: #ffffff;
  }

  .bottomInput {
    position: relative;
    z-index: 1000;
    padding: 0 5px;
    margin-bottom: var(--uni-safe-area-inset-bottom);
    bottom: 0px;
  }

  @media (prefers-color-scheme: dark) {
    .input-text,
    .bottom-input {
      color: #ffffff;
      background-color: #2d2d2d;
    }
  }
</style>
