<template>
    <uni-nav-bar :navigationBarTextStyle="navigationBarTextColor">
      <template #left>
        <uni-back-arrow-circle :auto-back="true"></uni-back-arrow-circle>
      </template>
      <template #mid>
        <text class="color-text-333">{{ title }}</text>
      </template>
    </uni-nav-bar>
    <view class="items-center">
      <text class="color-text-333">输入框上推示例</text>
      <enum-data-checkbox
        :model-value="data.indexView.toString()"
        :items="viewOptions"
        mode="default"
        :show-toast="false"
        @change="ChangeView"
      />
    </view>
    <scroll-view v-if="data.indexView==0" class="flex-1 bg-page-f5f5f5 p-5-0" :refresher-enabled="false">
      <view v-for="item in 10">
        <view class="d-flex flex-dir-column u-p-15 m-5-10 bg-list-fff radius-5">
          <text class="fs-14 color-text-666 opacity-0_75">内容：{{item}}</text>
          <input class="input-text color-333 bg-fff mt-8" placeholder="备注输入框:" :id="`input-in-scroll-view-${item}`" :focus="item == 5 ? data.scrollViewInputFocus : false" />
        </view>
      </view>
    </scroll-view>
    <list-view v-if="data.indexView==1" class="flex-1 bg-page-f5f5f5 p-5-0">
      <list-item v-for="item in 10" :key="item">
        <view class="d-flex flex-dir-column u-p-15 m-5-10 bg-list-fff radius-5">
          <text class="fs-14 color-text-666 opacity-0_75">列表项内容：{{item}}</text>
          <input class="input-text color-333 bg-fff mt-8" placeholder="备注输入框:" :id="`input-in-list-view-${item}`" :focus="item == 5 ? data.listViewInputFocus : false" />
        </view>
      </list-item>
    </list-view>
    <web-view v-if="data.indexView==2" src="/hybrid/html/local.html" id="webv" class="flex-1 bg-page-f5f5f5 p-5-0"></web-view>
    <view class="pos-relative bottomInput z-index-1000 p-0-5" :style="{bottom: inputBottom}">
      <input id="input" class="bottom-input color-333 bg-fff" placeholder="滚动视图外底部输入框，焦点时手动控制显示位置" :adjust-position="false" @blur="onInputBlur" @keyboardheightchange="onInputKeyboardChange" />
    </view>
</template>

<script setup lang="ts">
  const viewOptions = [
    { value: '0', text: 'scroll-view' },
    { value: '1', text: 'list-view' },
    // #ifndef MP
    { value: '2', text: 'web-view' },
    // #endif
  ]

  /**
   * @description: 演示软键盘弹起时，scroll-view、list-view、web-view 等容器中的输入框避让与底部输入框位置调整效果。
   * @logic: 页面通过切换不同容器场景，对比输入框获取焦点后的页面表现，并在底部输入框中监听键盘高度变化实现手动避让。
   * @optimization: 统一复用键盘高度变化处理逻辑，并在 iOS 与 HarmonyOS 平台扣除安全区高度，减少不同场景下的重复适配。
   */
  const currentPage = getCurrentInstance()?.proxy?.$page

  import { state, setLifeCycleNum as setLifeCycleNumStore } from '@/store/index.ts'

  const title = ref('输入框上推示例')
  const navigationBarTextColor = ref('#000')
  const data = reactive({
    indexView: 0,
    scrollViewInputFocus: false,
    listViewInputFocus: false,
  })
  const inputBottom = ref('0px')

  // 自动化测试
  function setLifeCycleNum(num : number) {
    setLifeCycleNumStore(num)
  }

  function setNavigationBarColor1() {
    uni.setNavigationBarColor({
      frontColor: '#ffffff',
      backgroundColor: '#0000',
      success: () => {
        navigationBarTextColor.value = '#fff'
        console.log('setNavigationBarColor success')
        setLifeCycleNum(state.lifeCycleNum + 1)
      },
      fail: () => {
        console.log('setNavigationBarColor fail')
        setLifeCycleNum(state.lifeCycleNum - 1)
      },
      complete: () => {
        console.log('setNavigationBarColor complete')
        setLifeCycleNum(state.lifeCycleNum + 1)
      }
    })
  }

  function setNavigationBarColor2() {
    uni.setNavigationBarColor({
      frontColor: '#000000',
      backgroundColor: '#0000',
      success: () => {
        navigationBarTextColor.value = '#000'
        console.log('setNavigationBarColor success')
        setLifeCycleNum(state.lifeCycleNum + 1)
      },
      fail: () => {
        console.log('setNavigationBarColor fail')
        setLifeCycleNum(state.lifeCycleNum - 1)
      },
      complete: () => {
        console.log('setNavigationBarColor complete')
        setLifeCycleNum(state.lifeCycleNum + 1)
      }
    })
  }

  function ChangeView(value : string){
    data.indexView = parseInt(value)
  }

  function onInputBlur(event:UniInputBlurEvent) {
    inputBottom.value = '0px';
  }

  function onInputKeyboardChange(e:UniInputKeyboardHeightChangeEvent) {
    let height = e.detail.height;
    // #ifdef APP-IOS || APP-HARMONY
    if(height>0 && currentPage != null){  //iOS与HarmonyOS平台软键盘的高度已经包含了安全区域高度，这里需要减掉
      height -= currentPage.safeAreaInsets.bottom;
    }
    // #endif
    inputBottom.value = `${height}px`;
  }

  // 自动化测试
  function getLifeCycleNum() : number {
    return state.lifeCycleNum
  }

  defineExpose({
    getLifeCycleNum,
    setLifeCycleNum,
    setNavigationBarColor1,
    setNavigationBarColor2,
    data
  })
</script>

<style>
  .bottomInput {
    margin-bottom: var(--uni-safe-area-inset-bottom);
  }

  @media (prefers-color-scheme: dark) {
    .input-text,
    .bottom-input {
      color: #ffffff;
      background-color: #2d2d2d;
    }
  }
</style>
