<template>
    <!-- #ifndef MP -->
    <fps />
    <!-- #endif -->

    <!-- 控制按钮区域 -->
    <view class="u-p-2 flex-dir-row flex-wrap-wrap items-center">
      <button @click="toggleAll" size="mini" class="m-2">{{ sharedChecked ? '取消' : '全选' }}</button>
    </view>

    <!-- 100个label+checkbox组合 -->
    <checkbox-group class="flex-dir-row flex-wrap-wrap u-p-2" @change="onGroupChange">
      <label class="m-4rpx items-center flex-dir-column" v-for="index in 100" :key="index" style="width: 12%;padding: 1px;">
        <text class="fs-9 color-666 mb-2">{{ index }}</text>
        <checkbox :value="index.toString()" :checked="sharedChecked" />
      </label>
    </checkbox-group>
</template>

<script setup lang="ts">
  const sharedChecked = ref(false)

  function toggleAll() {
    sharedChecked.value = !sharedChecked.value
    console.log('切换全选状态:', sharedChecked.value)
  }

  function onGroupChange(e : UniCheckboxGroupChangeEvent) {
    console.log('checkbox-group change:', e.detail.value)
  }
</script>
