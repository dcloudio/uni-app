<template>
  <view class="u-p-15">
    <view v-if="!hasLeftWin" class="p-15-15 flex-dir-column justify-center items-center u-mt-5">
      <image class="w-80 h-80" src="/static/extuiIndex.png"></image>
    </view>
    <view v-if="!hasLeftWin" class="mb-20">
      <text class="color-text-333 fs-14 lh-20">uni-ui x 扩展组件示例，文档详见：</text>
      <uni-link class="color-text-333 fs-14 lh-20" href="https://doc.dcloud.net.cn/uni-app-x/component/uni-ui-x"
      <!-- #ifndef MP -->
      target="_blank"
      <!-- #endif -->
      >
        https://doc.dcloud.net.cn/uni-app-x/component/uni-ui-x
      </uni-link>
    </view>
    <uni-collapse>
      <template v-for="(item, index) in list" :key="item.id">
        <uni-collapse-item v-if="item.pages.length > 0" class="mb-12" :open="item.open" :title="item.name"
          title-wrap-class="bg-list-fff-important" title-class="color-text-333-important"
          content-wrap-class="bg-list-fff-important" arrow-class="border-r-color-arrow-999-important border-b-color-arrow-999-important"
          @change="syncCollapseState(index, $event as boolean)">
          <view class="flex-dir-row items-center bg-list border-t-style-solid border-t-color-border border-t-width-1 p-12-16 justify-between pl-18"
            :hover-class="page.enable == false ? '' : 'bg-active'" v-for="(page, key) in item.pages" :key="key"
            @click="goDetailPage(page)">
            <text class="color-text-333 fs-14 fw-normal w-94pct ws-nowrap overflow-hidden text-overflow-ellipsis"
              :class="{'color-007aff-important': leftWinActive === getPageKey(page.url) && hasLeftWin,'color-active-important' : page.enable == false}">{{ page.name }}</text>
            <view class="w-8 h-8 ml-12 transform-rotate-neg45deg border-r-width-1 border-r-style-solid border-r-color-arrow-999 border-b-width-1 border-b-style-solid border-b-color-arrow-999"></view>
          </view>
        </uni-collapse-item>
        <view v-else class="mb-12">
          <view hover-class="bg-active" class="bg-list flex-dir-row-important justify-between-important items-center-important p-12 p-12-18" @click="triggerCollapse(index, item)">
            <text class="color-text-333 fs-14 fw-normal"
              :class="{
                'color-active-important': item.enable == false || item.open == true,
                'color-007aff-important': getPageKey(item.url!) == leftWinActive && hasLeftWin
              }">{{ item.name }}</text>
            <view class="w-8 h-8 ml-12 transform-rotate-neg45deg border-r-width-1 border-r-style-solid border-r-color-arrow-999 border-b-width-1 border-b-style-solid border-b-color-arrow-999"></view>
          </view>
        </view>
      </template>
    </uni-collapse>
  </view>
</template>

<script setup lang="ts">
  defineOptions({
    styleIsolation: 'app'
  })

  type Page = {
    name : string
    enable ?: boolean
    url : string
  }

  type ListItem = {
    id : string
    name : string
    open : boolean
    pages : Page[]
    url ?: string
    enable ?: boolean
  }

  import { state } from '@/store/index.ts'

  const list = ref<ListItem[]>([
    {
      id: 'badge',
      name: 'uni-badge-view 数字角标',
      open: false,
      url: '/pages/uni-ui/badge-view/badge-view',
      pages: [] as Page[]
    },
    {
      id: 'backarrow-circle',
      name: 'uni-backarrow-circle 圆形返回按钮',
      open: false,
      url: '/pages/uni-ui/backarrow-circle/backarrow-circle',
      pages: [] as Page[]
    },
    {
      id: 'collapse',
      name: 'uni-collapse 折叠面板',
      open: false,
      url: '/pages/uni-ui/collapse/collapse',
      pages: [] as Page[]
    },
    // #ifndef (APP-IOS || APP-HARMONY) && !VUE3-VAPOR
    {
      id: 'combobox',
      name: 'uni-combobox 组合框',
      open: false,
      url: '/pages/uni-ui/combobox/combobox',
      pages: [] as Page[]
    },
    // #endif
    {
      id: 'data-checkbox',
      name: 'uni-data-checkbox 数据选择器',
      open: false,
      url: '/pages/uni-ui/data-checkbox/data-checkbox',
      pages: [] as Page[]
    },
    {
      id: 'data-picker',
      name: 'uni-data-picker 级联选择器',
      open: false,
      url: '/pages/uni-ui/data-picker/data-picker',
      pages: [] as Page[]
    },
    {
      id: 'data-picker-view',
      name: 'uni-data-picker-view 级联选择器',
      open: false,
      url: '/pages/uni-ui/data-picker/data-picker-view',
      pages: [] as Page[]
    },
    {
      id: 'data-vertical-marquee',
      name: 'uni-data-vertical-marquee 上下滚动文字',
      open: false,
      url: '/pages/uni-ui/data-vertical-marquee/data-vertical-marquee',
      pages: [] as Page[]
    },
    {
      id: 'drag-cell',
      name: 'uni-drag-cell 拖拽排序',
      open: false,
      url: '/pages/uni-ui/drag-cell/drag-cell',
      pages: [] as Page[]
    },
    {
      id: 'easyinput',
      name: 'uni-easyinput 增强输入框',
      open: false,
      url: '/pages/uni-ui/easyinput/easyinput',
      pages: [] as Page[]
    },
    // #ifdef VUE3-VAPOR || MP
    {
      id: 'expandable-text',
      name: 'uni-expandable-text 展开文本',
      open: false,
      url: '/pages/uni-ui/expandable-text/expandable-text',
      pages: [] as Page[]
    },
    // #endif
    {
      id: 'fab-button',
      name: 'uni-fab-button 悬浮按钮',
      open: false,
      url: '/pages/uni-ui/fab-button/fab-button',
      pages: [] as Page[]
    },
    {
      id: 'forms',
      name: 'uni-forms 表单',
      open: false,
      url: '/pages/uni-ui/forms/forms',
      pages: [] as Page[]
    },
    {
      id: 'icons',
      name: 'uni-icons 图标',
      open: false,
      url: '/pages/uni-ui/icons/icons',
      pages: [] as Page[]
    },
    {
      id: 'index-bar',
      name: 'uni-index-bar 索引栏',
      open: false,
      url: '/pages/uni-ui/index-bar/index-bar',
      pages: [] as Page[]
    },
    {
      id: 'link',
      name: 'uni-link 链接',
      open: false,
      url: '/pages/uni-ui/link/link',
      pages: [] as Page[]
    },
    {
      id: 'nav-bar',
      name: 'uni-nav-bar 导航栏',
      open: false,
      url: '/pages/uni-ui/nav-bar/nav-bar',
      pages: [] as Page[]
    },
    {
      id: 'number-box',
      name: 'uni-number-box 数字输入框',
      open: false,
      url: '/pages/uni-ui/number-box/number-box',
      pages: [] as Page[]
    },
    {
      id: 'rate',
      name: 'uni-rate 评分组件',
      open: false,
      url: '/pages/uni-ui/rate/rate',
      pages: [] as Page[]
    },
    // #ifndef MP-ALIPAY
    {
      id: 'refresh-box',
      name: 'uni-refresh-box 下拉刷新组件',
      open: false,
      url: '/pages/uni-ui/refresh-box/refresh-box',
      pages: [] as Page[]
    },
    // #endif
    {
      id: 'tab-bar',
      name: 'uni-tab-bar 底部选项卡',
      open: false,
      pages: [
        {
          name: '默认样式',
          url: '/pages/uni-ui/tab-bar/tab-bar'
        },
        {
          name: '暗色风格',
          url: '/pages/uni-ui/tab-bar/tab-bar-dark'
        },
        {
          name: '自定义样式',
          url: '/pages/uni-ui/tab-bar/tab-bar-custom'
        },
        // #ifndef APP && !VUE3-VAPOR
        {
          name: '半透明毛玻璃',
          url: '/pages/uni-ui/tab-bar/tab-bar-blur'
        },
        // #endif
        {
          name: '中间按钮',
          url: '/pages/uni-ui/tab-bar/tab-bar-midbutton'
        },
        {
          name: '中间按钮镂空',
          url: '/pages/uni-ui/tab-bar/tab-bar-midbutton-notch'
        }
      ] as Page[]
    },
    {
      id: 'time-format',
      name: 'uni-time-format 时间格式化',
      open: false,
      url: '/pages/uni-ui/time-format/time-format',
      pages: [] as Page[]
    },
  ] as ListItem[])

  const hasLeftWin = computed(() : boolean => {
    return !state.noMatchLeftWindow
  })
  const leftWinActive = computed(() : string => {
    const parts = state.leftWinActive.split('/').filter((item) : boolean => {
      return item.length > 0
    })
    return parts.length > 0 ? parts[parts.length - 1] : ''
  })
  function getPageKey(url : string) : string {
    const parts = url.split('/').filter((item) : boolean => {
      return item.length > 0
    })
    return parts.length > 0 ? parts[parts.length - 1] : url
  }

  function goDetailPage(page : Page) {
    if (page.enable == false) {
      uni.showToast({
        icon: 'none',
        title: '暂不支持',
      })
      return
    }
    if (hasLeftWin.value) {
      uni.reLaunch({ url: page.url })
    } else {
      uni.navigateTo({
        url: page.url,
        fail() {
          console.log('页面跳转失败：' + page.url)
        }
      })
    }
  }

  function triggerCollapse(index : number, item : ListItem) {
    if (item.pages.length == 0) {
      const page : Page = {
        name: item.name,
        enable: item.enable,
        url: item.url!
      }
      goDetailPage(page)
      return
    }
    for (let i = 0; i < list.value.length; i++) {
      list.value[i].open = index == i ? !list.value[i].open : false
    }
  }

  function syncCollapseState(index : number, open : boolean) {
    for (let i = 0; i < list.value.length; i++) {
      list.value[i].open = open && index == i
    }
  }

  function syncActiveGroup(path : string) {
    const matchedIndex = list.value.findIndex((item) : boolean => {
      for (const page of item.pages) {
        if (getPageKey(page.url) == path) {
          return true
        }
      }
      if (item.url != null && getPageKey(item.url!) == path) {
        return true
      }
      return false
    })

    if (matchedIndex == -1) {
      return
    }

    for (let i = 0; i < list.value.length; i++) {
      list.value[i].open = matchedIndex == i && list.value[i].pages.length > 0
    }
  }

  watch(() : string => leftWinActive.value, (path : string) => {
    syncActiveGroup(path)
  }, { immediate: true })

  // #ifdef WEB
  import { useRouter } from 'vue-router'
  // Vapor 不支持实例 $route，VDOM/Vapor 统一通过 Router 获取路由。
  // 直接监听 currentRoute ref，保留路由对象切换时的触发语义，无需深度监听。
  const { currentRoute } = useRouter()
  watch(currentRoute, (newRoute) => {
    if (newRoute && newRoute.matched.length) {
      syncActiveGroup(newRoute.path.split('/')[3])
    }
  }, { immediate: true })
  // #endif
</script>

<style>
  page {
    background-color: var(--tabbar-background-color) !important;
    /* #ifdef APP && VUE3-VAPOR */
    padding-bottom: var(--uni-safe-area-inset-bottom);
    /* #endif */
  }
</style>
