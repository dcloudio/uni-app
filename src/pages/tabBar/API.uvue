<template>
    <view class="u-p-15">
      <view v-if="!hasLeftWin" class="p-15-15 flex-dir-column justify-center items-center u-mt-5">
        <image class="w-80 h-80" src="/static/apiIndex.png"></image>
      </view>
      <view v-if="!hasLeftWin" class="mb-20">
        <text class="color-text-333 fs-14 lh-20">uni-app x API接口能力，文档详见：</text>
        <uni-link class="color-text-333 fs-14 lh-20" href="https://doc.dcloud.net.cn/uni-app-x/api/"
        <!-- #ifndef MP -->
        target="_blank"
        <!-- #endif -->
        >
          https://doc.dcloud.net.cn/uni-app-x/api/
        </uni-link>
      </view>
      <uni-collapse>
        <uni-collapse-item ref="categoryRef" v-for="menuItem in menu" :key="menuItem.id" :title="menuItem.name"
          class="mb-12" title-wrap-class="bg-list-fff-important"
          title-class="color-text-333-important" content-wrap-class="bg-list-fff-important"
          arrow-class="border-r-color-arrow-999-important border-b-color-arrow-999-important">
          <template v-for="childMenuItem in menuItem.items" :key="childMenuItem.id">
            <view v-if="childMenuItem.items.length==0" hover-class="bg-active"
              :class="{'flex-dir-row items-center bg-list border-t-style-solid border-t-color-border border-t-width-1 p-12-16 justify-between':childMenuItem.path !== 'set-tab-bar' || windowWidth <= 768}"
               @click="goPage(`/${childMenuItem.path}`)">
              <template v-if="childMenuItem.path !== 'set-tab-bar' || windowWidth <= 768">
                <text class="color-text-333 fs-14 fw-normal w-94pct ws-nowrap overflow-hidden text-overflow-ellipsis"
                  :class="{'color-007aff-important': leftWinActive === childMenuItem.path && hasLeftWin}">{{ childMenuItem.style["navigationBarTitleText"] }}</text>
                <view class="w-8 h-8 ml-12 transform-rotate-neg45deg border-r-width-1 border-r-style-solid border-r-color-arrow-999 border-b-width-1 border-b-style-solid border-b-color-arrow-999"></view>
              </template>
            </view>
            <uni-collapse v-else style="width: 100%;border-top: 1px solid var(--border-color);">
              <uni-collapse-item :title="childMenuItem.name" class="mb-12"
                style="margin-bottom: 0;" title-wrap-class="bg-list-fff-important pl-16-important pr-20-important"
                title-class="color-text-333-important" content-wrap-class="bg-list-fff-important"
                arrow-class="border-r-color-arrow-999-important border-b-color-arrow-999-important">
                <view class="flex-dir-row items-center bg-list border-t-style-solid border-t-color-border border-t-width-1 p-12-16 justify-between pr-20" hover-class="bg-active"
                  v-for="grandChildMenuItem in childMenuItem.items" :key="grandChildMenuItem.path"
                  @click="goPage(`/${grandChildMenuItem.path}`)">
                  <text class="color-text-333 fs-14 fw-normal w-94pct ws-nowrap overflow-hidden text-overflow-ellipsis" :class="{
                      'color-007aff-important':
                        leftWinActive === grandChildMenuItem.path && hasLeftWin,
                    }">{{ grandChildMenuItem.style["navigationBarTitleText"] }}</text>
                  <view class="w-8 h-8 ml-12 transform-rotate-neg45deg border-r-width-1 border-r-style-solid border-r-color-arrow-999 border-b-width-1 border-b-style-solid border-b-color-arrow-999"></view>
                </view>
              </uni-collapse-item>
            </uni-collapse>
          </template>
        </uni-collapse-item>
      </uni-collapse>
      <!-- #ifdef MP || WEB -->
      <view v-if="!hasLeftWin" ref="popRef" @click="hidePop()" class="pos-fixed top-0 bottom-0 right-0 items-center justify-center popup left-0" @touchmove.prevent="stopPropagation">
      <!-- #endif -->
      <!-- #ifndef MP || WEB -->
      <view v-if="!hasLeftWin" ref="popRef" @click="hidePop()" class="pos-fixed top-0 bottom-0 right-0 items-center justify-center popup left-0">
      <!-- #endif -->
        <view class="w-90pct bg-white" @click.stop="stopClickPop">
          <api-set-tabbar></api-set-tabbar>
        </view>
      </view>
    </view>
</template>

<script setup lang="ts">
  defineOptions({
    styleIsolation: 'app'
  })

  const activeIndex = inject<Ref<number>>('tabBarCurrentIndex', ref(0))

  import { generateMenu, MenuItem } from './generateMenu.ts'
  const menuData = generateMenu('pages/API')
  import { state } from '@/store/index.ts'

  // Template refs
  const popRef = ref<UniElement | null>(null)
  const categoryRef = ref<ComponentPublicInstance[] | null>(null)

  const menu = ref(menuData as MenuItem[])

  // #ifdef APP && VUE3-VAPOR
  type OnTabItemTapTestResult = {
    count: number
    index: number
    text: string
    pagePath: string
  }

  const onTabItemTapTestResult = reactive<OnTabItemTapTestResult>({
    count: 0,
    index: -1,
    text: '',
    pagePath: ''
  })

  onTabItemTap((options) => {
    console.log(`API onTabItemTap: index=${options.index}, text=${options.text}, pagePath=${options.pagePath}`)
    onTabItemTapTestResult.count++
    onTabItemTapTestResult.index = options.index
    onTabItemTapTestResult.text = options.text
    onTabItemTapTestResult.pagePath = options.pagePath
  })

  function getOnTabItemTapTestResult() : OnTabItemTapTestResult {
    return {
      count: onTabItemTapTestResult.count,
      index: onTabItemTapTestResult.index,
      text: onTabItemTapTestResult.text,
      pagePath: onTabItemTapTestResult.pagePath
    }
  }
  // #endif

  const hasLeftWin = computed((): boolean => {
    return !state.noMatchLeftWindow
  })

  const leftWinActive = computed((): string => {
    return state.leftWinActive.slice(1)
  })

  const windowWidth = computed((): number => {
    return uni.getWindowInfo().windowWidth
  })

  const netless = computed((): boolean => {
    return state.netless
  })

  function showPop() {
    const popElement = popRef.value
    if (popElement != null) {
      popElement.style.setProperty("display", "flex")
    }
  }

  function goPage(url : string) {
    if (url == '/set-tab-bar') {
      showPop()
    }else {
      if (hasLeftWin.value) {
        uni.reLaunch({ url })
      } else {
        uni.navigateTo({ url })
      }
    }
  }

  function hidePop() {
    const popElement = popRef.value
    if (popElement != null) {
      popElement.style.setProperty("display", "none")
    }
  }

  function stopClickPop(e : PointerEvent) {
    e.stopPropagation() //点击到pop的非灰色区域，拦截点击事件
  }

  function stopPropagation() {

  }

  // #ifdef APP-HARMONY
  watch(netless, (netlessValue) => {
    if (netlessValue) {
      menu.value = menu.value.filter(item => {
        return !['unicloud'].includes(item.id)
      })
    }
  }, { immediate: true })
  // #endif

  // #ifdef WEB
  import { useRouter } from 'vue-router'
  // Vapor 不支持实例 $route，VDOM/Vapor 统一通过 Router 获取路由。
  // 直接监听 currentRoute ref，保留路由对象切换时的触发语义，无需深度监听。
  const { currentRoute } = useRouter()
  watch(currentRoute, (newRoute) => {
    if (newRoute.matched.length) {
      const activeCategoryIndex = menu.value.findIndex(menuItem => menuItem?.items.some(item => leftWinActive.value !== "" && leftWinActive.value === item?.path))
      if (activeCategoryIndex > -1) {
        nextTick(() => {
          const categoryRefs = categoryRef.value
          if (categoryRefs != null && categoryRefs[activeCategoryIndex] != null) {
            categoryRefs[activeCategoryIndex].$callMethod('openCollapse', true)
          }
        })
      }
    }
  }, { immediate: true })
  // #endif

  // #ifdef WEB
  function getTabBarElement() : Element | null {
    return document.querySelector('.uni-tabbar-bottom .uni-tabbar')
  }

  function getTabBarLabels() : NodeListOf<Element> {
    return document.querySelectorAll('.uni-tabbar-bottom .uni-tabbar__label')
  }

  function getTabBarItemText(index: number) : string {
    const label = getTabBarLabels()[index] as HTMLElement | undefined
    return label != null ? (label.textContent || '').trim() : ''
  }

  function getTabBarStyle(name: string) : string {
    const tabBar = getTabBarElement()
    return tabBar != null ? getComputedStyle(tabBar).getPropertyValue(name) : ''
  }

  function getTabBarItemStyle(index: number, name: string) : string {
    const label = getTabBarLabels()[index] as HTMLElement | undefined
    return label != null ? getComputedStyle(label).getPropertyValue(name) : ''
  }
  // #endif

  // #ifdef APP-ANDROID
  const testOpenDialogPage = () => {
    uni.openDialogPage({
      url: '/pages/API/dialog-page/dialog-5'
    });
  }

  const testCloseDialogPage = () => {
    uni.closeDialogPage();
  }

  // #endif

  defineExpose({
    // #ifdef APP && VUE3-VAPOR
    getOnTabItemTapTestResult,
    // #endif
    // #ifdef WEB
    getTabBarItemText,
    getTabBarStyle,
    getTabBarItemStyle,
    // #endif
    // #ifdef APP-ANDROID
    testOpenDialogPage,
    testCloseDialogPage
    // #endif
  })
</script>

<style>
  page {
    background-color: var(--tabbar-background-color) !important;
    /* #ifdef APP && VUE3-VAPOR */
    padding-bottom: var(--uni-safe-area-inset-bottom);
    /* #endif */
  }

  .popup {
    display: none;
    background-color: rgba(16, 16, 16, 0.5);
  }
</style>
