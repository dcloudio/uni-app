<template>
    <view class="u-p-15">
      <view v-if="!hasLeftWin" class="p-15-15 flex-dir-column justify-center items-center u-mt-5">
        <image class="w-80 h-80" src="/static/cssIndex.png"></image>
      </view>
      <view v-if="!hasLeftWin" class="mb-20">
        <text class="color-text-333 fs-14 lh-20">uni-app x App平台支持的CSS，文档详见：</text>
        <uni-link class="color-text-333 fs-14 lh-20" href="https://doc.dcloud.net.cn/uni-app-x/css/"
        <!-- #ifndef MP -->
        target="_blank"
        <!-- #endif -->
        >
          https://doc.dcloud.net.cn/uni-app-x/css/
        </uni-link>
      </view>
      <uni-collapse>
        <uni-collapse-item ref="categoryRef" v-for="menuItem in menu" :key="menuItem.id" :title="menuItem.name"
          class="mb-12" title-wrap-class="bg-list-fff-important"
          title-class="color-text-333-important" content-wrap-class="bg-list-fff-important"
          arrow-class="border-r-color-arrow-999-important border-b-color-arrow-999-important">
          <template v-for="childMenuItem in menuItem.items" :key="childMenuItem.id">
            <view v-if="childMenuItem.items.length==0" class="flex-dir-row items-center bg-list border-t-style-solid border-t-color-border border-t-width-1 p-12-16 justify-between"
              hover-class="bg-active" @click="goPage(`/${childMenuItem.path}`)">
              <text class="color-text-333 fs-14 fw-normal w-94pct ws-nowrap overflow-hidden text-overflow-ellipsis" :class="{
                  'color-007aff-important': leftWinActive === childMenuItem.path && hasLeftWin,
                }">{{ childMenuItem.style["navigationBarTitleText"] }}</text>
              <view class="w-8 h-8 ml-12 transform-rotate-neg45deg border-r-width-1 border-r-style-solid border-r-color-arrow-999 border-b-width-1 border-b-style-solid border-b-color-arrow-999"></view>
            </view>
            <uni-collapse v-else style="width: 100%;border-top: 1px solid var(--border-color);">
              <uni-collapse-item :title="childMenuItem.name" class="mb-12"
                style="margin-bottom: 0;" title-wrap-class="bg-list-fff-important pl-16-important pr-20-important"
                title-class="color-text-333-important" content-wrap-class="bg-list-fff-important"
                arrow-class="border-r-color-arrow-999-important border-b-color-arrow-999-important">
                <view class="flex-dir-row items-center bg-list border-t-style-solid border-t-color-border border-t-width-1 p-12-16 justify-between pr-20" hover-class="bg-active"
                  v-for="grandChildMenuItem in childMenuItem.items" :key="grandChildMenuItem.path"
                  @click="goPage(`/${grandChildMenuItem.path}`)">
                  <text class="color-text-333 fs-14 fw-normal w-94pct ws-nowrap overflow-hidden text-overflow-ellipsis" :class="{
                      'color-007aff-important':
                        leftWinActive === grandChildMenuItem.path && hasLeftWin,
                    }">{{ grandChildMenuItem.style["navigationBarTitleText"] }}</text>
                  <view class="w-8 h-8 ml-12 transform-rotate-neg45deg border-r-width-1 border-r-style-solid border-r-color-arrow-999 border-b-width-1 border-b-style-solid border-b-color-arrow-999"></view>
                </view>
              </uni-collapse-item>
            </uni-collapse>
          </template>
        </uni-collapse-item>
      </uni-collapse>
    </view>
</template>

<script setup lang="ts">
  defineOptions({
    styleIsolation: 'app'
  })

  const activeIndex = inject<Ref<number>>('tabBarCurrentIndex', ref(0))

  import { generateMenu, MenuItem } from './generateMenu.ts'
  const menuData = generateMenu('pages/CSS')
  import { state } from '@/store/index.ts'

  // Template refs
  const categoryRef = ref<ComponentPublicInstance[] | null>(null)

  const menu = ref(menuData as MenuItem[])

  const hasLeftWin = computed((): boolean => {
    return !state.noMatchLeftWindow
  })

  const leftWinActive = computed((): string => {
    return state.leftWinActive.slice(1)
  })

  function goPage(url : string) {
    if (hasLeftWin.value) {
      uni.reLaunch({ url })
    } else {
      uni.navigateTo({ url })
    }
  }

  // #ifdef WEB
  import { useRouter } from 'vue-router'
  // Vapor 不支持实例 $route，VDOM/Vapor 统一通过 Router 获取路由。
  // 直接监听 currentRoute ref，保留路由对象切换时的触发语义，无需深度监听。
  const { currentRoute } = useRouter()
  watch(currentRoute, (newRoute) => {
    if (newRoute && newRoute.matched.length) {
      const activeCategoryIndex = menu.value.findIndex(menuItem => menuItem?.items.some(item => leftWinActive.value !== "" && leftWinActive.value === item?.path))
      if (activeCategoryIndex > -1) {
        nextTick(() => {
          const categoryRefs = categoryRef.value
          if (categoryRefs != null && categoryRefs[activeCategoryIndex] != null) {
            categoryRefs[activeCategoryIndex].$callMethod('openCollapse', true)
          }
        })
      }
    }
  }, { immediate: true })
  // #endif
</script>

<style>
  page {
    background-color: var(--tabbar-background-color) !important;
    /* #ifdef APP && VUE3-VAPOR */
    padding-bottom: var(--uni-safe-area-inset-bottom);
    /* #endif */
  }
</style>
