<template>
		<text class="fs-24 fw-bold border-b-1-solid-ccc m-8-0">联系人选择 uni.chooseContact</text>
		<text>调用系统的联系人选择界面</text>

		<text class="fs-20 fw-bold m-8-0">快捷操作</text>
		<text class="m-5-0">调用状态：{{ invokeState }}</text>
		<button class="m-5-0" @tap="choosePhoneContact">选择联系人</button>
		<button class="m-5-0" @tap="clearResult">清空结果</button>
		<button class="m-5-0" @tap="clearLogs">清空日志</button>

		<text class="fs-20 fw-bold m-8-0">选择结果</text>
		<text class="mt-6 fs-14">displayName</text>
		<text class="m-5-0 u-p-10 border-1-solid-ccc fs-14">{{ displayName }}</text>
		<text class="mt-6 fs-14">phoneNumber</text>
		<text class="m-5-0 u-p-10 border-1-solid-ccc fs-14">{{ phoneNumber }}</text>
		<text class="mt-6 fs-14">phoneNumberList（{{ phoneNumberList.length }}）</text>
		<view class="m-5-0 u-p-10 border-1-solid-ccc d-flex flex-dir-column" v-if="phoneNumberList.length > 0">
			<text class="fs-14 m-4-0" v-for="item in phoneNumberList" :key="item">{{ item }}</text>
		</view>
		<text class="m-5-0 u-p-10 border-1-solid-ccc fs-14" v-else>尚未返回手机号列表</text>

		<text class="fs-20 fw-bold m-8-0">回调信息</text>
		<text class="m-5-0">success：{{ successText }}</text>
		<text class="m-5-0">fail：{{ failText }}</text>
		<text class="m-5-0">complete：{{ completeText }}</text>

		<text class="fs-20 fw-bold m-8-0">最近日志</text>
		<view class="m-5-0 u-p-10 border-1-solid-ccc d-flex flex-dir-column" v-if="logs.length > 0">
			<text class="fs-14 m-4-0" v-for="item in logs" :key="item">{{ item }}</text>
		</view>
		<text class="m-5-0 u-p-10 border-1-solid-ccc fs-14" v-else>暂无日志</text>
</template>

<script setup lang="ts">
	const invokeState = ref<string>('尚未调用')
	const displayName = ref<string>('尚未选择联系人')
	const phoneNumber = ref<string>('尚未选择手机号')
	const phoneNumberList = ref<Array<string>>(new Array<string>())
	const successText = ref<string>('尚未触发')
	const failText = ref<string>('尚未触发')
	const completeText = ref<string>('尚未触发')
	const logs = ref<Array<string>>(new Array<string>())

	function appendLog(text : string) : void {
		logs.value.unshift(`${Date.now()} ${text}`)
		if (logs.value.length > 10) {
			logs.value.pop()
		}
	}

	function resetCallbackTexts() : void {
		successText.value = '尚未触发'
		failText.value = '尚未触发'
		completeText.value = '尚未触发'
	}

	function clearResult() : void {
		invokeState.value = '尚未调用'
		displayName.value = '尚未选择联系人'
		phoneNumber.value = '尚未选择手机号'
		phoneNumberList.value = new Array<string>()
		resetCallbackTexts()
		appendLog('已清空 chooseContact 结果')
	}

	function clearLogs() : void {
		logs.value = new Array<string>()
	}

	function describeComplete(result : ChooseContactComplete) : string {
		if (result instanceof UniError) {
			return `${result.errMsg} (${result.errCode})`
		}
		const successResult = result as ChooseContactSuccess
		return `${successResult.errMsg} / ${successResult.displayName} / ${successResult.phoneNumber}`
	}

	function choosePhoneContact() : void {
		invokeState.value = '调用中'
		resetCallbackTexts()
		appendLog('开始调用 chooseContact')
		uni.chooseContact({
			success: (result : ChooseContactSuccess) => {
				invokeState.value = 'success'
				displayName.value = result.displayName
				phoneNumber.value = result.phoneNumber
				phoneNumberList.value = result.phoneNumberList
				successText.value = `${result.errMsg} / ${result.displayName} / ${result.phoneNumber}`
				failText.value = '本次未触发'
				appendLog(`chooseContact success ${result.displayName} ${result.phoneNumber}`)
			},
			fail: (err : ChooseContactFail) => {
				invokeState.value = 'fail'
				failText.value = `${err.errMsg} (${err.errCode})`
				appendLog(`chooseContact fail ${err.errMsg}`)
			},
			complete: (result : ChooseContactComplete) => {
				completeText.value = describeComplete(result)
				appendLog(`chooseContact complete ${completeText.value}`)
			}
		})
	}
</script>

<style>
page {
  padding: 6px;
}
</style>
