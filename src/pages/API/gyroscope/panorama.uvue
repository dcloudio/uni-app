<template>
		<text class="fs-24 fw-bold border-b-1-solid-ccc m-8-0">全景浏览</text>
		<text>左右转动手机，超宽画卷会跟随陀螺仪横向移动，展示屏幕之外的内容。</text>

		<text class="fs-20 fw-bold m-8-0">当前状态</text>
		<text id="panoramaStatus" class="m-5-0">{{ statusText }}</text>
		<view class="m-5-0 d-flex flex-dir-row">
			<view class="flex-1 p-14 border-1-solid-ccc">
				<text>水平偏移</text>
				<text class="mt-4 fs-30">{{ offsetText }}</text>
			</view>
			<view class="flex-1 p-14 border-1-solid-ccc u-ml-10">
				<text>角速度 Y</text>
				<text class="mt-4 fs-30">{{ velocityText }}</text>
			</view>
		</view>

		<text class="fs-20 fw-bold m-8-0">移动视窗</text>
		<text class="m-5-0">将手机朝左或朝右缓慢转动，观察画面边缘不断切换的色块与文字。</text>
		<view id="panoramaViewport" class="m-5-0 border-1-solid-ccc overflow-hidden h-220">
			<view class="d-flex flex-dir-row pos-relative panorama-strip h-220" :style="panoramaStyle">
				<view class="w-full h-full p-20 d-flex flex-dir-column justify-flex-end">
					<text class="fs-30 color-fff panel-title">渐变全景画卷</text>
					<text class="mt-6 fs-14 color-fff">从红色过渡到黄色的超宽视界</text>
				</view>
				<view class="pos-absolute d-flex flex-dir-column end-tip bottom-20 items-end">
						<text class="fs-24 fw-bold color-333">到达尾部了</text>
						<text class="fs-12 color-666 mt-4">已展示全部内容</text>
				</view>
			</view>
		</view>

</template>

<script setup lang="ts">
	const panoramaWidth = 1400
	const pixelsPerRadian = 320

	const statusText = ref('正在初始化陀螺仪...')
	const offsetText = ref('0 px')
	const velocityText = ref('0.0000')
	const panoramaStyle = ref('transform: translateX(0px)')
	const viewportWidth = ref(0)
	const callBackId = ref(0)

	let currentOffset = 0.0
	let lastTimestamp : number | null = null

	function clamp(value : number, min : number, max : number) : number {
		if (value < min) {
			return min
		}
		if (value > max) {
			return max
		}
		return value
	}

	function updatePanoramaStyle() : void {
		const rounded = Math.round(currentOffset)
		offsetText.value = `${rounded} px`
		panoramaStyle.value = `transform: translateX(-${rounded}px)`
	}

	function getMaxOffset() : number {
		const hiddenWidth = panoramaWidth - viewportWidth.value
		if (hiddenWidth > 0) {
			return hiddenWidth
		}
		return 0
	}

	function measureViewport() : void {
		uni.createSelectorQuery().select('#panoramaViewport').boundingClientRect().exec((ret) => {
			if (ret.length > 0) {
				const rect = ret[0] as NodeInfo
				const rectWidth = rect.width != null ? rect.width : 0
				viewportWidth.value = Math.round(rectWidth)
				currentOffset = clamp(currentOffset, 0, getMaxOffset())
				updatePanoramaStyle()
			}
		})
	}

	const gyroscopeListener : OnGyroscopeChangeCallback = (result : OnGyroscopeChangeCallbackResult) => {
		velocityText.value = result.y.toFixed(4)
		if (viewportWidth.value <= 0) {
			return
		}

		const now = Date.now()
		if (lastTimestamp == null) {
			lastTimestamp = now
			statusText.value = '请左右转动手机查看全景'
			return
		}

		const deltaSeconds = (now - (lastTimestamp as number)) / 1000
		lastTimestamp = now

		currentOffset = clamp(currentOffset + result.y * deltaSeconds * pixelsPerRadian, 0, getMaxOffset())
		statusText.value = '请左右转动手机查看全景'
		updatePanoramaStyle()
	}

	function startListen() : void {
		uni.startGyroscope({
			interval: 'game',
			success: () => {
				statusText.value = '请左右转动手机查看全景'
			},
			fail: (error) => {
				statusText.value = error.errMsg != null ? error.errMsg : '陀螺仪启动失败'
			}
		})
	}

	function stopListen() : void {
		uni.stopGyroscope({
			success: () => {
				statusText.value = '已停止监听'
			}
		})
		lastTimestamp = null
	}

	onReady(() => {
		measureViewport()
		uni.onGyroscopeChange(gyroscopeListener)
		startListen()
	})

	onShow(() => {
		measureViewport()
		startListen()
	})

	onHide(() => {
		stopListen()
	})

	onResize(() => {
		measureViewport()
	})

	onUnload(() => {
		uni.offGyroscopeChange(gyroscopeListener)
		uni.stopGyroscope()
	})

	defineExpose({
		startListen,
		stopListen
	})
</script>

<style>
	page {
		padding: 6px;
	}

	.panorama-strip {
		width: 1400px;
		/* 这里的总宽度要和 script 中的 panoramaWidth 一致 */
		/* 核心修改：应用线性渐变背景 */
		background-image: linear-gradient(to right, #ff4d4d, #fffa65); /* 必须加这个，方便子元素绝对定位 */
	}

	.panel-title {
		/* 渐变背景下白色文字通常更清晰 */
		text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
	}

	/* 右侧提示文字容器 */
	.end-tip {
	    right: 40px;      /* 距离最右侧留点边距 */
	}
</style>
