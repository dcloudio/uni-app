		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		margin: 15px 15px 10px;
		background-color: #1f2329;
		border-radius: 6px;
		overflow: hidden;
	}

	.panel-heading {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 8px 10px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #3a3f47;
	}

	.panel-title {
		font-size: 14px;
		font-weight: 600;
		color: #ffffff;
	}

	.clear-button {
		margin: 0;
	}

	.log-list {
		height: 210px;
		padding: 8px 10px;
	}

	.log-empty,
	.log-item {
		margin-bottom: 6px;
		font-size: 11px;
		line-height: 16px;
		color: #aeb6c2;
	}

	.log-item {
		color: #d7dde5;
	}

	.section {
		display: flex;
		flex-direction: column;
		margin-bottom: 20px;
	}

	.section-title {
		margin-bottom: 10px;
		font-size: 16px;
		font-weight: 600;
		color: #222222;
	}

	.listener-card {
		display: flex;
		flex-direction: column;
		margin-bottom: 12px;
		padding: 12px;
		background-color: #ffffff;
		border-radius: 6px;
	}

	.listener-heading {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 8px;
	}

	.listener-title {
		font-size: 14px;
		font-weight: 600;
		color: #222222;
	}

	.listener-status {
		font-size: 11px;
		color: #777777;
	}

	.listener-api-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 46px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #eeeeee;
	}

	.listener-api-name {
		flex: 1;
		margin-right: 10px;
		font-size: 12px;
		color: #333333;
	}

	.listener-button {
		width: 64px;
		margin: 0;
	}

	.api-card {
		display: flex;
		flex-direction: column;
		margin-bottom: 12px;
		padding: 12px;
		background-color: #ffffff;
		border-radius: 6px;
	}

	.api-name {
		flex: 1;
		margin-right: 10px;
		font-size: 14px;
		font-weight: 600;
		color: #222222;
	}

	.api-action-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 32px;
	}

	.api-action-row-after-parameters {
		margin-top: 10px;
	}

	.parameter-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		min-height: 42px;
		padding: 4px 0;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #eeeeee;
	}

	.parameter-row-column {
		flex-direction: column;
		align-items: stretch;
	}

	.parameter-name {
		font-size: 12px;
		color: #555555;
	}

	.parameter-input {
		height: 36px;
		margin-top: 6px;
