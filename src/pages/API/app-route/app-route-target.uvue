<template>
    <page-head title="应用路由事件目标页"></page-head>
    <view class="p-0-15">
      <view class="p-12 color-text-333 bg-fff">
        <text class="fs-15 fw-bold color-text-333">跳转参数</text>
        <text class="mt-8">from：{{ data.from }}</text>
        <text v-if="data.preserved != ''" class="mt-8">保留的参数 preserved：{{ data.preserved }}</text>
      </view>
      <view class="p-5-0 mt-15">
        <button type="primary" @click="navigateBack">返回</button>
      </view>
    </view>
</template>

<script setup lang="ts">
  type DataType = {
    from : string,
    preserved: string
  }

  const data = reactive({
    from: '',
    preserved:''
  } as DataType)

  onLoad((options : OnLoadOptions) => {
    data.from = options['from'] ?? ''
    data.preserved = options['preserved'] ?? ''
  })

  const navigateBack = () => {
    uni.navigateBack()
  }

  defineExpose({
    data,
    navigateBack
  })
</script>
