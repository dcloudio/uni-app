<template>
  <view class="u-p-15 page" id="page">
    <page-head :title="title"></page-head>
    <page-intro content="本页演示元素获取布局矩形：getBoundingClientRectAsync 异步接口与 getBoundingClientRect 同步方法，返回 x、y、width、height、left、top、right、bottom；对 view、text、image、scroll-view 等组件分别测试，并含拍平（flatten）对比，以及 box-shadow 导致尺寸变大的现象演示。"></page-intro>
    <button class="mt-15" @click="getBoundingClientRectAsync">getBoundingClientRectAsync</button>
    <view id="rect-test" ref="rectTest" class="mt-15 h-100 bg-dodgerblue"></view>
    <view class="mt-15 flex-dir-column" v-if="data.rectInfo != null">
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">x: </text>
        <text class="fw-bold lh-2x">{{data.rectInfo!.x}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">y: </text>
        <text class="fw-bold lh-2x">{{data.rectInfo!.y}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">width: </text>
        <text class="fw-bold lh-2x">{{data.rectInfo!.width}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">height: </text>
        <text class="fw-bold lh-2x">{{data.rectInfo!.height}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">left: </text>
        <text class="fw-bold lh-2x">{{data.rectInfo!.left}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">top: </text>
        <text class="fw-bold lh-2x">{{data.rectInfo!.top}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">right: </text>
        <text class="fw-bold lh-2x">{{data.rectInfo!.right}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">bottom: </text>
        <text class="fw-bold lh-2x">{{data.rectInfo!.bottom}}</text>
      </view>
    </view>

    <!-- #ifndef MP -->
    <!-- 新增 getBoundingClientRect 同步方法测试 -->
    <view class="mt-30 u-h-1 section-divider"></view>
    <text class="mt-15 fs-16 fw-bold section-title">getBoundingClientRect 方法测试</text>

    <!-- View 元素测试 -->
    <view class="mt-20 flex-dir-column">
      <view class="flex-dir-row justify-around mb-10">
        <button class="fs-13 radius-4 flex-1 m-0-5 btn-small" type="default" @click="getViewRect">View</button>
        <button class="fs-13 radius-4 flex-1 m-0-5 btn-small" @click="getViewRectFlat">View(拍平测试)</button>
      </view>
      <view class="flex-dir-row justify-around items-center mb-10 test-elements">
        <view id="rect-test-view" class="h-60 bg-dodgerblue w-45pct"></view>
        <view id="rect-test-view-flat" class="h-60 bg-dodgerblue w-45pct" flatten></view>
      </view>
    </view>
    <view class="flex-dir-row mb-15 pb-15 rect-row"  v-if="syncData.viewRectInfo != null || syncData.viewRectInfoFlat != null">
      <view class="flex-1 flex-dir-column m-0-5" v-if="syncData.viewRectInfo != null">
        <text class="fs-12 rect-data-item lh-1_8x">x: {{syncData.viewRectInfo!.x}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">y: {{syncData.viewRectInfo!.y}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">width: {{syncData.viewRectInfo!.width}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">height: {{syncData.viewRectInfo!.height}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">left: {{syncData.viewRectInfo!.left}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">top: {{syncData.viewRectInfo!.top}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">right: {{syncData.viewRectInfo!.right}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">bottom: {{syncData.viewRectInfo!.bottom}}</text>
      </view>
      <view class="flex-1 flex-dir-column m-0-5" v-if="syncData.viewRectInfoFlat != null">
        <text class="fs-12 rect-data-item lh-1_8x">x: {{syncData.viewRectInfoFlat!.x}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">y: {{syncData.viewRectInfoFlat!.y}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">width: {{syncData.viewRectInfoFlat!.width}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">height: {{syncData.viewRectInfoFlat!.height}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">left: {{syncData.viewRectInfoFlat!.left}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">top: {{syncData.viewRectInfoFlat!.top}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">right: {{syncData.viewRectInfoFlat!.right}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">bottom: {{syncData.viewRectInfoFlat!.bottom}}</text>
      </view>
    </view>

    <!-- Text 元素测试 -->
    <view class="mt-20 flex-dir-column">
      <view class="flex-dir-row justify-around mb-10">
        <button class="fs-13 radius-4 flex-1 m-0-5 btn-small" @click="getTextRect">Text</button>
        <button class="fs-13 radius-4 flex-1 m-0-5 btn-small" @click="getTextRectFlat">Text(拍平测试)</button>
      </view>
      <view class="flex-dir-row justify-around items-center mb-10 test-elements">
        <text id="rect-test-text" class="p-8 fs-14 color-fff bg-ff6b6b w-45pct">测试文本</text>
        <text id="rect-test-text-flat" class="p-8 fs-14 color-fff bg-ff6b6b w-45pct" flatten>测试文本拍平</text>
      </view>
    </view>
    <view class="flex-dir-row mb-15 pb-15 rect-row" v-if="syncData.textRectInfo != null || syncData.textRectInfoFlat != null">
      <view class="flex-1 flex-dir-column m-0-5" v-if="syncData.textRectInfo != null">
        <text class="fs-12 rect-data-item lh-1_8x">x: {{syncData.textRectInfo!.x}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">y: {{syncData.textRectInfo!.y}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">width: {{syncData.textRectInfo!.width}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">height: {{syncData.textRectInfo!.height}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">left: {{syncData.textRectInfo!.left}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">top: {{syncData.textRectInfo!.top}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">right: {{syncData.textRectInfo!.right}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">bottom: {{syncData.textRectInfo!.bottom}}</text>
      </view>
      <view class="flex-1 flex-dir-column m-0-5" v-if="syncData.textRectInfoFlat != null">
        <text class="fs-12 rect-data-item lh-1_8x">x: {{syncData.textRectInfoFlat!.x}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">y: {{syncData.textRectInfoFlat!.y}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">width: {{syncData.textRectInfoFlat!.width}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">height: {{syncData.textRectInfoFlat!.height}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">left: {{syncData.textRectInfoFlat!.left}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">top: {{syncData.textRectInfoFlat!.top}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">right: {{syncData.textRectInfoFlat!.right}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">bottom: {{syncData.textRectInfoFlat!.bottom}}</text>
      </view>
    </view>

    <!-- Image 元素测试 -->
    <view class="mt-20 flex-dir-column">
      <view class="flex-dir-row justify-around mb-10">
        <button class="fs-13 radius-4 flex-1 m-0-5 btn-small" @click="getImageRect">Image</button>
        <button class="fs-13 radius-4 flex-1 m-0-5 btn-small" @click="getImageRectFlat">Image(拍平测试)</button>
      </view>
      <view class="flex-dir-row justify-around items-center mb-10 test-elements">
        <image id="rect-test-image" class="h-60 bg-f0f0f0 w-45pct" src="/static/test-image/logo.png" mode="aspectFit"></image>
        <image id="rect-test-image-flat" class="h-60 bg-f0f0f0 w-45pct" src="/static/test-image/logo.png" mode="aspectFit" flatten></image>
      </view>
    </view>
    <view class="flex-dir-row mb-15 pb-15 rect-row" v-if="syncData.imageRectInfo != null || syncData.imageRectInfoFlat != null" >
      <view class="flex-1 flex-dir-column m-0-5" v-if="syncData.imageRectInfo != null">
        <text class="fs-12 rect-data-item lh-1_8x">x: {{syncData.imageRectInfo!.x}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">y: {{syncData.imageRectInfo!.y}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">width: {{syncData.imageRectInfo!.width}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">height: {{syncData.imageRectInfo!.height}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">left: {{syncData.imageRectInfo!.left}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">top: {{syncData.imageRectInfo!.top}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">right: {{syncData.imageRectInfo!.right}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">bottom: {{syncData.imageRectInfo!.bottom}}</text>
      </view>
      <view class="flex-1 flex-dir-column m-0-5" v-if="syncData.imageRectInfoFlat != null">
        <text class="fs-12 rect-data-item lh-1_8x">x: {{syncData.imageRectInfoFlat!.x}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">y: {{syncData.imageRectInfoFlat!.y}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">width: {{syncData.imageRectInfoFlat!.width}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">height: {{syncData.imageRectInfoFlat!.height}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">left: {{syncData.imageRectInfoFlat!.left}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">top: {{syncData.imageRectInfoFlat!.top}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">right: {{syncData.imageRectInfoFlat!.right}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">bottom: {{syncData.imageRectInfoFlat!.bottom}}</text>
      </view>
    </view>

    <!-- ScrollView 元素测试 -->
    <button class="mt-15" @click="getScrollViewRect">getBoundingClientRect - ScrollView</button>
    <scroll-view id="rect-test-scrollview" class="mt-15 h-120 border-1-solid-dcdfe6 bg-f5f7fa">
      <view class="h-120 u-p-10 justify-center items-center border-1-solid-37b4ea">
        <text class="lh-30 fs-14 color-606266">滚动区域内容1</text>
      </view>
      <view class="h-120 u-p-10 justify-center items-center border-1-solid-37b4ea">
        <text class="lh-30 fs-14 color-606266">滚动区域内容2</text>
      </view>
      <view class="h-120 u-p-10 justify-center items-center border-1-solid-37b4ea">
        <text class="lh-30 fs-14 color-606266">滚动区域内容2</text>
      </view>
    </scroll-view>
    <view class="mt-15 flex-dir-column" v-if="syncData.scrollViewRectInfo != null">
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">x: </text>
        <text class="fw-bold lh-2x">{{syncData.scrollViewRectInfo!.x}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">y: </text>
        <text class="fw-bold lh-2x">{{syncData.scrollViewRectInfo!.y}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">width: </text>
        <text class="fw-bold lh-2x">{{syncData.scrollViewRectInfo!.width}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">height: </text>
        <text class="fw-bold lh-2x">{{syncData.scrollViewRectInfo!.height}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">left: </text>
        <text class="fw-bold lh-2x">{{syncData.scrollViewRectInfo!.left}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">top: </text>
        <text class="fw-bold lh-2x">{{syncData.scrollViewRectInfo!.top}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">right: </text>
        <text class="fw-bold lh-2x">{{syncData.scrollViewRectInfo!.right}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">bottom: </text>
        <text class="fw-bold lh-2x">{{syncData.scrollViewRectInfo!.bottom}}</text>
      </view>
    </view>

    <!-- 自定义组件测试 -->
    <button class="mt-15" @click="getCustomComponentRect">getBoundingClientRect - 自定义组件</button>
    <child id="rect-test-component" class="mt-15"></child>
    <view class="mt-15 flex-dir-column" v-if="syncData.customComponentRectInfo != null">
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">x: </text>
        <text class="fw-bold lh-2x">{{syncData.customComponentRectInfo!.x}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">y: </text>
        <text class="fw-bold lh-2x">{{syncData.customComponentRectInfo!.y}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">width: </text>
        <text class="fw-bold lh-2x">{{syncData.customComponentRectInfo!.width}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">height: </text>
        <text class="fw-bold lh-2x">{{syncData.customComponentRectInfo!.height}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">left: </text>
        <text class="fw-bold lh-2x">{{syncData.customComponentRectInfo!.left}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">top: </text>
        <text class="fw-bold lh-2x">{{syncData.customComponentRectInfo!.top}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">right: </text>
        <text class="fw-bold lh-2x">{{syncData.customComponentRectInfo!.right}}</text>
      </view>
      <view class="flex-dir-row">
        <text class="w-72 lh-2x">bottom: </text>
        <text class="fw-bold lh-2x">{{syncData.customComponentRectInfo!.bottom}}</text>
      </view>
    </view>

    <view class="mt-20 flex-dir-column">
      <view class="flex-dir-row justify-around mb-10">
        <button class="fs-13 radius-4 flex-1 m-0-5 btn-small" @click="getShadowBaseRect">View(无阴影)</button>
        <button class="fs-13 radius-4 flex-1 m-0-5 btn-small" @click="getShadowBugRect">View(box-shadow)</button>
      </view>
      <text class="mb-10 fs-12 lh-18 test-tip">两个元素样式尺寸一致，右侧仅增加 box-shadow，用于演示获取到的宽高可能变大。</text>
      <view class="flex-dir-row justify-around items-center mb-10 test-elements">
        <view id="rect-test-shadow-base" class="h-60 radius-8 border-width-1 border-style-solid shadow-demo-box bg-67c23a w-45pct"></view>
        <view id="rect-test-shadow-bug" class="h-60 radius-8 border-width-1 border-style-solid shadow-demo-box shadow-demo-box-bug bg-67c23a w-45pct"></view>
      </view>
    </view>
    <view class="flex-dir-row mb-15 pb-15 rect-row" v-if="syncData.shadowBaseRectInfo != null || syncData.shadowBugRectInfo != null">
      <view class="flex-1 flex-dir-column m-0-5" v-if="syncData.shadowBaseRectInfo != null">
        <text class="fs-12 rect-data-item lh-1_8x">无阴影 x: {{syncData.shadowBaseRectInfo!.x}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">无阴影 y: {{syncData.shadowBaseRectInfo!.y}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">无阴影 width: {{syncData.shadowBaseRectInfo!.width}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">无阴影 height: {{syncData.shadowBaseRectInfo!.height}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">无阴影 left: {{syncData.shadowBaseRectInfo!.left}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">无阴影 top: {{syncData.shadowBaseRectInfo!.top}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">无阴影 right: {{syncData.shadowBaseRectInfo!.right}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">无阴影 bottom: {{syncData.shadowBaseRectInfo!.bottom}}</text>
      </view>
      <view class="flex-1 flex-dir-column m-0-5" v-if="syncData.shadowBugRectInfo != null">
        <text class="fs-12 rect-data-item lh-1_8x">阴影 x: {{syncData.shadowBugRectInfo!.x}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">阴影 y: {{syncData.shadowBugRectInfo!.y}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">阴影 width: {{syncData.shadowBugRectInfo!.width}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">阴影 height: {{syncData.shadowBugRectInfo!.height}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">阴影 left: {{syncData.shadowBugRectInfo!.left}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">阴影 top: {{syncData.shadowBugRectInfo!.top}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">阴影 right: {{syncData.shadowBugRectInfo!.right}}</text>
        <text class="fs-12 rect-data-item lh-1_8x">阴影 bottom: {{syncData.shadowBugRectInfo!.bottom}}</text>
      </view>
    </view>

    <!-- 自动化测试时创建，三个节点使用完全相同的布局参数。 -->
    <view v-if="data.showTextRectRegression" class="text-rect-fixture">
      <text id="rect-regression-normal" class="text-rect-target" :flatten="false">拍平文本尺寸测试。拍平文本尺寸测试。</text>
      <text id="rect-regression-flat" class="text-rect-target" flatten>拍平文本尺寸测试。拍平文本尺寸测试。</text>
      <text id="rect-regression-hidden-flat" class="text-rect-target text-rect-hidden" flatten>拍平文本尺寸测试。拍平文本尺寸测试。</text>
    </view>

    <!-- #endif -->
 </view>
</template>

<script setup lang="ts">
  import Child from './child.uvue'

  type DomRectType = {
    x : number,
    y : number,
    left : number,
    top : number,
    right : number,
    bottom : number,
    width : number,
    height : number,
  }

  type DataType = {
    rectInfo: DomRectType,
    showTextRectRegression: boolean,
  }

  type SyncDataType = {
    viewRectInfo: DomRectType | null,
    textRectInfo: DomRectType | null,
    imageRectInfo: DomRectType | null,
    shadowBaseRectInfo: DomRectType | null,
    shadowBugRectInfo: DomRectType | null,
    viewRectInfoFlat: DomRectType | null,
    textRectInfoFlat: DomRectType | null,
    imageRectInfoFlat: DomRectType | null,
    scrollViewRectInfo: DomRectType | null,
    customComponentRectInfo: DomRectType | null,
  }

  function createEmptyRectInfo(): DomRectType {
    return {
      x: 0,
      y: 0,
      width: 0,
      height: 0,
      left: 0,
      top: 0,
      right: 0,
      bottom: 0,
    }
  }

  function createRectInfo(rect : DOMRect): DomRectType {
    return {
      x: rect.x,
      y: rect.y,
      width: rect.width,
      height: rect.height,
      left: rect.left,
      top: rect.top,
      right: rect.right,
      bottom: rect.bottom,
    }
  }

  const title = ref('getBoundingClientRectAsync')
  const rectTest = ref<UniElement | null>(null)

  const data = reactive<DataType>({
    rectInfo: createEmptyRectInfo(),
    showTextRectRegression: false,
  })

  const syncData = reactive<SyncDataType>({
    viewRectInfo: null,
    textRectInfo: null,
    imageRectInfo: null,
    shadowBaseRectInfo: null,
    shadowBugRectInfo: null,
    viewRectInfoFlat: null,
    textRectInfoFlat: null,
    imageRectInfoFlat: null,
    scrollViewRectInfo: null,
    customComponentRectInfo: null,
  })

  function getBoundingClientRectAsync() {
    if (rectTest.value != null) {
      rectTest.value!.getBoundingClientRectAsync()!.then((rect : DOMRect) => {
        data.rectInfo = createRectInfo(rect)
      })
    }
  }

  // 通用方法：获取元素的位置信息
  function getRectInfo(elementId: string, dataKey: keyof SyncDataType) {
    const element = uni.getElementById(elementId)!
    const rect = element.getBoundingClientRect()
    syncData[dataKey] = createRectInfo(rect)
  }

  function getTextRectRegressionInfo() {
    return {
      normal: createRectInfo(uni.getElementById('rect-regression-normal')!.getBoundingClientRect()),
      flat: createRectInfo(uni.getElementById('rect-regression-flat')!.getBoundingClientRect()),
      hiddenFlat: createRectInfo(uni.getElementById('rect-regression-hidden-flat')!.getBoundingClientRect())
    }
  }

  function getViewRect() {
    getRectInfo('rect-test-view', 'viewRectInfo')
  }

  function getTextRect() {
    getRectInfo('rect-test-text', 'textRectInfo')
  }

  function getImageRect() {
    getRectInfo('rect-test-image', 'imageRectInfo')
  }

  function getShadowBaseRect() {
    getRectInfo('rect-test-shadow-base', 'shadowBaseRectInfo')
  }

  function getShadowBugRect() {
    getRectInfo('rect-test-shadow-bug', 'shadowBugRectInfo')
  }

  function getViewRectFlat() {
    getRectInfo('rect-test-view-flat', 'viewRectInfoFlat')
  }

  function getTextRectFlat() {
    getRectInfo('rect-test-text-flat', 'textRectInfoFlat')
  }

  function getImageRectFlat() {
    getRectInfo('rect-test-image-flat', 'imageRectInfoFlat')
  }

  function getScrollViewRect() {
    getRectInfo('rect-test-scrollview', 'scrollViewRectInfo')
  }

  function getCustomComponentRect() {
    getRectInfo('rect-test-component', 'customComponentRectInfo')
  }

  defineExpose({
    data,
    syncData,
    getBoundingClientRectAsync,
    getViewRect,
    getTextRect,
    getImageRect,
    getShadowBaseRect,
    getShadowBugRect,
    getViewRectFlat,
    getTextRectFlat,
    getTextRectRegressionInfo,
    getImageRectFlat,
    getScrollViewRect,
    getCustomComponentRect
  })
</script>

