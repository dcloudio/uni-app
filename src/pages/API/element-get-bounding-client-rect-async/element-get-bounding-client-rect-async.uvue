    justify-content: space-around;
    align-items: center;
    margin-bottom: 10px;
    padding: 14px 0;
  }

  .rect-test-small {
    width: 45%;
    height: 60px;
    background-color: dodgerblue;
  }

  .rect-test-text-small {
    width: 45%;
    padding: 8px;
    font-size: 14px;
