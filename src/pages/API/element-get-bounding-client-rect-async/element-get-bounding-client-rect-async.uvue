    font-size: 16px;
    font-weight: bold;
    color: var(--rect-title-color, #333);
  }

  .test-group {
    margin-top: 20px;
    flex-direction: column;
  }

  .test-buttons {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 10px;
  }

  .btn-small {
    /* #ifndef MP-ALIPAY */
    padding: 5px 15px;
    /* #endif */
    font-size: 13px;
