    font-size: 14px;
    color: #606266;
  }

  @media (prefers-color-scheme: dark) {
    .page {
      --rect-divider-color: rgba(255, 255, 255, 0.1);
      --rect-title-color: #ffffff;
      --rect-muted-color: #a0a0a0;
