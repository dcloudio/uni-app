<template>
	<view class="page u-p-15">
		<text class="fs-18 fw-bold title">UniElement EventListener 示例</text>
		<text class="mt-10 lh-22 desc">点击下方红色区域前，先注册 click 监听；移除后再次点击将不再计数。</text>
		<text class="mt-10 color-007aff lh-22">{{ data.supportText }}</text>

		<view ref="targetRef" class="mt-16 radius-10 listener-target">
			<text class="color-fff">点按这里触发元素 click 事件</text>
		</view>

		<view class="mt-16 p-12 radius-10 panel">
			<text class="mt-6 panel-text">监听状态：{{ data.listenerStatusText }}</text>
			<text class="mt-6 panel-text">触发次数：{{ data.triggerCount }}</text>
			<text class="mt-6 panel-text">最近事件：{{ data.lastEventType }}</text>
			<text class="mt-6 panel-text">最近结果：{{ data.lastAction }}</text>
		</view>

		<text class="pos-relative box-border-box radius-5 overflow-hidden bg-007aff border-style-solid color-fff mt-15 button border-width-0_5" @click="add">addEventListener</text>
		<text class="pos-relative box-border-box radius-5 overflow-hidden bg-007aff border-style-solid color-fff mt-15 button border-width-0_5" @click="remove">removeEventListener</text>
		<text class="pos-relative box-border-box radius-5 overflow-hidden bg-007aff border-style-solid color-fff mt-15 button border-width-0_5" @click="reset">reset</text>
	</view>
</template>

<script setup lang="ts">
	type EventListenerData = {
		supportText: string;
		listenerStatusText: string;
		triggerCount: number;
		lastEventType: string;
		lastAction: string;
		listenerAdded: boolean;
	}

	const targetRef = ref<UniViewElement | null>(null)
	const data = reactive<EventListenerData>({
		supportText: '当前平台暂不支持此 API。',
		listenerStatusText: '未注册',
		triggerCount: 0,
		lastEventType: '尚未触发',
		lastAction: '等待操作',
		listenerAdded: false,
	})

	let callbackWrapper : UniCallbackWrapper | null = null

	onReady(() => {
		// #ifdef WEB
		data.supportText = '当前平台支持 addEventListener/removeEventListener，可直接验证元素事件监听。'
		// #endif
		// #ifndef WEB
		data.supportText = '当前平台不支持 UniElement.addEventListener，本页仅展示调用方式。'
		// #endif
	})

	function eventCallback(event : UniEvent) : void {
		data.triggerCount += 1
		data.lastEventType = event.type
		data.lastAction = '监听回调已执行'
	}

	function add() {
		if (data.listenerAdded) {
			data.lastAction = '监听已存在，无需重复注册'
			return
		}

		const element = targetRef.value
		if (element == null) {
			data.lastAction = '目标元素未就绪'
			return
		}

		callbackWrapper = element.addEventListener<UniEvent, void>('click', eventCallback)
		data.listenerAdded = true
		data.listenerStatusText = '已注册'
		data.lastAction = '已注册 click 监听'
	}

	function remove() {
		const element = targetRef.value
		if (element == null || callbackWrapper == null) {
			data.lastAction = '暂无可移除的监听'
			data.listenerAdded = false
			data.listenerStatusText = '未注册'
			return
		}

		element.removeEventListener('click', callbackWrapper)
		callbackWrapper = null
		data.listenerAdded = false
		data.listenerStatusText = '未注册'
		data.lastAction = '已移除 click 监听'
	}

	function reset() {
		remove()
		data.triggerCount = 0
		data.lastEventType = '尚未触发'
		data.lastAction = '状态已重置'
	}

	onUnload(() => {
		remove()
	})

	defineExpose({
		data,
		add,
		remove,
		reset,
	})
</script>

<style>
	.title {
		color: var(--event-title-color, #222222);
	}

	.desc {
		color: var(--event-desc-color, #666666);
	}

	.listener-target {
		padding: 50px 12px;
		background-color: #f04f4f;
	}

	.panel {
		background-color: var(--event-panel-background, #f5f7fa);
	}

	.panel-text {
		color: var(--event-panel-text-color, #333333);
	}

	.button {
		border-color: rgba(0, 0, 0, 0.2);
		padding: 10px 5px;
	}

	@media (prefers-color-scheme: dark) {
		.page {
			--event-title-color: #ffffff;
			--event-desc-color: #a0a0a0;
			--event-panel-background: #2d2d2d;
			--event-panel-text-color: #ffffff;
		}
	}
</style>
