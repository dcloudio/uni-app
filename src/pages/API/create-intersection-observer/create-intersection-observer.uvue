<template>
	<view>
		<page-head :title="data.title"></page-head>
		<view class="p-0-15 mt-15">
			<view class="p-10-0 color-text-333 mt-15">
				{{data.appear ? '小球出现' : '小球消失'}}
			</view>
			<scroll-view class="h-200 bg-list-fff box-border-box scroll-view" :scroll-top="data.scrollTop">
				<view class="d-flex flex-dir-column items-center scroll-area">
					<text class="color-text-333 notice">向下滚动让小球出现</text>
					<view class="w-100 h-100 radius-100 ball"></view>
				</view>
			</scroll-view>
			<navigator url="/pages/API/create-intersection-observer/intersection-observer-batch"><button class="mt-15">批量监听多个元素</button></navigator>
			<navigator url="/pages/API/create-intersection-observer/intersection-observer-multi-root"><button class="mt-15">嵌套多根节点（嵌套滚动）</button></navigator>
		</view>
	</view>
</template>
<script setup lang="ts">
  let observer: IntersectionObserver | null = null;

  type DataType = {
    appear: boolean;
    title: string;
    testRes: ObserveResult | null;
    scrollTop: number;
  }

  const initData: DataType = {
    appear: false,
    title: 'intersectionObserver',
    testRes: null,
    scrollTop: 0
  }
  const data = reactive(initData)

  onReady(() => {
    observer = uni.createIntersectionObserver(getCurrentInstance()!.proxy!, {});
    observer.relativeTo('.scroll-view').observe('.ball', (res: ObserveResult) => {
      data.testRes = res;
      if (res.intersectionRatio > 0 && !data.appear) {
        data.appear = true;
      } else if (res.intersectionRatio <= 0 && data.appear) {
        data.appear = false;
      }
    })
  })

  onUnload(() => {
    if (observer) {
      observer.disconnect()
    }
  })

  defineExpose({
    data
  })
</script>
<style>
	.scroll-view {
		border: 1px solid var(--border-color, #ccc);
	}

	.scroll-area {
		height: 650px;
	}

	.notice {
		margin-top: 75px;
		margin:75px 0 200px 0;
	}

	.ball {
		background: #4cd964;
	}
</style>
