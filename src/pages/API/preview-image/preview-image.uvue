<template>
      <!-- #ifndef MP-ALIPAY -->
      <view>
        <text class="mt-16 ml-8 mb-16 fw-bold color-text-333">图片指示器样式</text>
        <enum-data-checkbox
          :model-value="currentIndicator"
          :items="indicator"
          mode="default"
          :disabled="isWeb"
          :show-toast="false"
          @change="onIndicatorChanged"
        />
      </view>
      <view>
        <enum-data-checkbox
          :model-value="isLoop ? ['loop'] : []"
          :items="loopOptions"
          mode="default"
          multiple
          :disabled="isWeb"
          :show-toast="false"
          @change="onCheckboxChange"
        />
      </view>
      <view>
        <text class="mt-16 ml-8 mb-16 fw-bold color-text-333">长按行为</text>
        <enum-data-checkbox
          :model-value="isLongPress ? '1' : '0'"
          :items="longPressAction"
          mode="default"
          :disabled="isWeb"
          :show-toast="false"
          @change="onLongPressCheckboxChange"
        />
      </view>
      <!-- #endif -->
      <view class="bg-list-fff">
        <text class="mt-16 ml-8 mb-16 fw-bold color-text-333">点击图片开始预览</text>
        <view class="flex-dir-row flex-wrap-wrap d-flex m-8">
          <view class="w-100 h-100 border-width-1 border-style-solid cell-choose-image ml-3 mr-3" v-for="(image, index) in imageList" :key="index">
            <text class="w-100 h-100 u-color-red text-center fs-14 lh-100 bg-d3d3d3" v-if="image.error"
              @click="previewImage(index)">图片路径非法</text>
            <image class="bg-list-fff w-100 h-100" mode="aspectFit" :src="image.src"
              v-if="!image.error" @click="previewImage(index)"
              @error="onImageLoadError(index,$event as ImageErrorEvent)">
            </image>
          </view>
          <image class="w-100 h-100 border-width-1 border-style-solid cell-choose-image ml-3 mr-3" src="/static/plus.png" @click="chooseImage">
          </image>
        </view>
      </view>
</template>

<script setup lang="ts">
  const loopOptions = [{ value: 'loop', text: '循环播放' }]

  type Indicator = "number" | "default" | "none"
  type ItemType = {
    value : Indicator,
    name : string
  }

  type ImageType = {
    src : string,
    error : boolean
  }

  type LongPressType = {
    value : string,
    name : string
  }

  const imageList = ref([
    { src: "https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni@2x.png", error: false },
    // 只支持 http 图片链接
    // #ifndef MP-ALIPAY
    { src: "/static/test-image/logo.png", error: false },
    { src: "/static/test-image/logo.svg", error: false },
    // #endif
    // #ifdef APP
    { src: "/static/uni2.png", error: false },
    // #endif
  ] as ImageType[])

  const indicator = ref([{
    value: "default",
    name: "圆点"
  }, {
    value: "number",
    name: "数字"
  }, {
    value: "none",
    name: "不显示"
  }] as ItemType[])

  const longPressAction = ref([{
    value: "0",
    name: "默认长按行为"
  }, {
    value: "1",
    name: "自定义长按行为"
  }] as LongPressType[])

  const currentIndicator = ref("default"  as Indicator)

  const isWeb = ref(false)

  const isLongPress = ref(true)
  const isLoop = ref(true)

  const previewImage = (index : number) => {
    let list = [] as Array<string>
    imageList.value.forEach((item : ImageType) => {
      list.push(item.src)
    })
    uni.previewImage({
      urls: list,
      current: index,
      // #ifdef MP-ALIPAY
      enableSavePhoto:true,
      // #endif
      // #ifndef MP-ALIPAY
      indicator: currentIndicator.value,
      loop: isLoop.value,
      longPressActions: (isLongPress.value ? ({
        itemList: ["按钮1", "按钮2", "按钮3"],
        itemColor: "#ccc",
        success: (e : LongPressActionsSuccessResult) => {
          uni.showToast({
            title: "用户选中了第" + (e.index + 1) + "张图片，并选中了第" + (e.tapIndex + 1) + "个选项",
            position: "bottom"
          })
        },
        fail: (e : LongPressActionsFailResult) => {
          uni.showToast({
            title: "用户关闭了action sheet",
            position: "bottom"
          })
        }
      } as LongPressActionsOptions) : null)
      // #endif
    })
  }

  const chooseImage = () => {
    uni.chooseImage({
      sourceType: ['album'],
      count: 1,
      success: (e) => {
        imageList.value = imageList.value.concat({ src: e.tempFilePaths[0], error: false } as ImageType)
        // imageList.value = imageList.value.concat(e.tempFilePaths)
      },
      fail(_) {
      }
    })
  }

  const onIndicatorChanged = (value : Indicator) => {
    currentIndicator.value = value as Indicator
  }

  const onCheckboxChange = (values : string[]) => {
    isLoop.value = values.includes('loop')
  }

  const onLongPressCheckboxChange = (value : string) => {
    isLongPress.value = (value == "1")
  }

  const onImageLoadError = (index : number, error : UniImageErrorEvent) => {
    imageList.value[index].error = true
  }

  const closePreviewImage = ()=>{
    uni.closePreviewImage({})
    uni.hideActionSheet()
  }

  const testSetCurrentIndicator = (value:string) =>{
    currentIndicator.value = value as Indicator
  }

  defineExpose({
  	testSetCurrentIndicator,
    previewImage,
    closePreviewImage
  })
</script>

<style>
  page {
    padding-left: 8px;
    padding-right: 8px;
  }

  .cell-choose-image {
    border-color: var(--border-color, lightgray);
  }
</style>
