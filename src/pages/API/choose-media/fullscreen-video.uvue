<template>
    <uni-back-arrow-circle :auto-back="true" class="back arrow"></uni-back-arrow-circle>
    <video ref="video" class="w-full flex-1 h-full" :src="url" controls="false" autoplay="true" show-progress="false"
      show-fullscreen-btn="false" show-play-btn="false" show-center-play-btn="false"></video>
</template>

<script setup lang="ts">
const url = ref("")
const coverPath = ref("")

onLoad((options : OnLoadOptions) => {
  uni.$once("__ONRECEIVEURL",(value:UTSJSONObject)=>{
    url.value = value["url"] as string;
    coverPath.value = value["cover"] as string;
  })
  uni.$emit("__ONFULLVIDEOLOAD",null)
})
</script>

<style>
  .back{
    position: absolute;
    /* #ifdef APP || MP */
    top: var(--status-bar-height);
    /* #endif */
    /* #ifdef WEB */
    top: 10px;
    /* #endif */
    z-index: 10;
  }
  /* uni-back-arrow-circle组件 自定义样式 */
  .arrow {
    --back-arrow-color: #FFFFFF;
  }
</style>
