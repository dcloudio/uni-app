<template>
	<view class="flex-dir-column items-center p-24">
		<text class="fs-20 color-1f2937">uniIdRouter</text>
		<text class="mt-12 fs-14 text-center color-8f8f94">未登录时进入「需要登录」的页面，会自动跳转到登录页</text>
		<button class="need-login-btn mt-40" @click="goNeedLogin">进入需要登录的页面</button>
	</view>
</template>

<script setup lang="ts">
	const goNeedLogin = () => {
		uni.navigateTo({
			url: '/pages/API/unicloud/uni-id-router/need-login'
		})
	}

	defineExpose({
		goNeedLogin
	})
</script>
