<template>
	<view class="content">
		<text class="title">uniIdRouter</text>
		<text class="desc">未登录时进入「需要登录」的页面，会自动跳转到登录页</text>
		<button class="need-login-btn" @click="goNeedLogin">进入需要登录的页面</button>
	</view>
</template>

<script setup lang="ts">
	const goNeedLogin = () => {
		uni.navigateTo({
			url: '/pages/API/unicloud/uni-id-router/need-login'
		})
	}

	defineExpose({
		goNeedLogin
	})
</script>

