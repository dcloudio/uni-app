<template>
	<view class="flex-dir-column items-center justify-center p-40">
		<text class="fs-20 color-333">登录页面</text>
		<text class="mt-20 fs-14 text-center color-8f8f94">uniIdRedirectUrl：{{ redirectUrl }}</text>
	</view>
</template>

<script setup lang="ts">
	const redirectUrl = ref('')

	onLoad((options : OnLoadOptions) => {
		const url = options['uniIdRedirectUrl']
		if (url != null) {
			redirectUrl.value = decodeURIComponent(url as string) || ''
		}
	})
</script>
