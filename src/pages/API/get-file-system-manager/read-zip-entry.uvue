<template>
  <!-- #ifdef APP -->
  <page-intro content="演示 FileSystemManager.readZipEntry：读取压缩包内文件条目（encoding 为 utf-8 时返回各条目内容映射）。"></page-intro>
  <scroll-view class="page-scroll" style="flex: 1;">
  <!-- #endif -->
    <view class="content-group">
      <view class="param-group">
        <view class="param-row">
          <text class="param-label">压缩包</text>
          <input class="param-input" v-model="data.filePath" placeholder="zip 文件路径" />
        </view>
        <view class="param-row">
          <text class="param-label">编码</text>
          <text class="param-tip">encoding：utf-8</text>
        </view>
      </view>
      <view class="action-group">
        <button class="action-btn" type="primary" @tap="readZipEntry" id="btn-readzip-entry">readZipEntry 读取条目</button>
      </view>
      <view class="result-group">
        <text class="result-title">执行结果：{{ data.lastResult == '' ? '等待执行' : (data.lastResult == 'success' ? '成功' : '失败') }}</text>
        <text class="result-line">目标路径：{{ data.filePath }}</text>
        <text class="result-line" v-if="data.lastResult == 'success'">条目列表（{{ data.zipEntryNames.length }} 项）：</text>
        <view class="result-list" v-if="data.lastResult == 'success'">
          <text class="result-line" v-for="(item, index) in data.zipEntryNames" :key="index">{{ item }}</text>
        </view>
        <text class="result-error" v-if="data.lastResult == 'fail'">errCode：{{ data.lastFailError.errCode }}；errMsg：{{ data.lastFailError.errMsg }}</text>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="ts">
  import { createFsmMockError } from './fsm-utils'

  type DataType = {
    filePath : string
    zipEntryNames : string[]
    existsRet : boolean
    done : boolean
    lastResult : string
    lastFailError : UniError
  }

  const data = reactive({
    filePath: '/static/filemanager/to.zip',
    zipEntryNames: [] as string[],
    existsRet: false,
    done: false,
    lastResult: '',
    lastFailError: createFsmMockError(),
  } as DataType)

  function resetResult() {
    data.done = false
    data.lastResult = ''
    data.zipEntryNames = [] as string[]
  }

  function applyFail(res : IUniError) {
    data.lastResult = 'fail'
    data.lastFailError = new UniError(res.errSubject, res.errCode, res.errMsg)
  }

  function exists(path : string) : void {
    const target = path != null ? path : data.filePath
    try {
      uni.getFileSystemManager().accessSync(target)
      data.existsRet = true
    } catch (e) {
      data.existsRet = false
    }
  }

  function prepare() : void {
    data.done = true
  }

  function cleanup() : void {
    data.done = true
  }

  function readZipEntry() : void {
    resetResult()
    const fileManager = uni.getFileSystemManager()
    const options : ReadZipEntryOptions = {
      filePath: data.filePath,
      encoding: 'utf-8',
      success: (res : EntriesResult) => {
        // 不同平台与编译模式下条目返回结构不同：Android 非 vapor 与 Harmony 返回 Map，其余返回 UTSJSONObject
        // #ifdef (APP-ANDROID && !VUE3-VAPOR) || APP-HARMONY
        res.entries.forEach((_ : ZipFileItem, key : string) => {
          data.zipEntryNames.push(key)
        })
        // #endif
        // #ifndef (APP-ANDROID && !VUE3-VAPOR) || APP-HARMONY
        Object.keys(res.result as UTSJSONObject).forEach((key : string) => {
          data.zipEntryNames.push(key)
        })
        // #endif
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.done = true
      }
    }
    fileManager.readZipEntry(options)
  }

  onReady(() => {
    prepare()
  })

  defineExpose({
    data,
    prepare,
    cleanup,
    exists,
    readZipEntry
  })
</script>

<style>
  .page-scroll {
    flex: 1;
  }
  .content-group {
    padding: 8px;
    flex-direction: column;
  }
  .param-group {
    margin: 4px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .param-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
  }
  .param-label {
    width: 72px;
    font-size: 14px;
    color: #333333;
  }
  .param-input {
    flex: 1;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    height: 32px;
  }
  .param-tip {
    flex: 1;
    font-size: 12px;
    color: #999999;
  }
  .action-group {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
  }
  .action-btn {
    margin: 4px;
  }
  .result-group {
    margin: 4px 0 12px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .result-list {
    flex-direction: column;
    margin-left: 8px;
  }
  .result-title {
    font-weight: bold;
    font-size: 14px;
    margin: 2px 0;
    color: #333333;
  }
  .result-line {
    font-size: 13px;
    margin: 2px 0;
    color: #666666;
  }
  .result-error {
    font-size: 13px;
    margin: 2px 0;
    color: #e64340;
  }
</style>
