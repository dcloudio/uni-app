<template>
  <!-- #ifdef APP -->
  <page-intro content="演示 FileSystemManager.stat / statSync：获取文件或目录的 Stats 对象，recursive 为 true 时递归统计子目录；Android 平台额外演示 isFile/isDirectory 方法。"></page-intro>
  <scroll-view class="page-scroll">
  <!-- #endif -->
    <view class="content-group">
      <view class="param-group">
        <view class="param-row">
          <text class="param-label">根目录</text>
          <enum-data-checkbox
            class="flex-1"
            :model-value="data.rootKey"
            :items="rootOptions"
            mode="default"
            :show-toast="false"
            @change="onRootChange"
          />
        </view>
        <view class="param-row">
          <text class="param-label">目标路径</text>
          <input class="param-input" v-model="data.statPath" placeholder="相对根目录的路径" />
        </view>
        <view class="param-row">
          <text class="param-label">递归统计</text>
          <switch :checked="data.recursive" @change="onRecursiveChange" />
          <text class="param-tip">recursive=true 时递归统计子目录</text>
        </view>
      </view>
      <view class="action-group">
        <button class="action-btn" type="primary" @tap="stat" id="btn-stat">stat 获取状态</button>
        <button class="action-btn" type="primary" @tap="statSync" id="btn-stat-sync">statSync 获取状态</button>
        <button class="action-btn" type="primary" @tap="setupStatDemo" id="btn-stat-demo">准备递归演示数据（含包内资源）</button>
        <button class="action-btn" type="warn" @tap="demoFail" id="btn-stat-fail">演示失败（路径不存在）</button>
      </view>
      <view class="result-group">
        <text class="result-title">执行结果：{{ data.lastResult == '' ? '等待执行' : (data.lastResult == 'success' ? '成功' : '失败') }}</text>
        <text class="result-line">目标路径：{{ data.rootPath }}{{ data.statPath }}</text>
        <view class="result-list" v-if="data.lastResult == 'success'">
          <view class="result-item" v-for="(item, index) in data.statsList" :key="index">
            <text class="result-line">path：{{ item.path }}；size：{{ item.size }}；isFile：{{ item.isFile }}；isDirectory：{{ item.isDirectory }}</text>
          </view>
        </view>
        <text class="result-error" v-if="data.lastResult == 'fail'">errCode：{{ data.lastFailError.errCode }}；errMsg：{{ data.lastFailError.errMsg }}</text>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="ts">
  import { createEnumItems } from '@/components/enum-data-checkbox/enum-data-checkbox-types'
  const rootOptions = createEnumItems(['usr', 'cache', 'sandbox'])

  import { getFsmRootPath, ensureFsmDirSync, ensureFsmFileSync, removeFsmPathSync, removeFsmDirSync, createFsmMockError } from './fsm-utils'

  type StatItem = {
    path : string
    size : number
    isFile : string
    isDirectory : string
  }

  type DataType = {
    rootKey : string
    rootPath : string
    statPath : string
    recursive : boolean
    statsList : StatItem[]
    existsRet : boolean
    done : boolean
    lastResult : string
    lastFailError : UniError
  }

  const data = reactive({
    rootKey: 'usr',
    rootPath: getFsmRootPath('usr'),
    statPath: 'fsm-stat-demo/1.txt',
    recursive: false,
    statsList: [] as StatItem[],
    existsRet: false,
    done: false,
    lastResult: '',
    lastFailError: createFsmMockError(),
  } as DataType)

  function onRootChange(value : string) {
    data.rootKey = value
    data.rootPath = getFsmRootPath(data.rootKey)
  }

  function onRecursiveChange(e : UniSwitchChangeEvent) {
    data.recursive = e.detail.value
  }

  function targetPath(path : string) : string {
    return `${data.rootPath}${path ?? data.statPath}`
  }

  function resetResult() {
    data.done = false
    data.lastResult = ''
    data.statsList = [] as StatItem[]
  }

  function applyFail(res : IUniError) {
    data.lastResult = 'fail'
    data.lastFailError = new UniError(res.errSubject, res.errCode, res.errMsg)
  }

  function exists(path : string) : void {
    try {
      uni.getFileSystemManager().accessSync(targetPath(path))
      data.existsRet = true
    } catch (e) {
      data.existsRet = false
    }
  }

  // 组装展示用的 stats 列表；isFile/isDirectory 方法仅部分平台支持，统一 try-catch 防御
  function buildStatList(stats : Array<FileStats>) : StatItem[] {
    const list : StatItem[] = []
    stats.forEach((item : FileStats) => {
      const entry : StatItem = { path: item.path, size: 0, isFile: '-', isDirectory: '-' }
      try {
        entry.size = item.stats.size
      } catch (e) {
        // size 读取失败时保持 0
      }
      // #ifdef APP-ANDROID
      try {
        entry.isFile = item.stats.isFile() ? '是' : '否'
        entry.isDirectory = item.stats.isDirectory() ? '是' : '否'
      } catch (e) {
        entry.isFile = 'err'
        entry.isDirectory = 'err'
      }
      // #endif
      list.push(entry)
    })
    return list
  }

  function prepare() : void {
    const demoDir = `${data.rootPath}fsm-stat-demo`
    ensureFsmDirSync(demoDir)
    ensureFsmFileSync(`${demoDir}/1.txt`, '测试stat API的写入功能。\n\t制表符缩进行\n回车换行：\r\n下一行\n反斜杠 \\ 双引号 " 单引号 \'\n空格[  ]全角空格[　]不间断空格[ ]\n混合内容：中文English123!@#')
    data.done = true
  }

  function cleanup() : void {
    removeFsmDirSync(`${data.rootPath}fsm-stat-demo`)
    data.done = true
  }

  // 准备递归演示数据：/m 子目录 + 包内 static 资源副本，用于递归 stats 用例
  function setupStatDemo() : void {
    const fileManager = uni.getFileSystemManager()
    const demoDir = `${data.rootPath}fsm-stat-demo`
    ensureFsmDirSync(`${demoDir}/m`)
    ensureFsmFileSync(`${demoDir}/1.txt`, '测试stat API的写入功能。\n\t制表符缩进行\n回车换行：\r\n下一行\n反斜杠 \\ 双引号 " 单引号 \'\n空格[  ]全角空格[　]不间断空格[ ]\n混合内容：中文English123!@#')
    try {
      fileManager.copyFileSync('/static/test-image/logo.ico', `${demoDir}/m/asset.ico`)
    } catch (e) {
      console.error('setupStatDemo copy fail', e)
    }
    data.statPath = 'fsm-stat-demo'
    data.recursive = true
    data.done = true
  }

  function stat() : void {
    resetResult()
    // 自愈：默认演示文件不存在时重建，保证任意时刻重复点击都能成功
    if (data.statPath == 'fsm-stat-demo/1.txt') {
      ensureFsmDirSync(`${data.rootPath}fsm-stat-demo`)
      ensureFsmFileSync(`${data.rootPath}fsm-stat-demo/1.txt`, '测试stat API的写入功能。\n\t制表符缩进行\n回车换行：\r\n下一行\n反斜杠 \\ 双引号 " 单引号 \'\n空格[  ]全角空格[　]不间断空格[ ]\n混合内容：中文English123!@#')
    }
    const fileManager = uni.getFileSystemManager()
    const options : StatOptions = {
      path: targetPath(data.statPath),
      recursive: data.recursive,
      success: (res : StatSuccessResult) => {
        data.statsList = buildStatList(res.stats)
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.done = true
      }
    }
    fileManager.stat(options)
  }

  function statSync() : void {
    resetResult()
    // 自愈：默认演示文件不存在时重建，保证任意时刻重复点击都能成功
    if (data.statPath == 'fsm-stat-demo/1.txt') {
      ensureFsmDirSync(`${data.rootPath}fsm-stat-demo`)
      ensureFsmFileSync(`${data.rootPath}fsm-stat-demo/1.txt`, '测试stat API的写入功能。\n\t制表符缩进行\n回车换行：\r\n下一行\n反斜杠 \\ 双引号 " 单引号 \'\n空格[  ]全角空格[　]不间断空格[ ]\n混合内容：中文English123!@#')
    }
    try {
      const res = uni.getFileSystemManager().statSync(targetPath(data.statPath), data.recursive)
      data.statsList = buildStatList(res)
      data.lastResult = 'success'
    } catch (e) {
      data.lastResult = 'fail'
      data.lastFailError = new UniError('uni-file-manager', 0, `${e}`)
    }
    data.done = true
  }

  // 一键演示失败场景：路径不存在，预期 errCode 1300002（演示后自动恢复参数）
  function demoFail() : void {
    resetResult()
    const prevPath = data.statPath
    const prevRecursive = data.recursive
    data.statPath = 'fsm-stat-demo/missing.txt'
    data.recursive = false
    const fileManager = uni.getFileSystemManager()
    const options : StatOptions = {
      path: `${data.rootPath}fsm-stat-demo/missing.txt`,
      recursive: false,
      success: (res : StatSuccessResult) => {
        data.statsList = buildStatList(res.stats)
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.statPath = prevPath
        data.recursive = prevRecursive
        data.done = true
      }
    }
    fileManager.stat(options)
  }

  onReady(() => {
    prepare()
  })

  defineExpose({
    data,
    prepare,
    cleanup,
    exists,
    setupStatDemo,
    stat,
    statSync,
    demoFail
  })
</script>

<style>
  .flex-1 {
    flex: 1;
  }
  .page-scroll {
    flex: 1;
  }
  .content-group {
    padding: 8px;
    flex-direction: column;
  }
  .param-group {
    margin: 4px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .param-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
  }
  .param-label {
    width: 72px;
    font-size: 14px;
    color: #333333;
  }
  .param-input {
    flex: 1;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    height: 32px;
  }
  .param-tip {
    flex: 1;
    font-size: 12px;
    color: #999999;
  }
  .radio-group {
    flex-direction: row;
    flex-wrap: wrap;
  }
  .radio-item {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
  }
  .action-group {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
  }
  .action-btn {
    margin: 4px;
  }
  .result-group {
    margin: 4px 0 12px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .result-list {
    flex-direction: column;
    margin-left: 8px;
  }
  .result-item {
    flex-direction: column;
  }
  .result-title {
    font-weight: bold;
    font-size: 14px;
    margin: 2px 0;
    color: #333333;
  }
  .result-line {
    font-size: 13px;
    margin: 2px 0;
    color: #666666;
  }
  .result-error {
    font-size: 13px;
    margin: 2px 0;
    color: #e64340;
  }
</style>
