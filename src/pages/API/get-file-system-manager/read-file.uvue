<template>
  <!-- #ifdef APP -->
  <page-intro content="演示 FileSystemManager.readFile / readFileSync：按 utf-8/base64/ascii 编码读取文本，不传编码时返回 ArrayBuffer；读取失败时展示错误码。"></page-intro>
  <scroll-view class="page-scroll">
  <!-- #endif -->
    <view class="content-group">
      <view class="param-group">
        <view class="param-row">
          <text class="param-label">根目录</text>
          <enum-data-checkbox
            class="flex-1"
            :model-value="data.rootKey"
            :items="rootOptions"
            mode="default"
            :show-toast="false"
            @change="onRootChange"
          />
        </view>
        <view class="param-row">
          <text class="param-label">文件路径</text>
          <input class="param-input" v-model="data.filePath" placeholder="相对根目录的路径，也可以输入绝对路径前缀配合根目录留空使用" />
        </view>
        <view class="param-row">
          <text class="param-label">编码</text>
          <enum-data-checkbox
            class="flex-1"
            :model-value="data.encoding"
            :items="encodingOptions"
            mode="default"
            :show-toast="false"
            @change="onEncodingChange"
          />
        </view>
        <view class="param-row">
          <text class="param-label"></text>
          <text class="flex-1 fs-12 color-999">演示文件为中文文本：utf-8 直接读回原文；base64 返回文件字节的 base64 字符串；ascii 读取非 ASCII 内容将显示乱码；不传返回 ArrayBuffer（展示字节数）</text>
        </view>
      </view>
      <view class="action-group">
        <button class="action-btn" type="primary" @tap="readFile" id="btn-read-file">readFile 读取</button>
        <button class="action-btn" type="primary" @tap="readFileSync" id="btn-read-file-sync">readFileSync 读取</button>
        <button class="action-btn" type="primary" @tap="readFileBuffer" id="btn-read-file-buffer">读取 ArrayBuffer</button>
        <button class="action-btn" type="warn" @tap="demoFail" id="btn-read-file-fail">演示失败（文件不存在）</button>
        <!-- #ifdef APP -->
        <button class="action-btn" type="primary" @tap="readFileByContent" id="btn-read-file-content">readFile(选择相册图片 content://)</button>
        <!-- #endif -->
      </view>
      <view class="result-group">
        <text class="result-title">执行结果：{{ data.lastResult == '' ? '等待执行' : (data.lastResult == 'success' ? '成功' : '失败') }}</text>
        <text class="result-line">目标路径：{{ data.rootPath }}{{ data.filePath }}</text>
        <text class="result-line" v-if="data.lastResult == 'success' && data.byteLength == 0">读取内容（{{ data.encoding == '' ? 'ArrayBuffer' : data.encoding }}）：</text>
        <text class="result-line" v-if="data.lastResult == 'success' && data.byteLength == 0">{{ data.readRet }}</text>
        <text class="result-line" v-if="data.byteLength != 0">ArrayBuffer 字节数：{{ data.byteLength }}；Float64[1]：{{ data.bufferValue }}</text>
        <text class="result-error" v-if="data.lastResult == 'fail'">errCode：{{ data.lastFailError.errCode }}；errMsg：{{ data.lastFailError.errMsg }}</text>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="ts">
  import { createEnumItems } from '@/components/enum-data-checkbox/enum-data-checkbox-types'
  const rootOptions = createEnumItems(['usr', 'cache', 'sandbox'])
  const encodingOptions = [
    { value: 'utf-8', text: 'utf-8' },
    { value: 'base64', text: 'base64' },
    { value: 'ascii', text: 'ascii' },
    { value: '', text: '不传(ArrayBuffer)' },
  ]

  import { getFsmRootPath, ensureFsmDirSync, ensureFsmFileSync, ensureFsmFileBufferSync, removeFsmPathSync, removeFsmDirSync, createFsmMockError } from './fsm-utils'

  type DataType = {
    rootKey : string
    rootPath : string
    filePath : string
    encoding : string
    readRet : string
    byteLength : number
    bufferValue : number
    existsRet : boolean
    done : boolean
    lastResult : string
    lastFailError : UniError
  }

  const data = reactive({
    rootKey: 'usr',
    rootPath: getFsmRootPath('usr'),
    filePath: 'fsm-read-file-demo/1.txt',
    encoding: 'utf-8',
    readRet: '',
    byteLength: 0,
    bufferValue: 0,
    existsRet: false,
    done: false,
    lastResult: '',
    lastFailError: createFsmMockError(),
  } as DataType)

  function onRootChange(value : string) {
    data.rootKey = value
    data.rootPath = getFsmRootPath(data.rootKey)
  }

  function onEncodingChange(value : string) {
    data.encoding = value
  }

  function targetPath(path : string) : string {
    return `${data.rootPath}${path ?? data.filePath}`
  }

  function resetResult() {
    data.done = false
    data.lastResult = ''
    data.readRet = ''
    data.byteLength = 0
    data.bufferValue = 0
  }

  function applyFail(res : IUniError) {
    data.lastResult = 'fail'
    data.lastFailError = new UniError(res.errSubject, res.errCode, res.errMsg)
  }

  function applySyncFail(e : any) {
    data.lastResult = 'fail'
    data.lastFailError = new UniError('uni-file-manager', 0, `${e}`)
  }

  function applyBufferResult(ab : ArrayBuffer) {
    data.byteLength = ab.byteLength
    const value = new Float64Array(ab)
    data.bufferValue = value[1]
  }

  function exists(path : string) : void {
    try {
      uni.getFileSystemManager().accessSync(targetPath(path))
      data.existsRet = true
    } catch (e) {
      data.existsRet = false
    }
  }

  function prepare() : void {
    const demoDir = `${data.rootPath}fsm-read-file-demo`
    ensureFsmDirSync(demoDir)
    ensureFsmFileSync(`${demoDir}/1.txt`, '测试readFile API的写入功能。\n\t制表符缩进行\n回车换行：\r\n下一行\n反斜杠 \\ 双引号 " 单引号 \'\n空格[  ]全角空格[　]不间断空格[ ]\n混合内容：中文English123!@#')
    const buffer = new ArrayBuffer(16)
    const float64 = new Float64Array(buffer)
    float64[1] = 1.2222222
    ensureFsmFileBufferSync(`${demoDir}/buffer.txt`, buffer)
    data.done = true
  }

  function cleanup() : void {
    removeFsmDirSync(`${data.rootPath}fsm-read-file-demo`)
    data.done = true
  }

  function readCore(sync : boolean) {
    resetResult()
    // 自愈：默认演示文件不存在时重建，保证任意时刻重复点击都能成功
    if (data.filePath == 'fsm-read-file-demo/1.txt') {
      ensureFsmDirSync(`${data.rootPath}fsm-read-file-demo`)
      ensureFsmFileSync(`${data.rootPath}fsm-read-file-demo/1.txt`, '测试readFile API的写入功能。\n\t制表符缩进行\n回车换行：\r\n下一行\n反斜杠 \\ 双引号 " 单引号 \'\n空格[  ]全角空格[　]不间断空格[ ]\n混合内容：中文English123!@#')
    } else if (data.filePath == 'fsm-read-file-demo/buffer.txt') {
      const buffer = new ArrayBuffer(16)
      const float64 = new Float64Array(buffer)
      float64[1] = 1.2222222
      ensureFsmDirSync(`${data.rootPath}fsm-read-file-demo`)
      ensureFsmFileBufferSync(`${data.rootPath}fsm-read-file-demo/buffer.txt`, buffer)
    }
    const fileManager = uni.getFileSystemManager()
    if (sync) {
      try {
        if (data.encoding == '') {
          applyBufferResult(fileManager.readFileSync(targetPath(data.filePath), null) as ArrayBuffer)
        } else {
          data.readRet = (fileManager.readFileSync(targetPath(data.filePath), data.encoding) as string).toString()
        }
        data.lastResult = 'success'
      } catch (e) {
        applySyncFail(e)
      }
      data.done = true
      return
    }
    const options : ReadFileOptions = {
      filePath: targetPath(data.filePath),
      success: (res : ReadFileSuccessResult) => {
        if (data.encoding == '') {
          applyBufferResult(res.data as ArrayBuffer)
        } else {
          data.readRet = res.data.toString()
        }
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.done = true
      }
    }
    if (data.encoding != '') {
      options.encoding = data.encoding
    }
    fileManager.readFile(options)
  }

  function readFile() : void {
    readCore(false)
  }

  function readFileSync() : void {
    readCore(true)
  }

  // 读取准备好的 ArrayBuffer 演示文件
  function readFileBuffer() : void {
    data.filePath = 'fsm-read-file-demo/buffer.txt'
    data.encoding = ''
    readCore(false)
  }

  // 一键演示失败场景：读取不存在的文件，预期 errCode 1300002（演示后自动恢复参数）
  function demoFail() : void {
    resetResult()
    const prevPath = data.filePath
    data.filePath = 'fsm-read-file-demo/missing.txt'
    const fileManager = uni.getFileSystemManager()
    const options : ReadFileOptions = {
      filePath: `${data.rootPath}fsm-read-file-demo/missing.txt`,
      encoding: 'utf-8',
      success: (res : ReadFileSuccessResult) => {
        data.readRet = res.data.toString()
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.filePath = prevPath
        data.done = true
      }
    }
    fileManager.readFile(options)
  }

  // #ifdef APP
  // 手动体验：选择相册图片后按当前编码读取临时文件（content:// 路径，需手动选择）
  function readFileByContent() : void {
    uni.chooseImage({
      count: 1,
      albumMode: 'system',
      sizeType: ['original'],
      sourceType: ['album'],
      success: (e) => {
        const filePath = e.tempFilePaths[0]
        resetResult()
        data.filePath = filePath
        const options : ReadFileOptions = {
          filePath: filePath,
          success: (res : ReadFileSuccessResult) => {
            if (data.encoding == '') {
              applyBufferResult(res.data as ArrayBuffer)
              data.readRet = `byteLength=${data.byteLength}`
            } else {
              data.readRet = `length=${res.data.toString().length}`
            }
            data.lastResult = 'success'
          },
          fail: (res : IUniError) => {
            applyFail(res)
          },
          complete: (_ : any) => {
            data.done = true
          }
        }
        if (data.encoding != '') {
          options.encoding = data.encoding
        }
        uni.getFileSystemManager().readFile(options)
      }
    })
  }
  // #endif

  onReady(() => {
    prepare()
  })

  defineExpose({
    data,
    prepare,
    cleanup,
    exists,
    readFile,
    readFileSync,
    readFileBuffer,
    demoFail
    // #ifdef APP
    ,readFileByContent
    // #endif
  })
</script>

<style>
  .color-999 {
    color: #999;
  }

  .flex-1 {
    flex: 1;
  }

  .fs-12 {
    font-size: 12px;
  }

  .page-scroll {
    flex: 1;
  }
  .content-group {
    padding: 8px;
    flex-direction: column;
  }
  .param-group {
    margin: 4px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .param-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
  }
  .param-label {
    width: 72px;
    font-size: 14px;
    color: #333333;
  }
  .param-input {
    flex: 1;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    height: 32px;
  }
  .param-tip {
    flex: 1;
    font-size: 12px;
    color: #999999;
  }
  .radio-group {
    flex-direction: row;
    flex-wrap: wrap;
  }
  .radio-item {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
  }
  .action-group {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
  }
  .action-btn {
    margin: 4px;
  }
  .result-group {
    margin: 4px 0 12px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .result-title {
    font-weight: bold;
    font-size: 14px;
    margin: 2px 0;
    color: #333333;
  }
  .result-line {
    font-size: 13px;
    margin: 2px 0;
    color: #666666;
  }
  .result-error {
    font-size: 13px;
    margin: 2px 0;
    color: #e64340;
  }
</style>
