<template>
  <!-- #ifdef APP -->
  <page-intro content="演示 FileSystemManager.readCompressedFile / readCompressedFileSync：读取指定压缩算法（brotli）的本地文件内容（HarmonyOS 平台暂不支持）。"></page-intro>
  <scroll-view class="flex-1">
  <!-- #endif -->
    <view class="p-8 flex-dir-column">
      <view class="p-8 border-1-solid-e0e0e0 radius-4 flex-dir-column m-4-0">
        <view class="flex-dir-row items-center m-4-0">
          <text class="w-72 fs-14 color-333">文件路径</text>
          <input class="flex-1 border-1-solid-d0d0d0 radius-4 p-4-8 fs-13 h-32" v-model="data.filePath" placeholder="压缩文件路径" />
        </view>
        <view class="flex-dir-row items-center m-4-0">
          <text class="w-72 fs-14 color-333">压缩算法</text>
          <text class="flex-1 fs-12 color-999">compressionAlgorithm：br（brotli）</text>
        </view>
      </view>
      <!-- #ifndef APP-HARMONY -->
      <view class="flex-dir-row flex-wrap-wrap m-4-0">
        <button class="m-4" type="primary" @tap="readCompressedFile" id="btn-compressed-file">readCompressedFile 读取</button>
        <button class="m-4" type="primary" @tap="readCompressedFileSync" id="btn-compressed-file-sync">readCompressedFileSync 读取</button>
      </view>
      <!-- #endif -->
      <!-- #ifdef APP-HARMONY -->
      <view class="p-8 border-1-solid-e0e0e0 radius-4 flex-dir-column m-4-0-12-0">
        <text class="fs-13 m-2-0 color-666">HarmonyOS 平台暂不支持 readCompressedFile / readCompressedFileSync</text>
      </view>
      <!-- #endif -->
      <view class="p-8 border-1-solid-e0e0e0 radius-4 flex-dir-column m-4-0-12-0">
        <text class="fw-bold fs-14 m-2-0 color-333">执行结果：{{ data.lastResult == '' ? '等待执行' : (data.lastResult == 'success' ? '成功' : '失败') }}</text>
        <text class="fs-13 m-2-0 color-666">目标路径：{{ data.filePath }}</text>
        <text class="fs-13 m-2-0 color-666" v-if="data.lastResult == 'success'">解压内容：{{ data.compressedFileRet }}</text>
        <text class="fs-13 m-2-0 color-e64340" v-if="data.lastResult == 'fail'">errCode：{{ data.lastFailError.errCode }}；errMsg：{{ data.lastFailError.errMsg }}</text>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="ts">
  import { createFsmMockError } from './fsm-utils'

  type DataType = {
    filePath : string
    compressedFileRet : string
    existsRet : boolean
    done : boolean
    lastResult : string
    lastFailError : UniError
  }

  const data = reactive({
    filePath: '/static/filemanager/1.txt.br',
    compressedFileRet: '',
    existsRet: false,
    done: false,
    lastResult: '',
    lastFailError: createFsmMockError(),
  } as DataType)

  function resetResult() {
    data.done = false
    data.lastResult = ''
    data.compressedFileRet = ''
  }

  function applyFail(res : IUniError) {
    data.lastResult = 'fail'
    data.lastFailError = new UniError(res.errSubject, res.errCode, res.errMsg)
  }

  function exists(path : string) : void {
    try {
      uni.getFileSystemManager().accessSync(path != null ? path : data.filePath)
      data.existsRet = true
    } catch (e) {
      data.existsRet = false
    }
  }

  function prepare() : void {
    data.done = true
  }

  function cleanup() : void {
    data.done = true
  }

  function readCompressedFile() : void {
    resetResult()
    const fileManager = uni.getFileSystemManager()
    const options : ReadCompressedFileOptions = {
      filePath: data.filePath,
      compressionAlgorithm: 'br',
      success: (res : ReadCompressedFileResult) => {
        data.compressedFileRet = res.data
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.done = true
      }
    }
    fileManager.readCompressedFile(options)
  }

  function readCompressedFileSync() : void {
    resetResult()
    try {
      const result = uni.getFileSystemManager().readCompressedFileSync(data.filePath, 'br')
      data.compressedFileRet = result
      data.lastResult = 'success'
    } catch (e) {
      data.lastResult = 'fail'
      data.lastFailError = new UniError('uni-file-manager', 0, `${e}`)
    }
    data.done = true
  }

  onReady(() => {
    prepare()
  })

  defineExpose({
    data,
    prepare,
    cleanup,
    exists,
    readCompressedFile,
    readCompressedFileSync
  })
</script>
