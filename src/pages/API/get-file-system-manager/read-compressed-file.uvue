<template>
  <!-- #ifdef APP -->
  <page-intro content="演示 FileSystemManager.readCompressedFile / readCompressedFileSync：读取指定压缩算法（brotli）的本地文件内容（HarmonyOS 平台暂不支持）。"></page-intro>
  <scroll-view class="page-scroll" style="flex: 1;">
  <!-- #endif -->
    <view class="content-group">
      <view class="param-group">
        <view class="param-row">
          <text class="param-label">文件路径</text>
          <input class="param-input" v-model="data.filePath" placeholder="压缩文件路径" />
        </view>
        <view class="param-row">
          <text class="param-label">压缩算法</text>
          <text class="param-tip">compressionAlgorithm：br（brotli）</text>
        </view>
      </view>
      <!-- #ifndef APP-HARMONY -->
      <view class="action-group">
        <button class="action-btn" type="primary" @tap="readCompressedFile" id="btn-compressed-file">readCompressedFile 读取</button>
        <button class="action-btn" type="primary" @tap="readCompressedFileSync" id="btn-compressed-file-sync">readCompressedFileSync 读取</button>
      </view>
      <!-- #endif -->
      <!-- #ifdef APP-HARMONY -->
      <view class="result-group">
        <text class="result-line">HarmonyOS 平台暂不支持 readCompressedFile / readCompressedFileSync</text>
      </view>
      <!-- #endif -->
      <view class="result-group">
        <text class="result-title">执行结果：{{ data.lastResult == '' ? '等待执行' : (data.lastResult == 'success' ? '成功' : '失败') }}</text>
        <text class="result-line">目标路径：{{ data.filePath }}</text>
        <text class="result-line" v-if="data.lastResult == 'success'">解压内容：{{ data.compressedFileRet }}</text>
        <text class="result-error" v-if="data.lastResult == 'fail'">errCode：{{ data.lastFailError.errCode }}；errMsg：{{ data.lastFailError.errMsg }}</text>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="ts">
  import { createFsmMockError } from './fsm-utils'

  type DataType = {
    filePath : string
    compressedFileRet : string
    existsRet : boolean
    done : boolean
    lastResult : string
    lastFailError : UniError
  }

  const data = reactive({
    filePath: '/static/filemanager/1.txt.br',
    compressedFileRet: '',
    existsRet: false,
    done: false,
    lastResult: '',
    lastFailError: createFsmMockError(),
  } as DataType)

  function resetResult() {
    data.done = false
    data.lastResult = ''
    data.compressedFileRet = ''
  }

  function applyFail(res : IUniError) {
    data.lastResult = 'fail'
    data.lastFailError = new UniError(res.errSubject, res.errCode, res.errMsg)
  }

  function exists(path : string) : void {
    try {
      uni.getFileSystemManager().accessSync(path != null ? path : data.filePath)
      data.existsRet = true
    } catch (e) {
      data.existsRet = false
    }
  }

  function prepare() : void {
    data.done = true
  }

  function cleanup() : void {
    data.done = true
  }

  function readCompressedFile() : void {
    resetResult()
    const fileManager = uni.getFileSystemManager()
    const options : ReadCompressedFileOptions = {
      filePath: data.filePath,
      compressionAlgorithm: 'br',
      success: (res : ReadCompressedFileResult) => {
        data.compressedFileRet = res.data
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.done = true
      }
    }
    fileManager.readCompressedFile(options)
  }

  function readCompressedFileSync() : void {
    resetResult()
    try {
      const result = uni.getFileSystemManager().readCompressedFileSync(data.filePath, 'br')
      data.compressedFileRet = result
      data.lastResult = 'success'
    } catch (e) {
      data.lastResult = 'fail'
      data.lastFailError = new UniError('uni-file-manager', 0, `${e}`)
    }
    data.done = true
  }

  onReady(() => {
    prepare()
  })

  defineExpose({
    data,
    prepare,
    cleanup,
    exists,
    readCompressedFile,
    readCompressedFileSync
  })
</script>

<style>
  .page-scroll {
    flex: 1;
  }
  .content-group {
    padding: 8px;
    flex-direction: column;
  }
  .param-group {
    margin: 4px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .param-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
  }
  .param-label {
    width: 72px;
    font-size: 14px;
    color: #333333;
  }
  .param-input {
    flex: 1;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    height: 32px;
  }
  .param-tip {
    flex: 1;
    font-size: 12px;
    color: #999999;
  }
  .action-group {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
  }
  .action-btn {
    margin: 4px;
  }
  .result-group {
    margin: 4px 0 12px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .result-title {
    font-weight: bold;
    font-size: 14px;
    margin: 2px 0;
    color: #333333;
  }
  .result-line {
    font-size: 13px;
    margin: 2px 0;
    color: #666666;
  }
  .result-error {
    font-size: 13px;
    margin: 2px 0;
    color: #e64340;
  }
</style>
