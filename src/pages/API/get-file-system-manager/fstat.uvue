<template>
  <!-- #ifdef APP -->
  <page-intro content="演示 FileSystemManager.fstat / fstatSync：通过文件描述符获取文件状态（size 等），页面准备阶段会自动打开描述符。"></page-intro>
  <scroll-view class="page-scroll">
  <!-- #endif -->
    <view class="content-group">
      <view class="param-group">
        <view class="param-row">
          <text class="param-label">根目录</text>
          <enum-data-checkbox
            class="flex-1"
            :model-value="data.rootKey"
            :items="rootOptions"
            mode="default"
            :show-toast="false"
            @change="onRootChange"
          />
        </view>
        <view class="param-row">
          <text class="param-label">文件路径</text>
          <input class="param-input" v-model="data.filePath" placeholder="相对根目录的路径" />
        </view>
      </view>
      <view class="action-group">
        <button class="action-btn" type="primary" @tap="fstat" id="btn-fstat">fstat 获取状态</button>
        <button class="action-btn" type="primary" @tap="fstatSync" id="btn-fstat-sync">fstatSync 获取状态</button>
        <button class="action-btn" type="warn" @tap="demoFail" id="btn-fstat-fail">演示失败（无效描述符）</button>
      </view>
      <view class="result-group">
        <text class="result-title">执行结果：{{ data.lastResult == '' ? '等待执行' : (data.lastResult == 'success' ? '成功' : '失败') }}</text>
        <text class="result-line">目标路径：{{ data.rootPath }}{{ data.filePath }}</text>
        <text class="result-line" v-if="data.lastResult == 'success'">文件大小：{{ data.fstatSize }} 字节</text>
        <text class="result-error" v-if="data.lastResult == 'fail'">errCode：{{ data.lastFailError.errCode }}；errMsg：{{ data.lastFailError.errMsg }}</text>
      </view>
    </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
</template>

<script setup lang="ts">
  import { createEnumItems } from '@/components/enum-data-checkbox/enum-data-checkbox-types'
  const rootOptions = createEnumItems(['usr', 'cache', 'sandbox'])

  import { getFsmRootPath, ensureFsmDirSync, ensureFsmFileSync, removeFsmPathSync, removeFsmDirSync, createFsmMockError } from './fsm-utils'

  type DataType = {
    rootKey : string
    rootPath : string
    filePath : string
    fd : string
    fstatSize : number
    existsRet : boolean
    done : boolean
    lastResult : string
    lastFailError : UniError
  }

  const data = reactive({
    rootKey: 'usr',
    rootPath: getFsmRootPath('usr'),
    filePath: 'fsm-fstat-demo/1.txt',
    fd: '',
    fstatSize: 0,
    existsRet: false,
    done: false,
    lastResult: '',
    lastFailError: createFsmMockError(),
  } as DataType)

  function onRootChange(value : string) {
    data.rootKey = value
    data.rootPath = getFsmRootPath(data.rootKey)
  }

  function targetPath(path : string) : string {
    return `${data.rootPath}${path ?? data.filePath}`
  }

  function resetResult() {
    data.done = false
    data.lastResult = ''
    data.fstatSize = 0
  }

  function applyFail(res : IUniError) {
    data.lastResult = 'fail'
    data.lastFailError = new UniError(res.errSubject, res.errCode, res.errMsg)
  }

  function exists(path : string) : void {
    try {
      uni.getFileSystemManager().accessSync(targetPath(path))
      data.existsRet = true
    } catch (e) {
      data.existsRet = false
    }
  }

  // 准备演示数据：固定 30 字节内容文件 + 打开 r 描述符
  function openFd() : void {
    // 自愈：默认演示文件不存在时重建，保证任意时刻重复点击都能成功
    if (data.filePath == 'fsm-fstat-demo/1.txt') {
      ensureFsmDirSync(`${data.rootPath}fsm-fstat-demo`)
      ensureFsmFileSync(`${data.rootPath}fsm-fstat-demo/1.txt`, '测试fstat API的写入功能。\n\t制表符缩进行\n回车换行：\r\n下一行\n反斜杠 \\ 双引号 " 单引号 \'\n空格[  ]全角空格[　]不间断空格[ ]\n混合内容：中文English123!@#')
    }
    try {
      data.fd = uni.getFileSystemManager().openSync({ filePath: targetPath(data.filePath), flag: 'r' } as OpenFileSyncOptions)
    } catch (e) {
      data.fd = ''
    }
  }

  function prepare() : void {
    const demoDir = `${data.rootPath}fsm-fstat-demo`
    ensureFsmDirSync(demoDir)
    ensureFsmFileSync(`${demoDir}/1.txt`, '测试fstat API的写入功能。\n\t制表符缩进行\n回车换行：\r\n下一行\n反斜杠 \\ 双引号 " 单引号 \'\n空格[  ]全角空格[　]不间断空格[ ]\n混合内容：中文English123!@#')
    openFd()
    data.done = true
  }

  function cleanup() : void {
    removeFsmDirSync(`${data.rootPath}fsm-fstat-demo`)
    data.fd = ''
    data.done = true
  }


  function fstat() : void {
    resetResult()
    // 自愈：描述符失效时重新准备
    if (data.fd == '') {
      openFd()
    }
    const fileManager = uni.getFileSystemManager()
    const options : FStatOptions = {
      fd: data.fd,
      success: (res : FStatSuccessResult) => {
        data.fstatSize = res.stats.size
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.done = true
      }
    }
    fileManager.fstat(options)
  }

  function fstatSync() : void {
    resetResult()
    // 自愈：描述符失效时重新准备
    if (data.fd == '') {
      openFd()
    }
    try {
      const stat = uni.getFileSystemManager().fstatSync({ fd: data.fd } as FStatSyncOptions)
      data.fstatSize = stat.size
      data.lastResult = 'success'
    } catch (e) {
      data.lastResult = 'fail'
      data.lastFailError = new UniError('uni-file-manager', 0, `${e}`)
    }
    data.done = true
  }

  // 一键演示失败场景：使用无效描述符获取状态
  function demoFail() : void {
    resetResult()
    const fileManager = uni.getFileSystemManager()
    const options : FStatOptions = {
      fd: '-1',
      success: (res : FStatSuccessResult) => {
        data.fstatSize = res.stats.size
        data.lastResult = 'success'
      },
      fail: (res : IUniError) => {
        applyFail(res)
      },
      complete: (_ : any) => {
        data.done = true
      }
    }
    fileManager.fstat(options)
  }

  onReady(() => {
    prepare()
  })

  defineExpose({
    data,
    prepare,
    cleanup,
    exists,
    fstat,
    fstatSync,
    demoFail
  })
</script>

<style>
  .flex-1 {
    flex: 1;
  }
  .page-scroll {
    flex: 1;
  }
  .content-group {
    padding: 8px;
    flex-direction: column;
  }
  .param-group {
    margin: 4px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .param-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
  }
  .param-label {
    width: 72px;
    font-size: 14px;
    color: #333333;
  }
  .param-input {
    flex: 1;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    height: 32px;
  }
  .radio-group {
    flex-direction: row;
    flex-wrap: wrap;
  }
  .radio-item {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
  }
  .action-group {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
  }
  .action-btn {
    margin: 4px;
  }
  .result-group {
    margin: 4px 0 12px 0;
    padding: 8px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    flex-direction: column;
  }
  .result-title {
    font-weight: bold;
    font-size: 14px;
    margin: 2px 0;
    color: #333333;
  }
  .result-line {
    font-size: 13px;
    margin: 2px 0;
    color: #666666;
  }
  .result-error {
    font-size: 13px;
    margin: 2px 0;
    color: #e64340;
  }
</style>
