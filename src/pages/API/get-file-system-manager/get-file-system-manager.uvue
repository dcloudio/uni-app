</template>

<script setup lang="ts">
  import { getFsmRootPath } from './fsm-utils'

  type QuickDemoDataType = {
    quickRet : string
  }

  const data = reactive({ quickRet: '' } as QuickDemoDataType)

  // 快速体验：创建目录 → 写入 → 读取 → 删除文件 → 删除目录的完整同步流程
  function runQuickDemo() : void {
    const fileManager = uni.getFileSystemManager()
    const dir = `${getFsmRootPath('usr')}fsm-quick-demo`
    const file = `${dir}/1.txt`
    const steps : string[] = []
    try {
      try {
        fileManager.accessSync(dir)
        fileManager.rmdirSync(dir, true)
      } catch (_) {
        // 目录不存在则无需清理
      }
      fileManager.mkdirSync(dir, true)
      steps.push('mkdirSync 成功')
      fileManager.writeFileSync(file, '测试getFileSystemManager API的写入功能。', 'utf-8')
      steps.push('writeFileSync 成功')
      const content = fileManager.readFileSync(file, 'utf-8')
      steps.push(`readFileSync 成功：${content}`)
      fileManager.unlinkSync(file)
      fileManager.rmdirSync(dir, true)
      steps.push('unlinkSync/rmdirSync 成功')
      data.quickRet = steps.join(' → ')
    } catch (e) {
      data.quickRet = `执行失败：${e}`
    }
  }

  defineExpose({
    data,
    runQuickDemo
  })
</script>

<style>
  .section-title {
    margin: 12px 4px 4px 4px;
  }
</style>
