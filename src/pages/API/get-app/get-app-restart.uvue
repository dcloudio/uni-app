<template>
    <page-head title="getApp restart"></page-head>
    <view class="p-0-15">
      <text>restart from: {{ restartFrom }}</text>
    </view>
</template>

<script setup lang="ts">
  const restartFrom = ref('')

  onLoad((options : OnLoadOptions) => {
    restartFrom.value = options['from'] ?? ''
  })

  defineExpose({
    restartFrom
  })
</script>
