	}

	.fold-button-compact {
		margin: 0;
	}

	.api-action-row,
	.listener-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 44px;
	}

	.api-row-border,
	.listener-row {
		border-top-width: 1px;
