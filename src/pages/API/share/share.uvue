<template>
    <page-head :title="title"></page-head>
    <view class="uni-list-cell-padding status-box">
      <view class="uni-title uni-common-mt">
        <text class="uni-title-text share-text">分享内容：</text>
      </view>
      <textarea class="share-content"
        :auto-height=" true" :value="shareContent"></textarea>
    </view>
    <view class="uni-list-cell-padding status-box">
      <view class="uni-title uni-common-mt">
        <text class="uni-title-text share-text">分享图片：</text>
      </view>
      <view style="flex-wrap: wrap;" >
        <image style="width: 104px; height: 104px;" v-if="imageURL != null"  :src="imageURL">
        </image>
        <image v-else class="uni-uploader__input-box" @tap="chooseImage" src="/static/plus.png"></image>
      </view>
    </view>
    <view class="uni-list-cell-padding status-box">
      <view class="uni-title uni-common-mt">
        <text class="uni-title-text share-text">分享类型：</text>
      </view>
      <enum-data-checkbox
        :model-value="type.toString()"
        :items="typeOptions"
        mode="default"
        :show-toast="false"
        @change="typeChange"
      />
    </view>
    <view class="uni-list-cell-padding status-box">
      <view class="uni-title uni-common-mt">
        <text class="uni-title-text share-text">分享到：</text>
      </view>
      <enum-data-checkbox
        :model-value="scene"
        :items="sceneOptions"
        mode="default"
        :show-toast="false"
        @change="sceneChange"
      />
    </view>

    <view v-if="type == 5" class="uni-list-cell-padding status-box">
      <text class="uni-title-text share-text">小程序（仅支持聊天分享）：</text>
      <input class="share-field" v-model="miniProgramId" placeholder="小程序原始 ID（gh_ 开头）" />
      <input class="share-field" v-model="miniProgramPath" placeholder="页面路径，如 pages/index/index" />
      <input class="share-field" v-model="miniProgramWebURL" placeholder="兼容低版本的网页链接" />
      <text class="share-text">使用正式版小程序，请先选择分享图片。</text>
    </view>

    <view class="uni-padding-wrap uni-common-mt">
      <button type="primary" @click="share">分享</button>
    </view>
</template>

<script setup lang="ts">
  const typeOptions = [
    { value: '0', text: '图文' }, { value: '1', text: '纯文字' }, { value: '2', text: '纯图片' },
    { value: '3', text: '音频' }, { value: '4', text: '视频' }, { value: '5', text: '小程序' },
  ]
  const audioURL = 'https://web-ext-storage.dcloud.net.cn/uni-app/ForElise.mp3'
  const mediaURL = 'https://web-ext-storage.dcloud.net.cn/video/sample/2minute-demo.mp4'
  const miniProgramId = ref('')
  const miniProgramPath = ref('')
  const miniProgramWebURL = ref('https://uniapp.dcloud.net.cn/')
  const sceneOptions = [{ value: 'WXSceneSession', text: '聊天界面' }, { value: 'WXSceneTimeline', text: '朋友圈' }, { value: 'WXSceneFavorite', text: '微信收藏（暂不支持）', disabled: true }]

  const scene = ref('WXSceneSession')
  const type = ref(0)

  const typeChange = (value : string) => {
    type.value = parseInt(value)
  }
  const sceneChange = (value : string) => {
    scene.value = value
  }

  const title = ref('share')
  const shareContent = ref('uni-app x 可以分享内容到微信了！')
  const imageURL = ref<string | null>(null)

  function chooseImage() {
    uni.chooseImage({
      count: 1,
      success: (res) => {
        imageURL.value = res.tempFilePaths[0]
      },
      fail: (err) => {
        console.log("err: ", JSON.stringify(err));
        uni.showToast({
          title: "choose image error.code:" + err.errCode + ";message:" + err.errMsg,
          position: "bottom"
        })
      }
    })
  }

  function share() {
    if (type.value == 5) {
      if (scene.value != 'WXSceneSession') {
        uni.showToast({ title: '小程序仅支持聊天分享', icon: 'none' })
        return
      }
      if (miniProgramId.value.trim().length == 0 || miniProgramWebURL.value.trim().length == 0 || imageURL.value == null) {
        uni.showToast({ title: '请填写小程序 ID、网页链接并选择图片', icon: 'none' })
        return
      }
    }
    uni.showLoading({
      title: "正在分享......"
    })
    console.log('scene.value: ', scene.value);
    uni.share({
      provider: 'weixin',
      title: '微信分享',
      scene: scene.value,
      type: type.value,
      href: "https://uniapp.dcloud.net.cn/api/plugins/share.html",
      summary: shareContent.value,
      imageUrl: imageURL.value,
      mediaUrl: type.value == 3 ? audioURL : (type.value == 4 ? mediaURL : null),
      miniProgram: type.value == 5 ? {
        id: miniProgramId.value.trim(),
        path: miniProgramPath.value.trim(),
        type: 0,
        webUrl: miniProgramWebURL.value.trim()
      } : null,
      success(res) {
        uni.hideLoading()
        uni.showToast({
          title: '分享成功'
        })
      },
      fail(e) {
        uni.hideLoading()
        uni.showToast({
          title: e.errMsg
        })
      }
    })
  }
</script>

<style>
  .share-field {
    margin-top: 10px;
    padding: 10px;
    border: 1px solid #D9D9D9;
  }

  .uni-uploader__input-box {
    margin: 5px;
    width: 104px;
    height: 104px;
    border: 1px solid #D9D9D9;
  }

  .status-box {
    background-color: var(--list-background-color, #ffffff);
    margin: 0 20px;
  }

  .share-text,
  .share-radio {
    color: var(--text-color, #333333);
  }

  .share-radio {
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .share-content {
    max-height: 100px;
    padding: 10px;
    color: #333333;
    background-color: aliceblue;
    border: 1px solid black;
  }

  @media (prefers-color-scheme: dark) {
    .share-content {
      color: var(--text-color, #ffffff);
      background-color: var(--list-background-color, #2d2d2d);
      border-color: var(--border-color, rgba(255, 255, 255, 0.1));
    }

    .uni-uploader__input-box {
      border-color: var(--border-color, rgba(255, 255, 255, 0.1));
    }
  }
</style>
