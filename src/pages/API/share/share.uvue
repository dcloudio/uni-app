<template>
    <page-head :title="title"></page-head>
    <view class="p-10-15 color-text-333 bg-list-fff m-0-20">
      <view class="p-10-0 color-text-333 mt-15">
        <text class="fs-15 fw-bold color-text-333">分享内容：</text>
      </view>
      <textarea class="u-p-10 color-333 share-content border-width-1 border-style-solid border-color-000 bg-f0f8ff"
        :auto-height=" true" :value="shareContent"></textarea>
    </view>
    <view class="p-10-15 color-text-333 bg-list-fff m-0-20">
      <view class="p-10-0 color-text-333 mt-15">
        <text class="fs-15 fw-bold color-text-333">分享图片：</text>
      </view>
      <view class="flex-wrap-wrap">
        <image v-if="imageURL != null" class="w-104 h-104" :src="imageURL">
        </image>
        <image v-else class="uni-uploader__input-box w-104 h-104 m-5 border-1-solid-d9d9d9" @tap="chooseImage" src="/static/plus.png"></image>
      </view>
    </view>
    <view class="p-10-15 color-text-333 bg-list-fff m-0-20">
      <view class="p-10-0 color-text-333 mt-15">
        <text class="fs-15 fw-bold color-text-333">分享类型：</text>
      </view>
      <enum-data-checkbox
        :model-value="type.toString()"
        :items="typeOptions"
        mode="default"
        :show-toast="false"
        @change="typeChange"
      />
    </view>
    <view class="p-10-15 color-text-333 bg-list-fff m-0-20">
      <view class="p-10-0 color-text-333 mt-15">
        <text class="fs-15 fw-bold color-text-333">分享到：</text>
      </view>
      <enum-data-checkbox
        :model-value="scene"
        :items="sceneOptions"
        mode="default"
        :show-toast="false"
        @change="sceneChange"
      />
    </view>

    <view class="p-0-15 mt-15">
      <button type="primary" @click="share">分享</button>
    </view>
</template>

<script setup lang="ts">
  const typeOptions = [{ value: '0', text: '图文' }, { value: '1', text: '纯文字' }, { value: '2', text: '纯图片' }]
  const sceneOptions = [{ value: 'WXSceneSession', text: '聊天界面' }, { value: 'WXSceneTimeline', text: '朋友圈' }, { value: 'WXSceneFavorite', text: '微信收藏（暂不支持）', disabled: true }]

  const scene = ref('WXSceneSession')
  const type = ref(0)

  const typeChange = (value : string) => {
    type.value = parseInt(value)
  }
  const sceneChange = (value : string) => {
    scene.value = value
  }

  const title = ref('share')
  const shareContent = ref('uni-app x 可以分享内容到微信了！')
  const imageURL = ref<string | null>(null)

  function chooseImage() {
    uni.chooseImage({
      count: 1,
      success: (res) => {
        imageURL.value = res.tempFilePaths[0]
      },
      fail: (err) => {
        console.log("err: ", JSON.stringify(err));
        uni.showToast({
          title: "choose image error.code:" + err.errCode + ";message:" + err.errMsg,
          position: "bottom"
        })
      }
    })
  }

  function share() {
    uni.showLoading({
      title: "正在分享......"
    })
    console.log('scene.value: ', scene.value);
    uni.share({
      provider: 'weixin',
      title: '微信分享',
      scene: scene.value,
      type: type.value,
      href: "https://uniapp.dcloud.net.cn/api/plugins/share.html",
      summary: shareContent.value,
      imageUrl: imageURL.value,
      success(res) {
        uni.hideLoading()
        uni.showToast({
          title: '分享成功'
        })
      },
      fail(e) {
        uni.hideLoading()
        uni.showToast({
          title: e.errMsg
        })
      }
    })
  }
</script>

<style>
  .share-content {
    max-height: 100px;
  }

  @media (prefers-color-scheme: dark) {
    .share-content {
      color: var(--text-color, #ffffff);
      background-color: var(--list-background-color, #2d2d2d);
      border-color: var(--border-color, rgba(255, 255, 255, 0.1));
    }

    .uni-uploader__input-box {
      border-color: var(--border-color, rgba(255, 255, 255, 0.1));
    }
  }
</style>
