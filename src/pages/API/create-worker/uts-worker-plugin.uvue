<template>
  <scroll-view class="flex-1 u-p-10">
    <view class="d-flex items-center justify-center mb-20 u-p-10 bg-list-fff radius-8">
      <text class="fs-16 color-active-666">Worker状态: </text>
      <text class="fs-16 fw-bold ml-8 color-text-333">{{statusText}}</text>
    </view>

    <view class="flex-dir-column mb-20">
      <text class="fs-14 color-active-666 lh-1_4x mb-10">操作步骤：1.创建Worker 2.发送数据测试（消息监听已在创建Worker时添加）</text>
      <button class="mb-10 radius-6 fs-14 text-center p-5-10" type="primary" :disabled="created_boolean" @click="create">UTS插件中创建Worker</button>
      <button class="mb-10 radius-6 fs-14 text-center p-5-10" @click="destory" :disabled="workerStatus != 'created'">UTS插件中销毁Worker</button>
    </view>

    <view class="u-p-15 bg-list-fff radius-8 mb-20">
      <text class="fs-18 fw-bold color-text-333 mb-10">输入测试值:</text>
      <text class="fs-14 color-active-666 lh-1_4x mb-10">点击发送按钮后，会将输入值传给Worker，在子线程执行+1操作后返回结果</text>
      <input class="w-full p-12 border-1-solid-ddd radius-6 fs-16 m-10-0 color-333 bg-fff" v-model="inputValue" type="number" placeholder="请输入数字" />
      <button class="mb-10 radius-6 fs-14 text-center p-5-10" type="primary" @click="sendMessage" :disabled="workerStatus != 'created'">通过UTS插件发送到Worker (值+1)</button>
    </view>

    <view class="u-p-15 bg-list-fff radius-8">
      <text class="fs-18 fw-bold color-text-333 mb-10">通信日志:</text>
      <scroll-view class="u-h-300 border-1-solid-border-ddd radius-4 u-p-10 m-10-0 bg-active-fafafa">
        <view v-for="(log, index) in logs" :key="index" class="mb-5">
          <text :class="['fs-12 lh-1_4x', 'log-text', log.type]">{{log.message}}</text>
        </view>
      </scroll-view>
      <button @click="clearLogs" class="mb-10 radius-6 fs-14 text-center bg-b45309 fs-12 color-fff radius-4 p-8-12">清空日志</button>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
  import { createTestWorker, sendTestMessage, terminateTestWorker } from "@/uni_modules/uts-worker-plugin"

  interface LogItem {
    message: string
    type: string
    time: string
  }

  const created_boolean = ref(false)
  const workerStatus = ref('none')
  const logs = ref([] as LogItem[])
  const inputValue = ref('1')
  const taskResult = ref('')

  const statusText = computed((): string => {
    switch(workerStatus.value) {
      case 'none': return '未创建';
      case 'created': return '已创建';
      case 'destroyed': return '已销毁';
      default: return '未知';
    }
  })

  function addLog(message: string, type: string = 'info') {
    const now = new Date();
    const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`;
    const logItem: LogItem = {
      message: `[${timeStr}] ${message}`,
      type: type,
      time: timeStr
    }
    logs.value.unshift(logItem);
    if (logs.value.length > 50) {
      logs.value = logs.value.slice(0, 50);
    }
  }

  function create() {
    createTestWorker((message: string) => {
      taskResult.value = message
      inputValue.value = message
      addLog(`收到Worker返回: ${message}`, 'receive')
    })
    workerStatus.value = 'created'
    addLog('Worker创建成功', 'success')
    created_boolean.value = true
  }

  function sendMessage() {
    if (inputValue.value == '') {
      addLog('请输入有效的数字', 'warning')
      return
    }
    sendTestMessage(inputValue.value)
    addLog(`发送值到Worker: ${inputValue.value}`, 'send')
  }

  function destory() {
    terminateTestWorker()
    workerStatus.value = 'destroyed'
    addLog('Worker已销毁', 'warning')
    created_boolean.value = false
  }

  function clearLogs() {
    logs.value = []
  }

  function test_resetInputValue() {
    inputValue.value = '1'
  }

  function test_taskResult(): string {
    return taskResult.value
  }

  onUnload(() => {
    destory()
  })

  defineExpose({
    test_resetInputValue,
    create,
    sendMessage,
    test_taskResult
  })
</script>

<style>
  .log-text.info { color: #2196F3; }
  .log-text.success { color: #4CAF50; }
  .log-text.warning { color: #ff9800; }
  .log-text.error { color: #f44336; }
  .log-text.send { color: #9C27B0; }
  .log-text.receive { color: #009688; }
</style>
