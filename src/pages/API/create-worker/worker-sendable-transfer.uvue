<template>
  <scroll-view class="flex-1 u-p-10 container">
    <view class="d-flex items-center justify-center mb-20 u-p-10 radius-8 bg-list-fff">
      <text class="fs-16 color-worker-secondary-666">Worker状态: </text>
      <text class="fs-16 fw-bold ml-8">{{statusText}}</text>
    </view>

    <view class="flex-dir-column mb-20">
      <text class="fs-14 lh-1_4x mb-10 color-worker-secondary-666">操作步骤：1.创建Worker 2.发送数据测试（消息监听已在创建Worker时添加）</text>
      <button class="mb-10 radius-6 fs-14 text-center p-5-10" type="primary" :disabled="created_boolean" @click="create">UTS插件中创建Worker</button>
      <button class="mb-10 radius-6 fs-14 text-center p-5-10" @click="destory" :disabled="workerStatus != 'created'">UTS插件中销毁Worker</button>
    </view>

    <view class="u-p-15 radius-8 mb-20 bg-list-fff">
      <button class="mb-10 radius-6 fs-14 text-center p-5-10" type="primary" @click="sendMessage"
        :disabled="workerStatus != 'created'">通过UTS插件发送到WorkerTask</button>
    </view>

    <view class="u-p-15 radius-8 bg-list-fff">
      <text class="fs-18 fw-bold mb-10 section-title">通信日志:</text>
      <scroll-view class="u-h-300 radius-4 u-p-10 m-10-0 log-container">
        <view v-for="(log, index) in logs" :key="index" class="mb-5">
          <text :class="['fs-12 lh-1_4x', 'log-text', log.type]">{{log.message}}</text>
        </view>
      </scroll-view>
      <button @click="clearLogs" class="mb-10 radius-6 fs-14 text-center fs-12 color-fff radius-4 clear-btn p-8-12">清空日志</button>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">

  import { UTSWorkerAddListenerOptions, UTSWorkerReceiveEventCallback, UTSWorkerSendWorkerMessageOptions, UTSSendableWorkerImpl } from "@/uni_modules/uts-worker-sendable-transfer";

  const sendableWorker = new UTSSendableWorkerImpl()

  type DataType = {
    myBufLength: number,
    sendableNumber: number,
  }

  interface LogItem {
    message: string
    type: string
    time: string
  }

  const created_boolean = ref(false)
  const workerStatus = ref('none') // none, created, destroyed
  const isListening = ref(false)
  const logs = ref([] as LogItem[])
  const myBuf = ref(new ArrayBuffer(8))
  const data = reactive({
    myBufLength: -1,
    sendableNumber: 0,
  } as DataType)

  onUnload(() => {
    destory();
  })

  const statusText = computed(() : string => {
    switch (workerStatus.value) {
      case 'none': return '未创建';
      case 'created': return '已创建';
      case 'destroyed': return '已销毁';
      default: return '未知';
    }
  })

  // 添加日志方法
  function addLog(message : string, type : string = 'info') {
    const now = new Date();
    const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`;
    const logItem: LogItem = {
      message: `[${timeStr}] ${message}`,
      type: type,
      time: timeStr
    }
    logs.value.unshift(logItem);
    // 限制日志数量
    if (logs.value.length > 50) {
      logs.value = logs.value.slice(0, 50);
    }
  }

  // 创建Worker
  function create() {
    sendableWorker.create()
    workerStatus.value = 'created';
    addLog('Worker创建成功', 'success');
    created_boolean.value = true;
    // 添加消息监听
    sendableWorker.onMessage({
      success: (res) => {
        const result = res.result;
        // #ifdef APP-HARMONY
        // 这里经过 worker 修改后，result.a 应该是 666
        data.sendableNumber = result.a
        // #endif
        addLog(`收到WorkerTask返回: ${JSON.stringify(result)}`, 'receive');
      }
    });
  }

  // 向workerTask发送消息
  function sendMessage() {
    data.myBufLength = myBuf.value.byteLength
    addLog(`buf.byteLength in main BEFORE transfer to worker: ${data.myBufLength}`, 'send');
    sendableWorker.sendMessage({
      message: '这里是主线程发送的 message',
      harmonySendable: true,
      transfer: [myBuf.value]
    })
    // NOTE: HarmonyOS 长度不变，web 长度变为 0
    data.myBufLength = myBuf.value.byteLength
    addLog(`buf.byteLength in main AFTER transfer to worker: ${data.myBufLength}`, 'send');
  }

  defineExpose({
    data,
    create,
    sendMessage
  })

  // 销毁Worker
  function destory() {
    sendableWorker.destroy()
    workerStatus.value = 'destroyed';
    isListening.value = false;
    addLog('Worker已销毁', 'warning');
    created_boolean.value = false;
  }

  // 清空日志
  function clearLogs() {
    logs.value = [];
  }
</script>

<style>
  .color-worker-secondary-666 {
    color: var(--worker-secondary-color, #666666);
  }

  .container {
    --worker-page-background: #fafafa;
    --worker-text-color: #333333;
    --worker-secondary-color: #666666;
    --worker-border-color: #dddddd;
  }

  @media (prefers-color-scheme: dark) {
    .container {
      --worker-page-background: #1a1a1a;
      --worker-text-color: #ffffff;
      --worker-secondary-color: #a0a0a0;
      --worker-border-color: rgba(255, 255, 255, 0.1);
    }
  }

  .section-title {
    color: var(--worker-text-color, #333333);
  }

  .log-container {
    border: 1px solid var(--worker-border-color, #dddddd);
    background-color: var(--worker-page-background, #fafafa);
  }

  .log-text.info {
    color: #2196F3;
  }

  .log-text.success {
    color: #4CAF50;
  }

  .log-text.warning {
    color: #ff9800;
  }

  .log-text.error {
    color: #f44336;
  }

  .log-text.send {
    color: #9C27B0;
  }

  .log-text.receive {
    color: #009688;
  }

  .clear-btn {
    background-color: #ff9800;
  }
</style>
