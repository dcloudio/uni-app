<template>
  <view class="w-full h-full bg-black-a30 d-flex justify-center items-center">
    <view class="w-80pct u-p-10 bg-list-fff radius-6">
      <text class="color-text-333">title: {{ title }}</text>
      <button class="mt-10" @click="closeDialog">
        closeDialog
      </button>
      <button class="mt-10" @click="closeThisDialog">
        closeThisDialog
      </button>
      <button class="mt-10" @click="openDialog3">
        open dialog 3
      </button>
    </view>
  </view>
</template>

<script setup lang="ts">
  const currentPage = getCurrentInstance()?.proxy?.$page

  import {
    state,
    setLifeCycleNum
  } from '@/store/index.ts'

  const title = ref('dialog 4')

  onPageShow(() => {
    console.log('dialog 4 onShow')
    // 自动化测试
    setLifeCycleNum(state.lifeCycleNum + 1)
  })

  onUnload(() => {
    console.log('dialog 4 onUnload')
    // 自动化测试
    setLifeCycleNum(state.lifeCycleNum - 5)
  })

  function closeDialog() {
    uni.closeDialogPage({
      success(res) {
        console.log('closeDialog success', res)
      },
      fail(err) {
        console.log('closeDialog fail', err)
      },
      complete(res) {
        console.log('closeDialog complete', res)
      }
    })
  }

  function closeThisDialog() {
    if (currentPage != null) {
      uni.closeDialogPage({
        dialogPage: currentPage,
        success(res) {
          console.log('closeThisDialog success', res)
        },
        fail(err) {
          console.log('closeThisDialog fail', err)
        },
        complete(res) {
          console.log('closeThisDialog complete', res)
        }
      })
    }
  }

  function openDialog3(){
    uni.openDialogPage({url: '/pages/API/dialog-page/dialog-3'})
  }
</script>

<style>
  page {
    background-color: transparent;
  }
</style>
