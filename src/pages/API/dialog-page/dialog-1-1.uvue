<template>
  <view id="dialog1" class="w-full h-full bg-black-a30 d-flex justify-center items-center">
    <view class="w-80pct u-p-10 bg-list-fff radius-6">
      <text class="color-text-333">title: {{ title }}</text>
      <button @click="closeThisDialog">Close</button>
    </view>
  </view>
</template>

<script setup lang="ts">
  const currentPage = getCurrentInstance()?.proxy?.$page

  import {
    state,
    setLifeCycleNum
  } from '@/store/index.ts'

  const title = ref('dialog 1-1')

  function closeThisDialog() {
    if (currentPage != null) {
      uni.closeDialogPage({
        dialogPage: currentPage,
      })
    }
  }

  onReady(() => {
    console.log('dialog 1-1 onReady')
    // 自动化测试
    setLifeCycleNum(state.lifeCycleNum + 2)
  })

  onUnload(() => {
    console.log('dialog 1-1 onUnload')
    // 自动化测试
    setLifeCycleNum(state.lifeCycleNum - 5)
  })
</script>

<style>
  page {
    background-color: transparent;
  }
</style>
