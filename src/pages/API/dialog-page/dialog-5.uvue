<template>
  <view class="w-full h-full bg-black-a30 d-flex justify-center items-center">
    <view class="w-80pct u-p-10 bg-list-fff radius-6">
      <text class="color-text-333">title: {{ title }}</text>
      <view class="mt-15 flex-dir-row flex-wrap-wrap" v-if="pageBody != null">
        <text class="color-text-333">pageBody: {</text>
        <text class="color-text-333">top: </text>
        <text id="page-body-top" class="color-text-333">{{pageBody!.top}}</text><text class="color-text-333">,</text>
        <text class="color-text-333">right: </text>
        <text id="page-body-right" class="color-text-333">{{pageBody!.right}}</text><text class="color-text-333">,</text>
        <text class="color-text-333">bottom: </text>
        <text id="page-body-bottom" class="color-text-333">{{pageBody!.bottom}}</text><text class="color-text-333">,</text>
        <text class="color-text-333">left: </text>
        <text id="page-body-left" class="color-text-333">{{pageBody!.left}}</text><text class="color-text-333">,</text>
        <text class="color-text-333">width: </text>
        <text id="page-body-width" class="color-text-333">{{pageBody!.width}}</text><text class="color-text-333">,</text>
        <text class="color-text-333">height: </text>
        <text id="page-body-height" class="color-text-333">{{pageBody!.height}}</text><text class="color-text-333">}</text>
      </view>
      <view class="mt-15 flex-dir-row flex-wrap-wrap" v-if="safeAreaInsets != null">
        <text class="color-text-333">safeAreaInsets: {</text>
        <text class="color-text-333">top: </text>
        <text id="page-safe-area-insets-top" class="color-text-333">{{safeAreaInsets!.top}}</text><text class="color-text-333">,</text>
        <text class="color-text-333">right: </text>
        <text id="page-safe-area-insets-right" class="color-text-333">{{safeAreaInsets!.right}}</text><text class="color-text-333">,</text>
        <text class="color-text-333">bottom: </text>
        <text id="page-safe-area-insets-bottom" class="color-text-333">{{safeAreaInsets!.bottom}}</text><text class="color-text-333">,</text>
        <text class="color-text-333">left: </text>
        <text id="page-safe-area-insets-left" class="color-text-333">{{safeAreaInsets!.left}}</text><text class="color-text-333">}</text>
      </view>
      <view class="mt-15 flex-dir-row flex-wrap-wrap color-text-333" v-if="width != null">
      <text class="color-text-333">width: </text>
      <text class="color-text-333">{{width!}}</text>
      </view>
      <view class="mt-15 flex-dir-row flex-wrap-wrap color-text-333" v-if="height != null">
      <text class="color-text-333">height: </text>
      <text class="color-text-333">{{height!}}</text>
      </view>
      <view class="mt-15 flex-dir-row flex-wrap-wrap color-text-333" v-if="statusBarHeight != null">
      <text class="color-text-333">statusBarHeight: </text>
      <text class="color-text-333">{{statusBarHeight!}}</text>
      </view>
      <button class="mt-10" @click="closeThisDialog">
        closeThisDialog
      </button>
    </view>
  </view>
</template>

<script setup lang="ts">
  const instance = getCurrentInstance()!.proxy!
  const currentPage = instance.$page

  const title = ref('dialog 5')
  const pageBody = ref(null as UniPageBody | null)
  const safeAreaInsets = ref(null as UniSafeAreaInsets | null)
  const width = ref(null as number | null)
  const height = ref(null as number | null)
  const statusBarHeight = ref(null as number | null)

  onPageShow(() => {
    console.log('dialog 5 onShow')
  })

  onReady(() => {
    pageBody.value = currentPage.pageBody;
    safeAreaInsets.value = currentPage.safeAreaInsets
    width.value = currentPage.width
    height.value = currentPage.height
    statusBarHeight.value = currentPage.statusBarHeight
  })

  onUnload(() => {
    console.log('dialog 5 onUnload')
  })

  function closeThisDialog() {
    if (currentPage != null) {
      uni.closeDialogPage({
        dialogPage: currentPage,
        success(res) {
          console.log('closeThisDialog success', res)
        },
        fail(err) {
          console.log('closeThisDialog fail', err)
        },
        complete(res) {
          console.log('closeThisDialog complete', res)
        }
      })
    }
  }
</script>

<style>
  page {
    background-color: transparent;
  }
</style>
