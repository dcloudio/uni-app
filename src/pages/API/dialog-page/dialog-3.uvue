<template>
  <view id="dialog3" class="w-full h-full bg-black-a30 d-flex justify-center items-center">
    <scroll-view class="bg-list-fff radius-6 dialog-content w-90pct p-10-6">
      <text class="color-text-333">title: {{ title }}</text>
      <template v-for="(item, index) in PageStyleArray">
        <view class="mt-10 radius-5 page-style-item" v-if="currentPageStyle[item.key] != null" :key="index">
          <view class="flex-dir-row">
            <text class="fw-bold color-text-333">{{ item.key }}:</text>
            <text class="ml-5 color-text-333">{{
              currentPageStyle[item.key]
            }}</text>
          </view>
          <view class="mt-10" v-if="item.type == 'boolean'">
            <boolean-data :value="(currentPageStyle[item.key] as boolean)" :title="item.key"
              @change="switchChange(item.key, $event as boolean)"></boolean-data>
          </view>
          <view class="mt-10" v-else-if="item.type == 'number'">
            <slider :value="(currentPageStyle[item.key] as number)" :show-value="true"
              @change="sliderChange(item.key, $event as UniSliderChangeEvent)" />
          </view>
          <view class="mt-10" v-else-if="item.type == 'string'">
            <enum-data-checkbox
              :model-value="currentPageStyle[item.key] as string"
              :items="createEnumItems(item.value as string[])"
              mode="default"
              :show-toast="false"
              @change="radioChange(item.key, $event as string)"
            />
          </view>
        </view>
      </template>
      <text class="mt-10 fw-bold color-text-333">choose close dialogPage animationType</text>
      <enum-data-checkbox
        :model-value="closeAnimationType"
        :items="closeAnimationOptions"
        mode="default"
        :show-toast="false"
        @change="handleChooseAnimationType"
      />
      <button class="mt-10" @click="closeThisDialog">
        closeThisDialog
      </button>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
  import { createEnumItems } from '@/components/enum-data-checkbox/enum-data-checkbox-types'
  const closeAnimationOptions = computed(() => createEnumItems(closeAnimationTypeList))

  const currentPage = getCurrentInstance()?.proxy?.$page

  import { PageStyleItem, PageStyleArray } from './page-style.ts';

  type CloseAnimationType =
    'auto' |
    'none' |
    'slide-out-right' |
    'slide-out-left' |
    'slide-out-top' |
    'slide-out-bottom' |
    'fade-out' |
    'zoom-in' |
    'zoom-fade-in'

  const title = ref('dialog 3')
  const currentPageStyle = ref({} as UTSJSONObject)
  const closeAnimationType = ref('auto' as CloseAnimationType)
  const closeAnimationTypeList = [
    'auto',
    'none',
    'slide-out-right',
    'slide-out-left',
    'slide-out-top',
    'slide-out-bottom',
    'fade-out',
    'zoom-in',
    'zoom-fade-in'
  ]

  function getPageStyle() {
    if (currentPage != null) {
      currentPageStyle.value = currentPage.getPageStyle()
    }
  }

  function setPageStyle(style : UTSJSONObject) {
    if (currentPage != null) {
      currentPage.setPageStyle(style);
    }
  }

  onLoad((_ : OnLoadOptions) => {
    getPageStyle()
  })

  function setStyleValue(key : string, value : any) {
    const style = {}
    style[key] = value
    setPageStyle(style)
    getPageStyle()
  }

  function radioChange(key : string, value : string) {
    setStyleValue(key, value);
  }

  function sliderChange(key : string, e : UniSliderChangeEvent) {
    setStyleValue(key, e.detail.value);
  }

  function switchChange(key : string, value : boolean) {
    setStyleValue(key, value);
  }

  function handleChooseAnimationType(value : CloseAnimationType){
    closeAnimationType.value = value as CloseAnimationType
  }

  function closeThisDialog() {
    if (currentPage != null) {
      uni.closeDialogPage({
        dialogPage: currentPage,
        animationType: closeAnimationType.value,
        success(res) {
          console.log('closeDialog success', res)
        },
        fail(err) {
          console.log('closeDialog fail', err)
        },
        complete(res) {
          console.log('closeDialog complete', res)
        }
      })
    }
  }
</script>

<style>
  page {
    background-color: #007aff;
  }

  .dialog-content {
    height: 500px;
  }

  .page-style-item {
    padding: 6px 0;
    background-color: var(--active-background-color, #ffffff);
  }
</style>
