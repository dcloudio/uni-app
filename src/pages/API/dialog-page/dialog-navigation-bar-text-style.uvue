<template>
  <view class="w-full h-full justify-center items-center mask">
    <view class="w-300 p-20 radius-8 bg-list-fff">
      <text class="fs-20 fw-bold title mb-14">dialogPage navigationBarTextStyle</text>
      <text class="fs-16 status mb-18">navigationBarTextStyle: black</text>
      <button class="mt-10" @click="closeDialog">close dialogPage</button>
    </view>
  </view>
</template>

<script setup lang="ts">
  const currentPage = getCurrentInstance()!.proxy!.$page

  function closeDialog() {
    uni.closeDialogPage({
      dialogPage: currentPage,
      animationType: 'fade-out',
      animationDuration: 200
    })
  }
</script>

<style>
  page {
    background-color: transparent;
  }

  .mask {
    background-color: rgba(0, 0, 0, 0.62);
  }

  .title {
    color: var(--text-color, #111827);
  }

  .status {
    color: var(--text-color, #374151);
  }
</style>
