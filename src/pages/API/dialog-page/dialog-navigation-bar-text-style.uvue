<template>
  <view class="mask">
    <view class="dialog">
      <text class="title">dialogPage navigationBarTextStyle</text>
      <text class="status">navigationBarTextStyle: black</text>
      <button class="button" @click="closeDialog">close dialogPage</button>
    </view>
  </view>
</template>

<script setup lang="ts">
  const currentPage = getCurrentInstance()!.proxy!.$page

  function closeDialog() {
    uni.closeDialogPage({
      dialogPage: currentPage,
      animationType: 'fade-out',
      animationDuration: 200
    })
  }
</script>

