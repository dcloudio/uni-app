<template>
    <button @tap="exitAppClick">退出应用</button>
    <button @tap="reLaunchPage">reLaunch 重启当前页面</button>
    <text>注:iOS仅在uni-app x SDK模式中支持应用退出</text>
</template>

<script setup lang="ts">
  const exitCallback = ref('')

  const exitAppClick = () => {
    exitCallback.value = ''
    uni.exit({
      success: function (res) {
        exitCallback.value = 'success'
        console.log(res)
      },
      fail: function(error){
        exitCallback.value = 'fail'
        console.log(error)
      }
    })
  }

  const reLaunchPage = () => {
    uni.reLaunch({
      url: '/pages/API/exit/exit'
    })
  }
  defineExpose({ exitAppClick, exitCallback })
</script>

<style>

</style>
