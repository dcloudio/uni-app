<template>
  <view class="bg-007aff w-full h-full">
    <view class="w-full pos-absolute h-full pt-status-bar-height">
      <view class="w-full pos-relative flex-dir-row justify-between h-45">
        <view class="justify-center items-center w-40 h-full">
          <text class="color-white h-full fs-26 left_icon top-5" @click="onBack()">{{backIcon}}</text>
        </view>

        <view class="pos-absolute h-full top-0 bottom-0 flex-dir-row justify-center items-center left-45 right-45">
          <text class="color-fff fs-17">{{title}}</text>
        </view>

      </view>
      <web-view class="pt-10 flex-1 w-full web_container" :src="url"></web-view>
    </view>
  </view>
</template>

<script setup lang="ts">
  const instance = getCurrentInstance()!.proxy!

  const url = ref('')
  const title = ref('')
  const animationType = ref('slide-out-bottom')
  const backIcon = ref('\ue601')

  function onBack() {
    uni.closeDialogPage({
      dialogPage: instance.$page,
      animationType: animationType.value,
      success(res) {
        console.log('closeThisDialog success', res)
      },
      fail(err) {
        console.log('closeThisDialog fail', err)
      }
    })
  }

  onLoad((options : OnLoadOptions) => {
    url.value = options["url"] as string;
    title.value = options["title"] as string;
    animationType.value = options["animationType"] as string;
  })
</script>

<style>
  .left_icon {
    font-family: uni-icon;
  }

  .web_container {
    background-color: #f1f1f1;
  }
</style>
