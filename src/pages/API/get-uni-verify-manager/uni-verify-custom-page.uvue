<template>
  <view class="flex-1 w-full">
    <view class="w-full h-full pt-status-bar-height">
      <text class="fs-24 color-text close_icon top-15" @click="closePage">{{closeIcon}}</text>
      <text class="self-center color-text top-20">这是一键登录自定义 uvue 页面</text>
      <view class="w-full pos-absolute h-120 number">
        <text id="number-text" class="w-full text-center fs-28 fw-bold self-center h-30 color-text" ref="number-text">{{phone}}</text>
        <text id="slogan-text" class="mt-10 w-full fs-13 text-center self-center color-808080 h-20">{{slogan}}</text>
      </view>
      <button id="login-button" class="login-button w-80pct pos-absolute self-center" @click="loginIn">本机号码一键登录</button>
      <view class="mt-10 flex-dir-row flex-wrap-wrap w-full justify-center self-center pos-absolute privacy">
        <checkbox id="privacy-checkbox" class="privacy-checkbox" ref="privacy-checkbox" :checked="privacyChecked" />
        <text class="mt-4 fs-14 color-808080">登录即同意</text>
        <text id="privacy-text" class="mt-4 color-007aff fs-14" @click="openLink">{{privacyName}}</text>
      </view>
      <text class="pos-absolute self-center fs-14 color-text other" @click="otherLogin">其他登录方式</text>
    </view>
  </view>
</template>

<script setup lang="ts">
  const instance = getCurrentInstance()!.proxy!

  const uniVerifyManager = ref(null as UniVerifyManager | null)
  const phone = ref('')
  const slogan = ref('')
  const privacyName = ref('')
  const privacyUrl = ref('')
  const closeIcon = ref('\uE650')
  const isLoading = ref(false)
  const privacyChecked = ref(false)
  const data = reactive({
    autoTest: false,
    onceEventName: ''
  })

  function closePage() {
    uni.closeDialogPage({
      dialogPage: instance.$page,
      animationType: 'slide-out-bottom',
      success(res) {
        console.log('closeThisDialog success', res)
      },
      fail(err) {
        console.log('closeThisDialog fail', err)
      }
    })
  }

  function openLink() {
    let url = '/pages/API/get-uni-verify-manager/full-webview-page?url=' + privacyUrl.value + '&title=' + privacyName.value + '&animationType=slide-out-bottom';
    uni.openDialogPage({
      url: url,
      animationType: 'slide-in-bottom',
      success(res) {
        console.log("打开隐私协议");
      },
      fail(err) {
        console.log(err);
      }
    })
  }

  function takePhoneNumber(token : string, openId : string) {
    uniCloud.callFunction({
      name: 'univerify',
      data: {
        access_token: token,
        openid: openId
      }
    }).then(res => {
      closePage();
      setTimeout(() => {
        uni.showModal({
          title: '取号成功',
          content: ((res.result.res as UTSJSONObject)?.phoneNumber as string),
          showCancel: false
        });
      }, 100);
    }).catch(err => {
      console.error(JSON.stringify(err));
      closePage();
      setTimeout(() => {
        uni.showModal({
          title: '取号失败',
          content: (err as Error).message,
          showCancel: false
        });
      }, 100);
    });
  }

  function loginIn() {
    if (isLoading.value) {
      uni.showToast({
        title: "正在登录中，请稍后",
        position: "bottom",
        duration: 2000
      })
      return;
    }else{
      isLoading.value = true;
    }
    const numberTextElement = instance.$page.getElementById('number-text');
    const sloganTextElement = instance.$page.getElementById('slogan-text');
    const loginButtonElement = instance.$page.getElementById('login-button');
    const privacyCheckBoxElement = instance.$page.getElementById('privacy-checkbox');
    const privacyTextElement = instance.$page.getElementById('privacy-text');
    if (numberTextElement != null && sloganTextElement != null && loginButtonElement != null && privacyCheckBoxElement != null && privacyTextElement != null) {
      uniVerifyManager.value?.customLogin({
        numberTextElement: numberTextElement,
        sloganTextElement: sloganTextElement,
        loginButtonElement: loginButtonElement,
        privacyCheckBoxElement: privacyCheckBoxElement,
        privacyTextElement: privacyTextElement,
        success: (res) => {
          console.log(res);
          // #ifdef APP-HARMONY
          if (data.autoTest) {
            closePage()
            uni.$emit(data.onceEventName)
            return
          }
          // #endif
          takePhoneNumber(res.accessToken, res.openId);
        },
        fail: (error) => {
          if (error.errCode == 40001) {
            uni.showToast({
              title: "请同意服务条款",
              position: "bottom",
              duration: 2000
            })
          } else if (error.errCode == 40002) {
            uni.showToast({
              title: "授权页不符合规范",
              position: "bottom",
              duration: 2000
            })
          } else {
            const errorMsg = (JSON.parse(error.cause?.cause?.message ?? "")?.errorDesc as string) ?? error.errMsg;
            uni.showToast({
              title: errorMsg,
              position: "bottom",
              duration: 2000
            })
          }
        },
        complete: () =>{
          isLoading.value = false;
        }
      })
    } else {
      uni.showToast({
        title: "未获取到页面元素",
        position: "bottom",
        duration: 2000
      })
      isLoading.value = false;
    }
  }

  function otherLogin() {
    uni.showToast({
      title: "使用其他方式登录",
      position: "bottom"
    })
  }

  onLoad((options : OnLoadOptions) => {
    uniVerifyManager.value = uni.getUniVerifyManager();
    phone.value = options['phone'] as string;
    slogan.value = options['slogan'] as string;
    privacyName.value = options['name'] as string;
    privacyUrl.value = options['link'] as string;

    data.autoTest = (options['autoTest'] as string) === 'true'
    data.onceEventName = options['onceEventName'] as string

    // #ifdef APP-HARMONY
    if (data.autoTest) {
      nextTick(() => {
        privacyChecked.value = true
        loginIn()
      })
    }
    // #endif
  })
</script>

<style>
  .close_icon {
    left: 90%;
    font-family: uni-icon;
    /* font-weight: bold; */
  }

  .number {
    top: 25%;
  }

  .login-button {
    top: 40%;
    background-color: orangered;
    font-size: 16px;
    color: white;
  }

  .privacy {
    top: 45%;
  }

  .privacy-checkbox {
    transform: scale(0.65);
  }

  .other {
    bottom: 7%;
    transform: translateY(50%);
  }
</style>
