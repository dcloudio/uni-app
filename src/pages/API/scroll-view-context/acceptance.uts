export type AcceptanceCheck = {
  id: string
  passed: boolean
  expected: string
  actual: string
}

export type GestureOptions = {
  enabled: boolean
  paging: boolean
  offset: number
  bounce: boolean
  twoLevelEnabled: boolean
}

export type AcceptanceHost = {
  container: string
  context: ScrollViewContext
  element: UniElement
  alive: () => boolean
  events: () => number[]
  position: () => number[]
  animation: (enabled: boolean) => Promise<void>
  record: (result: AcceptanceCheck) => void
}

export function delay(ms: number): Promise<void> {
  return new Promise<void>((resolve) => setTimeout(resolve, ms))
}

// 轮询真实原生状态；不将请求坐标当作结果。
export async function until(predicate: () => boolean, timeout: number = 2500): Promise<void> {
  const start = Date.now()
  while (!predicate()) {
    if (Date.now() - start > timeout) throw new Error('等待原生状态超时')
    await delay(40)
  }
}

export function queryContext(useCallback: boolean): Promise<ScrollViewContext> {
  return new Promise<ScrollViewContext>((resolve, reject) => {
    function accept(result: any) {
      if (result == null || result.node == null) reject(new Error('未找到滚动上下文'))
      else resolve(result.node as ScrollViewContext)
    }
    const query = uni.createSelectorQuery().select('#demo-scroll')
    if (useCallback) query.node(accept).exec()
    else query.node().exec((results) => accept(results.length == 0 ? null : results[0]))
  })
}

export async function runAcceptance(host: AcceptanceHost): Promise<void> {
  async function pause(ms: number): Promise<void> {
    if (!host.alive()) throw new Error('页面已卸载')
    await delay(ms)
    if (!host.alive()) throw new Error('页面已卸载')
  }
  async function waitFor(predicate: () => boolean): Promise<void> {
    await until(() => {
      if (!host.alive()) throw new Error('页面已卸载')
      return predicate()
    })
  }
  const ctx = host.context
  const el = host.element
  const original = [ctx.bounces, ctx.showScrollbar, ctx.scrollEnabled, ctx.pagingEnabled]
  const initialPosition = [el.scrollLeft, el.scrollTop]
  const horizontal = host.container == 'scroll-view'
  const supportedProperties = ['bounces', 'showScrollbar', 'scrollEnabled', 'pagingEnabled'].filter((key) => typeof (ctx as any)[key] == 'boolean')
  function near(actual: number, expected: number): boolean { return Math.abs(actual - expected) <= 2 }
  function flag(key: string): boolean { return (el as any).nativeElement.getAnyAttribute(key) == true }
  function assert(ok: boolean, expected: string, actual: string) {
    if (!ok) throw new Error('期望 ' + expected + '；实际 ' + actual)
    return actual
  }
  async function test(id: string, expected: string, action: () => Promise<string>) {
    if (!host.alive()) throw new Error('页面已卸载')
    try {
      const actual = await action()
      if (host.alive()) host.record({ id, passed: true, expected, actual })
    } catch (error) {
      if (!host.alive()) throw error
      host.record({ id, passed: false, expected, actual: String(error) })
    }
  }
  async function move(options: ScrollViewScrollToOptions, expectedTop: number, expectedLeft: number = 0): Promise<string> {
    ctx.scrollTo(options)
    try { await waitFor(() => near(el.scrollTop, expectedTop) && near(el.scrollLeft, expectedLeft)) }
    catch (error) { throw new Error('期望 left=' + expectedLeft + ',top=' + expectedTop + '；实际 left=' + el.scrollLeft + ',top=' + el.scrollTop) }
    return 'left=' + el.scrollLeft + ',top=' + el.scrollTop
  }
  async function reset() {
    if (typeof ctx.closeRefresh == 'function') ctx.closeRefresh()
    if (typeof ctx.closeTwoLevel == 'function') ctx.closeTwoLevel({ duration: 0 })
    if (supportedProperties.includes('scrollEnabled')) ctx.scrollEnabled = true
    if (supportedProperties.includes('pagingEnabled')) ctx.pagingEnabled = false
    ctx.bounces = false
    await host.animation(false)
    await pause(350)
    await move({ top: 0, left: 0, animated: false }, 0)
  }
  async function refreshClosed() {
    ctx.closeRefresh()
    await waitFor(() => !flag('refresher-triggered'))
    await pause(400)
  }

  try {
    // 在任何写入前读取默认值，要求从新页面启动。
    await test('context.exec', 'node().exec 获得四个属性及六个方法', async () => {
      const selected = await queryContext(false)
      const methods = ['scrollTo', 'scrollIntoView', 'triggerRefresh', 'closeRefresh', 'triggerTwoLevel', 'closeTwoLevel']
      return assert(methods.every((key) => typeof (selected as any)[key] == 'function'), '全部方法可调用', methods.join(','))
    })
    await test('properties.defaults', 'bounces/showScrollbar/scrollEnabled=true,pagingEnabled=false', async () => {
      return assert(ctx.bounces && ctx.showScrollbar && ctx.scrollEnabled && !ctx.pagingEnabled,
        'true,true,true,false', [ctx.bounces, ctx.showScrollbar, ctx.scrollEnabled, ctx.pagingEnabled].join(','))
    })
    for (const property of ['bounces', 'showScrollbar', 'scrollEnabled', 'pagingEnabled']) {
      for (const value of [false, true]) {
        await test('properties.' + property + '.' + value, '立即读取和重新获取均为 ' + value, async () => {
          assert(supportedProperties.includes(property), '原生上下文声明布尔属性', property + ' 缺失')
          ;(ctx as any)[property] = value
          const immediate = (ctx as any)[property]
          const execContext = await queryContext(false)
          const callbackContext = await queryContext(true)
          return assert(immediate == value && (execContext as any)[property] == value && (callbackContext as any)[property] == value,
            String(value), [immediate, (execContext as any)[property], (callbackContext as any)[property]].join(','))
        })
      }
    }
    await reset()
    await test('scrollTo.top', 'top=300', async () => await move({ top: 300, animated: false }, 300))
    await test('scrollTo.empty', '空对象保持位置', async () => {
      ctx.scrollTo({})
      await pause(150)
      return assert(near(el.scrollTop, 300), '300', String(el.scrollTop))
    })
    if (horizontal) {
      await test('scrollTo.left', '省略 top 时保留 300', async () => await move({ left: 120, animated: false }, 300, 120))
      await test('scrollTo.both', 'left=80,top=360', async () => await move({ left: 80, top: 360, animated: false }, 360, 80))
      await test('scrollTo.omitLeft', '省略 left 时保留 80', async () => await move({ top: 420, animated: false }, 420, 80))
    }
    await test('scrollTo.negative', '负坐标钳制到 0', async () => await move({ top: -100, left: -100, animated: false }, 0))
    await test('scrollTo.disabled', '禁用手势仍可程序化滚动', async () => {
      assert(supportedProperties.includes('scrollEnabled') && supportedProperties.includes('pagingEnabled'), '支持手势及分页属性', supportedProperties.join(','))
      ctx.scrollEnabled = false
      ctx.pagingEnabled = true
      try { return await move({ top: 300, animated: false }, 300) }
      finally { ctx.scrollEnabled = true; ctx.pagingEnabled = false }
    })
    for (const duration of [0, -50]) {
      await test('scrollTo.duration.' + duration, '零/负时长立即到 420', async () => {
        await move({ top: 0, animated: false }, 0)
        return await move({ top: 420, duration }, 420)
      })
    }
    await test('scrollTo.animatedFalse', 'animated=false 覆盖 duration/velocity', async () => {
      return await move({ top: 180, animated: false, duration: 2000, velocity: 1000 }, 180)
    })
    await test('scrollTo.duration', '600ms 动画有中间帧且到达 600', async () => {
      await move({ top: 0, animated: false }, 0)
      ctx.scrollTo({ top: 600, duration: 600 })
      await pause(150)
      const sample = el.scrollTop
      assert(sample > 0 && sample < 598, '0<中间坐标<600', String(sample))
      await waitFor(() => near(el.scrollTop, 600))
      return '150ms=' + sample + ',end=' + el.scrollTop
    })
    for (const velocity of [0, 1200, -100]) {
      await test('scrollTo.velocity.' + velocity, '带初速度的动画到达 600', async () => {
        await move({ top: 0, animated: false }, 0)
        ctx.scrollTo({ top: 600, duration: 600, velocity })
        await pause(150)
        const sample = el.scrollTop
        assert(sample > 0 && sample < 598, '有中间帧', String(sample))
        await waitFor(() => near(el.scrollTop, 600))
        return '150ms=' + sample + ',end=' + el.scrollTop
      })
    }
    await test('scrollTo.defaultAnimation', '省略 animated 使用组件动画', async () => {
      await move({ top: 0, animated: false }, 0)
      await host.animation(true)
      ctx.scrollTo({ top: 600 })
      await pause(60)
      const sample = el.scrollTop
      assert(sample < 598, '动画尚未完成', String(sample))
      await waitFor(() => near(el.scrollTop, 600))
      await host.animation(false)
      return '60ms=' + sample + ',end=' + el.scrollTop
    })
    await test('scrollTo.interrupt', '新调用取消旧动画并保持 180', async () => {
      ctx.scrollTo({ top: 900, duration: 600 })
      await pause(100)
      await move({ top: 180, animated: false }, 180)
      await pause(650)
      return assert(near(el.scrollTop, 180), '180', String(el.scrollTop))
    })
    await host.animation(false)

    // 虚拟列表先滚入内容中部，再选当前视口内实际可见的条目。
    const prime = host.container == 'waterflow' ? 450 : 800
    for (const alignment of ['start', 'center', 'end', 'nearest']) {
      for (const offset of [0, 12, -12]) {
        await test('scrollIntoView.' + alignment + '.' + offset, '已渲染条目按 ' + alignment + ' 偏移 ' + offset, async () => {
          await move({ top: prime, left: 0, animated: false }, prime)
          await pause(100)
          const viewport = el.getBoundingClientRect()
          let target: UniElement | null = null
          let targetId = ''
          let visibleHeight = 0
          for (let item = 1; item <= 30; item++) {
            const selector = '#item-' + item
            const candidate = el.querySelector(selector)
            if (candidate == null) continue
            const rect = candidate.getBoundingClientRect()
            const overlap = Math.min(rect.bottom, viewport.bottom) - Math.max(rect.top, viewport.top)
            if (overlap <= visibleHeight) continue
            target = candidate
            targetId = selector
            visibleHeight = overlap
          }
          if (target == null) throw new Error('当前视口没有已渲染的可见条目')
          const targetRect = target.getBoundingClientRect()
          const start = el.scrollTop + targetRect.top - viewport.top
          const size = targetRect.height
          const before = el.scrollTop
          let expected = start
          if (alignment == 'center') expected = start - (viewport.height - size) / 2
          if (alignment == 'end') expected = start + size - viewport.height
          if (alignment == 'nearest') {
            if (start >= before && start + size <= before + viewport.height) expected = before
            else expected = start < before ? start : start + size - viewport.height
          }
          // nearest 对完全可见的目标保持位置，offset 也不引起移动。
          if (alignment != 'nearest' || expected != before) expected += offset
          ctx.scrollIntoView(targetId, { alignment: alignment as any, offset, animated: false })
          try { await waitFor(() => near(el.scrollTop, expected)) }
          catch (error) { throw new Error('期望 top=' + expected + '；实际 top=' + el.scrollTop) }
          return targetId + ': expected=' + expected + ',actual=' + el.scrollTop
        })
      }
    }
    await test('scrollIntoView.legacy', '无 options 定位首项', async () => {
      await move({ top: 50, left: 0, animated: false }, 50)
      await pause(100)
      ctx.scrollIntoView('#item-1')
      await waitFor(() => near(el.scrollTop, 0))
      return String(el.scrollTop)
    })
    for (const selector of ['#missing-scroll-target', '#outside-target']) {
      await test('scrollIntoView.scope.' + selector, '容器外/未命中目标保持位置', async () => {
        await move({ top: 180, animated: false }, 180)
        ctx.scrollIntoView(selector, { animated: false })
        await pause(200)
        return assert(near(el.scrollTop, 180), '180', String(el.scrollTop))
      })
    }
    await test('scrollTo.overflowAndEvent', '越界钳制且 scroll 事件与实际坐标一致', async () => {
      ctx.scrollTo({ top: 100000, left: 100000, animated: false })
      await pause(350)
      const actual = [el.scrollLeft, el.scrollTop]
      const events = host.position()
      return assert(actual[1] > 0 && actual[1] < 100000 && actual[0] >= 0 && actual[0] < 100000 && near(actual[0], events[0]) && near(actual[1], events[1]),
        '钳制且事件一致', 'native=' + actual.join(',') + ';event=' + events.join(','))
    })

    await reset()
    for (const style of ['none', 'black', 'white']) {
      el.setAnyAttribute('refresher-default-style', style)
      await pause(100)
      await test('refresh.' + style, '刷新事件一次、重复调用不重发、关闭恢复一次', async () => {
        const before = host.events()
        ctx.triggerRefresh({ duration: 0, easingFunction: 'linear' })
        await waitFor(() => host.events()[0] == before[0] + 1)
        assert(flag('refresher-triggered'), '刷新中', 'state=' + flag('refresher-triggered'))
        ctx.triggerRefresh({ duration: 0 })
        await move({ top: 300, animated: false }, 300)
        ctx.triggerRefresh({ duration: 0 })
        await pause(100)
        assert(host.events()[0] == before[0] + 1 && near(el.scrollTop, 300), '去重且保持 300', host.events().join(',') + ';top=' + el.scrollTop)
        await refreshClosed()
        return assert(host.events()[1] == before[1] + 1 && near(el.scrollTop, 300), '恢复一次且保持 300', host.events().join(',') + ';top=' + el.scrollTop)
      })
      await test('twoLevel.' + style, '二级开关、重复调用不触发普通刷新', async () => {
        await move({ top: 0, animated: false }, 0)
        const count = host.events()[0]
        ctx.triggerTwoLevel({ duration: 0 })
        await waitFor(() => flag('refresher-two-level-triggered'))
        ctx.triggerTwoLevel({ duration: 0 })
        ctx.triggerRefresh({ duration: 0 })
        await pause(100)
        assert(flag('refresher-two-level-triggered') && host.events()[0] == count, '仍为二级且刷新事件不增加', String(host.events()[0]))
        ctx.closeTwoLevel({ duration: 0 })
        await waitFor(() => !flag('refresher-two-level-triggered'))
        return assert(near(el.scrollTop, 0), '关闭回到 0', String(el.scrollTop))
      })
    }
    el.setAnyAttribute('refresher-default-style', 'none')
    for (const easingFunction of ['linear', 'ease', 'ease-in', 'ease-out', 'ease-in-out']) {
      await test('refresh.easing.' + easingFunction, '指定曲线的刷新与二级开关均完成', async () => {
        const before = host.events()[0]
        ctx.triggerRefresh({ duration: 80, easingFunction: easingFunction as any })
        await waitFor(() => host.events()[0] == before + 1)
        await refreshClosed()
        ctx.triggerTwoLevel({ duration: 80, easingFunction: easingFunction as any })
        await pause(180)
        assert(flag('refresher-two-level-triggered'), '二级已打开', String(flag('refresher-two-level-triggered')))
        ctx.closeTwoLevel({ duration: 80, easingFunction: easingFunction as any })
        await pause(180)
        return assert(!flag('refresher-two-level-triggered'), '二级已关闭', String(flag('refresher-two-level-triggered')))
      })
    }
    await test('refresh.defaults', '不传 options 的刷新及二级开关', async () => {
      const before = host.events()[0]
      ctx.triggerRefresh()
      await waitFor(() => host.events()[0] == before + 1)
      await refreshClosed()
      ctx.triggerTwoLevel()
      await pause(650)
      assert(flag('refresher-two-level-triggered'), '已打开', String(flag('refresher-two-level-triggered')))
      ctx.closeTwoLevel()
      await pause(650)
      return assert(!flag('refresher-two-level-triggered'), '已关闭', String(flag('refresher-two-level-triggered')))
    })
    await test('refresh.cancel', '立刻关闭可取消刷新动画且不发 refresh', async () => {
      const before = host.events()[0]
      ctx.triggerRefresh({ duration: 500 })
      ctx.closeRefresh()
      await pause(650)
      return assert(!flag('refresher-triggered') && host.events()[0] == before, '关闭且事件不增加', host.events().join(','))
    })
    await test('twoLevel.cancel', '立刻关闭可取消二级动画', async () => {
      ctx.triggerTwoLevel({ duration: 500 })
      ctx.closeTwoLevel({ duration: 0 })
      await pause(650)
      return assert(!flag('refresher-two-level-triggered') && near(el.scrollTop, 0), '关闭且 top=0', String(el.scrollTop))
    })
    await test('refresh.disabledScroll', '禁用滚动仍可程序化刷新及二级开关', async () => {
      ctx.scrollEnabled = false
      const before = host.events()[0]
      ctx.triggerRefresh({ duration: 0 })
      await waitFor(() => host.events()[0] == before + 1)
      await refreshClosed()
      ctx.triggerTwoLevel({ duration: 0 })
      await waitFor(() => flag('refresher-two-level-triggered'))
      ctx.closeTwoLevel({ duration: 0 })
      await waitFor(() => !flag('refresher-two-level-triggered'))
      ctx.scrollEnabled = true
      return '刷新与二级开关完成'
    })
    await test('refresh.requireEnabled', '未开启 refresher-enabled 时不触发', async () => {
      el.setAnyAttribute('refresher-enabled', false)
      await pause(100)
      const before = host.events()[0]
      ctx.triggerRefresh({ duration: 0 })
      ctx.triggerTwoLevel({ duration: 0 })
      await pause(180)
      return assert(!flag('refresher-triggered') && !flag('refresher-two-level-triggered') && host.events()[0] == before,
        '无刷新/二级', host.events().join(','))
    })
  } finally {
    if (host.alive()) {
      el.setAnyAttribute('refresher-enabled', true)
      el.setAnyAttribute('refresher-default-style', 'none')
      if (typeof ctx.closeRefresh == 'function') ctx.closeRefresh()
      if (typeof ctx.closeTwoLevel == 'function') ctx.closeTwoLevel({ duration: 0 })
      await pause(400)
      ctx.bounces = original[0]
      ctx.showScrollbar = original[1]
      if (supportedProperties.includes('scrollEnabled')) ctx.scrollEnabled = original[2]
      if (supportedProperties.includes('pagingEnabled')) ctx.pagingEnabled = original[3]
      await host.animation(false)
      ctx.scrollTo({ left: initialPosition[0], top: initialPosition[1], animated: false })
    }
  }
}
