import { runAcceptance, delay, type AcceptanceCheck, type GestureOptions } from './acceptance.uts'
import { runFocusedCheck } from './focused-checks.uts'

type LabValue<T> = { value: T }

export function previewHeightForWindow(windowHeight: number): number {
  return Math.max(180, Math.min(220, Math.round(windowHeight * 0.3)))
}

export type ContextLabState = {
  container: LabValue<string>
  activePanel: LabValue<string>
  controlsMaxHeight: LabValue<string>
  scrollDirection: LabValue<string>
  contextReady: LabValue<boolean>
  extendedReady: LabValue<boolean>
  status: LabValue<string>
  message: LabValue<string>
  targetInfo: LabValue<string>
  left: LabValue<number>
  top: LabValue<number>
  bounces: LabValue<boolean>
  scrollbar: LabValue<boolean>
  animated: LabValue<boolean>
  checkingEdges: LabValue<boolean>
  edgeResult: LabValue<string>
  checkingContext: LabValue<boolean>
  contextResult: LabValue<string>
  scrollEnabled: LabValue<boolean>
  pagingEnabled: LabValue<boolean>
  refreshCount: LabValue<number>
  restoreCount: LabValue<number>
  acceptanceRunning: LabValue<boolean>
  acceptanceChecks: LabValue<AcceptanceCheck[]>
  acceptanceSummary: LabValue<string>
  focusedChecks: LabValue<AcceptanceCheck[]>
  focusedRunning: LabValue<boolean>
  busy: LabValue<boolean>
  items: number[]
  unsupportedProperties: string[]
  flush: () => Promise<void>
}

export function createContextLab(state: ContextLabState) {
  const { container, activePanel, controlsMaxHeight, scrollDirection, contextReady, extendedReady, status, message, targetInfo, left, top, bounces, scrollbar, animated, checkingEdges, edgeResult, checkingContext, contextResult, scrollEnabled, pagingEnabled, refreshCount, restoreCount, acceptanceRunning, acceptanceChecks, acceptanceSummary, focusedChecks, focusedRunning, busy, items, unsupportedProperties } = state
  // 缓存原生上下文，不使用 ref/reactive 包装。
  let context: ScrollViewContext | null = null
  // 仅用于显示目标查询结果，与 context 是同一个节点，不替代上下文方法。
  let scrollElement: UniElement | null = null
  let alive = true
  let callCount = 0

  function report(text: string) {
    callCount++
    message.value = '[' + callCount + '] ' + text
    console.log('[ScrollViewContext]', message.value)
  }

  function getContext(): ScrollViewContext | null {
    if (busy.value) return null
    if (context == null) report('未获取上下文，请先点击 node 获取按钮')
    return context
  }

  function selectPanel(panel: string) { activePanel.value = panel }

  function focusedResult(key: string): string {
    const result = focusedChecks.value.find((check) => check.id == key)
    if (result == null) return '待检查'
    return (result.passed ? 'PASS · ' : 'FAIL · ') + result.actual
  }

  async function checkFocused(key: string) {
    if (busy.value || context == null || scrollElement == null) return
    const current = context
    const element = scrollElement
    focusedRunning.value = true
    focusedChecks.value = focusedChecks.value.filter((check) => check.id != key)
    try {
      const actual = await runFocusedCheck(key, {
        context: current, element,
        refreshCount: () => refreshCount.value,
        restoreCount: () => restoreCount.value
      })
      focusedChecks.value.push({ id: key, passed: true, expected: '单项检查通过', actual })
    } catch (error) {
      focusedChecks.value.push({ id: key, passed: false, expected: '单项检查通过', actual: String(error) })
    } finally {
      bounces.value = current.bounces
      scrollbar.value = current.showScrollbar
      scrollEnabled.value = current.scrollEnabled
      pagingEnabled.value = current.pagingEnabled
      focusedRunning.value = false
    }
  }

  function focusedSnapshot(): string {
    return JSON.stringify({ running: focusedRunning.value, checks: focusedChecks.value })!
  }

  function toggleScrollDirection() {
    if (busy.value) return
    scrollDirection.value = scrollDirection.value == 'all' ? 'vertical' : 'all'
    report('滚动方向：' + (scrollDirection.value == 'vertical' ? '竖向' : '双轴'))
  }

  function resetDemo() {
    const current = getContext()
    if (current == null) return
    current.closeRefresh?.()
    current.closeTwoLevel?.({ duration: 0 })
    current.bounces = true
    current.showScrollbar = true
    current.scrollEnabled = true
    current.pagingEnabled = false
    current.scrollTo({ top: 0, left: 0, animated: false })
    bounces.value = true
    scrollbar.value = true
    scrollEnabled.value = true
    pagingEnabled.value = false
    animated.value = false
    scrollDirection.value = 'all'
    targetInfo.value = '尚未点击条目'
    report('已恢复默认属性并回到左上角')
  }

  function prepareRefreshGesture() {
    const current = getContext()
    if (current == null) return
    if (container.value == 'scroll-view') scrollDirection.value = 'vertical'
    current.bounces = true
    current.scrollEnabled = true
    current.pagingEnabled = false
    current.scrollTo({ top: 0, left: 0, animated: false })
    bounces.value = true
    scrollEnabled.value = true
    pagingEnabled.value = false
    report('已准备下拉手势：在预览区从顶部向下拖动')
  }

  function acceptContext(node: any) {
    if (!alive) return
    if (node == null || typeof node.scrollTo != 'function' || typeof node.scrollIntoView != 'function') {
      status.value = node == null ? '未找到 #demo-scroll' : '节点方法不可用，请确认框架和基座已更新'
      report(status.value)
      return
    }
    const selected = node as ScrollViewContext
    context = selected
    scrollElement = node as UniElement
    scrollElement.setAnyAttribute('refresher-two-level-enabled', true)
    bounces.value = selected.bounces
    scrollbar.value = selected.showScrollbar
    scrollEnabled.value = selected.scrollEnabled
    pagingEnabled.value = selected.pagingEnabled
    contextReady.value = true
    const missing = ['scrollEnabled', 'pagingEnabled'].filter((key) => typeof node[key] != 'boolean')
    for (const key of ['triggerRefresh', 'closeRefresh', 'triggerTwoLevel', 'closeTwoLevel']) {
      if (typeof node[key] != 'function') missing.push(key)
    }
    status.value = missing.length == 0 ? '已获取' : '已获取（基座接口不完整）'
    extendedReady.value = missing.length == 0
    report(missing.length == 0 ? '读取：bounces=' + selected.bounces + '，showScrollbar=' + selected.showScrollbar : '当前基座缺少：' + missing.join(', '))
  }

  function acquireContext(useCallback: boolean) {
    if (busy.value) return
    // #ifndef APP
    status.value = '仅支持 App Vapor'
    report(status.value)
    return
    // #endif
    context = null
    scrollElement = null
    contextReady.value = false
    targetInfo.value = '尚未点击条目'
    status.value = '获取中'
    report(useCallback ? 'node(callback).exec()' : 'node().exec(...)')
    const nodes = uni.createSelectorQuery().select('#demo-scroll')
    if (useCallback) {
      nodes.node((res) => acceptContext(res == null ? null : res.node)).exec()
    } else {
      nodes.node().exec((res) => acceptContext(res.length == 0 || res[0] == null ? null : res[0].node))
    }
  }

  function scrollTo(options: ScrollViewScrollToOptions) {
    const current = getContext()
    if (current == null) return
    report('调用 scrollTo(' + JSON.stringify(options) + ')')
    current.scrollTo(options)
  }

  function scrollIntoItem(item: number) {
    const current = getContext()
    if (current == null) return
    const selector = '#item-' + item
    try {
      const target = scrollElement?.querySelector(selector)
      targetInfo.value = target == null ? selector + '：未找到' :
        'id=' + target.getAttribute('id') + '，nodeId=' + target.getNodeId()
      report('调用 scrollIntoView("' + selector + '")；' + targetInfo.value)
      current.scrollIntoView(selector)
    } catch (error) {
      report('scrollIntoView 异常：' + String(error))
    }
  }

  function scrollIntoVisible(alignment: string) {
    const current = getContext()
    const element = scrollElement
    if (current == null || element == null) return
    const viewport = element.getBoundingClientRect()
    for (const item of items) {
      const target = element.querySelector('#item-' + item)
      if (target == null) continue
      const rect = target.getBoundingClientRect()
      if (rect.bottom <= viewport.top || rect.top >= viewport.bottom) continue
      current.scrollIntoView('#item-' + item, { alignment: alignment as any, offset: alignment == 'start' ? 12 : 0, animated: true })
      targetInfo.value = '第 ' + item + ' 项 · ' + alignment + (alignment == 'start' ? ' · offset 12' : '')
      report('定位第 ' + item + ' 项：' + alignment)
      return
    }
    targetInfo.value = '当前视口没有已渲染的可定位条目'
  }

  // 不返回长期 pending 的 Promise，自动化端轮询结果，避免桥接调用超时。
  function startAcceptance() {
    const current = getContext()
    const element = scrollElement
    if (current == null || element == null) return
    acceptanceRunning.value = true
    acceptanceChecks.value = []
    acceptanceSummary.value = '运行中'
    const previousAnimation = animated.value
    runAcceptance({
      container: container.value, context: current, element,
      alive: () => alive,
      events: () => [refreshCount.value, restoreCount.value],
      position: () => [left.value, top.value],
      animation: async (enabled: boolean) => {
        animated.value = enabled
        await state.flush()
        await delay(60)
      },
      record: (result: AcceptanceCheck) => {
        acceptanceChecks.value.push(result)
        const failed = acceptanceChecks.value.filter((check) => !check.passed).length
        acceptanceSummary.value = '运行中 ' + acceptanceChecks.value.length + ' 项，失败 ' + failed
      }
    }).catch((error) => {
      if (alive) acceptanceChecks.value.push({ id: 'suite', passed: false, expected: '完成验收', actual: String(error) })
    }).finally(() => {
      if (!alive) return
      animated.value = previousAnimation
      const failed = acceptanceChecks.value.filter((check) => !check.passed).length
      acceptanceSummary.value = (failed == 0 ? 'PASS ' : 'FAIL ') + (acceptanceChecks.value.length - failed) + '/' + acceptanceChecks.value.length
      bounces.value = current.bounces
      scrollbar.value = current.showScrollbar
      scrollEnabled.value = current.scrollEnabled
      pagingEnabled.value = current.pagingEnabled
      acceptanceRunning.value = false
      activePanel.value = 'results'
    })
  }

  function acceptanceSnapshot(full: boolean = true): string {
    return JSON.stringify({ ready: contextReady.value, running: acceptanceRunning.value,
      container: container.value, summary: acceptanceSummary.value, count: acceptanceChecks.value.length,
      unsupportedProperties,
      gestureReady: extendedReady.value,
      checks: full ? acceptanceChecks.value : [], viewport: scrollElement?.getBoundingClientRect(),
      controls: uni.getElementById('demo-controls')?.getBoundingClientRect(),
      controlsTop: uni.getElementById('demo-controls')?.scrollTop,
      controlsScrollHeight: uni.getElementById('demo-controls')?.scrollHeight,
      refresher: uni.getElementById('refresher-content')?.getBoundingClientRect(),
      left: scrollElement?.scrollLeft, top: scrollElement?.scrollTop, refresh: refreshCount.value, restore: restoreCount.value,
      twoLevel: scrollElement == null ? false : (scrollElement as any).nativeElement.getAnyAttribute('refresher-two-level-triggered') == true })!
  }

  function prepareGesture(options: GestureOptions) {
    const current = getContext()
    if (current == null) return
    if (typeof current.scrollEnabled != 'boolean' || typeof current.pagingEnabled != 'boolean' || typeof current.closeRefresh != 'function' || typeof current.closeTwoLevel != 'function') {
      throw new Error('当前基座缺少手势验收所需的 scrollEnabled/pagingEnabled/刷新接口')
    }
    current.closeRefresh()
    current.closeTwoLevel({ duration: 0 })
    scrollElement?.setAnyAttribute('refresher-two-level-enabled', options.twoLevelEnabled)
    current.scrollEnabled = options.enabled
    current.pagingEnabled = options.paging
    current.bounces = options.bounce
    current.scrollTo({ top: options.offset, left: 0, animated: false })
    scrollEnabled.value = current.scrollEnabled
    pagingEnabled.value = current.pagingEnabled
  }

  function finishGestureRefresh() { getContext()?.closeRefresh() }

  function setControlsMaxHeightForTest(maxHeight: string) { controlsMaxHeight.value = maxHeight }

  function changeBounces(event: UniSwitchChangeEvent) {
    const current = getContext()
    if (current == null) return
    current.bounces = event.detail.value
    bounces.value = current.bounces
    report('写入并读回 bounces=' + current.bounces)
  }

  function changeScrollbar(event: UniSwitchChangeEvent) {
    const current = getContext()
    if (current == null) return
    current.showScrollbar = event.detail.value
    scrollbar.value = current.showScrollbar
    report('写入并读回 showScrollbar=' + current.showScrollbar)
  }

  function changeAnimation(event: UniSwitchChangeEvent) {
    if (busy.value) return
    animated.value = event.detail.value
    report('组件默认动画=' + animated.value)
  }

  function changeScrollEnabled(event: UniSwitchChangeEvent) {
    if (context == null || busy.value) return
    if (typeof context.scrollEnabled != 'boolean') { report('当前基座缺少 scrollEnabled'); return }
    context.scrollEnabled = event.detail.value
    scrollEnabled.value = context.scrollEnabled
    report('写入并读回 scrollEnabled=' + context.scrollEnabled)
  }

  function changePagingEnabled(event: UniSwitchChangeEvent) {
    if (context == null || busy.value) return
    if (typeof context.pagingEnabled != 'boolean') { report('当前基座缺少 pagingEnabled'); return }
    context.pagingEnabled = event.detail.value
    pagingEnabled.value = context.pagingEnabled
    report('写入并读回 pagingEnabled=' + context.pagingEnabled)
  }

  function onRefresh() { refreshCount.value++ }
  function onRestore() { restoreCount.value++ }
  function triggerRefresh() {
    const current = getContext()
    if (current == null) return
    current.triggerRefresh?.({ duration: 300, easingFunction: 'ease-out' })
    report('已调用 triggerRefresh；观察刷新计数和面板')
  }
  function closeRefresh() {
    const current = getContext()
    if (current == null) return
    current.closeRefresh?.()
    report('已调用 closeRefresh；观察复位计数')
  }
  function triggerTwoLevel() {
    const current = getContext()
    if (current == null) return
    current.triggerTwoLevel?.({ duration: 500, easingFunction: 'ease-in-out' })
    report('已调用 triggerTwoLevel；观察绿色面板')
  }
  function closeTwoLevel() {
    const current = getContext()
    if (current == null) return
    current.closeTwoLevel?.({ duration: 500, easingFunction: 'ease-in-out' })
    report('已调用 closeTwoLevel；观察内容恢复')
  }

  async function checkContext() {
    const current = getContext()
    const element = scrollElement
    if (current == null || element == null || checkingContext.value) return
    if (!extendedReady.value) {
      contextResult.value = 'Context: FAIL 当前基座缺少刷新/二级接口'
      return
    }
    checkingContext.value = true
    contextResult.value = 'Context: running'
    const previousScrollEnabled = current.scrollEnabled
    const previousPagingEnabled = current.pagingEnabled
    const previousLeft = element.scrollLeft
    const previousTop = element.scrollTop
    let checks = 0
    function nativeFlag(key: string): boolean {
      return (element as any).nativeElement.getAnyAttribute(key) == true
    }
    function check(ok: boolean, label: string) {
      if (!ok) throw new Error(label)
      checks++
    }
    try {
      current.scrollEnabled = true
      current.pagingEnabled = false
      check(current.scrollEnabled && !current.pagingEnabled, 'baseline')
      current.scrollEnabled = false
      current.pagingEnabled = true
      check(!current.scrollEnabled && current.pagingEnabled, 'write/read')
      current.scrollTo({ top: 80, left: 0, animated: false })
      await settleScroll()
      if (!alive) return
      check(Math.abs(element.scrollTop - 80) < 2, 'disabled programmatic scroll')
      current.scrollEnabled = true
      current.pagingEnabled = false
      current.scrollTo({ top: 0, left: 0, animated: false })
      await settleScroll()
      if (!alive) return
      const initialRefresh = refreshCount.value
      const initialRestore = restoreCount.value
      current.triggerRefresh({ duration: 0, easingFunction: 'linear' })
      await settleScroll()
      if (!alive) return
      check(nativeFlag('refresher-triggered'), 'refresh state')
      check(refreshCount.value == initialRefresh + 1, 'refresh event')
      current.triggerRefresh({ duration: 0 })
      await settleScroll()
      if (!alive) return
      check(refreshCount.value == initialRefresh + 1, 'repeat refresh')
      current.closeRefresh()
      await settleScroll()
      if (!alive) return
      check(!nativeFlag('refresher-triggered') && restoreCount.value == initialRestore + 1, 'close refresh')
      current.triggerTwoLevel({ duration: 0 })
      await settleScroll()
      if (!alive) return
      check(nativeFlag('refresher-two-level-triggered'), 'two level state')
      check(!nativeFlag('refresher-triggered') && refreshCount.value == initialRefresh + 1, 'two level is separate')
      current.triggerTwoLevel({ duration: 0 })
      current.closeTwoLevel({ duration: 0 })
      await settleScroll()
      if (!alive) return
      check(!nativeFlag('refresher-two-level-triggered'), 'close two level')
      current.triggerRefresh({ duration: 200 })
      current.closeRefresh()
      await settleScroll()
      if (!alive) return
      check(!nativeFlag('refresher-triggered') && refreshCount.value == initialRefresh + 1, 'cancel refresh animation')
      current.triggerTwoLevel({ duration: 200 })
      current.closeTwoLevel({ duration: 0 })
      await settleScroll()
      if (!alive) return
      check(!nativeFlag('refresher-two-level-triggered') && Math.abs(element.scrollTop) < 2, 'cancel two level animation')
      for (const style of ['black', 'white']) {
        element.setAnyAttribute('refresher-default-style', style)
        const before = refreshCount.value
        current.triggerRefresh({ duration: 120, easingFunction: 'ease-in' })
        await settleScroll()
        if (!alive) return
        check(nativeFlag('refresher-triggered') && refreshCount.value == before + 1, style + ' refresh')
        current.closeRefresh()
        await settleScroll()
        if (!alive) return
        check(!nativeFlag('refresher-triggered'), style + ' close')
      }
      contextResult.value = 'Context: PASS ' + checks + '/16'
    } catch (error) {
      contextResult.value = 'Context: FAIL ' + checks + '/16 ' + String(error)
    } finally {
      if (alive) {
        current.closeRefresh()
        current.closeTwoLevel({ duration: 0 })
        element.setAnyAttribute('refresher-default-style', 'none')
        current.scrollTo({ left: previousLeft, top: previousTop, animated: false })
        current.scrollEnabled = previousScrollEnabled
        current.pagingEnabled = previousPagingEnabled
        scrollEnabled.value = previousScrollEnabled
        pagingEnabled.value = previousPagingEnabled
        checkingContext.value = false
      }
    }
  }

  function settleScroll(): Promise<void> {
    return new Promise<void>((resolve) => setTimeout(resolve, 500))
  }

  async function checkEdges() {
    const current = getContext()
    const element = scrollElement
    if (current == null || element == null || checkingEdges.value) return
    checkingEdges.value = true
    edgeResult.value = 'Edge: running'
    const previousBounces = current.bounces
    const previousAnimation = animated.value
    let checks = 0
    try {
      current.bounces = false
      animated.value = false
      await state.flush()
      current.scrollTo({ left: 120, top: 360, animated: false })
      await settleScroll()
      if (!alive) return
      if (Math.abs(element.scrollTop - 360) > 1) {
        throw new Error('setup offset: ' + element.scrollTop)
      }
      current.scrollTo({ left: -100, top: -100, animated: false })
      await settleScroll()
      if (!alive) return
      if (Math.abs(element.scrollLeft) > 1 || Math.abs(element.scrollTop) > 1) {
        throw new Error('negative offset: ' + element.scrollLeft + ',' + element.scrollTop)
      }
      checks++

      current.scrollIntoView('#item-1')
      await settleScroll()
      if (!alive) return
      if (Math.abs(element.scrollLeft) > 1 || Math.abs(element.scrollTop) > 1) {
        throw new Error('repeat target: ' + element.scrollLeft + ',' + element.scrollTop)
      }
      checks++

      current.scrollTo({ left: 100000, top: 100000, animated: false })
      await settleScroll()
      if (!alive) return
      const endLeft = element.scrollLeft
      const endTop = element.scrollTop
      if (endLeft < 0 || endLeft >= 100000 || endTop <= 0 || endTop >= 100000 ||
        Math.abs(left.value - endLeft) > 1 || Math.abs(top.value - endTop) > 1) {
        throw new Error('overflow/event mismatch: ' + endLeft + ',' + endTop + '; event=' + left.value + ',' + top.value)
      }
      checks++

      current.scrollIntoView('#missing-scroll-target')
      await settleScroll()
      if (!alive) return
      if (Math.abs(element.scrollLeft - endLeft) > 1 || Math.abs(element.scrollTop - endTop) > 1) {
        throw new Error('missing target changed position')
      }
      checks++
      edgeResult.value = 'Edge: PASS ' + checks + '/4'
      report(edgeResult.value)
    } catch (error) {
      if (alive) {
        edgeResult.value = 'Edge: FAIL ' + checks + '/4 ' + String(error)
        report(edgeResult.value)
      }
    } finally {
      if (alive) {
        current.bounces = previousBounces
        animated.value = previousAnimation
        checkingEdges.value = false
      }
    }
  }

  function onScroll(event: UniScrollEvent) {
    // 只展示真实滚动事件，不把期望坐标写成执行结果。
    left.value = Math.round(event.detail.scrollLeft)
    top.value = Math.round(event.detail.scrollTop)
  }

  function flowHeight(item: number): string {
    return (120 + item % 3 * 30) + 'px'
  }


  function dispose() {
    alive = false
    context = null
    scrollElement = null
    contextReady.value = false
  }

  return {
    selectPanel,
    focusedResult,
    checkFocused,
    focusedSnapshot,
    toggleScrollDirection,
    resetDemo,
    prepareRefreshGesture,
    acquireContext,
    scrollTo,
    scrollIntoItem,
    scrollIntoVisible,
    startAcceptance,
    acceptanceSnapshot,
    prepareGesture,
    finishGestureRefresh,
    setControlsMaxHeightForTest,
    changeBounces,
    changeScrollbar,
    changeAnimation,
    changeScrollEnabled,
    changePagingEnabled,
    onRefresh,
    onRestore,
    triggerRefresh,
    closeRefresh,
    triggerTwoLevel,
    closeTwoLevel,
    checkContext,
    checkEdges,
    onScroll,
    flowHeight,
    dispose,
  }
}
