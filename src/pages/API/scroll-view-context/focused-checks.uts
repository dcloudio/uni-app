import { delay, queryContext, until } from './acceptance.uts'

export type FocusedCheckHost = {
  context: ScrollViewContext
  element: UniElement
  refreshCount: () => number
  restoreCount: () => number
}

// 单项检查只改动该项需要的状态，并在结束时恢复上下文，便于继续人工操作。
export async function runFocusedCheck(key: string, host: FocusedCheckHost): Promise<string> {
  const ctx = host.context
  const el = host.element
  const initialTop = el.scrollTop
  const initialLeft = el.scrollLeft
  const initialProperties = [ctx.bounces, ctx.showScrollbar, ctx.scrollEnabled, ctx.pagingEnabled]
  const near = (value: number, target: number): boolean => Math.abs(value - target) <= 2
  const flag = (name: string): boolean => (el as any).nativeElement.getAnyAttribute(name) == true
  const requireState = (ok: boolean, detail: string) => { if (!ok) throw new Error(detail) }
  try {
    if (key == 'node.exec' || key == 'node.callback') {
      const selected = await queryContext(key == 'node.callback')
      requireState(['scrollTo', 'scrollIntoView', 'triggerRefresh', 'closeRefresh', 'triggerTwoLevel', 'closeTwoLevel']
        .every((name) => typeof (selected as any)[name] == 'function'), '上下文方法缺失')
      return '已获取 ScrollViewContext，六个方法可调用'
    }
    if (['bounces', 'showScrollbar', 'scrollEnabled', 'pagingEnabled'].includes(key)) {
      const original = (ctx as any)[key] as boolean
      requireState(typeof original == 'boolean', key + ' 不是布尔属性')
      const next = !original
      ;(ctx as any)[key] = next
      const immediate = (ctx as any)[key]
      const execValue = (await queryContext(false) as any)[key]
      const callbackValue = (await queryContext(true) as any)[key]
      requireState(immediate == next && execValue == next && callbackValue == next,
        '写入 ' + next + '，读回 ' + [immediate, execValue, callbackValue].join('/'))
      return '写入 ' + next + '，直接读取 / 两种 node() 均一致'
    }
    if (key == 'scrollTo') {
      ctx.scrollTo({ top: 300, animated: false })
      await until(() => near(el.scrollTop, 300))
      return '原生 top=' + el.scrollTop
    }
    if (key == 'scrollIntoView') {
      ctx.scrollTo({ top: 50, left: 0, animated: false })
      await until(() => near(el.scrollTop, 50))
      requireState(el.querySelector('#item-1') != null, '#item-1 未渲染')
      ctx.scrollIntoView('#item-1', { animated: false })
      await until(() => near(el.scrollTop, 0))
      return '#item-1 已定位，原生 top=' + el.scrollTop
    }
    if (key == 'triggerRefresh' || key == 'closeRefresh') {
      ctx.closeRefresh()
      await delay(120)
      const beforeRefresh = host.refreshCount()
      const beforeRestore = host.restoreCount()
      ctx.triggerRefresh({ duration: 0 })
      await until(() => flag('refresher-triggered') && host.refreshCount() == beforeRefresh + 1)
      if (key == 'triggerRefresh') return '刷新状态已打开，refresh 事件 +1'
      ctx.closeRefresh()
      await until(() => !flag('refresher-triggered') && host.restoreCount() == beforeRestore + 1)
      return '刷新状态已关闭，restore 事件 +1'
    }
    if (key == 'triggerTwoLevel' || key == 'closeTwoLevel') {
      ctx.closeTwoLevel({ duration: 0 })
      await delay(120)
      ctx.triggerTwoLevel({ duration: 0 })
      await until(() => flag('refresher-two-level-triggered'))
      if (key == 'triggerTwoLevel') return '二级面板已打开'
      ctx.closeTwoLevel({ duration: 0 })
      await until(() => !flag('refresher-two-level-triggered'))
      return '二级面板已关闭'
    }
    throw new Error('未知检查项：' + key)
  } finally {
    try {
      const refreshWasTriggered = flag('refresher-triggered')
      const restoreBeforeCleanup = host.restoreCount()
      ctx.closeRefresh()
      ctx.closeTwoLevel({ duration: 0 })
      await until(() => !flag('refresher-triggered') && !flag('refresher-two-level-triggered') &&
        (!refreshWasTriggered || host.restoreCount() > restoreBeforeCleanup))
    } finally {
      ctx.bounces = initialProperties[0]
      ctx.showScrollbar = initialProperties[1]
      ctx.scrollEnabled = initialProperties[2]
      ctx.pagingEnabled = initialProperties[3]
      ctx.scrollTo({ top: initialTop, left: initialLeft, animated: false })
    }
  }
}
