<template>
      <page-head :title="title"></page-head>
      <!-- #ifdef APP-IOS -->
      <view style="padding-left: 20px; padding-right: 20px;">
      		<text style="color: #353535; font-size: 15px;">
      			iOS 调试首先需要添加对应 audio、video、image 存储到文件系统中，步骤如下：\n
      			1. 从系统相册或者语音备忘录中选择具体的video、image、audio；\n
      			2. 点击 ‘分享’ 按钮；\n
      			3. 下滑点击 ’存储到”文件“‘按钮；\n
      		</text>
      </view>
      <!-- #endif -->
      <button size="mini" @click="log=''">清空日志</button>
      <text style="margin: 2px; padding: 2px; border: 1px solid #000000;">{{ log }}</text>

      <button class="btnstyle" type="primary" @tap="chooseVideo">选择文件(video) 单选</button>
      <button class="btnstyle" type="primary" @tap="chooseVideoMul">选择文件(video) 多选</button>
      <button class="btnstyle" type="primary" @tap="playVideo">选择文件(video)并播放</button>
      <video class="video" :src="src" :controls="true" :autoplay="true" :loop="true">111</video>
      <button class="btnstyle" type="primary" @tap="chooseImage">选择文件(image) 单选</button>
      <button class="btnstyle" type="primary" @tap="chooseImageMul">选择文件(image) 多选</button>
      <button class="btnstyle" type="primary" @tap="viewImg">选择文件(image) 并预览</button>
      <button class="btnstyle" type="primary" @tap="chooseAudio">选择文件(audio) 单选</button>
      <button class="btnstyle" type="primary" @tap="chooseAudioMul">选择文件(audio) 多选</button>
      <button class="btnstyle" type="primary" @tap="playAudio">选择文件(audio) 并播放</button>
      <button class="btnstyle" type="primary" @tap='chooseAll'>选择文件(all) 单选</button>
      <button class="btnstyle" type="primary" @tap='chooseAllMul'>选择文件(all) 多选</button>
       <!-- #ifdef WEB || MP -->
       <button class="btnstyle" type="primary" @tap="chooseFileWithExtension">选择文件（extension: png）</button>
       <!-- #endif -->
       <!-- #ifdef APP -->
       <text class="section-title">extension 参数测试</text>
       <button class="btnstyle" type="primary" @tap="chooseWithoutExtension">省略 extension</button>
       <button class="btnstyle" type="primary" @tap="choosePngWithExtension">单后缀：['png']，type=all</button>
       <button class="btnstyle" type="primary" @tap="chooseDocumentsWithExtension">多后缀：['.PDF', 'txt', '.zip']</button>
       <button class="btnstyle" type="primary" @tap="chooseNormalizedExtension">格式归一化：空格、大小写、重复项</button>
       <button class="btnstyle" type="primary" @tap="chooseCustomExtension">自定义后缀：['.utsdemo']</button>
       <button class="btnstyle" type="primary" @tap="chooseWithEmptyExtensions">空数组：[]</button>
       <button class="btnstyle" type="primary" @tap="chooseWithNullExtension">空值：null</button>
       <button class="btnstyle" type="primary" @tap="chooseWithEmptyExtensionItem">非法项：['pdf', '']</button>
       <button class="btnstyle" type="primary" @tap="chooseWithMimeExtension">非法 MIME：['application/pdf']</button>
       <button class="btnstyle" type="primary" @tap="chooseWithWildcardExtension">非法通配符：['*']</button>
       <button class="btnstyle" type="primary" @tap="chooseImageIgnoringExtension">组合测试：type=image，extension=['pdf']</button>
       <!-- #endif -->
      <!-- #ifdef APP-HARMONY || WEB || MP -->
      <button class="btnstyle" type="primary" @tap="chooseFileWithSourceType">选择文件（sourceType: album）</button>
      <!-- #endif -->
      <!-- #ifdef WEB || MP -->
      <button class="btnstyle" type="primary" @tap="chooseFileWithSizeType">选择文件（sizeType: original）</button>
      <!-- #endif -->

      <view style="height: 4px;"></view>
</template>

<script setup lang="ts">
  const log = ref('')
  const title = ref('choose-file')
  const src = ref('')
  const _audioContext = ref(null as InnerAudioContext | null)

  onUnmounted(() => {
    if (_audioContext.value != null) {
      _audioContext.value!.destroy()
    }
  })

  const getPath = (chooseFils: ChooseFileTempFile[]): string => {
    var urls = new Array<string>()
    chooseFils.forEach(value => {
      urls.push(value.path)
    })
    return urls.join(', ')
  }

  const chooseVideo = () => {
    uni.chooseFile({
      type: 'video',
      count: 1,
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          log.value += getPath(res.tempFiles) + '\n\n'
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const chooseVideoMul = () => {
    uni.chooseFile({
      type: 'video',
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          log.value += getPath(res.tempFiles) + '\n\n'
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const playVideo = () => {
    uni.chooseFile({
      type: 'video',
      count: 1,
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          src.value = res.tempFiles[0].path
          _audioContext.value?.destroy()
          _audioContext.value = null
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const chooseImage = () => {
    uni.chooseFile({
      type: 'image',
      count: 1,
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          log.value += getPath(res.tempFiles) + '\n\n'
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const chooseImageMul = () => {
    uni.chooseFile({
      type: 'image',
      count: 90,
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          log.value += getPath(res.tempFiles) + '\n\n'
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const viewImg = () => {
    uni.chooseFile({
      type: 'image',
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          const tempFiles: Array<string> = res.tempFiles.map((value) => {
          	return value.path
          })
          uni.previewImage({
            current: 0,
            urls: tempFiles,
            success: (res) => {
              console.log(res)
            },
            fail: (err) => {
              console.log(err)
            }
          })
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const chooseAudio = () => {
    uni.chooseFile({
      type: 'audio',
      count: 1,
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          log.value += getPath(res.tempFiles) + '\n\n'
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const chooseAudioMul = () => {
    uni.chooseFile({
      type: 'audio',
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          log.value += getPath(res.tempFiles) + '\n\n'
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const playAudio = () => {
    uni.chooseFile({
      type: 'audio',
      count: 1,
      success: (res) => {
        console.log(res);
        if (res.tempFiles.length > 0) {
          if (_audioContext.value == null) {
          src.value = ''
            _audioContext.value = uni.createInnerAudioContext()
            _audioContext.value!.autoplay = true
          } else if (!_audioContext.value!.paused) {
            _audioContext.value!.stop()
          }
          _audioContext.value!.src = res.tempFiles[0].path
        }
      },
      complete: (res) => {
        console.log(res);
      }
    });
  }

  const chooseAll = () => {
    uni.chooseFile({
      type: 'all',
      count: 1,
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          log.value += getPath(res.tempFiles) + '\n\n'
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  const chooseAllMul = () => {
    uni.chooseFile({
      type: 'all',
      success: (res) => {
        console.log(res)
        if (res.tempFiles.length > 0) {
          log.value += getPath(res.tempFiles) + '\n\n'
        }
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }

  // #ifdef WEB || MP
  const chooseFileWithExtension = () => {
    uni.chooseFile({
      type: 'all',
      extension: ['png'],
      success: (res) => {
        console.log(res)
        log.value += getPath(res.tempFiles) + '\n\n'
      },
      fail: (err) => {
        log.value += 'fail: ' + err.errCode + ' ' + err.errMsg + '\n\n'
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }
  // #endif

  // #ifdef APP
  const chooseWithoutExtension = () => {
    log.value += '【省略 extension】\n'
    uni.chooseFile({
      count: 5,
      success: (res) => {
        log.value += 'success: ' + res.tempFiles.length + ' 个文件\n'
        res.tempFiles.forEach((file) => {
          log.value += file.name + ' | ' + file.type + ' | ' + file.path + '\n'
        })
      },
      fail: (err) => {
        log.value += 'fail: ' + err.errCode + ' ' + err.errMsg + '\n'
      },
      complete: (res) => {
        console.log('extension complete', res)
        log.value += 'complete\n\n'
      }
    })
  }

  const chooseByExtensions = (testName: string, extensions: string[] | null) => {
    log.value += '【' + testName + '】\n'
    log.value += 'extension: ' + JSON.stringify(extensions) + '\n'
    uni.chooseFile({
      count: 5,
      extension: extensions,
      success: (res) => {
        log.value += 'success: ' + res.tempFiles.length + ' 个文件\n'
        res.tempFiles.forEach((file) => {
          log.value += file.name + ' | ' + file.type + ' | ' + file.path + '\n'
        })
      },
      fail: (err) => {
        log.value += 'fail: ' + err.errCode + ' ' + err.errMsg + '\n'
      },
      complete: (res) => {
        console.log('extension complete', res)
        log.value += 'complete\n\n'
      }
    })
  }

  const choosePngWithExtension = () => {
    log.value += '【单后缀，显式 type=all】\n'
    log.value += 'extension: ["png"]\n'
    uni.chooseFile({
      type: 'all',
      count: 1,
      extension: ['png'],
      success: (res) => {
        log.value += 'success: ' + res.tempFiles.length + ' 个文件\n'
        res.tempFiles.forEach((file) => {
          log.value += file.name + ' | ' + file.type + ' | ' + file.path + '\n'
        })
      },
      fail: (err) => {
        log.value += 'fail: ' + err.errCode + ' ' + err.errMsg + '\n'
      },
      complete: (res) => {
        console.log('extension complete', res)
        log.value += 'complete\n\n'
      }
    })
  }

  const chooseDocumentsWithExtension = () => {
    chooseByExtensions('多后缀，省略 type', ['.PDF', 'txt', '.zip'])
  }

  const chooseNormalizedExtension = () => {
    chooseByExtensions('空格、大小写和重复项', [' .PDF ', 'pdf', '.Pdf'])
  }

  const chooseCustomExtension = () => {
    chooseByExtensions('自定义后缀', ['.utsdemo'])
  }

  const chooseWithEmptyExtensions = () => {
    chooseByExtensions('空数组', [])
  }

  const chooseWithNullExtension = () => {
    chooseByExtensions('空值', null)
  }

  const chooseWithEmptyExtensionItem = () => {
    chooseByExtensions('包含空字符串', ['pdf', ''])
  }

  const chooseWithMimeExtension = () => {
    chooseByExtensions('MIME 类型', ['application/pdf'])
  }

  const chooseWithWildcardExtension = () => {
    chooseByExtensions('通配符', ['*'])
  }

  const chooseImageIgnoringExtension = () => {
    log.value += '【type 与 extension 组合】\n'
    log.value += 'type: image, extension: ["pdf"]\n'
    uni.chooseFile({
      type: 'image',
      count: 1,
      extension: ['pdf'],
      success: (res) => {
        log.value += 'success: ' + res.tempFiles.length + ' 个文件\n'
        res.tempFiles.forEach((file) => {
          log.value += file.name + ' | ' + file.type + ' | ' + file.path + '\n'
        })
      },
      fail: (err) => {
        log.value += 'fail: ' + err.errCode + ' ' + err.errMsg + '\n'
      },
      complete: (res) => {
        console.log(res)
        log.value += 'complete\n\n'
      }
    })
  }
  // #endif

  // #ifdef APP-HARMONY || WEB || MP
  const chooseFileWithSourceType = () => {
    uni.chooseFile({
      type: 'all',
      sourceType: ['album'],
      success: (res) => {
        console.log(res)
        log.value += getPath(res.tempFiles) + '\n\n'
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }
  // #endif

  // #ifdef WEB || MP
  const chooseFileWithSizeType = () => {
    uni.chooseFile({
      type: 'image',
      sizeType: ['original'],
      success: (res) => {
        console.log(res)
        log.value += getPath(res.tempFiles) + '\n\n'
      },
      complete: (res) => {
        console.log(res)
      }
    })
  }
  // #endif
</script>

<style>
  .btnstyle {
    margin: 4px;
  }

  .section-title {
    margin: 12px 8px 4px;
    font-size: 16px;
    font-weight: bold;
  }

  .video {
    width: 100%;
    height: 225px;
  }

  .uni-uploader__input-box {
    margin: 5px;
    width: 104px;
    height: 104px;
    border: 1px solid #D9D9D9;
  }
</style>
