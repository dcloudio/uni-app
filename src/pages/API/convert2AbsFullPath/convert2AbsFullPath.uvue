<template>
  <view class="page">
    <text class="title">convert2AbsFullPath 演示</text>
    <text class="desc">将项目相对路径转换为运行期绝对路径</text>

    <view class="field">
      <text class="label">输入路径</text>
      <input class="input" v-model="inputPath" type="text" placeholder="例如：/static/logo.png" />
    </view>

    <button class="btn" type="primary" @click="onConvert">转换</button>

    <view class="result">
      <text class="label">输入</text>
      <text class="value" :selectable="true">{{ inputResult }}</text>
    </view>

    <view class="result">
      <text class="label">输出</text>
      <text class="value" :selectable="true">{{ outputResult }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  const inputPath = ref<string>('/static/logo.png')
  const inputResult = ref<string>('')
  const outputResult = ref<string>('')

  const convertPath = (path: string): string => uni.convert2AbsFullPath(path)

  const onConvert = () => {
    inputResult.value = inputPath.value
    outputResult.value = convertPath(inputPath.value)
  }

  onReady(() => {
    onConvert()
  })

  defineExpose({
    convertPath
  })
</script>

