  .title {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 5px;
  }

  .desc {
    font-size: 13px;
    color: #888888;
    margin-bottom: 15px;
  }

  .field {
    display: flex;
    flex-direction: column;
    margin-bottom: 15px;
  }

  .label {
    font-size: 13px;
    color: #666666;
    margin-bottom: 5px;
  }

  .input {
    height: 40px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-style: solid;
    border-color: #DDDDDD;
    border-radius: 6px;
    font-size: 14px;
  }

  .btn {
    margin-bottom: 15px;
  }

  .result {
    display: flex;
    flex-direction: column;
    margin-bottom: 15px;
  }

  .value {
    font-size: 14px;
    line-height: 20px;
    padding: 10px;
    background-color: #F5F5F5;
    border-radius: 6px;
  }
</style>
