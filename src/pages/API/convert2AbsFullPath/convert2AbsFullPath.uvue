<template>
    <text class="fs-18 fw-bold mb-5">convert2AbsFullPath 演示</text>
    <text class="fs-13 color-888 mb-15">将项目相对路径转换为运行期绝对路径</text>

    <view class="d-flex flex-dir-column mb-15">
      <text class="fs-13 color-666 mb-5">输入路径</text>
      <input class="h-40 pl-10 pr-10 border-width-1 border-style-solid radius-6 fs-14 input" v-model="inputPath" type="text" placeholder="例如：/static/logo.png" />
    </view>

    <button class="mb-15" type="primary" @click="onConvert">转换</button>

    <view class="d-flex flex-dir-column mb-15">
      <text class="fs-13 color-666 mb-5">输入</text>
      <text class="fs-14 lh-20 u-p-10 bg-f5f5f5 radius-6" :selectable="true">{{ inputResult }}</text>
    </view>

    <view class="d-flex flex-dir-column mb-15">
      <text class="fs-13 color-666 mb-5">输出</text>
      <text class="fs-14 lh-20 u-p-10 bg-f5f5f5 radius-6" :selectable="true">{{ outputResult }}</text>
    </view>
</template>

<script setup lang="ts">
  const inputPath = ref<string>('/static/logo.png')
  const inputResult = ref<string>('')
  const outputResult = ref<string>('')

  const convertPath = (path: string): string => uni.convert2AbsFullPath(path)

  const onConvert = () => {
    inputResult.value = inputPath.value
    outputResult.value = convertPath(inputPath.value)
  }

  onReady(() => {
    onConvert()
  })

  defineExpose({
    convertPath
  })
</script>

<style>
  page {
    padding: 15px;
  }

  .input {
    border-color: #DDDDDD;
  }
</style>
