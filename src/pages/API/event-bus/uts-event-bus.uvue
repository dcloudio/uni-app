<template>
  <view>
    <button @click="JsOnUts">1. js监听uts消息</button>
    <button @click="emitFromUts">2. uts中触发监听</button>
    <button @click="emitUtsMessageUTSObject">2.1 uts中触发监听(UTSJSONObject)</button>
    <button @click="emitUtsMessages">2.2 uts中触发监听(多个参数)</button>
    <button @click="emitUtsMessageNoArgument">2.3 uts中触发监听(无参数)</button>
    <button @click="offUts">取消uts消息监听</button>

    <button @click="UtsOnJS">1. uts监听js消息</button>
    <button @click="emitFormJS">2 .js中触发监听</button>
    <button @click="emitFormJSObject">2.1 js中触发监听(UTSJSONObject)</button>
    <button @click="offJs">取消js消息监听</button>
    <button @click="clear">清空消息</button>

    <view class="box">
      <view>收到的消息：</view>
      <view>
        <view v-for="(item, index) in data.log" :key="index">{{ item }}</view>
      </view>
    </view>
  </view>
  <button @click="testAll">test all</button>
</template>

<script setup lang="ts">

  import {
    uts_onJsMessage,
    uts_offJsMessage,
    uts_emitUtsMessage,
    uts_emitUtsMessageUTSObject,
    uts_emitUtsMessageNoArgument,
    uts_emitUtsMessages,
    uts_getMessageChannel,
    uts_getRevJsMessage,
    uts_clearJsMessage,
    uts_onJsMessageOnce,
  } from "@/uni_modules/uts-eventbus"

  type DataType = {
    log: string[],
  }

  const data = reactive({
    log: [] as string[],
  } as DataType)

  function fn(res : any, res2 : any) {
    if (res != null){
      console.log("on rev: " + JSON.stringify(res))
      data.log.push(res)
    }
    if (res2 != null) {
      console.log("on rev: " + JSON.stringify(res2))
      data.log.push(res2)
    }
  }

  function fn2(res : string) {
    data.log.push(res)
  }

  function JsOnUts() {
    uni.$off(uts_getMessageChannel(), fn)
    uni.$on(uts_getMessageChannel(), fn)
  }

  function offUts() {
    uni.$off(uts_getMessageChannel(), fn)
  }

  function emitFromUts() {
    uts_emitUtsMessage("emit form uts")
  }

  function emitUtsMessageUTSObject() {
    uts_emitUtsMessageUTSObject({
        latitude: 39.951028,
        longitude: 116.354662,
        name: '金运大厦',
        address: '西直门北大街xx号'
      })
  }

  function emitUtsMessages() {
    uts_emitUtsMessages({
        latitude: 39.951028,
        longitude: 116.354662,
        name: '金运大厦',
        address: '西直门北大街xx号'
      }, "emit form uts")
  }

  function emitUtsMessageNoArgument() {
    uts_emitUtsMessageNoArgument()
  }

  function JsOnUtsOnce() {
    uni.$once(uts_getMessageChannel(), fn2)
  }

  function UtsOnJS() {
    uts_onJsMessage("JsMessage")
  }

  function UtsOnJSOnce() {
    uts_onJsMessageOnce("JsMessage")
  }

  function offJs() {
    uts_offJsMessage("JsMessage")
  }

  function emitFormJS() {
    uts_clearJsMessage()
    uni.$emit("JsMessage", "emit form js")
    let msg = uts_getRevJsMessage()
    console.log("message:"+msg)
    if (msg && msg.length){
      data.log.push(msg)
    }
  }

  function emitFormJSObject() {
    uts_clearJsMessage()
    uni.$emit("JsMessage", {
        latitude: 39.951028,
        longitude: 116.354662,
        name: '金运大厦form js',
        address: '西直门北大街xx号 from js'
      })
    let msg = uts_getRevJsMessage()
    console.log("message:"+msg)
    if (msg && msg.length){
      data.log.push(msg)
    }
  }

  function clear() {
    uts_clearJsMessage()
    data.log.length = 0
  }

  function testAll() {
  	JsOnUts();
  	emitFromUts();
  	UtsOnJS();
  	emitFormJS();
  }

  defineExpose({
    data,
    clear,
    JsOnUts,
    emitFromUts,
    emitUtsMessageUTSObject,
    emitUtsMessages,
    emitUtsMessageNoArgument,
    offUts,
    JsOnUtsOnce,
    UtsOnJS,
    UtsOnJSOnce,
    offJs,
    emitFormJS,
    emitFormJSObject,
    testAll
  })
</script>

<style>
  .box {
    padding: 10px;
  }
</style>
