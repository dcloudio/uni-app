          <text class="fs-12 color-999">设置值: {{data.backgroundColor}}</text>
          <text class="fs-12 color-999">获取值: {{data.backgroundColorActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-image" :style="{ backgroundColor: data.backgroundColor }" flatten src="/static/test-image/logo.png"></image>
