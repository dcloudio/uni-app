<template>
    <view class="flex-grow-1">
      <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">说明：左边是正常版本，右边是拍平版本</text>
      <view>
        <text>padding-left: 25px</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="padding-left: 25px;">
            <view class="inner-content"></view>
          </view>
          <view class="common" style="padding-left: 25px;" flatten>
            <view class="inner-content"></view>
          </view>
        </view>
      </view>

      <view>
        <text>padding-left: 10%</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="padding-left: 10%;">
            <view class="inner-content"></view>
          </view>
          <view class="common" style="padding-left: 10%;" flatten>
            <view class="inner-content"></view>
          </view>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">scroll-view 组件</text>
      </view>

      <view>
        <text class="color-888 fs-12 fw-bold u-mt-5">padding-left: 10% 和 padding-left: 30px</text>
        <view class="flex-dir-row justify-around mt-10">
          <scroll-view class="common" style="padding-left: 10%;">
            <view class="inner-content"></view>
          </scroll-view>
          <scroll-view class="common" style="padding-left: 30px;">
            <view class="inner-content"></view>
          </scroll-view>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">setProperty 设置与 getPropertyValue 获取</text>
      </view>

      <!-- 普通版本 -->
      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件</text>
          <text class="fs-12 color-999">设置值: {{data.paddingLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.paddingLeftActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ paddingLeft: data.paddingLeft }">
              <view style="flex-grow: 1;background-color: cyan;"><text class="color-1a1a1a">view</text></view>
            </view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件</text>
          <text class="fs-12 color-999">设置值: {{data.paddingLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.paddingLeftActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ paddingLeft: data.paddingLeft }">text</text>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">image 组件</text>
          <text class="fs-12 color-999">设置值: {{data.paddingLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.paddingLeftActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-image" :style="{ paddingLeft: data.paddingLeft }" src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.paddingLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.paddingLeftActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ paddingLeft: data.paddingLeft }" flatten>
              <view style="flex-grow: 1;background-color: cyan;"><text class="color-1a1a1a">view</text></view>
            </view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.paddingLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.paddingLeftActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ paddingLeft: data.paddingLeft }" flatten>text</text>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">image 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.paddingLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.paddingLeftActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-image" :style="{ paddingLeft: data.paddingLeft }" flatten src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="mt-15 mb-15">
        <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">第一个枚举值，'' (空字符串) - 空值情况</text>
        <enum-data-checkbox :items="paddingLeftEnum" title="padding-left 枚举值" @change="radioChangePaddingLeft" :compact="true"></enum-data-checkbox>
        <input-data :defaultValue="data.paddingLeft" title="padding-left 自定义值" type="text" @confirm="inputChangePaddingLeft"></input-data>
      </view>

    </view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types'

  const data = reactive({
    paddingLeft: '25px',
    paddingLeftActual: '',
    paddingLeftActualText: '',
    paddingLeftActualImage: '',
    paddingLeftActualFlat: '',
    paddingLeftActualTextFlat: '',
    paddingLeftActualImageFlat: ''
  })
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const paddingLeftEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '20px' },
    { value: 4, name: '0%' },
    { value: 5, name: '10%' }
  ]

  const getPropertyValues = () => {
    data.paddingLeftActual = viewRef.value?.style.getPropertyValue('padding-left') ?? ''
    data.paddingLeftActualFlat = viewRefFlat.value?.style.getPropertyValue('padding-left') ?? ''
    data.paddingLeftActualText = textRef.value?.style.getPropertyValue('padding-left') ?? ''
    data.paddingLeftActualTextFlat = textRefFlat.value?.style.getPropertyValue('padding-left') ?? ''
    data.paddingLeftActualImage = imageRef.value?.style.getPropertyValue('padding-left') ?? ''
    data.paddingLeftActualImageFlat = imageRefFlat.value?.style.getPropertyValue('padding-left') ?? ''
  }


  const changePaddingLeft = (value: string) => {
    data.paddingLeft = value
    viewRef.value?.style.setProperty('padding-left', value)
    viewRefFlat.value?.style.setProperty('padding-left', value)
    textRef.value?.style.setProperty('padding-left', value)
    textRefFlat.value?.style.setProperty('padding-left', value)
    imageRef.value?.style.setProperty('padding-left', value)
    imageRefFlat.value?.style.setProperty('padding-left', value)
    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      getPropertyValues()
    })
  }

  const radioChangePaddingLeft = (index: number) => {
    const selectedItem = paddingLeftEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changePaddingLeft(selectedItem.name)
    }
  }

  const inputChangePaddingLeft = (value: string) => {
    changePaddingLeft(value)
  }

  onReady(() => {
    getPropertyValues()
  })

  defineExpose({
    radioChangePaddingLeft,
    data
  })
</script>

<style>
  .common {
    flex:1;
    margin:0 10px;
    height: 100px;
    background-color: gray;
  }
  .inner-content {
    flex-grow: 1;
    background-color: cyan;
  }

  .common-dynamic {
    height: 80px;
    background-color: gray;
  }

  .common-image {
    width: 80px;
    height: 80px;
    background-color: gray;
  }

  .test-box {
    width: 100%;
    height: 80px;
    background-color: lightgray;
  }

</style>
