      <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">说明：左边是正常版本，右边是拍平版本</text>
      <view>
        <text>padding: 25px</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="padding: 25px;">
            <view class="inner-content"></view>
          </view>
          <view class="common" style="padding: 25px;" flatten>
            <view class="inner-content"></view>
          </view>
        </view>
      </view>

      <view>
        <text>padding: 5%</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="padding: 5%;">
            <view class="inner-content"></view>
          </view>
          <view class="common" style="padding: 5%;" flatten>
            <view class="inner-content"></view>
          </view>
        </view>
      </view>
      <view>
