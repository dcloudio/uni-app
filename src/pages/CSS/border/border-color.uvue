        </view>
      </view>

      <view>
        <text>border-bottom-color: blue</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="border-bottom-width: 5px; border-bottom-color: blue; border-bottom-style: solid; "></view>
          <view class="common" style="border-bottom-width: 5px; border-bottom-color: blue; border-bottom-style: solid; " flatten></view>
        </view>
      </view>

      <text class="fs-15 fw-bold color-text-333 mt-15">scroll-view 组件</text>

      <view class="flex-dir-row justify-around mt-10">
        <scroll-view class="common scroll-view-border" style="border-color: cyan;">
          <text class="common-text">border-color: cyan</text>
        </scroll-view>
        <scroll-view class="common scroll-view-border" style="border-color: #00FF00;">
          <text class="common-text">border-color: #00FF00</text>
        </scroll-view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">setProperty 设置与 getPropertyValue 获取</text>
      </view>

      <!-- 普通版本 -->
      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件</text>
          <text class="fs-12 color-999">设置值: {{data.borderColor}}</text>
          <text class="fs-12 color-999">获取值: {{data.borderColorActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ borderWidth: '5px', borderColor: data.borderColor, borderStyle: 'solid' }">
              <view style="flex-grow: 1;background-color: green;"><text>view</text></view>
            </view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件</text>
