        <text class="fs-12 color-999">设置值: {{data.borderWidth}}</text>
        <text class="fs-12 color-999">获取值: {{data.borderWidthActualText}}</text>
        <view class="test-box">
          <text ref="textRef" class="common-dynamic"
            :style="{ borderWidth: data.borderWidth, borderStyle: 'solid' }">text</text>
        </view>
      </view>

      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">image 组件</text>
        <text class="fs-12 color-999">设置值: {{data.borderWidth}}</text>
        <text class="fs-12 color-999">获取值: {{data.borderWidthActualImage}}</text>
        <view class="test-box">
          <image ref="imageRef" class="common-image" :style="{ borderWidth: data.borderWidth, borderStyle: 'solid' }"
            src="/static/test-image/logo.png"></image>
        </view>
      </view>
    </view>

    <!-- 拍平版本 -->
    <view class="flex-dir-row justify-between mt-10">
      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">view 组件拍平</text>
        <text class="fs-12 color-999">设置值: {{data.borderWidth}}</text>
        <text class="fs-12 color-999">获取值: {{data.borderWidthActualFlat}}</text>
        <view class="test-box">
          <view ref="viewRefFlat" class="common-dynamic" :style="{ borderWidth: data.borderWidth, borderStyle: 'solid' }"
            flatten>
            <view style="flex-grow: 1;background-color: cyan;"><text class="color-1a1a1a">view</text></view>
          </view>
        </view>
      </view>

      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">text 组件拍平</text>
        <text class="fs-12 color-999">设置值: {{data.borderWidth}}</text>
        <text class="fs-12 color-999">获取值: {{data.borderWidthActualTextFlat}}</text>
        <view class="test-box">
          <text ref="textRefFlat" class="common-dynamic" :style="{ borderWidth: data.borderWidth, borderStyle: 'solid' }"
            flatten>text</text>
        </view>
      </view>

