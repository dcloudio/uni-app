        <text class="fs-12 color-999">设置值: {{data.borderWidth}}</text>
        <text class="fs-12 color-999">获取值: {{data.borderWidthActual}}</text>
        <view class="test-box">
          <view ref="viewRef" class="common-dynamic" :style="{ borderWidth: data.borderWidth, borderStyle: 'solid' }">
            <view style="flex-grow: 1;background-color: cyan;"><text class="color-1a1a1a">view</text></view>
          </view>
        </view>
      </view>

      <view class="flex-1 m-0-5">
