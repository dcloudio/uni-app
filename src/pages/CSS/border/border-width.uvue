          /* 3. 变成正圆 */
          border-radius: 20px;
          transform: rotate(45deg) translateZ(0); /* 开启硬件加速 */"></view>
        <view flatten style="width: 40px; height: 40px;
          /* 1. 基础边框：厚度、样式、透明色 */
          border: 5px solid transparent;
          /* 2. 给其中三条边上色，形成 3/4 圆弧 */
