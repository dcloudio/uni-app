        <text class="color-888 fs-12 fw-bold u-mt-5">image 组件拍平</text>
        <text class="fs-12 color-999">设置值: {{data.borderWidth}}</text>
        <text class="fs-12 color-999">获取值: {{data.borderWidthActualImageFlat}}</text>
        <view class="test-box">
          <image ref="imageRefFlat" class="common-image" :style="{ borderWidth: data.borderWidth, borderStyle: 'solid' }"
            flatten src="/static/test-image/logo.png"></image>
