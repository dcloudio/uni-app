        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件</text>
          <text class="fs-12 color-999">设置值: {{data.borderRadius}}</text>
          <text class="fs-12 color-999">获取值: {{data.borderRadiusActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ borderRadius: data.borderRadius }">
              <view style="flex-grow: 1;background-color: bisque;"><text>view</text></view>
