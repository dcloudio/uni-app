<template>
  <scroll-view class="page" :scroll-top="scrollTop">
    <view class="content">
      <text class="title">仅组件包含媒体查询</text>
      <text class="description">页面没有 @media，只有下方组件使用。调整窗口宽度或重新添加组件，检查条件是否正确匹配。</text>
      <button size="mini" @click="setComponentVisible(!componentVisible)">
        {{ componentVisible ? '移除组件' : '添加组件' }}
      </button>
      <media-query-component v-if="componentVisible" id="media-query-component" />
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
  import MediaQueryComponent from './media-query-component.uvue'
  import { getMediaViewport } from './viewport.uts'

  const componentVisible = ref(true)

  function setComponentVisible(visible : boolean) {
    componentVisible.value = visible
  }

  const scrollTop = ref(0)

  // 自动化截图分段滚动，避免依赖各端不同的元素滚动接口。
  function setScrollTop(value : number) {
    scrollTop.value = value
  }

  defineExpose({ setScrollTop, setComponentVisible, getMediaViewport })
</script>

<style>
  .page { flex: 1; background-color: #f5f6f8; }
  .content { padding: 16px; }
  .title { font-size: 22px; font-weight: bold; color: #111827; margin-bottom: 12px; }
  .description { font-size: 14px; color: #475569; margin-bottom: 12px; }
</style>
