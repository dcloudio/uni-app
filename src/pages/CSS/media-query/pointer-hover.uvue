<template>
  <scroll-view class="page" :scroll-top="scrollTop">
    <view class="content">
      <text class="title">指针与悬停</text>
      <view class="summary">
        <text class="description">连接或断开鼠标、触控板，观察条件变化。绿色表示满足，灰色表示不满足。</text>
        <text class="description">App 有触屏时，接入鼠标仍匹配 pointer: coarse、hover: none；可通过 any-pointer、any-hover 查询鼠标能力。</text>
        <text class="description">Web 和微信小程序的结果由浏览器或宿主决定，可能与 App 不同。</text>
      </view>
      <pointer-hover-component id="pointer-hover-component" />
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
  import PointerHoverComponent from './pointer-hover-component.uvue'

  const scrollTop = ref(0)

  // 自动化截图分段滚动，避免依赖各端不同的元素滚动接口。
  function setScrollTop(value : number) {
    scrollTop.value = value
  }

  defineExpose({ setScrollTop })
</script>

<style>
  .page { flex: 1; background-color: #f5f6f8; }
  .content { padding: 16px; }
  .title { font-size: 22px; font-weight: bold; color: #111827; margin-bottom: 12px; }
  .summary { padding: 12px; border-radius: 8px; background-color: #eff6ff; }
  .description { font-size: 14px; color: #475569; margin-bottom: 8px; }
</style>
