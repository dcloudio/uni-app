<template>
  <view class="single-root-box" :class="props.childClass">
    <text class="single-root-text">{{ props.text }}</text>
    <view :class="'box ' + props.boxClass"></view>
  </view>
</template>

<script setup lang="ts">

  // 禁用自动属性继承，手动控制属性绑定位置
  defineOptions({
    inheritAttrs: false,
    externalClasses: ['child-class', 'box-class']
    // TODO: Web 端 externalClasses 目前只补来源组件的作用域，缺少 App 作用域，
    // 导致内部元素无法匹配 App.uvue 中定义的外部 class。
    // 临时用 styleIsolation: 'app' 绕过此缺陷；它会允许 App 样式影响整个组件，
    // 并非 externalClasses 的使用要求。修复后应移除此配置，验证默认隔离下的行为。
    // #ifdef WEB
    ,styleIsolation: 'app'
    // #endif
  })

  // 定义组件属性接口
  type Props = {
    text ?: string,
    childClass ?: string.ClassString,
    boxClass ?: string.ClassString
  }

  // 使用 withDefaults 设置默认值
  const props = withDefaults(defineProps<Props>(), {
    text: '单根节点组件:绿色背景红色描边',
    childClass: '',
    boxClass: ''
  })
</script>

<style>
  .single-root-box {
    background-color: #FFF3E0;
    padding: 15px;
    border-radius: 8px;
    border: 2px solid #FF9800;
    margin: 5px;
  }

  .single-root-text {
    color: #E65100;
    font-size: 14px;
  }

  .box {
    width: 150px;
    height: 30px;
    background-color:  #d9d1ff;
    border: #9e4ef7 solid 2px;
  }
</style>
