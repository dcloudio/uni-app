<template>
    <view class="flex-grow-1">
      <view>
        <text>min-width: 250px</text>
        <view class="common" style="min-width: 250px;">
          <text class="color-1a1a1a">width: 50px</text>
        </view>
        <text>拍平</text>
        <view class="common" style="min-width: 250px;" flatten>
          <text class="color-1a1a1a">width: 50px</text>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">scroll-view 组件</text>
      </view>

      <view class="flex-dir-row justify-around mt-10">
        <scroll-view class="common" style="min-width: 100px; background-color: cyan;">
          <text class="fs-12 text-center color-1a1a1a">min-width: 100px</text>
        </scroll-view>
        <scroll-view class="common" style="min-width: 200px; background-color: cyan;">
          <text class="fs-12 text-center color-1a1a1a">min-width: 200px</text>
        </scroll-view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">setProperty 设置与 getPropertyValue 获取</text>
      </view>

      <!-- 普通版本 -->
      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件</text>
          <text class="fs-12 color-999">设置值: {{data.minWidth}}</text>
          <text class="fs-12 color-999">获取值: {{data.minWidthActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ minWidth: data.minWidth }">
              <text class="color-1a1a1a">view</text>
            </view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件</text>
          <text class="fs-12 color-999">设置值: {{data.minWidth}}</text>
          <text class="fs-12 color-999">获取值: {{data.minWidthActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ minWidth: data.minWidth }">text</text>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">image 组件</text>
          <text class="fs-12 color-999">设置值: {{data.minWidth}}</text>
          <text class="fs-12 color-999">获取值: {{data.minWidthActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-dynamic" :style="{ minWidth: data.minWidth }"
              src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.minWidth}}</text>
          <text class="fs-12 color-999">获取值: {{data.minWidthActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ minWidth: data.minWidth }"
              flatten>
              <text class="color-1a1a1a">view</text>
            </view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.minWidth}}</text>
          <text class="fs-12 color-999">获取值: {{data.minWidthActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ minWidth: data.minWidth }"
              flatten>text</text>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">image 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.minWidth}}</text>
          <text class="fs-12 color-999">获取值: {{data.minWidthActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-dynamic" :style="{ minWidth: data.minWidth }"
              flatten src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="mt-15 mb-15">
        <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">第一个枚举值，'' (空字符串) - 空值情况</text>
        <enum-data-checkbox :items="minWidthEnum" title="min-width 枚举值" @change="radioChangeMinWidth"
          :compact="true"></enum-data-checkbox>
        <input-data :defaultValue="data.minWidth" title="min-width 自定义值" type="text"
          @confirm="inputChangeMinWidth"></input-data>
      </view>

      <!-- #ifndef MP-ALIPAY -->
      <view class="mb-15">
        <text>native-view组件: min-width: 100px 和 min-width: 200px</text>
        <view class="demo-box-native flex-dir-row justify-around mt-10">
          <view class="container-native" style="background-color: green;">
            <native-view style="min-width: 100px; height: 100px;"></native-view>
          </view>
          <view class="container-native" style="background-color: red;">
            <native-view style="min-width: 200px; height: 100px;"></native-view>
          </view>
        </view>
      </view>
      <!-- #endif -->
    </view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types'

  const minWidthEnum : ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '80px' },
    { value: 4, name: '120px' },
    { value: 5, name: '80rpx' },
  ]

  const data = reactive({
    minWidth: '100px',
    minWidthActual: '',
    minWidthActualText: '',
    minWidthActualImage: '',
    minWidthActualFlat: '',
    minWidthActualTextFlat: '',
    minWidthActualImageFlat: ''
  })
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const getPropertyValues = () => {
    data.minWidthActual = viewRef.value?.style.getPropertyValue('min-width') ?? ''
    data.minWidthActualFlat = viewRefFlat.value?.style.getPropertyValue('min-width') ?? ''
    data.minWidthActualText = textRef.value?.style.getPropertyValue('min-width') ?? ''
    data.minWidthActualTextFlat = textRefFlat.value?.style.getPropertyValue('min-width') ?? ''
    data.minWidthActualImage = imageRef.value?.style.getPropertyValue('min-width') ?? ''
    data.minWidthActualImageFlat = imageRefFlat.value?.style.getPropertyValue('min-width') ?? ''
  }


  const changeMinWidth = (value : string) => {
    data.minWidth = value
    viewRef.value?.style.setProperty('min-width', value)
    viewRefFlat.value?.style.setProperty('min-width', value)
    textRef.value?.style.setProperty('min-width', value)
    textRefFlat.value?.style.setProperty('min-width', value)
    imageRef.value?.style.setProperty('min-width', value)
    imageRefFlat.value?.style.setProperty('min-width', value)
    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      getPropertyValues()
    })
  }

  const radioChangeMinWidth = (index : number) => {
    console.log('index', index)
    const selectedItem = minWidthEnum.find((item) : boolean => item.value === index)
    if (selectedItem != null) {
      changeMinWidth(selectedItem.name)
    }
  }

  const inputChangeMinWidth = (value : string) => {
    changeMinWidth(value)
  }

  onReady(() => {
    getPropertyValues()
  })

  defineExpose({
    radioChangeMinWidth,
    data
  })
</script>

<style>
  .common {
    width: 50px;
    height: 80px;
    background-color: cyan;
    justify-content: center;
    align-items: center;
  }

  .common-dynamic {
    width: 50px;
    height: 80px;
    background-color: cyan;
    color: #1a1a1a;
  }

  .test-box {
    width: 100%;
    height: 80px;
    background-color: gray;
  }

  .demo-box-native {
    align-items: center;
  }

  .container-native {
    background-color: cyan;
  }
</style>
