<template>
    <view class="flex-grow-1">
      <view>
        <text class="color-text-333">max-height: 100px</text>
        <view class="common" style="max-height: 100px;">
          <text class="color-1a1a1a">height: 400px</text>
        </view>
        <text class="color-text-333">拍平</text>
        <view class="common" style="max-height: 100px;" flatten>
          <text class="color-1a1a1a">height: 400px</text>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">scroll-view 组件</text>
      </view>

      <view class="flex-dir-row justify-around mt-10">
        <scroll-view class="common" style="max-height: 80px; background-color: cyan;width:100px;">
          <text class="color-1a1a1a fs-12 text-center">max-height: 80px</text>
        </scroll-view>
        <scroll-view class="common" style="max-height: 120px; background-color: cyan;width:100px;">
          <text class="color-1a1a1a fs-12 text-center">max-height: 120px</text>
        </scroll-view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">setProperty 设置与 getPropertyValue 获取</text>
      </view>

      <!-- 普通版本 -->
      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件</text>
          <text class="fs-12 color-999">设置值: {{data.maxHeight}}</text>
          <text class="fs-12 color-999">获取值: {{data.maxHeightActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="common-dynamic" :style="{ maxHeight: data.maxHeight }">
              <text class="color-1a1a1a" style="font-size: 12px;">view</text>
            </view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件</text>
          <text class="fs-12 color-999">设置值: {{data.maxHeight}}</text>
          <text class="fs-12 color-999">获取值: {{data.maxHeightActualText}}</text>
          <view class="test-box">
            <text ref="textRef" class="common-dynamic" :style="{ maxHeight: data.maxHeight }">text</text>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">image 组件</text>
          <text class="fs-12 color-999">设置值: {{data.maxHeight}}</text>
          <text class="fs-12 color-999">获取值: {{data.maxHeightActualImage}}</text>
          <view class="test-box">
            <image ref="imageRef" class="common-dynamic" :style="{ maxHeight: data.maxHeight }"
              src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <!-- 拍平版本 -->
      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.maxHeight}}</text>
          <text class="fs-12 color-999">获取值: {{data.maxHeightActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="common-dynamic" :style="{ maxHeight: data.maxHeight }"
              flatten>
              <text class="color-1a1a1a" style="font-size: 12px;">view</text>
            </view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.maxHeight}}</text>
          <text class="fs-12 color-999">获取值: {{data.maxHeightActualTextFlat}}</text>
          <view class="test-box">
            <text ref="textRefFlat" class="common-dynamic" :style="{ maxHeight: data.maxHeight }"
              flatten>text</text>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">image 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.maxHeight}}</text>
          <text class="fs-12 color-999">获取值: {{data.maxHeightActualImageFlat}}</text>
          <view class="test-box">
            <image ref="imageRefFlat" class="common-dynamic" :style="{ maxHeight: data.maxHeight }"
              flatten src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="mt-15 mb-15">
        <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">第一个枚举值，'' (空字符串) - 空值情况</text>
        <enum-data-checkbox :items="maxHeightEnum" title="max-height 枚举值" @change="radioChangeMaxHeight"
          :compact="true"></enum-data-checkbox>
        <input-data :defaultValue="data.maxHeight" title="max-height 自定义值" type="text"
          @confirm="inputChangeMaxHeight"></input-data>
      </view>

      <!-- #ifndef MP-ALIPAY -->
      <view class="mb-15">
        <text class="color-text-333">native-view组件: max-height: 80px 和 max-height: 120px</text>
        <view class="demo-box-native flex-dir-row justify-around mt-10">
          <view class="container-native">
            <native-view style="max-height: 80px; width:100px; height: 400px;"></native-view>
          </view>
          <view class="container-native">
            <native-view style="max-height: 120px; width:100px; height: 400px;"></native-view>
          </view>
        </view>
      </view>
      <!-- #endif -->
    </view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types'

  const maxHeightEnum : ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '100px' },
    { value: 4, name: '150px' },
    { value: 5, name: '80rpx' },
    { value: 6, name: 'none' }
  ]

  const data = reactive({
    maxHeight: '50px',
    maxHeightActual: '',
    maxHeightActualText: '',
    maxHeightActualImage: '',
    maxHeightActualFlat: '',
    maxHeightActualTextFlat: '',
    maxHeightActualImageFlat: ''
  })
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const getPropertyValues = () => {
    data.maxHeightActual = viewRef.value?.style.getPropertyValue('max-height') ?? ''
    data.maxHeightActualFlat = viewRefFlat.value?.style.getPropertyValue('max-height') ?? ''
    data.maxHeightActualText = textRef.value?.style.getPropertyValue('max-height') ?? ''
    data.maxHeightActualTextFlat = textRefFlat.value?.style.getPropertyValue('max-height') ?? ''
    data.maxHeightActualImage = imageRef.value?.style.getPropertyValue('max-height') ?? ''
    data.maxHeightActualImageFlat = imageRefFlat.value?.style.getPropertyValue('max-height') ?? ''
  }


  const changeMaxHeight = (value : string) => {
    data.maxHeight = value
    viewRef.value?.style.setProperty('max-height', value)
    viewRefFlat.value?.style.setProperty('max-height', value)
    textRef.value?.style.setProperty('max-height', value)
    textRefFlat.value?.style.setProperty('max-height', value)
    imageRef.value?.style.setProperty('max-height', value)
    imageRefFlat.value?.style.setProperty('max-height', value)
    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      getPropertyValues()
    })
  }

  const radioChangeMaxHeight = (index : number) => {
    const selectedItem = maxHeightEnum.find((item) : boolean => item.value === index)
    if (selectedItem != null) {
      changeMaxHeight(selectedItem.name)
    }
  }

  const inputChangeMaxHeight = (value : string) => {
    changeMaxHeight(value)
  }

  onReady(() => {
    getPropertyValues()
  })

  defineExpose({
    radioChangeMaxHeight,
    data
  })
</script>

<style>
  .common {
    width: 200px;
    height: 400px;
    background-color: cyan;
    justify-content: center;
    align-items: center;
  }

  .common-dynamic {
    width: 100px;
    height: 150px;
    background-color: cyan;
  }

  .test-box {
    width: 100%;
    height: 150px;
    background-color: gray;
  }

  .demo-box-native {
    align-items: center;
  }

  .container-native {
    background-color: cyan;
  }
</style>
