            <view class="flex-item blue"></view>
          </view>
          <view class="flex-container">
            <view class="common" style="flex-basis: 100px" flatten>
              <text>100px</text>
            </view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
          </view>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">scroll-view 组件</text>
      </view>

      <view class="flex-dir-row justify-around mt-10">
        <view class="flex-container">
          <scroll-view class="common" style="flex-basis: 50px;">
            <text class="scroll-view-label fs-12 text-center">50px</text>
          </scroll-view>
          <view class="flex-item green"></view>
          <view class="flex-item blue"></view>
        </view>
        <view class="flex-container">
          <scroll-view class="common" style="flex-basis: 100px;">
            <text class="scroll-view-label fs-12 text-center">100px</text>
          </scroll-view>
          <view class="flex-item green"></view>
          <view class="flex-item blue"></view>
        </view>
