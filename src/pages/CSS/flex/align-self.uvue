        <view class="demo-container align-start">
          <view class="common" style="align-self: auto;"></view>
        </view>
        <view class="demo-container align-start">
          <view class="common" style="align-self: auto;" flatten></view>
        </view>
      </view>
    </view>

    <view class="mt-15">
      <text class="color-text-333">align-self: center</text>
      <view class="flex-dir-row justify-around mt-10">
        <view class="demo-container align-center">
          <view class="common" style="align-self: center;"></view>
        </view>
        <view class="demo-container align-center">
          <view class="common" style="align-self: center;" flatten></view>
        </view>
      </view>
    </view>

    <view class="mt-15">
      <text class="color-text-333">align-self: flex-start</text>
      <view class="flex-dir-row justify-around mt-10">
        <view class="demo-container align-start">
          <view class="common" style="align-self: flex-start;"></view>
        </view>
        <view class="demo-container align-start">
          <view class="common" style="align-self: flex-start;" flatten></view>
        </view>
      </view>
    </view>

    <view class="mt-15">
      <text class="color-text-333">align-self: flex-end</text>
      <view class="flex-dir-row justify-around mt-10">
        <view class="demo-container">
          <view class="common" style="align-self: flex-end;"></view>
        </view>
        <view class="demo-container">
          <view class="common" style="align-self: flex-end;" flatten></view>
        </view>
      </view>
    </view>

    <view class="mt-15">
      <text class="color-text-333">align-self: stretch</text>
      <view class="flex-dir-row justify-around mt-10">
        <view class="demo-container">
          <view class="common" style="align-self: stretch;"></view>
        </view>
        <view class="demo-container">
          <view class="common" style="align-self: stretch;" flatten></view>
        </view>
      </view>
    </view>

    <view class="mt-15">
      <text class="fs-15 fw-bold color-text-333">scroll-view 组件</text>
    </view>

    <view class="flex-dir-row justify-around mt-10">
      <view class="demo-container align-center">
        <scroll-view class="common" style="align-self: center;" direction="horizontal">
          <text class="color-1a1a1a fs-12 text-center">align-self: center</text>
        </scroll-view>
      </view>
      <view class="demo-container align-center">
        <scroll-view class="common" style="align-self: flex-start;" direction="horizontal">
          <text class="color-1a1a1a fs-12 text-center">align-self: flex-start</text>
        </scroll-view>
      </view>
    </view>

    <view class="mt-15">
      <text class="fs-15 fw-bold color-text-333">setProperty 设置与 getPropertyValue 获取</text>
    </view>

    <!-- 普通版本 -->
    <view class="flex-dir-row justify-between mt-10">
      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">view 组件</text>
        <text class="fs-12 color-999">设置值: {{data.alignSelf}}</text>
        <text class="fs-12 color-999">获取值: {{data.alignSelfActual}}</text>
        <view class="test-box">
          <view ref="viewRef" class="common" :style="{ alignSelf: data.alignSelf }">
            <text class="common-text color-1a1a1a">view</text>
          </view>
        </view>
      </view>

      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">text 组件</text>
        <text class="fs-12 color-999">设置值: {{data.alignSelf}}</text>
        <text class="fs-12 color-999">获取值: {{data.alignSelfActualText}}</text>
        <view class="test-box">
          <text ref="textRef" class="common color-1a1a1a" :style="{ alignSelf: data.alignSelf }">text</text>
        </view>
      </view>

      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">image 组件</text>
        <text class="fs-12 color-999">设置值: {{data.alignSelf}}</text>
        <text class="fs-12 color-999">获取值: {{data.alignSelfActualImage}}</text>
        <view class="test-box">
          <image ref="imageRef" class="common" :style="{ alignSelf: data.alignSelf }" src="/static/test-image/logo.png"></image>
        </view>
      </view>
    </view>

    <!-- 拍平版本 -->
    <view class="flex-dir-row justify-between mt-10">
      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">view 组件拍平</text>
        <text class="fs-12 color-999">设置值: {{data.alignSelf}}</text>
        <text class="fs-12 color-999">获取值: {{data.alignSelfActualFlat}}</text>
        <view class="test-box">
          <view ref="viewRefFlat" class="common" :style="{ alignSelf: data.alignSelf }" flatten>
            <text class="common-text color-1a1a1a">view</text>
          </view>
        </view>
      </view>

      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">text 组件拍平</text>
        <text class="fs-12 color-999">设置值: {{data.alignSelf}}</text>
        <text class="fs-12 color-999">获取值: {{data.alignSelfActualTextFlat}}</text>
        <view class="test-box">
          <text ref="textRefFlat" class="common color-1a1a1a" :style="{ alignSelf: data.alignSelf }" flatten>text</text>
        </view>
      </view>

      <view class="flex-1 m-0-5">
        <text class="color-888 fs-12 fw-bold u-mt-5">image 组件拍平</text>
        <text class="fs-12 color-999">设置值: {{data.alignSelf}}</text>
        <text class="fs-12 color-999">获取值: {{data.alignSelfActualImageFlat}}</text>
        <view class="test-box">
          <image ref="imageRefFlat" class="common" :style="{ alignSelf: data.alignSelf }" flatten src="/static/test-image/logo.png"></image>
        </view>
      </view>
    </view>

    <view class="mt-15 mb-15">
      <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">第一个枚举值，'' (空字符串) - 空值情况</text>
      <enum-data-checkbox :items="alignSelfEnum" title="align-self 枚举值" @change="radioChangeAlignSelf" :compact="true"></enum-data-checkbox>
      <input-data :defaultValue="data.alignSelf" title="align-self 自定义值" type="text" @confirm="inputChangeAlignSelf"></input-data>
    </view>

    <!-- #ifndef MP-ALIPAY -->
      <text class="fs-15 fw-bold color-text-333 mt-15">native-view 组件：align-self: center 和 flex-start</text>
      <text class="color-888 fs-12 fw-bold u-mt-5">native-view 作为 flex 子项</text>
      <view class="mb-15 flex-dir-row justify-around mt-10">
        <view class="demo-container align-center">
          <test-native-view class="common" style="align-self: center;"></test-native-view>
        </view>
        <view class="demo-container align-center">
          <test-native-view class="common" style="align-self: flex-start;"></test-native-view>
        </view>
      </view>
    <!-- #endif -->
  </view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types'

  const alignSelfEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'auto' },
    { value: 2, name: 'center' },
    { value: 3, name: 'flex-start' },
    { value: 4, name: 'flex-end' },
    { value: 5, name: 'stretch' }
  ]

  const data = reactive({
    alignSelf: 'center',
    alignSelfActual: '',
    alignSelfActualText: '',
    alignSelfActualImage: '',
    alignSelfActualFlat: '',
    alignSelfActualTextFlat: '',
    alignSelfActualImageFlat: ''
  })
  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const getPropertyValues = () => {
    data.alignSelfActual = viewRef.value?.style.getPropertyValue('align-self') ?? ''
    data.alignSelfActualFlat = viewRefFlat.value?.style.getPropertyValue('align-self') ?? ''
    data.alignSelfActualText = textRef.value?.style.getPropertyValue('align-self') ?? ''
    data.alignSelfActualTextFlat = textRefFlat.value?.style.getPropertyValue('align-self') ?? ''
    data.alignSelfActualImage = imageRef.value?.style.getPropertyValue('align-self') ?? ''
    data.alignSelfActualImageFlat = imageRefFlat.value?.style.getPropertyValue('align-self') ?? ''
  }

  const changeAlignSelf = (value: string) => {
    data.alignSelf = value
    viewRef.value?.style.setProperty('align-self', value)
    viewRefFlat.value?.style.setProperty('align-self', value)
    textRef.value?.style.setProperty('align-self', value)
    textRefFlat.value?.style.setProperty('align-self', value)
    imageRef.value?.style.setProperty('align-self', value)
    imageRefFlat.value?.style.setProperty('align-self', value)
    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      getPropertyValues()
    })
  }

  const radioChangeAlignSelf = (index: number) => {
    const selectedItem = alignSelfEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeAlignSelf(selectedItem.name)
    }
  }

  const inputChangeAlignSelf = (value: string) => {
    changeAlignSelf(value)
  }

  onReady(() => {
    getPropertyValues()
  })

  defineExpose({
    radioChangeAlignSelf,
    data
  })
</script>

<style>
  .demo-container {
    display: flex;
    background-color: #cdcbcb;
    border: #ddd solid 1px;
    flex: 1;
    margin: 0 10px;
  }

  .align-start {
    align-items: flex-start;
  }

  .align-center {
    align-items: center;
  }

  .common {
    width: 80px;
    height: 80px;
    background-color: cyan;
  }

  .common-text {
    width: 50px;
  }

  .test-box {
    display: flex;
    width: 100%;
    height: 80px;
    background-color: gray;
    align-items: flex-start;
  }
</style>
