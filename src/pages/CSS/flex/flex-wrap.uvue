<template>
    <view class="flex-grow-1">
      <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">说明：左边是正常版本，右边是拍平版本</text>
      <view>
        <text>flex-wrap: nowrap</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="flex-wrap: nowrap">
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
          </view>
          <view class="common" style="flex-wrap: nowrap" flatten>
            <view class="common-item red" flatten></view>
            <view class="common-item green" flatten></view>
            <view class="common-item blue" flatten></view>
            <view class="common-item red" flatten></view>
            <view class="common-item green" flatten></view>
            <view class="common-item blue" flatten></view>
          </view>
        </view>
      </view>

      <view>
        <text>flex-wrap: wrap</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="flex-wrap: wrap">
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
          </view>
          <view class="common" style="flex-wrap: wrap" flatten>
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
          </view>
        </view>
      </view>

      <view>
        <text>flex-wrap: wrap-reverse</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="flex-wrap: wrap-reverse">
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
          </view>
          <view class="common" style="flex-wrap: wrap-reverse" flatten>
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
            <view class="common-item red"></view>
            <view class="common-item green"></view>
            <view class="common-item blue"></view>
          </view>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">scroll-view 组件</text>
      </view>
      <text class="color-888 fs-12 fw-bold u-mt-5">flex-wrap: wrap 和 nowrap</text>
      <view class="flex-dir-row justify-around mt-10">
        <scroll-view class="common" style="flex-wrap: wrap;" direction="horizontal">
          <view class="common-item red"></view>
          <view class="common-item green"></view>
          <view class="common-item blue"></view>
          <view class="common-item red"></view>
          <view class="common-item green"></view>
          <view class="common-item blue"></view>
        </scroll-view>
        <scroll-view class="common" style="flex-wrap: nowrap;" direction="horizontal">
          <view class="common-item red"></view>
          <view class="common-item green"></view>
          <view class="common-item blue"></view>
          <view class="common-item red"></view>
          <view class="common-item green"></view>
          <view class="common-item blue"></view>
        </scroll-view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">setProperty 设置与 getPropertyValue 获取</text>
      </view>

      <view class="flex-dir-row justify-around">
        <!-- 普通版本 -->
        <view class="mt-15">
          <text class="fs-15 fw-bold color-text-333">flex-wrap</text>
          <text class="fs-12 color-999">设置值: {{data.flexWrap}}</text>
          <text class="fs-12 color-999">获取值: {{data.flexWrapActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="test-flex-container" :style="{ flexWrap: data.flexWrap }">
              <view class="common-item red"></view>
              <view class="common-item green"></view>
              <view class="common-item blue"></view>
              <view class="common-item red"></view>
              <view class="common-item green"></view>
              <view class="common-item blue"></view>
            </view>
          </view>
        </view>

        <!-- 拍平版本 -->
        <view class="mt-15">
          <text class="fs-15 fw-bold color-text-333">拍平</text>
          <text class="fs-12 color-999">设置值: {{data.flexWrap}}</text>
          <text class="fs-12 color-999">获取值: {{data.flexWrapActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="test-flex-container" :style="{ flexWrap: data.flexWrap }" flatten>
              <view class="common-item red"></view>
              <view class="common-item green"></view>
              <view class="common-item blue"></view>
              <view class="common-item red"></view>
              <view class="common-item green"></view>
              <view class="common-item blue"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="mt-15 mb-15">
        <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">第一个枚举值，'' (空字符串) - 空值情况</text>
        <enum-data-checkbox :items="flexWrapEnum" title="flex-wrap 枚举值" @change="radioChangeFlexWrap"
          :compact="true"></enum-data-checkbox>
        <input-data :defaultValue="data.flexWrap" title="flex-wrap 自定义值" type="text"
          @confirm="inputChangeFlexWrap"></input-data>
      </view>
    </view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types'

  const flexWrapEnum : ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'nowrap' },
    { value: 2, name: 'wrap' },
    { value: 3, name: 'wrap-reverse' }
  ]

  const data = reactive({
    flexWrap: 'nowrap',
    flexWrapActual: '',
    flexWrapActualFlat: ''
  })
  const viewRef = ref(null as UniElement | null)
  const viewRefFlat = ref(null as UniElement | null)

  const getPropertyValues = () => {
    data.flexWrapActual = viewRef.value?.style.getPropertyValue('flex-wrap') ?? ''
    data.flexWrapActualFlat = viewRefFlat.value?.style.getPropertyValue('flex-wrap') ?? ''
  }


  const changeFlexWrap = (value : string) => {
    data.flexWrap = value
    viewRef.value?.style.setProperty('flex-wrap', value)
    viewRefFlat.value?.style.setProperty('flex-wrap', value)
    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      getPropertyValues()
    })
  }

  const radioChangeFlexWrap = (index : number) => {
    const selectedItem = flexWrapEnum.find((item) : boolean => item.value === index)
    if (selectedItem != null) {
      changeFlexWrap(selectedItem.name)
    }
  }

  const inputChangeFlexWrap = (value : string) => {
    changeFlexWrap(value)
  }

  onReady(() => {
    getPropertyValues()
  })

  defineExpose({
    radioChangeFlexWrap,
    data
  })
</script>

<style>
  .common {
    flex: 1;
    margin: 0 10px;
    height: 150px;
    background-color: gray;
    flex-direction: row;
  }

  .test-box {
    width: 180px;
    height: 140px;
    background-color: gray;
  }


  .test-flex-container {
    width: 100%;
    height: 100%;
    background-color: gray;
    flex-direction: row;
  }

  .common-item {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }

  .red {
    background-color: red;
  }

  .green {
    background-color: green;
  }

  .blue {
    background-color: blue;
  }
</style>
