    <view class="flex-grow-1">
      <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">说明：左边是正常版本，右边是拍平版本</text>
      <view>
        <text>flex-flow: row nowrap</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="flex-flow: row nowrap">
            <view class="flex-item red"></view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
            <view class="flex-item red"></view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
          </view>
          <view class="common" style="flex-flow: row nowrap" flatten>
            <view class="flex-item red" flatten></view>
            <view class="flex-item green" flatten></view>
            <view class="flex-item blue" flatten></view>
            <view class="flex-item red" flatten></view>
            <view class="flex-item green" flatten></view>
            <view class="flex-item blue" flatten></view>
          </view>
        </view>
      </view>

      <view>
        <text>flex-flow: row wrap</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="flex-flow: row wrap">
            <view class="flex-item red"></view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
            <view class="flex-item red"></view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
          </view>
          <view class="common" style="flex-flow: row wrap" flatten>
            <view class="flex-item red" flatten></view>
            <view class="flex-item green" flatten></view>
            <view class="flex-item blue" flatten></view>
            <view class="flex-item red" flatten></view>
            <view class="flex-item green" flatten></view>
            <view class="flex-item blue" flatten></view>
          </view>
        </view>
      </view>

      <view>
        <text>flex-flow: column nowrap</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="flex-flow: column nowrap">
            <view class="flex-item red"></view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
            <view class="flex-item red"></view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
          </view>
          <view class="common" style="flex-flow: column nowrap" flatten>
            <view class="flex-item red" flatten></view>
            <view class="flex-item green" flatten></view>
            <view class="flex-item blue" flatten></view>
            <view class="flex-item red" flatten></view>
            <view class="flex-item green" flatten></view>
            <view class="flex-item blue" flatten></view>
          </view>
        </view>
      </view>

      <view>
        <text>flex-flow: column wrap</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="common" style="flex-flow: column wrap">
            <view class="flex-item red"></view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
            <view class="flex-item red"></view>
            <view class="flex-item green"></view>
            <view class="flex-item blue"></view>
          </view>
          <view class="common" style="flex-flow: column wrap" flatten>
            <view class="flex-item red" flatten></view>
            <view class="flex-item green" flatten></view>
            <view class="flex-item blue" flatten></view>
            <view class="flex-item red" flatten></view>
            <view class="flex-item green" flatten></view>
            <view class="flex-item blue" flatten></view>
          </view>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">scroll-view 组件</text>
        <text class="color-888 fs-12 fw-bold u-mt-5">flex-flow: row wrap 和 flex-flow: column nowrap</text>
      </view>

      <view class="flex-dir-row justify-around mt-10">
        <scroll-view class="common" style="flex-flow: row wrap;" direction="horizontal">
          <view class="flex-item red"></view>
          <view class="flex-item green"></view>
          <view class="flex-item blue"></view>
          <view class="flex-item red"></view>
          <view class="flex-item green"></view>
          <view class="flex-item blue"></view>
        </scroll-view>
        <scroll-view class="common" style="flex-flow: column nowrap;" direction="horizontal">
          <view class="flex-item red"></view>
          <view class="flex-item green"></view>
          <view class="flex-item blue"></view>
          <view class="flex-item red"></view>
          <view class="flex-item green"></view>
          <view class="flex-item blue"></view>
        </scroll-view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">setProperty 设置与 getPropertyValue 获取</text>
      </view>

      <view class="flex-dir-row justify-around">
        <!-- 普通版本 -->
        <view class="mt-15">
          <text class="fs-15 fw-bold color-text-333">flex-flow</text>
          <text class="fs-12 color-999">设置值: {{data.flexFlow}}</text>
          <text class="fs-12 color-999">获取值: {{data.flexFlowActual}}</text>
          <view class="test-box">
            <view ref="viewRef" class="test-flex-container" :style="{ flexFlow: data.flexFlow }">
              <view class="test-item red"></view>
              <view class="test-item green"></view>
              <view class="test-item blue"></view>
              <view class="test-item red"></view>
              <view class="test-item green"></view>
              <view class="test-item blue"></view>
            </view>
          </view>
        </view>

        <!-- 拍平版本 -->
        <view class="mt-15">
          <text class="fs-15 fw-bold color-text-333">拍平</text>
          <text class="fs-12 color-999">设置值: {{data.flexFlow}}</text>
          <text class="fs-12 color-999">获取值: {{data.flexFlowActualFlat}}</text>
          <view class="test-box">
            <view ref="viewRefFlat" class="test-flex-container" :style="{ flexFlow: data.flexFlow }" flatten>
              <view class="test-item red" flatten></view>
              <view class="test-item green" flatten></view>
              <view class="test-item blue" flatten></view>
              <view class="test-item red" flatten></view>
              <view class="test-item green" flatten></view>
              <view class="test-item blue" flatten></view>
            </view>
          </view>
        </view>
      </view>

      <view class="mt-15 mb-15">
          <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">第一个枚举值，'' (空字符串) - 空值情况</text>
          <enum-data-checkbox :items="flexFlowEnum" title="flex-flow 枚举值" @change="radioChangeFlexFlow" :compact="true"></enum-data-checkbox>
          <input-data :defaultValue="data.flexFlow" title="flex-flow 自定义值" type="text" @confirm="inputChangeFlexFlow"></input-data>
      </view>
    </view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types'

  const flexFlowEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: 'row nowrap' },
    { value: 2, name: 'row wrap' },
    { value: 3, name: 'row wrap-reverse' },
    { value: 4, name: 'column nowrap' },
    { value: 5, name: 'column wrap' },
    { value: 6, name: 'column wrap-reverse' }
  ]

  const data = reactive({
    flexFlow: 'row wrap',
    flexFlowActual: '',
    flexFlowActualFlat: ''
  })
  const viewRef = ref(null as UniElement | null)
  const viewRefFlat = ref(null as UniElement | null)

  const getPropertyValues = () => {
    data.flexFlowActual = viewRef.value?.style.getPropertyValue('flex-flow') ?? ''
    data.flexFlowActualFlat = viewRefFlat.value?.style.getPropertyValue('flex-flow') ?? ''
  }


  const changeFlexFlow = (value : string) => {
    data.flexFlow = value
    viewRef.value?.style.setProperty('flex-flow', value)
    viewRefFlat.value?.style.setProperty('flex-flow', value)
    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      getPropertyValues()
    })
  }

  const radioChangeFlexFlow = (index: number) => {
    const selectedItem = flexFlowEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeFlexFlow(selectedItem.name)
    }
  }

  const inputChangeFlexFlow = (value: string) => {
    changeFlexFlow(value)
  }

  onReady(() => {
    getPropertyValues()
  })

  defineExpose({
    radioChangeFlexFlow,
    data
  })
</script>

<style>
  .common {
    flex: 1;
    margin: 0 10px;
    height: 190px;
    background-color: gray;
  }

  .flex-item {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-bottom:#ddd solid 1px;
  }
  .red {
    background-color: red;
  }
  .green {
    background-color: green;
  }
  .blue {
    background-color: blue;
  }

  .test-box {
    width: 180px;
    height: 180px;
    background-color: gray;
  }


  .test-flex-container {
    width: 100%;
    height: 100%;
    background-color: gray;
  }

  .test-item {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
</style>
