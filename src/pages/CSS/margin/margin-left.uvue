<template>
    <view class="flex-grow-1">
      <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">说明：左边是正常版本，右边是拍平版本</text>
      <view>
        <text>margin-left: 25px</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="demo-container">
            <view class="common red"></view>
            <view class="common" style="margin-left: 25px;"></view>
            <view class="common blue"></view>
          </view>
          <view class="demo-container">
            <view class="common red"></view>
            <view class="common" style="margin-left: 25px;" flatten></view>
            <view class="common blue"></view>
          </view>
        </view>
      </view>

      <view>
        <text>margin-left: 10%</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="demo-container">
            <view class="common red"></view>
            <view class="common" style="margin-left: 10%;"></view>
            <view class="common blue"></view>
          </view>
          <view class="demo-container">
            <view class="common red"></view>
            <view class="common" style="margin-left: 10%;" flatten></view>
            <view class="common blue"></view>
          </view>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">scroll-view 组件</text>
      </view>
      <view>
        <text class="color-888 fs-12 fw-bold u-mt-5">margin-left: 10% 和 margin-left: 30px</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="demo-container">
            <view class="common red"></view>
            <scroll-view class="common" style="margin-left: 10%;"></scroll-view>
            <view class="common blue"></view>
          </view>
          <view class="demo-container">
            <view class="common red"></view>
            <scroll-view class="common" style="margin-left: 30px;"></scroll-view>
            <view class="common blue"></view>
          </view>
        </view>
      </view>

      <view class="mt-15">
        <text class="fs-15 fw-bold color-text-333">setProperty 设置与 getPropertyValue 获取</text>
      </view>

      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件</text>
          <text class="fs-12 color-999">设置值: {{data.marginLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.marginLeftActual}}</text>
          <view class="test-box">
            <view class="common-view" style="background-color: red;"></view>
            <view ref="viewRef" class="common-view" :style="{ marginLeft: data.marginLeft }">
              <text class="common-text">view</text>
            </view>
            <view class="common-view" style="background-color: blue;"></view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件</text>
          <text class="fs-12 color-999">设置值: {{data.marginLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.marginLeftActualText}}</text>
          <view class="test-box">
            <text class="common-view common-text" style="background-color: red;">红色</text>
            <text ref="textRef" class="common-view common-text" :style="{ marginLeft: data.marginLeft }">text</text>
            <text class="common-view common-text" style="background-color: blue;">蓝色</text>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">image 组件</text>
          <text class="fs-12 color-999">设置值: {{data.marginLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.marginLeftActualImage}}</text>
          <view class="test-box">
            <image class="common-image" style="background-color: red;" src="/static/test-image/logo.png"></image>
            <image ref="imageRef" class="common-image" :style="{ marginLeft: data.marginLeft }" src="/static/test-image/logo.png"></image>
            <image class="common-image" style="background-color: blue;" src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>

      <view class="flex-dir-row justify-between mt-10">
        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">view 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.marginLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.marginLeftActualFlat}}</text>
          <view class="test-box">
            <view class="common-view" style="background-color: red;"></view>
            <view ref="viewRefFlat" class="common-view" :style="{ marginLeft: data.marginLeft }" flatten>
              <text class="common-text">view</text>
            </view>
            <view class="common-view" style="background-color: blue;"></view>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">text 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.marginLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.marginLeftActualTextFlat}}</text>
          <view class="test-box">
            <text class="common-view common-text" style="background-color: red;">红色</text>
            <text ref="textRefFlat" class="common-view common-text" :style="{ marginLeft: data.marginLeft }" flatten>text</text>
            <text class="common-view common-text" style="background-color: blue;">蓝色</text>
          </view>
        </view>

        <view class="flex-1 m-0-5">
          <text class="color-888 fs-12 fw-bold u-mt-5">image 组件拍平</text>
          <text class="fs-12 color-999">设置值: {{data.marginLeft}}</text>
          <text class="fs-12 color-999">获取值: {{data.marginLeftActualImageFlat}}</text>
          <view class="test-box">
            <image class="common-image" style="background-color: red;" src="/static/test-image/logo.png"></image>
            <image ref="imageRefFlat" class="common-image" :style="{ marginLeft: data.marginLeft }" flatten src="/static/test-image/logo.png"></image>
            <image class="common-image" style="background-color: blue;" src="/static/test-image/logo.png"></image>
          </view>
        </view>
      </view>
      <view class="mt-15 mb-15">
        <text class="fs-13 color-tips-0958d9 bg-tips-e6f4ff border-l-4-solid-tips-91caff p-10-12 radius-4 m-10">第一个枚举值，'' (空字符串) - 空值情况</text>
        <enum-data-checkbox :items="marginLeftEnum" title="margin-left 枚举值" @change="radioChangeMarginLeft" :compact="true"></enum-data-checkbox>
        <input-data :defaultValue="data.marginLeft" title="margin-left 自定义值" type="text" @confirm="inputChangeMarginLeft"></input-data>
      </view>

      <!-- #ifndef MP-ALIPAY -->
      <view class="mb-15">
        <text>native-view组件: margin-left: 25px 和 10%</text>
        <view class="flex-dir-row justify-around mt-10">
          <view class="demo-container">
            <view class="common red"></view>
            <test-native-view class="common" style="margin-left: 25px;"></test-native-view>
            <view class="common blue"></view>
          </view>
          <view class="demo-container">
            <view class="common red"></view>
            <test-native-view class="common" style="margin-left: 10%;"></test-native-view>
            <view class="common blue"></view>
          </view>
        </view>
      </view>
      <!-- #endif -->
    </view>
</template>

<script setup lang="ts">
  import { ItemType } from '@/components/enum-data-checkbox/enum-data-checkbox-types'

  const data = reactive({
    marginLeft: '25px',
    marginLeftActual: '',
    marginLeftActualText: '',
    marginLeftActualImage: '',
    marginLeftActualFlat: '',
    marginLeftActualTextFlat: '',
    marginLeftActualImageFlat: ''
  })

  const viewRef = ref(null as UniElement | null)
  const textRef = ref(null as UniTextElement | null)
  const imageRef = ref(null as UniImageElement | null)
  const viewRefFlat = ref(null as UniElement | null)
  const textRefFlat = ref(null as UniTextElement | null)
  const imageRefFlat = ref(null as UniImageElement | null)

  const marginLeftEnum: ItemType[] = [
    { value: 0, name: '' },
    { value: 1, name: '0' },
    { value: 2, name: '0px' },
    { value: 3, name: '20px' },
    { value: 4, name: '0%' },
    { value: 5, name: '10%' },
    { value: 6, name: 'auto' }
  ]

  const getPropertyValues = () => {
    data.marginLeftActual = viewRef.value?.style.getPropertyValue('margin-left') ?? ''
    data.marginLeftActualFlat = viewRefFlat.value?.style.getPropertyValue('margin-left') ?? ''
    data.marginLeftActualText = textRef.value?.style.getPropertyValue('margin-left') ?? ''
    data.marginLeftActualTextFlat = textRefFlat.value?.style.getPropertyValue('margin-left') ?? ''
    data.marginLeftActualImage = imageRef.value?.style.getPropertyValue('margin-left') ?? ''
    data.marginLeftActualImageFlat = imageRefFlat.value?.style.getPropertyValue('margin-left') ?? ''
  }


  const changeMarginLeft = (value: string) => {
    data.marginLeft = value
    viewRef.value?.style.setProperty('margin-left', value)
    viewRefFlat.value?.style.setProperty('margin-left', value)
    textRef.value?.style.setProperty('margin-left', value)
    textRefFlat.value?.style.setProperty('margin-left', value)
    imageRef.value?.style.setProperty('margin-left', value)
    imageRefFlat.value?.style.setProperty('margin-left', value)
    // 使用 nextTick 确保样式已应用后再获取值
    nextTick(() => {
      getPropertyValues()
    })
  }

  const radioChangeMarginLeft = (index: number) => {
    const selectedItem = marginLeftEnum.find((item): boolean => item.value === index)
    if (selectedItem != null) {
      changeMarginLeft(selectedItem.name)
    }
  }

  const inputChangeMarginLeft = (value: string) => {
    changeMarginLeft(value)
  }

  onReady(() => {
    getPropertyValues()
  })

  defineExpose({
    radioChangeMarginLeft,
    data
  })
</script>

