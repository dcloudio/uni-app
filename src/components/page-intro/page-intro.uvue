<script setup lang="ts">
  defineOptions({
    styleIsolation: 'app'
  })

const props = defineProps({
  content: {
    type: String,
    default: ''
  }
})

const expanded = ref(true)

const toggle = () => {
  expanded.value = !expanded.value
}
</script>

<template>
  <view class="page-intro m-10 radius-4 overflow-hidden" @click="toggle">
    <view class="page-intro-header flex-dir-row justify-between items-center">
      <text class="page-intro-label fs-13 fw-bold">页面介绍</text>
      <text class="page-intro-arrow fs-11">{{ expanded ? '▲' : '▼' }}</text>
    </view>
    <view v-if="expanded" class="page-intro-body">
      <text class="page-intro-content fs-13 lh-22">{{ content }}</text>
    </view>
  </view>
</template>

