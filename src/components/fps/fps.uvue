<template>
  <view class="pos-fixed right-10 z-index-999 flex-dir-column items-end pointer-events-none" style="top: var(--uni-safe-area-inset-top, 10);">
    <text class="fs-24 color-008000">FPS: {{ fps }}</text>
  </view>
</template>

<script setup lang="ts">
  defineOptions({
    styleIsolation: 'app'
  })

  const props = defineProps({
    interval: {
      type: Number,
      default: 1000
    }
  })

  let animationId : number = -1
  const fps = ref<number>(0)
  let frameCount: number = 0
  let fpsUpdateTime: number = 0

  let calculateFPS = (currentTime : number) => { }
  calculateFPS = (currentTime : number) => {
    if (fpsUpdateTime == (0 as number)) {
      fpsUpdateTime = currentTime
      animationId = requestAnimationFrame(calculateFPS)
      return
    }
    frameCount++
    const delta = currentTime - fpsUpdateTime
    if (delta >= props.interval) {
      const value = Math.floor(frameCount * 1000 / delta)
      fps.value = value
      frameCount = 0
      fpsUpdateTime = currentTime
    }
    animationId = requestAnimationFrame(calculateFPS)
  }

  onMounted(() => {
    animationId = requestAnimationFrame(calculateFPS)
  })

  onBeforeUnmount(() => {
    cancelAnimationFrame(animationId)
  })
</script>
